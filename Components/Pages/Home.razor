@page "/dashboard"
@using System.Globalization

<PageTitle>Dashboard - CNET ERP V7</PageTitle>

<div class="dashboard-wrapper">
    <!-- Top HOME tab -->
    <div class="top-tab-header">
        <div class="tab-item active">HOME</div>
    </div>

    <div class="dashboard-content">
        <!-- Profile Header Section -->
        <div class="profile-header-card">
            <div class="profile-photo-area">
                <div class="photo-placeholder">
                    <i class="bi bi-person-bounding-box mb-1"></i>
                    <span>No image data</span>
                </div>
            </div>
            
            <div class="profile-info-grid">
                <div class="welcome-title">Welcome Red Cloud ICT Solutions PLC</div>
                <div class="info-row">
                    <div class="info-cell"><span class="cell-label">Name</span><span class="cell-value">CNET ADMINISTRATOR</span></div>
                    <div class="info-cell"><span class="cell-label">Version</span><span class="cell-value">1.0</span></div>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span class="cell-label">Role</span><span class="cell-value">CNET ADMIN</span></div>
                    <div class="info-cell"><span class="cell-label">Current Date</span><span class="cell-value">@currentDateString</span></div>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span class="cell-label">Department</span><span class="cell-value">Administration</span></div>
                    <div class="info-cell"></div>
                </div>
            </div>
            
            <div class="profile-logo-area">
                @* <div class="e-invoice-tag">E-Invoice</div> *@
                <div class="red-cloud-logo">
                    <div class="logo-cloud"><i class="bi bi-cloud-fill"></i></div>
                    <div class="logo-text">RED<span>CLOUD</span><div class="sub-text">ICT Solutions</div></div>
                </div>
            </div>
        </div>

        <!-- Sub Tabs Area -->
        <div class="sub-tabs-bar">
            <div class="sub-tab-item active">
                <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </div>
            <div class="sub-tab-item">
                <i class="bi bi-shield-lock me-1"></i>Security
            </div>
        </div>

        <!-- Columns Area -->
        <div class="dashboard-main-grid">
            <!-- Left Column: Tables -->
            <div class="grid-left-col">
                <div class="actions-row">
                    <div class="action-buttons">
                        <button class="action-btn text-success" title="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
                        <button class="action-btn text-danger" title="Export PDF"><i class="bi bi-file-pdf"></i></button>
                        <button class="action-btn text-primary" title="Statistics"><i class="bi bi-bar-chart-line"></i></button>
                    </div>
                    <div class="hotel-select-area">
                        <span class="select-label">Hotel</span>
                        <select class="hotel-select">
                            <option>WASSAMAR HOTEL</option>
                        </select>
                    </div>
                </div>

                <!-- Table 1: Tasks -->
                <div class="table-container mb-4">
                    <table class="dashboard-table font-table">
                        <thead>
                            <tr>
                                <th style="width: 45%;">Task</th>
                                <th style="width: 15%; text-align: center;">Statistics</th>
                                <th style="width: 40%;">Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in tasksList)
                            {
                                <tr class="@(task.Stats > 0 ? "highlight-row" : "")">
                                    <td>@task.TaskName</td>
                                    <td class="stat-cell">@task.Stats</td>
                                    <td class="text-muted">@task.Remark</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Table 2: Room Statistics -->
                <div class="table-container">
                    <div class="table-section-title">Today's Room Statistics</div>
                    <table class="dashboard-table room-stats-table">
                        <thead>
                            <tr>
                                <th style="width: 10%; text-align: center;">SN</th>
                                <th style="width: 70%;">Description</th>
                                <th style="width: 20%; text-align: center;">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in roomStatsList)
                            {
                                <tr class="@(stat.Count > 0 && stat.Description.Contains("Dirty") ? "highlight-count-row-dirty" : stat.Count > 0 ? "highlight-count-row" : "")">
                                    <td class="sn-cell">@stat.SN</td>
                                    <td>@stat.Description</td>
                                    <td class="count-cell">@stat.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Charts -->
            <div class="grid-right-col">
                <!-- Pie Chart Widget -->
                <div class="chart-widget mb-4">
                    <div class="chart-widget-header">Room Occupancy (Today)</div>
                    <div class="chart-widget-body pie-chart-layout">
                        <!-- SVG Pie Chart -->
                        <div class="pie-svg-wrapper">
                            <svg viewBox="0 0 120 120" width="160" height="160">
                                <!-- Base grey circle -->
                                <circle cx="60" cy="60" r="50" fill="#f1f3f4" />
                                <!-- Vacant slice (73.33%): length = 230.37, offset = 0 -->
                                <circle cx="60" cy="60" r="25" fill="transparent" stroke="#3b71ca" stroke-width="50" 
                                        stroke-dasharray="230.37 314.16" transform="rotate(-90 60 60)" />
                                <!-- Occupied slice (26.67%): length = 83.79, offset = 230.37 -->
                                <circle cx="60" cy="60" r="25" fill="transparent" stroke="#b02a37" stroke-width="50" 
                                        stroke-dasharray="83.79 314.16" stroke-dashoffset="-230.37" transform="rotate(-90 60 60)" />
                                <!-- Center white hole to make it look like a donut/pie -->
                                <circle cx="60" cy="60" r="10" fill="#ffffff" />
                            </svg>
                            <div class="pie-percentage-label">73.33%</div>
                            <div class="pie-percentage-label-occupied">26.67%</div>
                        </div>

                        <!-- Legend -->
                        <div class="chart-legend">
                            <div class="legend-item">
                                <span class="legend-color-box bg-primary-slice"></span>
                                <span class="legend-text">Vacant (66): 73.33%</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-color-box bg-danger-slice"></span>
                                <span class="legend-text">Occupied (24): 26.67%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Area Chart Widget -->
                <div class="chart-widget">
                    <div class="chart-widget-header d-flex justify-content-between align-items-center">
                        <span>Reservations (2026) Total=837</span>
                    </div>
                    <div class="chart-widget-body area-chart-layout">
                        <!-- SVG Area Chart -->
                        <svg viewBox="0 0 520 220" width="100%" height="220" class="svg-area-chart">
                            <!-- Grids background -->
                            <line x1="40" y1="30" x2="500" y2="30" stroke="#f1f3f4" stroke-width="1" />
                            <line x1="40" y1="60" x2="500" y2="60" stroke="#e9eef2" stroke-width="1" />
                            <line x1="40" y1="90" x2="500" y2="90" stroke="#e9eef2" stroke-width="1" />
                            <line x1="40" y1="120" x2="500" y2="120" stroke="#e9eef2" stroke-width="1" />
                            <line x1="40" y1="150" x2="500" y2="150" stroke="#e9eef2" stroke-width="1" />
                            <line x1="40" y1="180" x2="500" y2="180" stroke="#e9eef2" stroke-width="1" />
                            
                            <!-- Y Axis Labels -->
                            <text x="30" y="35" class="chart-axis-text" text-anchor="end">240</text>
                            <text x="30" y="65" class="chart-axis-text" text-anchor="end">210</text>
                            <text x="30" y="95" class="chart-axis-text" text-anchor="end">180</text>
                            <text x="30" y="125" class="chart-axis-text" text-anchor="end">150</text>
                            <text x="30" y="155" class="chart-axis-text" text-anchor="end">120</text>
                            <text x="30" y="185" class="chart-axis-text" text-anchor="end">90</text>
                            <text x="30" y="215" class="chart-axis-text" text-anchor="end">0</text>
                            
                            <!-- Filled Area Path -->
                            <path d="M 40,60 C 60,70 70,75 80,80 C 100,90 110,110 120,126 C 130,135 150,110 160,100 C 170,90 190,110 200,120 C 215,130 230,165 240,180 C 250,190 270,210 280,210 L 480,210 L 40,210 Z" 
                                  fill="rgba(59, 113, 202, 0.15)" stroke="none" />
                            
                            <!-- Stroke Path -->
                            <path d="M 40,60 C 60,70 70,75 80,80 C 100,90 110,110 120,126 C 130,135 150,110 160,100 C 170,90 190,110 200,120 C 215,130 230,165 240,180 C 250,190 270,210 280,210 L 480,210" 
                                  fill="none" stroke="#3b71ca" stroke-width="3" />
                            
                            <!-- X Axis line -->
                            <line x1="40" y1="210" x2="500" y2="210" stroke="#cccccc" stroke-width="1.5" />
                            
                            <!-- X Axis Labels -->
                            <text x="40" y="222" class="chart-axis-text" text-anchor="middle">Jan</text>
                            <text x="80" y="222" class="chart-axis-text" text-anchor="middle">Mar</text>
                            <text x="120" y="222" class="chart-axis-text" text-anchor="middle">Apr</text>
                            <text x="160" y="222" class="chart-axis-text" text-anchor="middle">May</text>
                            <text x="200" y="222" class="chart-axis-text" text-anchor="middle">Jun</text>
                            <text x="240" y="222" class="chart-axis-text" text-anchor="middle">Jul</text>
                            <text x="280" y="222" class="chart-axis-text" text-anchor="middle">Aug</text>
                            <text x="320" y="222" class="chart-axis-text" text-anchor="middle">Sep</text>
                            <text x="360" y="222" class="chart-axis-text" text-anchor="middle">Oct</text>
                            <text x="400" y="222" class="chart-axis-text" text-anchor="middle">Nov</text>
                            <text x="440" y="222" class="chart-axis-text" text-anchor="middle">Dec</text>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string currentDateString = DateTime.Now.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture);

    private List<DashboardTask> tasksList = new()
    {
        new("HuluBeje App Registrations", 0, "Registrations Made By HuluBeje APP"),
        new("Guest's Birthday", 0, "In-House Registrations where the guest's birthday is today."),
        new("Today's Pickup", 0, "Registrations whose pickup for shuttle service is today."),
        new("Today's Drop-off", 0, "Registrations whose drop-off for shuttle service is today."),
        new("Over Due Out", 1, "Check In Registration Where Departure Date <= for Given Date"),
        new("Due Out", 0, "Check In Registration Where Departure Date Is Today."),
        new("No Show", 0, "6PM or Confirmed Reservation Where Departure Date <= for Given Date"),
        new("Waiting List", 0, "Waiting Registration"),
        new("Six PM Arrivals", 0, "All SIX PM Arrivals"),
        new("Guaranteed Arrivals", 0, "All Guaranteed Arrivals"),
        new("All Arrivals", 0, "All Arrivals")
    };

    private List<RoomStat> roomStatsList = new()
    {
        new(1, "Total House Keeping Rooms", 66),
        new(2, "Total Clean", 58),
        new(3, "Total Dirty", 8),
        new(4, "Total Inspected", 0),
        new(5, "Total Pickup", 0),
        new(6, "Total Out Of Order", 0),
        new(7, "Total Out Of Service", 0),
        new(8, "Not Reserved - Clean", 58),
        new(9, "Not Reserved - Dirty", 8),
        new(10, "Not Reserved - Inspected", 0),
        new(11, "Not Reserved - Pickup", 0),
        new(12, "Not Reserved - Out Of Service", 0),
        new(13, "Reserved - Clean", 0),
        new(14, "Reserved - Dirty", 0),
        new(15, "Reserved - Inspected", 0)
    };

    public class DashboardTask
    {
        public string TaskName { get; set; }
        public int Stats { get; set; }
        public string Remark { get; set; }

        public DashboardTask(string taskName, int stats, string remark)
        {
            TaskName = taskName;
            Stats = stats;
            Remark = remark;
        }
    }

    public class RoomStat
    {
        public int SN { get; set; }
        public string Description { get; set; }
        public int Count { get; set; }

        public RoomStat(int sn, string description, int count)
        {
            SN = sn;
            Description = description;
            Count = count;
        }
    }
}
