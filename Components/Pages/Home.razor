@page "/dashboard"
@rendermode InteractiveServer
@using DevExpress.Blazor

<PageTitle>Dashboard - CNET ERP</PageTitle>

<div class="dashboard-page">

    <!-- ===================== TOP HEADER ===================== -->
    <div class="top-header">
        <div class="user-card">
            <!-- Left: female avatar icon -->
            <div class="avatar">
                <svg viewBox="0 0 100 100" width="300" height="300" xmlns="http://www.w3.org/2000/svg">

                    <!-- Background -->
                    <rect width="100" height="100" fill="#b5b9d3" />

                    <!-- Female profile placeholder silhouette -->
                    <path d="
                    M 50,7

                    C 35,7 25,16 23,31
                    C 21,41 21,51 19,59

                    C 17,64 14,67 11,70
                    C 15,70 18,68 21,65

                    C 19,69 17,72 14,75
                    C 19,76 23,74 26,71

                    C 25,76 23,79 21,82
                    C 28,85 35,86 40,87

                    L 40,91

                    C 34,93 28,96 21,98
                    L 79,98

                    C 72,96 66,93 60,91
                    L 60,87

                    C 65,86 72,85 79,82

                    C 77,79 75,76 74,71

                    C 77,74 81,76 86,75
                    C 83,72 81,69 79,65

                    C 82,68 85,70 89,70
                    C 86,67 83,64 81,59

                    C 79,51 79,41 77,31
                    C 75,16 65,7 50,7

                    Z
                    " fill="#ffffff" />
                </svg>
            </div>

            <!-- Right: flex column -->
            <div class="user-details">
                <!-- Row 1: hotel name full width -->
                <div class="welcome-row">
                    Welcome to <span class="hotel-name">Eden Hotel</span>
                </div>
                <!-- Row 2: grid left + right -->
                <div class="info-grid">
                    <div class="info-left">
                        <div class="info-row"><span class="lbl">Name</span><span class="val">System CNET
                            ADMINISTRATOR</span></div>
                            <div class="info-row"><span class="lbl">Role</span><span class="val">Cnet Admin</span></div>
                            <div class="info-row"><span class="lbl">Department</span><span class="val"></span></div>
                        </div>
                        <div class="info-right">
                            <div class="info-row"><span class="lbl">Access Level</span><span class="val">81.07%</span></div>
                            <div class="info-row"><span class="lbl">Release Date</span><span class="val">15-05-2017
                                (V6.0.1.21)</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="calendar-box">
                    <div class="cal-left">
                        <div class="cal-toggle">
                            <DxComboBox Data="@calendarModes" @bind-Value="calendarMode" CssClass="cal-mode-combo" />
                        </div>
                        <div class="cal-nav-vert">
                            <span class="cal-lbl">Month</span>
                            <DxComboBox Data="@months" @bind-Value="selectedMonth" Width="90px" />
                            <span class="cal-lbl">Year</span>
                            <DxSpinEdit @bind-Value="selectedYear" MinValue="2000" MaxValue="2030" Width="72px" />
                        </div>
                        <div class="cal-footer-vert">
                            <DxButton Text="Today" RenderStyle="ButtonRenderStyle.Link" Click="GoToday" />
                            <span class="cal-date">@selectedDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                    <div class="cal-right">
                        <DxCalendar @bind-SelectedDate="selectedDate" CssClass="dash-calendar" VisibleDate="@visibleDate"
                                    VisibleDateChanged="OnVisibleDateChanged" />
                    </div>
                </div>

                <div class="logo-box">
                    <img src="cnet logo.jpg" alt="CNET Logo" class="cnet-logo-img" />
                </div>
            </div>

            <!-- ===================== MAIN TABS ===================== -->
            <DxTabs @bind-ActiveTabIndex="activeTab" CssClass="main-tabs">
                <DxTabPage Text="Dashboard">
                    <div class="dashboard-body">

                        <!-- Left: Task Statistics Grid -->
                        <div class="left-panel">
                            <div class="panel-toolbar">
                                <DxButton Text="Refresh" IconCssClass="oi oi-reload" Click="RefreshTasks"
                                          RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
                            </div>
                            <DxGrid Data="@taskItems" KeyFieldName="SN" CssClass="task-grid" RowClick="OnTaskRowClick"
                                    CustomizeElement="OnTaskCustomizeElement" PageSize="15" ShowPager="false"
                                    TextWrapEnabled="true">
                                <Columns>
                                    <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
                                    <DxGridDataColumn FieldName="Task" Caption="Task" MinWidth="140" />
                                    <DxGridDataColumn FieldName="Statistics" Caption="Statistics" Width="80px" />
                                    <DxGridDataColumn FieldName="Remark" Caption="Remark" MinWidth="220" />
                                </Columns>
                            </DxGrid>
                        </div>

                        <!-- Right: Charts -->
                        <div class="right-panel">
                            <!-- Pie: Room Occupancy -->
                            <div class="chart-card">
                                <div class="chart-title">Room Occupancy (Today)</div>
                                <DxChart Data="@occupancyData" Height="200px" Width="100%">
                                    <DxChartLegend Visible="true" HorizontalAlignment="HorizontalAlignment.Right" />
                                    <DxChartPieSeries T="OccupancySlice" TArgument="string" TValue="decimal"
                                                      ArgumentField="@(x => x.Name)" ValueField="@(x => x.Value)" Name="Occupancy">
                                        <DxChartSeriesLabel Visible="true" Position="RelativePosition.Outside" />
                                    </DxChartPieSeries>
                                </DxChart>
                                <div class="legend-manual">
                                    <span class="leg-item"><span class="dot vacant"></span> Vacant (2): 6.90 %</span>
                                    <span class="leg-item"><span class="dot occupied"></span> Occupied (1): 93.10 %</span>
                                </div>
                            </div>

                            <!-- Line: Reservations -->
                            <div class="chart-card">
                                <div class="chart-title">Reservations (@selectedYear) Total=@totalReservations</div>
                                <DxChart Data="@reservationData" Height="200px" Width="100%">
                                    <DxChartLegend Visible="true" HorizontalAlignment="HorizontalAlignment.Right" />
                                    <DxChartArgumentAxis>
                                        <DxChartAxisLabel />
                                    </DxChartArgumentAxis>
                                    <DxChartValueAxis>
                                        <DxChartAxisRange StartValue="0" EndValue="80" />
                                    </DxChartValueAxis>
                                    <DxChartLineSeries T="ReservationPoint" TArgument="DateTime" TValue="int"
                                                       ArgumentField="@(x => x.Month)" ValueField="@(x => x.Count)" Name="Reservations"
                                                       Color="@reservationLineColor">
                                        <DxChartSeriesPoint Visible="true" />
                                    </DxChartLineSeries>
                                </DxChart>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom: Today's Room Status -->
                    <div class="room-status-panel">
                        <div class="room-status-title">Today's Room Status</div>
                        <div class="room-status-placeholder">
                            <!-- Placeholder – wire to real room status data when available -->
                        </div>
                    </div>
                </DxTabPage>

                <DxTabPage Text="Task Notification">
                    <div class="tab-placeholder">Task Notification content</div>
                </DxTabPage>
                <DxTabPage Text="Activity">
                    <div class="tab-placeholder">Activity content</div>
                </DxTabPage>
                <DxTabPage Text="Message">
                    <div class="tab-placeholder">Message content</div>
                </DxTabPage>
                <DxTabPage Text="E-mail">
                    <div class="tab-placeholder">E-mail content</div>
                </DxTabPage>
                <DxTabPage Text="Security">
                    <div class="tab-placeholder">Security content</div>
                </DxTabPage>
                <DxTabPage Text="Personal Record">
                    <div class="tab-placeholder">Personal Record content</div>
                </DxTabPage>
                <DxTabPage Text="My Note">
                    <div class="tab-placeholder">My Note content</div>
                </DxTabPage>
            </DxTabs>
        </div>

        <style>
            .dashboard-page {
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
                background: #f0f2f5;
                min-height: 100vh;
                padding: 0;
            }

            /* ---------- Top header ---------- */
            .top-header {
                display: flex;
                gap: 12px;
                padding: 6px 12px;
                background: #fff;
                border-bottom: 1px solid #d0d5dd;
                align-items: stretch;
            }

            .user-card {
                display: flex;
                gap: 12px;
                flex: 1;
                padding: 4px 0;
            }

            /* Left: female icon */
            .avatar {
                width: 300px;
                height: 300px;
                border-radius: 4px;
                background: #eceff1;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #cfd8dc;
                flex-shrink: 0;
                overflow: hidden;
            }

            /* Right: flex column */
            .user-details {
                display: flex;
                flex-direction: column;
                flex: 1;
                gap: 4px;
                padding-top: 2px;

                
            }

            /* Row 1: full-width hotel name */
            .welcome-row {
                width: 100%;
                font-size: 35px;
                font-weight: 700;
                color: #222;
                line-height: 2.3;
            }

            .hotel-name {
                color: #1565c0;
            }

            /* Row 2: two-column grid */
            .info-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0 24px;
            }

            .info-left,
            .info-right {
                display: flex;
                flex-direction: column;
                gap: 1px;
            }

            .info-row {
                font-size: 12px;
                line-height: 1.5;
                color: #555;
                white-space: nowrap;
            }

            .info-row .lbl {
                display: inline-block;
                width: 95px;
                color: #777;
            }

            .info-row .val {
                font-weight: 500;
                color: #222;
            }

            /* ---------- Calendar (landscape) ---------- */
            .calendar-box {
                display: flex;
                flex-direction: row;
                align-items: stretch;
                border: 1px solid #bdbdbd;
                background: #fff;
                padding: 5px 7px;
                flex-shrink: 0;
                gap: 8px;
                height: 155px;
                box-sizing: border-box;
            }

            /* Left sidebar: controls */
            .cal-left {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 4px;
                min-width: 95px;
                border-right: 1px solid #e0e0e0;
                padding-right: 8px;
            }

            .cal-toggle {
                font-size: 11px;
            }

            .cal-nav-vert {
                display: flex;
                flex-direction: column;
                gap: 3px;
                font-size: 11px;
            }

            .cal-lbl {
                color: #777;
                font-size: 10px;
            }

            .cal-footer-vert {
                display: flex;
                flex-direction: row;
                align-items: center;
                text-align: center;
                gap: 1px;
                margin-top: 20px;
                font-size: 11px;
            }

            .cal-date {
                color: #555;
                font-size: 14px;
                text-align: center;
                padding: 3px;
                border: 1px solid lightgrey;
                border-radius: 5px;
            }

            /* Right: calendar grid */
            .cal-right {
                flex: 1;
                overflow: hidden;
            }

            .dash-calendar {
                width: 100%;
                font-size: 10px;
            }

            /* ---------- Logo ---------- */
            .logo-box {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 180px;
                flex-shrink: 0;
                height: 155px;
                box-sizing: border-box;
                padding: 6px;
            }

            .cnet-logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            /* ---------- Main tabs ---------- */
            .main-tabs {
                background: #fff;
                margin: 0 8px;
            }

            .main-tabs ::deep .dxbl-tabs {
                border-bottom: 1px solid #d0d5dd;
                padding-left: 8px;
            }

            .main-tabs ::deep .dxbl-tabs-item {
                padding: 8px 16px !important;
                font-size: 13px;
                font-weight: 600;
                color: #666;
            }

            .main-tabs ::deep .dxbl-tabs-item-active {
                color: #1565c0 !important;
                border-bottom: 2px solid #1565c0 !important;
            }

            /* ---------- Dashboard body ---------- */
            .dashboard-body {
                display: flex;
                gap: 10px;
                padding: 10px;
                background: #f5f6f8;
                min-height: 380px;
            }

            .left-panel {
                flex: 1.2;
                background: #fff;
                border: 1px solid #c8cdd4;
                display: flex;
                flex-direction: column;
            }

            .panel-toolbar {
                padding: 4px 6px;
                border-bottom: 1px solid #e0e0e0;
                background: #f8f9fa;
            }

            .task-grid {
                flex: 1;
                font-size: 12px;
            }

            /* Selected row */
            .task-row-selected,
            .task-row-selected td,
            .task-row-selected .dxbl-grid-cell {
                --dxbl-grid-cell-back: #0078d4 !important;
                background-color: #0078d4 !important;
                color: white !important;
            }

            .task-grid .dxbl-grid-data-row {
                cursor: pointer;
            }

            .right-panel {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .chart-card {
                background: #fff;
                border: 1px solid #c8cdd4;
                padding: 8px 12px;
                flex: 1;
            }

            .chart-title {
                text-align: center;
                font-size: 15px;
                font-weight: 600;
                color: #1565c0;
                margin-bottom: 4px;
            }

            .legend-manual {
                display: flex;
                justify-content: center;
                gap: 18px;
                font-size: 11px;
                margin-top: 4px;
            }

            .leg-item {
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .dot {
                width: 10px;
                height: 10px;
                border-radius: 2px;
                display: inline-block;
            }

            .dot.vacant {
                background: #1e88e5;
            }

            .dot.occupied {
                background: #c62828;
            }

            /* ---------- Room status ---------- */
            .room-status-panel {
                margin: 0 10px 10px;
                background: #fff;
                border: 1px solid #c8cdd4;
                min-height: 120px;
            }

            .room-status-title {
                text-align: center;
                font-size: 16px;
                font-weight: 600;
                color: #1565c0;
                padding: 10px;
                border-bottom: 1px solid #eee;
            }

            .room-status-placeholder {
                height: 80px;
            }

            .tab-placeholder {
                padding: 40px;
                text-align: center;
                color: #999;
                font-size: 14px;
            }
        </style>

@code {
    // ---------- Header / Calendar ----------
    string calendarMode = "Gregorian";
    string[] calendarModes = new[] { "Ethiopian", "Gregorian" };
    int selectedMonth = 8;
    int selectedYear = 2017;
    DateTime selectedDate = new DateTime(2017, 8, 19);
    DateTime visibleDate = new DateTime(2017, 8, 1);

    List<int> months = Enumerable.Range(1, 12).ToList();

    void OnVisibleDateChanged(DateTime date)
    {
        visibleDate = date;
        selectedMonth = date.Month;
        selectedYear = date.Year;
    }

    void GoToday()
    {
        selectedDate = DateTime.Today;
        visibleDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        selectedMonth = DateTime.Today.Month;
        selectedYear = DateTime.Today.Year;
    }

    // ---------- Tabs ----------
    int activeTab = 0;

    // ---------- Task grid ----------
    TaskItem? selectedTask;

    List<TaskItem> taskItems = new()
    {
        new() { SN = 1, Task = "Over Due Out", Statistics = 79, Remark = "Check In Registration Where Departure Date <= for Given Date" },
        new() { SN = 2, Task = "Due Out", Statistics = 0, Remark = "Check In Registration Where Departure Date Is Today." },
        new() { SN = 3, Task = "No Show", Statistics = 0, Remark = "GPM or Confirmed Reservation Where Departure Date <= for Given Date" },
        new() { SN = 4, Task = "Unassigned Reservation", Statistics = 7, Remark = "GPM or Confirmed Reservation Where Room is not assigned to them" },
        new() { SN = 5, Task = "Waiting List", Statistics = 1, Remark = "Waiting Registration" },
        new() { SN = 6, Task = "Arrival List", Statistics = 3, Remark = "All Arrival List" },
        new() { SN = 7, Task = "Stay Overs", Statistics = 0, Remark = "Inhouse Registrations whose departure date is greater than today" },
        new() { SN = 8, Task = "Departures", Statistics = 0, Remark = "Registrations that have already checked-out today" },
        new() { SN = 9, Task = "Post Masters", Statistics = 5, Remark = "Check In Registrations Whose room type is Pseudo Room type" },
        new() { SN = 10, Task = "Cancellations", Statistics = 0, Remark = "Registrations with cancel state" },
        new() { SN = 11, Task = "Arrived", Statistics = 1, Remark = "Check-In registrations that have already arrived today" },
    };

    void OnTaskRowClick(GridRowClickEventArgs e)
    {
        selectedTask = e.Grid?.GetDataItem(e.VisibleIndex) as TaskItem;
    }

    void OnTaskCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as TaskItem;
            if (item != null && selectedTask != null && item.SN == selectedTask.SN)
                e.CssClass = "task-row-selected";
        }
    }

    void RefreshTasks()
    {
        selectedTask = null;
        StateHasChanged();
    }

    // ---------- Occupancy pie ----------
    List<OccupancySlice> occupancyData = new()
    {
        new() { Name = "Vacant", Value = 6.90m },
        new() { Name = "Occupied", Value = 93.10m }
    };

    // ---------- Reservations line ----------
    int totalReservations = 141;
    System.Drawing.Color reservationLineColor = System.Drawing.Color.FromArgb(0x1e, 0x88, 0xe5);

    List<ReservationPoint> reservationData = new()
    {
        new() { Month = new DateTime(2017, 1, 1), Count = 12 },
        new() { Month = new DateTime(2017, 2, 1), Count = 18 },
        new() { Month = new DateTime(2017, 3, 1), Count = 25 },
        new() { Month = new DateTime(2017, 4, 1), Count = 32 },
        new() { Month = new DateTime(2017, 5, 1), Count = 55 },
        new() { Month = new DateTime(2017, 6, 1), Count = 68 },
        new() { Month = new DateTime(2017, 7, 1), Count = 42 },
        new() { Month = new DateTime(2017, 8, 1), Count = 22 },
        new() { Month = new DateTime(2017, 9, 1), Count = 15 },
        new() { Month = new DateTime(2017, 10, 1), Count = 10 },
        new() { Month = new DateTime(2017, 11, 1), Count = 8 },
        new() { Month = new DateTime(2017, 12, 1), Count = 5 },
    };

    // ---------- Models ----------
    public class TaskItem
    {
        public int SN { get; set; }
        public string Task { get; set; } = "";
        public int Statistics { get; set; }
        public string Remark { get; set; } = "";
    }

    public class OccupancySlice
    {
        public string Name { get; set; } = "";
        public decimal Value { get; set; }
    }

    public class ReservationPoint
    {
        public DateTime Month { get; set; }
        public int Count { get; set; }
    }
}