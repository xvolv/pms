@page "/dashboard"
@rendermode InteractiveServer
@using DevExpress.Blazor


<PageTitle>Dashboard - CNET ERP</PageTitle>

<div class="dashboard-page">

    <!-- ===================== TOP HEADER ===================== -->
    <div class="top-header">
        <div class="user-card">
            <!-- Left: female avatar icon -->
            <div class="avatar">
                <svg viewBox="0 0 100 100" width="300" height="300" xmlns="http://www.w3.org/2000/svg">

                    <!-- Background -->
                    <rect width="100" height="100" fill="#b5b9d3" />

                    <!-- Female profile placeholder silhouette -->
                    <path d="
                    M 50,7

                    C 35,7 25,16 23,31
                    C 21,41 21,51 19,59

                    C 17,64 14,67 11,70
                    C 15,70 18,68 21,65

                    C 19,69 17,72 14,75
                    C 19,76 23,74 26,71

                    C 25,76 23,79 21,82
                    C 28,85 35,86 40,87

                    L 40,91

                    C 34,93 28,96 21,98
                    L 79,98

                    C 72,96 66,93 60,91
                    L 60,87

                    C 65,86 72,85 79,82

                    C 77,79 75,76 74,71

                    C 77,74 81,76 86,75
                    C 83,72 81,69 79,65

                    C 82,68 85,70 89,70
                    C 86,67 83,64 81,59

                    C 79,51 79,41 77,31
                    C 75,16 65,7 50,7

                    Z
                    " fill="#ffffff" />
                </svg>
            </div>

            <!-- Right: flex column -->
            <div class="user-details">
                <!-- Row 1: hotel name full width -->
                <div class="welcome-row">
                    Welcome to <span class="hotel-name">Eden Hotel</span>
                </div>
                <!-- Row 2: one aligned list — Access Level is just another row, not a separate column -->
                <div class="info-grid">
                    <div class="info-row"><span class="lbl">Name</span><span class="val">SYSTEM CNET
                        ADMINISTRATOR</span></div>
                        <div class="info-row"><span class="lbl">Role</span><span class="val">CNET ADMIN</span></div>
                        <div class="info-row"><span class="lbl">Department</span><span class="val"></span></div>
                        <div class="info-row"><span class="lbl">Access Level</span><span class="val">81.07%</span></div>
                    </div>
                </div>
            </div>

            <div class="logo-box">
                <img src="cnet logo.png" alt="CNET Logo" class="cnet-logo-img" />
            </div>
        </div>

        <!-- ===================== MAIN TABS ===================== -->
        <DxTabs @bind-ActiveTabIndex="activeTab" CssClass="main-tabs">
            <DxTabPage Text="Dashboard">
                <div class="dashboard-body">

                    <!-- Left: Task Statistics Grid -->
                    <div class="left-panel">
                        <div class="panel-toolbar">
                            <button type="button" class="icon-toolbar-btn" title="Refresh" @onclick="RefreshTasks">
                                <i class="bi bi-arrow-clockwise" style="color:#4caf50;"></i>
                            </button>
                            <button type="button" class="icon-toolbar-btn" title="Print" @onclick="OnPrintTasks">
                                <i class="bi bi-file-earmark-pdf" style="color:#d32f2f;"></i>
                            </button>
                            <button type="button" class="icon-toolbar-btn" title="Export to Excel" @onclick="OnExportTasks">
                                <i class="bi bi-file-earmark-excel" style="color:#2e7d32;"></i>
                            </button>

                            <div class="panel-toolbar-hotel">
                                <span class="tb-label">Hotel</span>
                                <DxComboBox Data="@dashboardHotels" @bind-Value="selectedDashboardHotel"
                                            CssClass="rt-detail-input" style="width:180px;" />
                            </div>
                        </div>
                        <DxGrid Data="@taskItems" KeyFieldName="SN" CssClass="task-grid" RowClick="OnTaskRowClick"
                                CustomizeElement="OnTaskCustomizeElement" PageSize="15" ShowPager="false"
                                TextWrapEnabled="true" Height="180px">
                            <Columns>
                                <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
                                <DxGridDataColumn FieldName="Task" Caption="Task" MinWidth="140" />
                                <DxGridDataColumn FieldName="Statistics" Caption="Statistics" Width="80px" />
                                <DxGridDataColumn FieldName="Remark" Caption="Remark" MinWidth="220" />
                            </Columns>
                        </DxGrid>

                        <!-- Today's Room Statistics -->
                        <div class="chart-card">
                            <div class="chart-title">Today's Room Statistics</div>
                            <DxGrid Data="@roomStatsItems" KeyFieldName="SN" CssClass="room-stats-grid"
                                    ShowPager="false" PageSize="20">
                                <Columns>
                                    <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
                                    <DxGridDataColumn FieldName="Description" Caption="Description" MinWidth="180" />
                                    <DxGridDataColumn FieldName="Count" Caption="Count" Width="70px" />
                                </Columns>
                            </DxGrid>
                        </div>

                        <!-- Pie: Today's Room Status -->
                        <div class="chart-card">
                            <div class="chart-title">Today's Room Status</div>
                            <DxPieChart Data="@roomStatusData" Height="200px" Width="100%">
                                <DxPieChartSeries T="RoomStatusSlice" TArgument="string" TValue="decimal"
                                                  ArgumentField="@(x => x.Name)" ValueField="@(x => x.Value)" Name="Room Status">
                                    <DxChartSeriesLabel Visible="true" Position="RelativePosition.Outside" />
                                </DxPieChartSeries>
                            </DxPieChart>
                            <div class="legend-manual">
                                <span class="leg-item"><span class="dot" style="background:#26a69a;"></span> Inspected (0): 0.00 %</span>
                                <span class="leg-item"><span class="dot" style="background:#ffb300;"></span> Clean (14): 100.00 %</span>
                                <span class="leg-item"><span class="dot" style="background:#e53935;"></span> Dirty (0): 0.00 %</span>
                                <span class="leg-item"><span class="dot" style="background:#43a047;"></span> Pickup (0): 0.00 %</span>
                                <span class="leg-item"><span class="dot" style="background:#6d4c31;"></span> Out of Service (0): 0.00 %</span>
                                <span class="leg-item"><span class="dot" style="background:#1a237e;"></span> Out of Order (0): 0.00 %</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Charts -->
                    <div class="right-panel">
                        <!-- Pie: Room Occupancy -->
                        <div class="chart-card">
                            <div class="chart-title">Room Occupancy (Today)</div>
                            <DxPieChart Data="@occupancyData" Height="200px" Width="100%">
                                <DxChartLegend Visible="true" HorizontalAlignment="HorizontalAlignment.Right" />
                                <DxPieChartSeries T="OccupancySlice" TArgument="string" TValue="decimal"
                                                  ArgumentField="@(x => x.Name)" ValueField="@(x => x.Value)" Name="Occupancy">
                                    <DxChartSeriesLabel Visible="true" Position="RelativePosition.Outside" />
                                </DxPieChartSeries>
                            </DxPieChart>
                            <div class="legend-manual">
                                <span class="leg-item"><span class="dot vacant"></span> Vacant (2): 6.90 %</span>
                                <span class="leg-item"><span class="dot occupied"></span> Occupied (1): 93.10 %</span>
                            </div>
                        </div>

                        <!-- Line: Reservations -->
                        <div class="chart-card">
                            <div class="chart-title">Reservations (@selectedYear) Total=@totalReservations</div>
                            <DxChart Data="@reservationData" Height="200px" Width="100%">
                                <DxChartLegend Visible="true" HorizontalAlignment="HorizontalAlignment.Right" />
                                <DxChartArgumentAxis>
                                    <DxChartAxisLabel />
                                </DxChartArgumentAxis>
                                <DxChartValueAxis>
                                    <DxChartAxisRange StartValue="0" EndValue="80" />
                                </DxChartValueAxis>
                                <DxChartLineSeries T="ReservationPoint" TArgument="DateTime" TValue="int"
                                                   ArgumentField="@(x => x.Month)" ValueField="@(x => x.Count)" Name="Reservations"
                                                   Color="@reservationLineColor">
                                    <DxChartSeriesPoint Visible="true" />
                                </DxChartLineSeries>
                            </DxChart>
                        </div>
                    </div>
                </div>
            </DxTabPage>
            <DxTabPage Text="Security">
                <div class="tab-placeholder">Security content</div>
            </DxTabPage>


        </DxTabs>
    </div>


    <style>
        * {
            box-sizing: border-box;
        }


        .dashboard-page {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: white;
            height: 100vh;
            padding: 0;

            display: flex;
            flex-direction: column;

            overflow: hidden;
        }


        .top-header {
            display: grid;

            /* USER | LOGO — logo pushed to the far right */
            grid-template-columns: 1fr 150px;

            gap: 12px;
            padding: 6px 12px;

            background: white ;
            @* border-bottom: 1px solid #1255c2; *@

            align-items: start;

            flex: 0 0 auto;
        }

        /* The DxTabs nav strip and its content panel are siblings of
           .top-header under .dashboard-page (DevExpress renders the tab
           content panel as a plain .dx-tabs-content-panel with no way to
           attach our own CssClass to it) — scope everything below to the
           element right after OUR nav via the adjacent-sibling combinator,
           so other DxTabs instances elsewhere in the app aren't affected. */
        .main-tabs {
            flex: 0 0 auto;
        }

        .main-tabs + .dx-tabs-content-panel {
            flex: 1 1 auto;
            min-height: 0;

            display: flex;
            flex-direction: column;

            overflow: hidden;
        }

        .main-tabs + .dx-tabs-content-panel .dx-tabs-content {
            flex: 1 1 auto;
            min-height: 0;

            display: flex;
            flex-direction: column;

            overflow: hidden;
        }


        .user-card {
            display: flex;
            align-items: flex-start;

            gap: 12px;

            min-width: 420px;

            padding: 4px 0;
        }

        .avatar {
            width: 150px;
            height: 150px;

            flex-shrink: 0;

            border-radius: 4px;
            background: #eceff1;
            border: 1px solid #cfd8dc;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;
        }

        .avatar svg {
            width: 100%;
            height: 100%;
        }

        .user-details {
            display: flex;
            flex-direction: column;

            min-width: 240px;

            gap: 4px;
            padding-top: 2px;
        }

        .welcome-row {
            font-size: clamp(22px, 2.2vw, 35px);
            font-weight: 700;

            color: #222;

            line-height: 1.3;

            white-space: normal;
            overflow-wrap: break-word;
            font-family: monospace, monospace;
        }

        .info-grid {
            display: flex;
            flex-direction: column;

            gap: 2px;
        }

        .info-row {
            font-size: 12px;
            line-height: 1.5;

            color: #555;

            white-space: normal;
        }

        .info-row .lbl {
            display: inline-block;

            min-width: 95px;

            white-space: nowrap;

            color: #777;
        }

        .info-row .val {
            font-weight: 500;
            color: #222;
        }



        .logo-box {
            width: 150px;

            display: flex;
            align-items: flex-start;
            justify-content: center;

            align-self: start;
        }

        .cnet-logo-img {
            display: block;

            width: 100%;
            height: auto;

            object-fit: contain;
            padding:2px;
            border:1px solid #cfd8dc !important;
        }


   

        .main-tabs {
            
            background: white;
            margin: 0 8px;
        }


        .main-tabs .nav-tabs {


            flex-wrap: nowrap !important;
        }

        .main-tabs .nav-tabs .nav-item {
            flex: 1 1 0%;

            text-align: center;
        }

        .main-tabs .nav-tabs .nav-link {
            padding: 10px 0px !important;

            font-size: 15px;

            white-space: nowrap;

            width: 100%;

            border: 1px solid #d0d5dd !important;
            border-bottom-color: transparent !important;
            border-radius: 0px !important;

            position: relative;
        }

        /* Inactive tabs get a visible border + recessed gray fill so they still
           read as clickable, but sit a step behind the active tab (lower
           z-index, no lift) instead of blending into the page. */
        .main-tabs .nav-tabs .nav-link:not(.active) {
            color: #6c757d !important;

            background: #eef1f4;

            border-bottom-color: #d0d5dd !important;
            padding-bottom: 8px !important;
            margin-top: 2px !important;
            z-index: 1;
        }

        .main-tabs .nav-tabs .nav-link.active {
            background: #fff;

            border-color: #d0d5dd !important;
            border-bottom-color: #fff !important;

            z-index: 2;
        }



        .dashboard-body {
            display: flex;
            flex-wrap: wrap;

            gap: 10px;

            padding: 10px;

            background: white;

            flex: 1 1 auto;
            min-height: 0;

            overflow: hidden;
        }

        .left-panel {
            flex: 1.2 1 320px;

            background: #fff;

            border: 1px solid #c8cdd4;

            display: flex;
            flex-direction: column;

            min-width: 280px;
            max-width: 100%;
            height: 100%;
            min-height: 0;

            overflow-y: auto;
            overflow-x: auto;
        }
                .left-panel::-webkit-scrollbar {
            width: 8px;
        }

        .left-panel::-webkit-scrollbar-thumb {
            background: hsla(0, 0%, 46%, 0.637);
            border-radius: 0px;
        }

        .toolbar-group {
            gap: 2px;
            flex-wrap: nowrap;
            flex-shrink: 0;
        }


        .panel-toolbar {
            display: flex;
            align-items: center;
            gap: 8px;

            padding: 6px 8px;

            border-bottom: 1px solid #e0e0e0;

            background: white;

            flex: 0 0 auto;

            position: sticky;
            top: 0;
            z-index: 10;
        }

        .icon-toolbar-btn {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 36px;
            height: 32px;

            border: 1px solid #c8cdd4;
            border-radius: 3px;
            background: #fff;

            cursor: pointer;
        }

        .icon-toolbar-btn i {
            font-size: 18px;
        }

        .icon-toolbar-btn:hover {
            background: #f0f4fa;
        }

        .panel-toolbar-hotel {
            display: flex;
            align-items: center;
            gap: 6px;

            margin-left: 8px;
        }

        .task-grid {
            flex: 0 0 auto;

            font-size: 12px;

            height: 280px;
            overflow: hidden;
        }

        .task-row-selected,
        .task-row-selected td,
        .task-row-selected .dxbl-grid-cell {
            --dxbl-grid-cell-back: #0078d4 !important;

            background-color: #0078d4 !important;

            color: white !important;
        }

        .task-grid .dxbl-grid-data-row {
            cursor: pointer;
        }

        .right-panel {
            flex: 1 1 280px;

            display: flex;
            flex-direction: column;

            gap: 10px;

            min-width: 260px;
            height: 100%;
            min-height: 0;

            overflow-y: auto;
        }

        .chart-card {
            background: #fff;

            border: 1px solid #c8cdd4;

            padding: 8px 12px;


        }

        .chart-title {
            text-align: center;

            font-size: clamp(13px, 1.6vw, 15px);

            font-weight: 600;

            color: #1565c0;

            margin-bottom: 4px;
        }

        .legend-manual {
            display: flex;
            flex-wrap: wrap;

            justify-content: center;

            gap: 18px;

            font-size: 11px;

            margin-top: 4px;
        }

        .leg-item {
            display: flex;
            align-items: center;

            gap: 4px;
        }

        .dot {
            width: 10px;
            height: 10px;

            border-radius: 2px;

            display: inline-block;
        }

        .dot.vacant {
            background: #1e88e5;
        }

        .dot.occupied {
            background: #c62828;
        }




        .tab-placeholder {
            padding: 40px;

            text-align: center;

            color: #999;

            font-size: 14px;
        }


       


 

        @@media (max-width: 1500px) {

            .top-header {
                grid-template-columns: minmax(380px, 1fr) minmax(440px, 1.5fr) 140px;
            }

            .user-card {
                min-width: 0;
            }

            .avatar {
                width: 130px;
                height: 130px;
            }

            .logo-box {
                width: 140px;
            }
        }



        @@media (max-width: 1100px) {

            .top-header {
                grid-template-columns: minmax(0, 1fr) 150px;

                grid-template-areas: "user logo";
            }

            .user-card {
                grid-area: user;
                min-width: 0;
            }

            .logo-box {
                grid-area: logo;
                width: 150px;
            }

            .avatar {
                width: 110px;
                height: 110px;
            }

            .welcome-row {
                font-size: 28px;
            }
        }




        @@media (max-width: 768px) {

            .top-header {
                grid-template-columns: minmax(0, 1fr) 130px;

                grid-template-areas: "user logo";

                padding: 10px;
            }

            .user-card {
                grid-area: user;

                display: flex;
                flex-direction: row;
                align-items: flex-start;

                gap: 12px;

                min-width: 0;
            }

            .avatar {
                width: 96px;
                height: 96px;

                flex-shrink: 0;
            }

            .user-details {
                min-width: 0;
                width: 100%;
            }

            .welcome-row {
                text-align: left;
                font-size: 24px;
            }

            .info-grid {
                display: grid;

                grid-template-columns: 95px 1fr;

                gap: 2px 8px;

                width: 100%;
            }

            .info-row {
                display: contents;
            }

            .info-row .lbl {
                min-width: 0;
            }

            .info-row .val {
                min-width: 0;
            }

            .logo-box {
                grid-area: logo;

                width: 130px;

                align-self: start;
                justify-self: end;
            }

            .cnet-logo-img {
                width: 100%;
                height: auto;
            }

            .dashboard-body {
                flex-direction: column;
            }

            .left-panel,
            .right-panel {
                min-width: 0;
                flex: 1 1 auto;
            }
        }




        @@media (max-width: 480px) {

            .top-header {
                grid-template-columns: minmax(0, 1fr) 90px;

                grid-template-areas: "user logo";
            }

            .logo-box {
                width: 90px;
            }

            .avatar {
                width: 72px;
                height: 72px;
            }

            .welcome-row {
                font-size: 20px;
                line-height: 1.25;
            }

            .info-row {
                white-space: normal;
            }

            .info-row .lbl {
                margin-right: 4px;
            }

            .main-tabs .nav-tabs .nav-link {
                padding: 6px 10px !important;
                font-size: 12px;
            }
        }

        @@media (min-width: 641px) {

            .top-row[b-hb0gcga9k0],
            article[b-hb0gcga9k0] {
                padding-left: 5px !important;
                padding-right: 0rem !important;
            }
        }

        @@media (max-width: 768px) {

            .top-header {
                display: grid;

                grid-template-columns: minmax(0, 1fr) 90px;

                grid-template-areas: "user logo";

                gap: 8px;

                padding: 8px;

                width: 100%;
                max-width: 100%;

                align-items: start;
            }

            .user-card {
                grid-area: user;
                min-width: 0;
            }

            .logo-box {
                grid-area: logo;

                width: 90px;
                height: 90px;

                align-self: start;
                justify-self: end;

                display: flex;
                align-items: flex-start;
                justify-content: flex-end;
            }

            .cnet-logo-img {
                display: block;

                width: 90px;
                height: auto;

                object-fit: contain;
            }

            .dx-legend-inside .dx-chart-legend.dx-center{
                background-color: red;
            }
            
        }
        .dx-legend-inside .dx-chart-legend.dx-center {
    left: 87%;
    transform: translate(-50%, 0);
}
    </style>


@code {
    // ---------- Header ----------
    int selectedYear = 2018;

    // ---------- Tabs ----------
    int activeTab = 0;

    // ---------- Task grid ----------
    TaskItem? selectedTask;

    List<TaskItem> taskItems = new()
    {
        new() { SN = 1, Task = "Over Due Out", Statistics = 79, Remark = "Check In Registration Where Departure Date <= for Given Date" },
        new() { SN = 2, Task = "Due Out", Statistics = 0, Remark = "Check In Registration Where Departure Date Is Today." },
        new() { SN = 3, Task = "No Show", Statistics = 0, Remark = "6PM or Confirmed Reservation Where Departure Date <= for Given Date" },
        new() { SN = 4, Task = "Unassigned Reservation", Statistics = 7, Remark = "6PM or Confirmed Reservation Where Room is not assigned to them" },
        new() { SN = 5, Task = "Waiting List", Statistics = 1, Remark = "Waiting Registration" },
        new() { SN = 6, Task = "Arrival List", Statistics = 3, Remark = "All Arrival List" },
        new() { SN = 7, Task = "Stay Overs", Statistics = 0, Remark = "Inhouse Registrations whose departure date is greater than today" },
        new() { SN = 8, Task = "Departures", Statistics = 0, Remark = "Registrations that have already checked-out today" },
        new() { SN = 9, Task = "Post Masters", Statistics = 5, Remark = "Check In Registrations Whose room type is Pseudo Room type" },
        new() { SN = 10, Task = "Cancellations", Statistics = 0, Remark = "Registrations with cancel state" },
        new() { SN = 11, Task = "Arrived", Statistics = 1, Remark = "Check-In registrations that have already arrived today" },
    };

    void OnTaskRowClick(GridRowClickEventArgs e)
    {
        selectedTask = e.Grid?.GetDataItem(e.VisibleIndex) as TaskItem;
    }

    void OnTaskCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as TaskItem;
            if (item != null && selectedTask != null && item.SN == selectedTask.SN)
                e.CssClass = "task-row-selected";
        }
    }

    void RefreshTasks()
    {
        selectedTask = null;
        StateHasChanged();
    }

    void OnPrintTasks()
    {
        // TODO: print logic
    }

    void OnExportTasks()
    {
        // TODO: export to Excel logic
    }

    // ---------- Task panel toolbar ----------
    List<string> dashboardHotels = new() { "MAIN TEST HOTEL" };
    string? selectedDashboardHotel = "MAIN TEST HOTEL";

    // ---------- Today's Room Statistics ----------
    List<RoomStatItem> roomStatsItems = new()
    {
        new() { SN = 1, Description = "Total House Keeping Rooms", Count = 14 },
        new() { SN = 2, Description = "Total Clean", Count = 14 },
        new() { SN = 3, Description = "Total Dirty", Count = 0 },
        new() { SN = 4, Description = "Total Inspected", Count = 0 },
        new() { SN = 5, Description = "Total Pickup", Count = 0 },
        new() { SN = 6, Description = "Total Out Of Order", Count = 0 },
        new() { SN = 7, Description = "Total Out Of Service", Count = 0 },
        new() { SN = 8, Description = "Not Reserved - Clean", Count = 14 },
        new() { SN = 9, Description = "Not Reserved - Dirty", Count = 0 },
        new() { SN = 10, Description = "Not Reserved - Inspected", Count = 0 },
        new() { SN = 11, Description = "Not Reserved - Pickup", Count = 0 },
        new() { SN = 12, Description = "Not Reserved - Out Of Service", Count = 0 },
        new() { SN = 13, Description = "Reserved - Clean", Count = 0 },
        new() { SN = 14, Description = "Reserved - Dirty", Count = 0 },
        new() { SN = 15, Description = "Reserved - Inspected", Count = 0 },
        new() { SN = 16, Description = "Reserved - Pickup", Count = 0 },
        new() { SN = 17, Description = "Reserved - Out Of Service", Count = 0 },
    };

    // ---------- Today's Room Status pie ----------
    List<RoomStatusSlice> roomStatusData = new()
    {
        new() { Name = "Inspected", Value = 0m },
        new() { Name = "Clean", Value = 14m },
