    private List<AmenityRow> FeatureRows => masterAmenities.Select(a => new AmenityRow
    {
        Name = a,
        Selected = selectedRoomType?.SelectedAmenities.Contains(a) ?? false,
        Description = selectedRoomType != null && selectedRoomType.AmenityDescriptions.TryGetValue(a, out var d) ? d : "",
    }).ToList();

    private void ToggleAmenity(string amenity, bool isChecked)
    {
        if (selectedRoomType == null)
            return;

        if (isChecked)
            selectedRoomType.SelectedAmenities.Add(amenity);
        else
            selectedRoomType.SelectedAmenities.Remove(amenity);
    }

    private string GetAmenityDescription(string amenity)
    {
        if (selectedRoomType == null)
            return "";

        return selectedRoomType.AmenityDescriptions.TryGetValue(amenity, out var description) ? description : "";
    }

    private void SetAmenityDescription(string amenity, string description)
    {
        if (selectedRoomType == null)
            return;

        if (string.IsNullOrWhiteSpace(description))
            selectedRoomType.AmenityDescriptions.Remove(amenity);
        else
            selectedRoomType.AmenityDescriptions[amenity] = description;
    }

    private void OnRoomTypeRowClick(GridRowClickEventArgs e)
    {
        var row = (RoomTypeRow)roomTypeGrid!.GetDataItem(e.VisibleIndex);
        selectedRoomType = row;
    }

    private void OnRoomTypeCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow)
            return;

        var row = (RoomTypeRow)roomTypeGrid!.GetDataItem(e.VisibleIndex);
        if (selectedRoomType?.Id == row.Id)
            e.CssClass = "rt-row-selected";
    }

