@page "/property"
@rendermode InteractiveServer
@using ERP.V7.WebPMS.Components.Pages.Room.Modals
@using ERP.V7.WebPMS.Components.Pages.Room.shared
@inject NavigationManager NavigationManager

<PageTitle>Property - Room Type</PageTitle>

<div class="dashboard-wrapper">
    <!-- Top Tabs -->
    <div class="top-tab-header">
        <div class="tab-item active" style="position: relative; padding-right: 2.5rem;">
            Property
            <i class="bi bi-x fs-4" @onclick="CloseProperty"
               style="position: absolute; top: -6px; right: 3px; cursor: pointer;"></i>
        </div>
    </div>

    <div class="dashboard-content">
        <DxTabs @bind-ActiveTabIndex="activeTabIndex" CssClass="property-tabs">
            <DxTabPage Text="Room Type" />

            <DxTabPage Text="Rooms" />
        </DxTabs>




        @if (activeTabIndex == 0)
        {
            <!-- Toolbar -->
            <Toolbar Items="roomTypeToolbarItems" />
            <!-- Grid + Features -->
            <div class="rt-grid-layout">
                <div class="rt-grid-area" @onclick:stopPropagation="true">

                    <DxGrid @ref="roomTypeGrid" width="100%" Data="@roomTypes" KeyFieldName="Id" CssClass="rt-grid"
                            RowClick="@OnRoomTypeRowClick" CustomizeElement="@OnRoomTypeCustomizeElement">
                        <Columns>
                            <DxGridDataColumn FieldName="Sn" Caption="SN" Width="5%" />
                            @* <DxGridDataColumn FieldName="Code" Caption="Code" Width="10%" /> *@
                            <DxGridDataColumn FieldName="Description" Caption="Description" Width="25%" />
                            <DxGridDataColumn FieldName="NoOfRooms" Caption="No. Of Rooms" Width="18%" />
                            <DxGridDataColumn FieldName="Status" Caption="Status" Width="7%">
                                <CellDisplayTemplate>
                                    <input type="checkbox" class="rt-grid-checkbox"
                                           checked="@(((RoomTypeRow)context.DataItem).Status)" disabled />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="IsHouseKeeping" Caption="Is House Keeping?" Width="15%">
                                <CellDisplayTemplate>
                                    <input type="checkbox" class="rt-grid-checkbox"
                                           checked="@(((RoomTypeRow)context.DataItem).IsHouseKeeping)" disabled />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="IsPseudoRoom" Caption="Is Pseudo Room?" Width="10%">
                                <CellDisplayTemplate>
                                    <input type="checkbox" class="rt-grid-checkbox"
                                           checked="@(((RoomTypeRow)context.DataItem).IsPseudoRoom)" disabled />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="AutoRoomAssign" Caption="Auto Room Assign" width="15%">
                                <CellDisplayTemplate>
                                    <input type="checkbox" class="rt-grid-checkbox"
                                           checked="@(((RoomTypeRow)context.DataItem).AutoRoomAssign)" disabled />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="CanBeMeetingRoom" Caption="Meeting Room?" Width="10%">
                                <CellDisplayTemplate>
                                    <input type="checkbox" class="rt-grid-checkbox"
                                           checked="@(((RoomTypeRow)context.DataItem).CanBeMeetingRoom)" disabled />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                        </Columns>
                    </DxGrid>

                    <div class="rt-footer">
                        Total Number of Rooms = @roomTypes.Sum(r => r.NoOfRooms)
                    </div>
                </div>

                <div class="rt-features-panel" @onclick:stopPropagation="true">
                    <div class="rt-features-tab">Features</div>
                    <div class="rt-features-body">
                        @if (selectedRoomType == null)
                        {
                            <div class="rt-features-empty">Select a room type to manage its features.</div>
                        }
                        else
                        {
                            <DxGrid Data="@FeatureRows" KeyFieldName="Name" CssClass="rt-features-grid" width="100%"
                                    ShowFilterRow="false" ShowGroupPanel="false" PageSize="@masterAmenities.Count"
                                    PagerVisible="false">
                                <Columns>
                                    <DxGridDataColumn FieldName="Selected" Caption="*" Width="40px">
                                        <CellDisplayTemplate>
                                            <input type="checkbox" class="rt-features-checkbox"
                                                   checked="@(((AmenityRow)context.DataItem).Selected)"
                                                   @onchange="@(e => ToggleAmenity(((AmenityRow)context.DataItem).Name, (bool)e.Value!))" />
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="Name" Caption="Amenities" Width="45%" />
                                    <DxGridDataColumn FieldName="Description" Caption="Description">
                                        <CellDisplayTemplate>
                                            <input type="text" class="rt-features-desc-input"
                                                   value="@(((AmenityRow)context.DataItem).Description)"
                                                   disabled="@(!((AmenityRow)context.DataItem).Selected)"
                                                   @onchange="@(e => SetAmenityDescription(((AmenityRow)context.DataItem).Name, e.Value?.ToString() ?? ""))" />
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                </Columns>
                            </DxGrid>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <Toolbar Items="blocksToolbarItems" />

            <div class="rooms-tab" @onclick:stopPropagation="true">
                <!-- Building / Floor Tree -->
                <div class="rooms-tree-panel">
                    <div class="rooms-tree-header">Building Name</div>
                    <div class="rooms-tree-body">
                        @foreach (var block in blocks)
                        {
                            <div class="block-header @(selectedBlockId == block.Id ? "active" : "")">
                                <span class="block-expand-toggle" title="Expand / collapse"
                                      @onclick="() => ToggleBlockExpand(block.Id)" @onclick:stopPropagation="true">
                                    <i class="bi @(block.IsExpanded ? "bi-dash-square" : "bi-plus-square")"></i>
                                </span>
                                <span class="block-name" title="View all rooms in this building"
                                      @onclick="() => ViewBlock(block.Id)">@block.Name</span>
                            </div>
                            @if (block.IsExpanded)
                            {
                                @foreach (var floor in block.Floors)
                                {
                                    <div class="floor-row @(currentFloorId == floor.Id ? "active" : "")"
                                         @onclick="() => SelectFloor(floor.Id)">
                                        Floor - @floor.Number@(floor.Rooms.Count > 0 ? $" ( {floor.Rooms.Count} Rooms )" : "")
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>

                <!-- Rooms / Floor Layout -->
                <div class="rooms-main-panel">
                    <DxTabs @bind-ActiveTabIndex="roomsSubTabIndex" CssClass="rooms-tabs">
                        <DxTabPage Text="Rooms">
                            <!-- Toolbar goes HERE -->
                            <div class="rooms-toolbar">
                                <button class="rt-toolbar-btn" @onclick="AddRoomTile">
                                    <i class="bi  bi-file-earmark-plus text-secondary"></i>
                                    <span>Add</span>
                                </button>
                                <button class="rt-toolbar-btn" @onclick="DeleteRoomTiles">
                                    <i class="bi bi-trash3 text-secondary"></i>
                                    <span>Delete</span>
                                </button>
                                <button class="rt-toolbar-btn" disabled="@(selectedTileIds.Count != 1)"
                                        @onclick="EditRoomTile">
                                    <i class="bi bi-pencil-square text-secondary"></i>
                                    <span>Edit</span>
                                </button>
                                <button class="rt-toolbar-btn" @onclick="ApplyRoomType">
                                    <i class="bi bi-check-circle text-secondary"></i>
                                    <span>Apply</span>
                                </button>
                                <div class="rooms-toolbar-field">
                                    <label>Room Type</label>
                                    <DxComboBox Data="@roomTypes" @bind-Value="@applyRoomTypeCode"
                                                TextFieldName="@nameof(RoomTypeRow.Description)"
                                                ValueFieldName="@nameof(RoomTypeRow.Code)" NullText="-- Select --"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Width="200px" />
                                </div>
                                <div class="rooms-toolbar-field">
                                    <label>Filter Rooms By</label>

                                    <select class="rt-form-select" @bind="statusFilter">
                                        <option value="">All</option>
                                        <option value="Clean">Clean</option>
                                        <option value="Dirty">Dirty</option>
                                        <option value="Occupied">Occupied</option>
                                        <option value="OOS">Out of Service</option>
                                    </select>
                                </div>

                                <div class="rooms-toolbar-selection">
                                    <span>Selection (@selectedTileIds.Count)</span>
                                    <select class="rt-form-select" @onchange="HandleSelectionAction">
                                        <option value="">-</option>
                                        <option value="all">Select All</option>
                                        <option value="none">Clear</option>
                                    </select>
                                </div>
                            </div>

                            <div class="rooms-scroll-area">
                                @if (ViewedFloors.Count == 0)
                                {
                                    <div class="rt-placeholder">Select a building or floor to view its rooms.</div>
                                }
                                else
                                {
                                    @foreach (var floor in ViewedFloors)
                                    {
                                        var owningBlock = BlockOfFloor(floor);
                                        <div class="rooms-floor-title">@(owningBlock != null ? $"{owningBlock.Name} - " : "")Floor - @floor.Number</div>
                                        <div class="room-tiles-grid">
                                            @foreach (var room in FilteredRooms(floor))
                                            {
                                                <div class="room-tile @(selectedTileIds.Contains(room.Id) ? "selected" : "")"
                                                     @onclick="() => ToggleTile(room.Id)">
                                                    <div class="room-tile-number">@room.Number</div>
                                                    <div class="room-tile-type">@room.TypeDescription</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </DxTabPage>

                        <DxTabPage Text="Floor Layout">
                            <div class="rt-placeholder">Floor layout designer coming soon.</div>
                        </DxTabPage>
                    </DxTabs>
                </div>
            </div>
        }
    </div>
</div>

<RoomTypeEditModal Visible="isModalOpen" EditingItem="editingItem" RoomTypes="roomTypes" RoomClasses="roomClasses"
                   Hotels="hotels" OnNew="NewRoomTypeInModal" OnSave="SaveModalRoomType" OnClose="CloseModal" />

<RoomEditModal Visible="isRoomModalOpen" IsNew="isRoomNewEntry" EditingItem="editingRoomTile" RoomTypes="roomTypes"
               SpaceArrangements="spaceArrangements" OnSave="SaveRoomTile" OnClose="CloseRoomModal" />

<BlockEditModal Visible="isBlockModalOpen" IsNew="isBlockNewEntry" EditingItem="editingBlockDraft" Hotels="hotels"
                OnSave="SaveNewBlock" OnClose="CloseBlockModal" />

<ConfirmDialog Visible="@isConfirmVisible" Title="@confirmTitle" Message="@confirmMessage" Danger="@confirmDanger"
               OnConfirm="HandleConfirmYes" OnCancel="HandleConfirmNo" />

<ConfirmDialog Visible="@isInfoVisible" Title="@infoTitle" Message="@infoMessage" ConfirmText="OK"
               ShowCancelButton="false" IconOverride="bi-info-circle-fill" IconColorClassOverride="text-primary"
               OnConfirm="CloseInfoDialog" />

@code {
    private bool isConfirmVisible;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private bool confirmDanger;
    private Func<Task>? pendingConfirmAction;

    private void RequestConfirm(string title, string message, bool danger, Func<Task> action)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmDanger = danger;
        pendingConfirmAction = action;
        isConfirmVisible = true;
    }

    private async Task HandleConfirmYes()
    {
        isConfirmVisible = false;
        var action = pendingConfirmAction;
        pendingConfirmAction = null;
        if (action != null)
            await action();
    }

    private void HandleConfirmNo()
    {
        isConfirmVisible = false;
        pendingConfirmAction = null;
    }

    private int activeTabIndex = 0;


    // --- Rooms tab (Block / Floor management) ---

    private List<BlockRow> blocks = CreateSampleBlocks();
    private int? currentFloorId;
    private int? viewingBlockId;
    private FloorRow? addTargetFloor;
    private HashSet<int> selectedTileIds = new();
    private string applyRoomTypeCode = "";
    private string statusFilter = "";

    private bool isRoomModalOpen;
    private bool isRoomNewEntry;
    private RoomTileRow? editingRoomTile;

    private bool isBlockModalOpen;
    private bool isBlockNewEntry;
    private BlockDraft? editingBlockDraft;
    private int? selectedBlockId;

    private FloorRow? currentFloor => blocks.SelectMany(b => b.Floors).FirstOrDefault(f => f.Id == currentFloorId);

    private List<FloorRow> ViewedFloors
    {
        get
        {
            if (currentFloorId != null)
                return currentFloor != null ? new List<FloorRow> { currentFloor } : new List<FloorRow>();

            if (viewingBlockId != null)
            {
                var block = blocks.FirstOrDefault(b => b.Id == viewingBlockId);
                if (block != null)
                    return block.Floors;
            }

            return new List<FloorRow>();
        }
    }

    private BlockRow? BlockOfFloor(FloorRow floor) => blocks.FirstOrDefault(b => b.Floors.Contains(floor));

    private RoomTileRow? FindRoomTile(int roomId) =>
        blocks.SelectMany(b => b.Floors).SelectMany(f => f.Rooms).FirstOrDefault(r => r.Id == roomId);

    private List<Toolbar.ToolbarItem> roomTypeToolbarItems = new List<Toolbar.ToolbarItem>();
    private List<Toolbar.ToolbarItem> blocksToolbarItems = new List<Toolbar.ToolbarItem>();

    protected override void OnInitialized()
    {
        roomTypeToolbarItems = new()
        {
                new() { Label = "Add", Icon = "bi-file-earmark-plus", OnClick = EventCallback.Factory.Create(this, AddRoomType) },
                new() { Label = "Delete", Icon = "bi-trash3", BeginGroup = true, OnClick = EventCallback.Factory.Create(this,
    DeleteRoomType) },
                new() { Label = "Save", Icon = "bi-floppy", BeginGroup = true, OnClick = EventCallback.Factory.Create(this,
    SaveRoomTypes) },
                new() { Label = "Edit", Icon = "bi-pencil-square", BeginGroup = true, OnClick = EventCallback.Factory.Create(this,
    EditRoomType) },
            };

        blocksToolbarItems = new()
        {
            new() { Label = "Add", Icon = "bi-file-earmark-plus", OnClick = EventCallback.Factory.Create(this, OpenAddBlockModal) },
            new() { Label = "Edit", Icon = "bi-pencil-square", BeginGroup = true, OnClick = EventCallback.Factory.Create(this,
EditSelectedBlock) },
            new() { Label = "Delete", Icon = "bi-trash3", BeginGroup = true, OnClick = EventCallback.Factory.Create(this,
DeleteSelectedBlock) },
            new() { Label = "Save", Icon = "bi-floppy", BeginGroup = true, OnClick = EventCallback.Factory.Create(this, SaveBlocks)
},
            new() { Label = "Refresh", Icon = "bi-arrow-clockwise", BeginGroup = true, OnClick = EventCallback.Factory.Create(this,
RefreshBlocks) },
        };

        var firstBlock = blocks.FirstOrDefault();
        if (firstBlock != null)
        {
            firstBlock.IsExpanded = true;
            selectedBlockId = firstBlock.Id;
            viewingBlockId = firstBlock.Id;
        }

        selectedRoomType = roomTypes.FirstOrDefault();
    }

    private void ToggleBlockExpand(int blockId)
    {
        var block = blocks.FirstOrDefault(b => b.Id == blockId);
        if (block != null)
            block.IsExpanded = !block.IsExpanded;

        selectedBlockId = blockId;
    }

    private void ViewBlock(int blockId)
    {
        var block = blocks.FirstOrDefault(b => b.Id == blockId);
        if (block != null)
            block.IsExpanded = true;

        selectedBlockId = blockId;
        viewingBlockId = blockId;
        currentFloorId = null;
        selectedTileIds.Clear();
    }

    private void SelectFloor(int floorId)
    {
        currentFloorId = floorId;
        viewingBlockId = null;
        var owningBlock = blocks.FirstOrDefault(b => b.Floors.Any(f => f.Id == floorId));
        if (owningBlock != null)
            selectedBlockId = owningBlock.Id;
        selectedTileIds.Clear();
    }

    private IEnumerable<RoomTileRow> FilteredRooms(FloorRow floor)
    {
        foreach (var room in floor.Rooms)
        {
            if (string.IsNullOrEmpty(statusFilter) || room.Status == statusFilter)
                yield return room;
        }
    }

    private IEnumerable<RoomTileRow> AllVisibleRooms() => ViewedFloors.SelectMany(FilteredRooms);

    private void ToggleTile(int roomId)
    {
        if (!selectedTileIds.Add(roomId))
            selectedTileIds.Remove(roomId);
    }

    private void HandleSelectionAction(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (value == "all")
            selectedTileIds = AllVisibleRooms().Select(r => r.Id).ToHashSet();
        else if (value == "none")
            selectedTileIds.Clear();
    }

    private void AddRoomTile()
    {
        addTargetFloor = currentFloor ?? ViewedFloors.FirstOrDefault();
        if (addTargetFloor == null)
            return;

        editingRoomTile = new RoomTileRow
        {
            Number = "",
            TypeCode = roomTypes.FirstOrDefault()?.Code ?? "",
            TypeDescription = roomTypes.FirstOrDefault()?.Description ?? "",
            Status = "Clean",
        };
        isRoomNewEntry = true;
        isRoomModalOpen = true;
    }

    private void EditRoomTile()
    {
        if (selectedTileIds.Count != 1)
            return;

        var source = FindRoomTile(selectedTileIds.First());
        if (source == null)
            return;

        editingRoomTile = new RoomTileRow
        {
            Id = source.Id,
            Number = source.Number,
            TypeCode = source.TypeCode,
            TypeDescription = source.TypeDescription,
            Status = source.Status,
            RoomCode = source.RoomCode,
            MaxOccupancy = source.MaxOccupancy,
            IsActive = source.IsActive,
            PhoneNo = source.PhoneNo,
            Measurement = source.Measurement,
            Remark = source.Remark,
            SpaceArrangement = source.SpaceArrangement,
            MaxCapacity = source.MaxCapacity,
            SpaceRemark = source.SpaceRemark,
            StayoverCredit = source.StayoverCredit,
            DepartureCredit = source.DepartureCredit,
            TurndownCredit = source.TurndownCredit,
            PickupCredit = source.PickupCredit,
            VacantCredit = source.VacantCredit,
            EveningSectionCredit = source.EveningSectionCredit,
        };
        isRoomNewEntry = false;
        isRoomModalOpen = true;
    }

    private void SaveRoomTile()
    {
        if (editingRoomTile == null)
            return;

        var selectedType = roomTypes.FirstOrDefault(rt => rt.Code == editingRoomTile.TypeCode);
        if (selectedType != null)
            editingRoomTile.TypeDescription = selectedType.Description;

        if (isRoomNewEntry)
        {
            if (addTargetFloor == null)
                return;

            var allTiles = blocks.SelectMany(b => b.Floors).SelectMany(f => f.Rooms);
            editingRoomTile.Id = allTiles.Any() ? allTiles.Max(r => r.Id) + 1 : 1;
            addTargetFloor.Rooms.Add(editingRoomTile);
        }
        else
        {
            var target = FindRoomTile(editingRoomTile.Id);
            if (target != null)
            {
                target.Number = editingRoomTile.Number;
                target.TypeCode = editingRoomTile.TypeCode;
                target.TypeDescription = editingRoomTile.TypeDescription;
                target.Status = editingRoomTile.Status;
                target.RoomCode = editingRoomTile.RoomCode;
                target.MaxOccupancy = editingRoomTile.MaxOccupancy;
                target.IsActive = editingRoomTile.IsActive;
                target.PhoneNo = editingRoomTile.PhoneNo;
                target.Measurement = editingRoomTile.Measurement;
                target.Remark = editingRoomTile.Remark;
                target.SpaceArrangement = editingRoomTile.SpaceArrangement;
                target.MaxCapacity = editingRoomTile.MaxCapacity;
                target.SpaceRemark = editingRoomTile.SpaceRemark;
                target.StayoverCredit = editingRoomTile.StayoverCredit;
                target.DepartureCredit = editingRoomTile.DepartureCredit;
                target.TurndownCredit = editingRoomTile.TurndownCredit;
                target.PickupCredit = editingRoomTile.PickupCredit;
                target.VacantCredit = editingRoomTile.VacantCredit;
                target.EveningSectionCredit = editingRoomTile.EveningSectionCredit;
            }
        }

        isRoomModalOpen = false;
        editingRoomTile = null;
    }

    private void CloseRoomModal()
    {
        isRoomModalOpen = false;
        editingRoomTile = null;
    }

    private void DeleteRoomTiles()
    {
        if (selectedTileIds.Count == 0)
            return;

        RequestConfirm("Delete Rooms", $"Are you sure you want to delete {selectedTileIds.Count} selected room(s)?", true,
            DeleteRoomTilesConfirmed);
    }

    private Task DeleteRoomTilesConfirmed()
    {
        foreach (var floor in blocks.SelectMany(b => b.Floors))
            floor.Rooms.RemoveAll(r => selectedTileIds.Contains(r.Id));

        selectedTileIds.Clear();
        return Task.CompletedTask;
    }

    private void ApplyRoomType()
    {
        if (string.IsNullOrEmpty(applyRoomTypeCode))
            return;

        var type = roomTypes.FirstOrDefault(rt => rt.Code == applyRoomTypeCode);
        if (type == null)
            return;

        foreach (var room in blocks.SelectMany(b => b.Floors).SelectMany(f => f.Rooms).Where(r => selectedTileIds.Contains(r.Id)))
        {
            room.TypeCode = type.Code;
            room.TypeDescription = type.Description;
        }
    }

    private void OpenAddBlockModal()
    {
        editingBlockDraft = new BlockDraft
        {
            Code = GenerateNextBlockCode(),
            Hotel = hotels.FirstOrDefault() ?? "",
            NoOfFloors = 1,
            FloorStartsFrom = 1,
            RoomNoDigit = 3,
            RoomNoStartsFrom = 1,
            RoomsPerFloor = 10,
        };
        isBlockNewEntry = true;
        isBlockModalOpen = true;
    }

    private void EditSelectedBlock()
    {
        if (selectedBlockId == null)
            return;

        var block = blocks.FirstOrDefault(b => b.Id == selectedBlockId);
        if (block == null)
            return;

        editingBlockDraft = new BlockDraft
        {
            Id = block.Id,
            Code = block.Code,
            Name = block.Name,
        };
        isBlockNewEntry = false;
        isBlockModalOpen = true;
    }

    private void DeleteSelectedBlock()
    {
        if (selectedBlockId == null)
            return;

        var block = blocks.FirstOrDefault(b => b.Id == selectedBlockId);
        if (block == null)
            return;

        RequestConfirm("Delete Block",
            $"Are you sure you want to delete block '{block.Name}'? This will remove all its floors and rooms.", true,
            DeleteSelectedBlockConfirmed);
    }

    private Task DeleteSelectedBlockConfirmed()
    {
        if (selectedBlockId == null)
            return Task.CompletedTask;

        var block = blocks.FirstOrDefault(b => b.Id == selectedBlockId);
        if (block == null)
            return Task.CompletedTask;

        bool wasViewed = block.Floors.Any(f => f.Id == currentFloorId) || viewingBlockId == block.Id;
        blocks.Remove(block);
        selectedBlockId = null;

        if (wasViewed)
        {
            currentFloorId = null;
            viewingBlockId = blocks.FirstOrDefault()?.Id;
            selectedTileIds.Clear();
        }

        return Task.CompletedTask;
    }


    private string GenerateNextBlockCode()
    {
        int maxNum = 0;
        foreach (var b in blocks)
        {
            var digits = new string(b.Code.Where(char.IsDigit).ToArray());
            if (int.TryParse(digits, out var n))
                maxNum = Math.Max(maxNum, n);
        }
        return $"BLK{(maxNum + 1):D3}";
    }

    private void CloseBlockModal()
    {
        isBlockModalOpen = false;
        editingBlockDraft = null;
    }

    private void SaveNewBlock()
    {
        if (editingBlockDraft == null
            || string.IsNullOrWhiteSpace(editingBlockDraft.Code)
            || string.IsNullOrWhiteSpace(editingBlockDraft.Name))
            return;

        if (!isBlockNewEntry)
        {
            var target = blocks.FirstOrDefault(b => b.Id == editingBlockDraft.Id);
            if (target != null)
            {
                target.Code = editingBlockDraft.Code.Trim();
                target.Name = editingBlockDraft.Name.Trim();
            }

            isBlockModalOpen = false;
            editingBlockDraft = null;
            return;
        }

        if (editingBlockDraft.NoOfFloors <= 0)
            return;

        var allFloors = blocks.SelectMany(b => b.Floors).ToList();
        var allTiles = allFloors.SelectMany(f => f.Rooms).ToList();
        int nextFloorId = allFloors.Any() ? allFloors.Max(f => f.Id) + 1 : 1;
        int nextRoomId = allTiles.Any() ? allTiles.Max(r => r.Id) + 1 : 1;
        var defaultType = roomTypes.FirstOrDefault();

        var newBlock = new BlockRow
        {
            Id = blocks.Count == 0 ? 1 : blocks.Max(b => b.Id) + 1,
            Code = editingBlockDraft.Code.Trim(),
            Name = editingBlockDraft.Name.Trim(),
            IsExpanded = true,
        };

        for (int f = 0; f < editingBlockDraft.NoOfFloors; f++)
        {
            int floorNumber = editingBlockDraft.FloorStartsFrom + f;
            var floorRow = new FloorRow { Id = nextFloorId++, Number = floorNumber };

            for (int r = 0; r < editingBlockDraft.RoomsPerFloor; r++)
            {
                int sequence = editingBlockDraft.RoomNoStartsFrom + r;
                floorRow.Rooms.Add(new RoomTileRow
                {
                    Id = nextRoomId++,
                    Number = RoomNumbering.Generate(floorNumber, editingBlockDraft.RoomNoDigit, sequence),
                    TypeCode = defaultType?.Code ?? "",
                    TypeDescription = defaultType?.Description ?? "",
                    Status = "Clean",
                });
            }

            newBlock.Floors.Add(floorRow);
        }

        blocks.Add(newBlock);
        newBlock.IsExpanded = true;
        selectedBlockId = newBlock.Id;
        viewingBlockId = newBlock.Id;
        currentFloorId = null;
        isBlockModalOpen = false;
