@if (Visible && EditingItem != null)
{
    <div class="rt-modal-backdrop">
        <div class="rt-modal room-modal">
            <div class="rt-modal-header">
                <span class="rt-modal-header-title"><i class="bi bi-door-closed-fill text-primary me-2"></i>@(IsNew ? "Add Room" : "Edit Room")</span>
                <button class="rt-modal-close-btn" @onclick="Close" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="rt-modal-body">
                <div class="rt-form-row">
                    <div class="rt-form-field rt-form-field-wide">
                        <label>Room Number</label>
                        <DxTextBox @bind-Text="@EditingItem.Number" CssClass="rt-form-input" />
                    </div>
                </div>

                <div class="rt-form-row">
                    <div class="rt-form-field rt-form-field-wide">
                        <label>Room Type</label>
                        <select class="rt-form-select" @bind="EditingItem.TypeCode">
                            @foreach (var rt in RoomTypes)
                            {
                                <option value="@rt.Code">@rt.Description</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="rt-form-row">
                    <div class="rt-form-field rt-form-field-wide">
                        <label>Status</label>
                        <select class="rt-form-select" @bind="EditingItem.Status">
                            <option value="Clean">Clean</option>
                            <option value="Dirty">Dirty</option>
                            <option value="Occupied">Occupied</option>
                            <option value="OOS">Out of Service</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="rt-toolbar room-modal-toolbar">
                <button class="rt-toolbar-btn" @onclick="Save" disabled="@(string.IsNullOrWhiteSpace(EditingItem.Number))">
                    <i class="bi bi-floppy-fill text-secondary"></i>
                    <span>Save</span>
                </button>
                <button class="rt-toolbar-btn" @onclick="Close">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span>Close</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public RoomTileRow? EditingItem { get; set; }
    [Parameter] public List<RoomTypeRow> RoomTypes { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Save() => await OnSave.InvokeAsync();

    private async Task Close() => await OnClose.InvokeAsync();
}
