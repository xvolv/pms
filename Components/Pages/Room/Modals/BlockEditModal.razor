@if (Visible && EditingItem != null)
{
    <div class="rt-modal-backdrop">
        <div class="rt-modal">
            <div class="rt-modal-header">
                <span class="rt-modal-header-title">@(IsNew ? "Add Block" : "Edit Block")</span>
                <button class="rt-modal-close-btn" @onclick="Close" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="rt-toolbar">
                <button class="rt-toolbar-btn" @onclick="Save">
                    <i class="bi bi-floppy text-secondary"></i>
                    <span>@(IsNew ? "Generate" : "Save")</span>
                </button>
                <button class="rt-toolbar-btn" @onclick="Close">
                    <i class="bi bi-x-circle text-secondary"></i>
                    <span>Close</span>
                </button>
            </div>

            <div class="rt-modal-body">
                <div class="rt-form-row">
                    <div class="rt-form-field">
                        <label>Building Code</label>
                        <DxTextBox @bind-Text="@EditingItem.Code" CssClass="rt-form-input" />
                    </div>
                    <div class="rt-form-field rt-form-field-wide">
                        <label>Building Name</label>
                        <DxTextBox @bind-Text="@EditingItem.Name" CssClass="rt-form-input" />
                    </div>
                </div>

                @if (IsNew)
                {
                    <div class="rt-form-row">
                        <div class="rt-form-field">
                            <label>No of Floors</label>
                            <DxSpinEdit @bind-Value="@EditingItem.NoOfFloors" MinValue="1" CssClass="rt-form-input" />
                        </div>
                        <div class="rt-form-field">
                            <label>Floor Starts From</label>
                            <DxSpinEdit @bind-Value="@EditingItem.FloorStartsFrom" MinValue="0" CssClass="rt-form-input" />
                        </div>
                    </div>

                    <div class="rt-form-row">
                        <div class="rt-form-field">
                            <label>Room No Digit</label>
                            <DxSpinEdit @bind-Value="@EditingItem.RoomNoDigit" MinValue="1" MaxValue="6"
                                        CssClass="rt-form-input" />
                        </div>
                        <div class="rt-form-field">
                            <label>Room No Starts From</label>
                            <DxSpinEdit @bind-Value="@EditingItem.RoomNoStartsFrom" MinValue="0" CssClass="rt-form-input" />
                        </div>
                        <div class="rt-form-field">
                            <label>Rooms on Each Floor</label>
                            <DxSpinEdit @bind-Value="@EditingItem.RoomsPerFloor" MinValue="0" CssClass="rt-form-input" />
                        </div>
                    </div>

                    <div class="rt-form-row">
                        <div class="rt-form-field rt-form-field-wide">
                            <label>Remarks</label>
                            <DxTextBox @bind-Text="@EditingItem.Remarks" CssClass="rt-form-input" />
                        </div>
                    </div>

                    <div class="block-generate-summary">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Will generate @EditingItem.NoOfFloors floor(s) starting at Floor - @EditingItem.FloorStartsFrom,
                        each with @EditingItem.RoomsPerFloor room(s) (e.g. room @SampleRoomNumber).
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public BlockDraft? EditingItem { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool CanSave =>
        EditingItem != null
        && !string.IsNullOrWhiteSpace(EditingItem.Code)
        && !string.IsNullOrWhiteSpace(EditingItem.Name)
        && EditingItem.NoOfFloors > 0;

    private string SampleRoomNumber =>
        EditingItem == null
            ? ""
            : RoomNumbering.Generate(EditingItem.FloorStartsFrom, EditingItem.RoomNoDigit, EditingItem.RoomNoStartsFrom);

    private async Task Save() => await OnSave.InvokeAsync();

    private async Task Close() => await OnClose.InvokeAsync();
}
