@if (Visible && EditingItem != null)
{
    <div class="rt-modal-backdrop">
        <div class="rt-modal">
            <div class="rt-modal-header">
                <span class="rt-modal-header-title"><i class="bi bi-asterisk text-danger me-2"></i>Room Type</span>
                <button class="rt-modal-close-btn" @onclick="Close" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="rt-toolbar">
                @* <button class="rt-toolbar-btn" @onclick="New">
                    <i class="bi bi-file-earmark-plus-fill text-primary"></i>
                    <span>New</span>
                </button> *@
                <button class="rt-toolbar-btn" @onclick="Save">
                    <i class="bi bi-floppy-fill text-secondary"></i>
                    <span>Save</span>
                </button>
                <button class="rt-toolbar-btn" @onclick="Close">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                    <span>Close</span>
                </button>
            </div>

            <div class="sub-tabs-bar rt-modal-tabs">
                <div class="sub-tab-item @(activeTab == "basic" ? "active" : "")" @onclick='() => activeTab = "basic"'>
                    Basic Information
                </div>
                <div class="sub-tab-item @(activeTab == "hk" ? "active" : "")" @onclick='() => activeTab = "hk"'>
                    HK-Credits
                </div>
            </div>

            <div class="rt-modal-body">
                @if (activeTab == "basic")
                {
                    <div class="rt-form-row">
                        <div class="rt-form-field">
                            <label>Room Type Code</label>
                            <DxTextBox @bind-Text="@EditingItem.Code" ReadOnly="true" CssClass="rt-form-input" />
                        </div>
                        <div class="rt-form-field rt-form-field-inline">
                            <DxCheckBox @bind-Checked="@EditingItem.Status">Active</DxCheckBox>
                        </div>
                        <div class="rt-form-field">
                            <label>Activation Date</label>
                            <DxDateEdit @bind-Date="@EditingItem.ActivationDate" CssClass="rt-form-input" />
                        </div>
                    </div>

                    <div class="rt-form-row">
                        <div class="rt-form-field rt-form-field-wide">
                            <label>Description</label>
                            <DxTextBox @bind-Text="@EditingItem.Description" CssClass="rt-form-input" />
                        </div>
                    </div>

                    <div class="rt-form-row">
                        <div class="rt-form-field">
                            <label>No of Rooms</label>
                            <DxSpinEdit @bind-Value="@EditingItem.NoOfRooms" MinValue="0" CssClass="rt-form-input" />
                        </div>
                        <div class="rt-form-field">
                            <label>Component Room</label>
                            <select class="rt-form-select" @bind="EditingItem.ComponentRoom">
                                <option value="">-- None --</option>
                                @foreach (var rt in RoomTypes)
                                {
                                    <option value="@rt.Code">@rt.Code - @rt.Description</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="rt-form-row">
                        <div class="rt-form-field">
                            <label>Room Class</label>
                            <select class="rt-form-select" @bind="EditingItem.RoomClass">
                                @foreach (var rc in RoomClasses)
                                {
                                    <option value="@rc">@rc</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="rt-form-row rt-form-row-groups">
                        <fieldset class="rt-form-fieldset">
                            <legend>Occupancy</legend>
                            <div class="rt-occupancy-grid">
                                <div class="rt-form-field">
                                    <label>Default Occupancy</label>
                                    <DxSpinEdit @bind-Value="@EditingItem.DefaultOccupancy" MinValue="0" CssClass="rt-form-input" />
                                </div>
                                <div class="rt-form-field">
                                    <label>Maximum Occupancy</label>
                                    <DxSpinEdit @bind-Value="@EditingItem.MaximumOccupancy" MinValue="0" CssClass="rt-form-input" />
                                </div>
                                <div class="rt-form-field">
                                    <label>Maximum Adult</label>
                                    <DxSpinEdit @bind-Value="@EditingItem.MaximumAdult" MinValue="0" CssClass="rt-form-input" />
                                </div>
                                <div class="rt-form-field">
                                    <label>Maximum Childs</label>
                                    <DxSpinEdit @bind-Value="@EditingItem.MaximumChilds" MinValue="0" CssClass="rt-form-input" />
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="rt-form-fieldset">
                            <legend>Type</legend>
                            <DxCheckBox @bind-Checked="@EditingItem.IsPseudoRoom">Pseudo Room Type</DxCheckBox>
                            <DxCheckBox @bind-Checked="@EditingItem.CanBeMeetingRoom">Can Be Meeting Room</DxCheckBox>
                            <DxCheckBox @bind-Checked="@EditingItem.IsHouseKeeping">House Keeping</DxCheckBox>
                            <DxCheckBox @bind-Checked="@EditingItem.AutoRoomAssign">Auto Room Assign</DxCheckBox>
                        </fieldset>
                    </div>
                }
                else
                {
                    <div class="rt-placeholder">HK-Credits settings coming soon.</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public RoomTypeRow? EditingItem { get; set; }
    [Parameter] public List<RoomTypeRow> RoomTypes { get; set; } = new();
    [Parameter] public List<string> RoomClasses { get; set; } = new();
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string activeTab = "basic";

    private async Task New()
    {
        activeTab = "basic";
        await OnNew.InvokeAsync();
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync();
    }

    private async Task Close()
    {
        activeTab = "basic";
        await OnClose.InvokeAsync();
    }
}
