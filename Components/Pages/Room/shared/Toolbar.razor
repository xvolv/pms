<DxToolbar CssClass="rt-toolbar">
    <Items>
        @foreach (var item in Items)
        {
            <DxToolbarItem BeginGroup="@item.BeginGroup" Click="item.OnClick">
                <Template>
                    <div class="toolbar-item">
                        <i class="bi @item.Icon toolbar-icon text-secondary"></i>
                        <span>@item.Label</span>
                    </div>
                </Template>
            </DxToolbarItem>
        }

    </Items>
</DxToolbar>

@code {
    [Parameter] public List<ToolbarItem> Items { get; set; } = new List<ToolbarItem>();

    public class ToolbarItem
    {
        public string Label { get; set; } = "";
        public string Icon { get; set; } = "";
        public EventCallback OnClick { get; set; }
        public bool BeginGroup { get; set; }
    }
}

