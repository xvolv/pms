@page "/not-found"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>404 Page Not Found | PMS ERP V7</PageTitle>

<div class="nf-stage">
    <div class="nf-content">
        <!-- Minimalist Branded Geometric Illustration -->
        <div class="nf-icon-wrap">
            <svg class="nf-graphic" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="60" cy="60" r="54" stroke="#e2e8f0" stroke-width="2" stroke-dasharray="4 4" />
                <circle cx="60" cy="60" r="38" fill="#fef2f2" />

                <!-- Cloud Silhouette Contour -->
                <path
                d="M42 66 C42 58 48 52 56 52 C58 46 64 42 71 44 C77 46 81 51 81 57 C85 57 88 61 88 65 C88 69 85 72 80 72 L44 72 C43 72 42 70 42 66 Z"
                stroke="#e52427" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />

                <!-- Subtle Compass Pin / Radar Pulse -->
                <circle cx="60" cy="60" r="2.5" fill="#e52427" />
                <line x1="60" y1="36" x2="60" y2="40" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round" />
                <line x1="60" y1="80" x2="60" y2="84" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round" />
                <line x1="36" y1="60" x2="40" y2="60" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round" />
                <line x1="80" y1="60" x2="84" y2="60" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>

        <div class="nf-badge">Lost in the Cloud</div>

        <h1 class="nf-headline"> 404 Page Not Found</h1>

        
        <div class="nf-buttons">
            <button type="button" class="nf-btn-primary" @onclick="GoHome">
                <i class="bi bi-grid-fill text-white me-2"></i> Back to Dashboard
            </button>
            <button type="button" class="nf-btn-ghost" @onclick="GoBack">
                <i class="bi bi-arrow-left me-2"></i> Previous
            </button>
        </div>
    </div>`
</div>

<style>
    .nf-stage {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 160px);
        padding: 40px 20px;
        box-sizing: border-box;
    }

    .nf-content {
        max-width: 460px;
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .nf-icon-wrap {
        width: 100px;
        height: 100px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nf-graphic {
        width: 100%;
        height: 100%;
    }

    .nf-badge {
        display: inline-flex;
        align-items: center;
        color: #e52427;
        font-size: 0.88rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .nf-headline {
        font-size: 1.95rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 42px 0;
        letter-spacing: -0.5px;
    }

    .nf-description {
        font-size: 0.94rem;
        color: #64748b;
        line-height: 1.55;
        margin: 0 0 32px 0;
        max-width: 400px;
    }

    .nf-buttons {
        display: flex;
        gap: 12px;
        width: 100%;
        justify-content: center;
    }

    .nf-btn-primary {
        background: #e52427;
        color: #ffffff;
        border: none;
        padding: 10px 24px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.1s;
    }

    .nf-btn-primary:hover {
        background: #c91b1e;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .nf-btn-ghost {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
        padding: 10px 22px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .nf-btn-ghost:hover {
        background: #f8fafc;
        color: #0f172a;
        border-color: #94a3b8;
    }
</style>

@code {
    private void GoHome() => Navigation.NavigateTo("/dashboard");

    private async Task GoBack()
    {
        try
        {
            await JS.InvokeVoidAsync("history.back");
        }
        catch
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}
