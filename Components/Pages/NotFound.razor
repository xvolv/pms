@page "/not-found"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>404 Page Not Found | PMS ERP V7</PageTitle>

<div class="nf-stage">
    <div class="nf-content">
        <!-- 3 Overlapping Sky Clouds Illustration (Matching Exact Reference Cloud Shape) -->
        <div class="nf-icon-wrap">
            <svg class="nf-graphic" viewBox="0 0 200 130" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- SVG Definition for the Exact Cloud Silhouette -->
                <defs>
                    <path id="cloud-shape" d="M 16,48 
                    C 8,48 1,42 2,34 
                    C 2,27 7,21 14,20 
                    C 16,9 27,2 40,2 
                    C 51,2 61,8 64,18 
                    C 68,14 74,11 80,11 
                    C 89,11 96,17 96,25 
                    C 103,26 108,32 108,39 
                    C 108,46 102,52 94,52 
                    L 16,52 
                    C 8,52 2,46 2,38 Z" />
                </defs>

                <!-- Cloud 1: Back Left (Soft Light Pink/Red) -->
                <use href="#cloud-shape" x="12" y="14" transform="scale(0.85)" fill="#fee2e2" />

                <!-- Cloud 2: Back Right (Soft Warm Coral Red) -->
                <use href="#cloud-shape" x="96" y="10" transform="scale(0.82)" fill="#fca5a5" />

                <!-- Cloud 3: Foreground Main (Bold Red with White Dot) -->
                <g transform="translate(34, 40) scale(1.18)">
                    <use href="#cloud-shape" fill="#e52427" />
                    <!-- White Center Circle Dot -->
                    <circle cx="38" cy="34" r="5" fill="#ffffff" />
                </g>
            </svg>
        </div>

        <div class="nf-badge">Lost in the Cloud</div>

        <h1 class="nf-headline">404 Page Not Found</h1>

        <div class="nf-buttons">
            <button type="button" class="nf-btn-primary" @onclick="GoHome">
                <i class="bi bi-grid-fill text-white me-2"></i> Back to Dashboard
            </button>
            <button type="button" class="nf-btn-ghost" @onclick="GoBack">
                <i class="bi bi-arrow-left me-2"></i> Previous
            </button>
        </div>
    </div>
</div>

<style>
    .nf-stage {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 160px);
        padding: 40px 20px;
        box-sizing: border-box;
    }

    .nf-content {
        max-width: 480px;
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .nf-icon-wrap {
        width: 200px;
        height: 130px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nf-graphic {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nf-badge {
        display: inline-flex;
        align-items: center;
        color: #e52427;
        font-size: 0.88rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .nf-headline {
        font-size: 1.95rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 36px 0;
        letter-spacing: -0.5px;
    }

    .nf-buttons {
        display: flex;
        gap: 12px;
        width: 100%;
        justify-content: center;
    }

    .nf-btn-primary {
        background: #e52427;
        color: #ffffff;
        border: none;
        padding: 10px 24px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.1s;
    }

    .nf-btn-primary:hover {
        background: #c91b1e;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .nf-btn-ghost {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
        padding: 10px 22px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .nf-btn-ghost:hover {
        background: #f8fafc;
        color: #0f172a;
        border-color: #94a3b8;
    }
</style>

@code {
    private void GoHome() => Navigation.NavigateTo("/dashboard");

    private async Task GoBack()
    {
        try
        {
            await JS.InvokeVoidAsync("history.back");
        }
        catch
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}
