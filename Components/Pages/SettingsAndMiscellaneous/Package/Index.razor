@page "/package"
@rendermode InteractiveServer

@inject NavigationManager Navigation
@using DevExpress.Blazor

<PageTitle>Package</PageTitle>
<div class="dashboard-wrapper">


<div class="">


    <!-- Ribbon -->
    <DxTabs @bind-ActiveTabIndex="ribbonActiveTab"
            CssClass="custom-ribbon-tabs">

        <DxTabPage Text="Package" />

    </DxTabs>


    <div class="sub-section">
    <!-- Toolbar -->
    <PackageToolbar OnNew="New"
                    OnEdit="Edit"
                    OnDelete="Delete"
                    OnPrint="Print" />




    <!-- Work Area -->
    <div class="erp-content">


        <DxTabs @bind-ActiveTabIndex="ActiveTabIndex"
                CssClass="custom-content-tabs">


            <DxTabPage Text="Package Header">

                <PackageHeader @ref="header" />

            </DxTabPage>



            <DxTabPage Text="Package Detail">

                <PackageDetail @ref="detail" />

            </DxTabPage>


        </DxTabs>


    </div>

        </div>
</div>
</div>



@code {

    PackageHeader? header;
    PackageDetail? detail;


    int ActiveTabIndex = 0;

    int ribbonActiveTab = 0;



    void New()
    {
        if (ActiveTabIndex == 0)
            header?.New();
        else
            detail?.New();
    }
     



    void Edit()
    {
        if (ActiveTabIndex == 0)
            header?.Edit();
        else
            detail?.Edit();
    }



    void Delete()
    {
        if (ActiveTabIndex == 0)
            header?.Delete();
        else
            detail?.Delete();
    }



    void Print()
    {
        if (ActiveTabIndex == 0)
            header?.Print();
        else
            detail?.Print();
    }

    
    void Save()
    {

    }



    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

}




<style>
    /* =====================================================
       ERP MAIN PAGE
    ===================================================== */

    .erp-page {
        min-height: 100%;
        padding: 8px;
    }

    .custom-content-tabs .nav-link:not(.active),
    .rooms-tabs .nav-link:not(.active) {
        color: #6c757d !important;
    }

    /* =====================================================
       RIBBON HEADER TABS
    ===================================================== */

    .custom-ribbon-tabs {
        padding-left: 6px;
    }

    .custom-ribbon-tabs ::deep .dxbl-tabs {
        min-height: 42px;
    }

    .custom-ribbon-tabs ::deep .dxbl-tabs-item {
        height: 42px;
        padding: 0 22px !important;
        display: flex;
        align-items: center;
        font-size: 14px;
        font-weight: 600;
        color: #495057;
        background: #f8f9fa;
        border-right: 1px solid #e1e5ea !important;
        border-top: 3px solid transparent !important;
        border-bottom: none !important;
        transition: .15s ease;
    }

    .custom-ribbon-tabs ::deep .dxbl-tabs-item:hover {
        background: #eef4fb !important;
        color: #1d73d4;
    }

    .custom-ribbon-tabs ::deep .dxbl-tabs-item-active {
        background: #ffffff !important;
        color: #1d73d4 !important;
        border-top: 3px solid #1d73d4 !important;
    }

    .custom-ribbon-tabs ::deep .dxbl-tabs-item-active .dxbl-tabs-item-text {
        color: #1d73d4 !important;
    }

    /* =====================================================
       MAIN WORK AREA
    ===================================================== */
    .sub-section {
        padding-left: 20px;
        padding-right: 20px;
    }

    .erp-content {
        margin-top: 8px;
        background: white;
        border: 1px solid #d8dde5;
        border-radius: 5px;
        min-height: 500px;
    }

    /* =====================================================
       INNER CONTENT TABS
    ===================================================== */

    .custom-content-tabs ::deep .dxbl-tabs {
        padding-left: 8px;
    }

    .custom-content-tabs ::deep .dxbl-tabs-item {
        padding: 10px 24px !important;
        font-size: 14px;
        font-weight: 600;
        color: #6c757d;
        border: none !important;
        border-bottom: 3px solid transparent !important;
        transition: .15s ease;
    }

    .custom-content-tabs ::deep .dxbl-tabs-item:hover {
        background: #f6f9fc;
        color: #1d73d4;
    }

    .custom-content-tabs ::deep .dxbl-tabs-item-active {
        color: #1d73d4 !important;
        background: white !important;
        border-bottom: 3px solid #1d73d4 !important;
    }

    .custom-content-tabs ::deep .dxbl-tabs-item-active .dxbl-tabs-item-text {
        color: #1d73d4 !important;
    }

    /* =====================================================
       TAB CLOSE BUTTON
    ===================================================== */

    .tab-close {
        border: none;
        background: transparent;
        color: #8b95a5;
        font-size: 16px;
        cursor: pointer;
        margin-left: 8px;
        padding: 0;
    }

    .tab-close:hover {
        color: #dc3545;
    }

    /* =====================================================
       TAB CONTENT PADDING
    ===================================================== */

    .erp-content ::deep .dxbl-tabs-content {
        padding: 12px;
    }

    /* =====================================================
       RESPONSIVE STYLES
    ===================================================== */

    /* Tablets and smaller screens */
    @@media (max-width: 1024px) {
        .sub-section {
            padding-left: 12px;
            padding-right: 12px;
        }

        .erp-content {
            min-height: 400px;
            border-radius: 4px;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 8px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            padding: 0 16px !important;
            font-size: 13px;
            height: 38px;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 8px 16px !important;
            font-size: 13px;
        }
    }

    /* Mobile devices */
    @@media (max-width: 768px) {
        .sub-section {
            padding-left: 8px;
            padding-right: 8px;
        }

        .custom-ribbon-tabs {
            padding-left: 4px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs {
            min-height: 36px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            height: 36px;
            padding: 0 12px !important;
            font-size: 12px;
            border-right: 1px solid #e1e5ea !important;
            border-top: 2px solid transparent !important;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item-active {
            border-top: 2px solid #1d73d4 !important;
        }

        .custom-content-tabs ::deep .dxbl-tabs {
            padding-left: 4px;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 6px 12px !important;
            font-size: 12px;
            border-bottom: 2px solid transparent !important;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item-active {
            border-bottom: 2px solid #1d73d4 !important;
        }

        .erp-content {
            margin-top: 6px;
            min-height: 350px;
            border-radius: 3px;
            border-width: 1px;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 6px;
            overflow-x: auto;
        }
    }

    /* Small mobile devices */
    @@media (max-width: 480px) {
        .sub-section {
            padding-left: 4px;
            padding-right: 4px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            height: 32px;
            padding: 0 8px !important;
            font-size: 11px;
            border-right: none !important;
            border-top: 2px solid transparent !important;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs {
            min-height: 32px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item-active {
            border-top: 2px solid #1d73d4 !important;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 4px 8px !important;
            font-size: 11px;
            border-bottom: 2px solid transparent !important;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item-active {
            border-bottom: 2px solid #1d73d4 !important;
        }

        .erp-content {
            margin-top: 4px;
            min-height: 300px;
            border-radius: 2px;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 4px;
        }

        /* Tab close button on mobile */
        .tab-close {
            font-size: 14px;
            margin-left: 4px;
        }
    }

    /* Very small mobile devices */
    @@media (max-width: 360px) {
        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            height: 30px;
            padding: 0 6px !important;
            font-size: 10px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs {
            min-height: 30px;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 3px 6px !important;
            font-size: 10px;
        }

        .erp-content {
            min-height: 250px;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 2px;
        }
    }

    /* Landscape phones */
    @@media (max-height: 600px) and (orientation: landscape) {
        .erp-content {
            min-height: 200px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            height: 32px;
            padding: 0 12px !important;
            font-size: 12px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs {
            min-height: 32px;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 4px 12px !important;
            font-size: 12px;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 4px;
        }

        .sub-section {
            padding-left: 8px;
            padding-right: 8px;
        }
    }

    /* Large screens */
    @@media (min-width: 1600px) {
        .sub-section {
            padding-left: 40px;
            padding-right: 40px;
        }

        .erp-content {
            min-height: 600px;
            margin-top: 12px;
            border-radius: 6px;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 20px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            height: 48px;
            padding: 0 28px !important;
            font-size: 15px;
        }

        .custom-ribbon-tabs ::deep .dxbl-tabs {
            min-height: 48px;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 12px 32px !important;
            font-size: 15px;
        }
    }

    /* Print styles */
    @@media print {
        .sub-section {
            padding: 0 !important;
        }

        .erp-content {
            border: 1px solid #ccc !important;
            min-height: auto !important;
            margin-top: 0 !important;
            border-radius: 0 !important;
        }

        .custom-ribbon-tabs,
        .custom-content-tabs {
            display: none !important;
        }

        .erp-content ::deep .dxbl-tabs-content {
            padding: 0 !important;
        }
    }
</style>