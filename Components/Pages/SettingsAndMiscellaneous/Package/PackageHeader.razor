@* PackageHeader.razor - child component rendered inside Package.razor's content tab *@
@using ERP.Components.Pages.SettingsAndMiscellaneous.Package.Models
@using ERP.Components.Pages.SettingsAndMiscellaneous.Package.Services
@using ERP.V7.WebPMS.Components.Shared

<div class="ph-master-detail">
    <!-- Left Panel with ParentId and Hotel columns using DxGrid -->
    <div class="package-header-left-pannel">
        <div class="grid-container">
            <DxGrid @ref="LeftGrid"
                    Data="@packageHeaderListItems"
                    KeyFieldName="ParentId"
                    CssClass="erp-grid"
                    ShowGroupPanel="false"
                    ShowFilterRow="false"
                    CustomizeElement="@OnLeftCustomizeElement">

                <Columns>
                    <DxGridDataColumn FieldName="ParentId" Caption="ParentId">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnLeftColumnClick(context.DataItem as PackageHeaderListItem)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderListItem)?.ParentId)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Hotel" Caption="Hotel">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnLeftColumnClick(context.DataItem as PackageHeaderListItem)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderListItem)?.Hotel)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>

            </DxGrid>
        </div>
    </div>

    <!-- Right Panel with the existing grid -->
    <div class="detail-grid-panel">
        <div class="grid-container">
            <DxGrid @ref="Grid"
                    Data="@Packages"
                    KeyFieldName="Code"
                    CssClass="erp-grid"
                    Width="100%"
                    ShowGroupPanel="false"
                    ShowFilterRow="false"
                    CustomizeElement="@OnCustomizeElement">

                <Columns>
                    <DxGridDataColumn FieldName="Code" Caption="Code">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Code)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Description" Caption="Description">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Description)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Hotel" Caption="Hotel">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Hotel)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Group" Caption="Group">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Group)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Type" Caption="Type">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Type)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Currency" Caption="Currency">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Currency)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Article" Caption="Article">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.Article)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="PostingRhythm" Caption="Posting-Rhythm">
                        <CellDisplayTemplate>
                            <span @onclick="() => OnColumnClick(context.DataItem as PackageHeaderModel)" 
                                  style="cursor: pointer; display: block; width: 100%; height: 100%;">
                                @((context.DataItem as PackageHeaderModel)?.PostingRhythm)
                            </span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>

            </DxGrid>
        </div>
    </div>
</div>

<!-- ===================== PACKAGE HEADER POPUP (Add / Edit) ===================== -->

<PackageHeaderPopup Visible="@ShowDialog"
                     VisibleChanged="@((value) => ShowDialog = value)"
                     Model="@Current"
                     Title="@popupTitle"
                     OnSave="HandleSave"
                     OnNew="HandlePopupNew"
                     OnClose="HandlePopupClose" />


<!-- ===================== DELETE CONFIRMATION POPUP ===================== -->

<DxPopup @bind-Visible="@ShowDeleteConfirm"
         Width="360px"
         ShowFooter="false"
         ShowCloseButton="true"
         CloseOnOutsideClick="false">

    <HeaderTemplate>
        <div class="popup-header confirm-header">
            <svg viewBox="0 0 24 24" width="22" height="22">
                <path fill="#c0392b" d="M12 2 1 21h22L12 2zm0 5.5a1.3 1.3 0 0 1 1.3 1.4l-.4 6.1a.9.9 0 0 1-1.8 0l-.4-6.1A1.3 1.3 0 0 1 12 7.5zm0 10.6a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8z" />
            </svg>
            <span class="popup-header-title confirm-title">Confirm Delete</span>
        </div>
    </HeaderTemplate>

    <BodyContentTemplate>

        <div class="confirm-body">

            <p>
                Are you sure you want to delete package
                <strong>@(PendingDelete?.Code) - @(PendingDelete?.Description)</strong>?
            </p>
            <p class="confirm-subtext">This action cannot be undone.</p>

        </div>

        <div class="confirm-footer">
            <button type="button" class="confirm-btn confirm-btn-cancel" @onclick="CancelDelete">Cancel</button>
            <button type="button" class="confirm-btn confirm-btn-delete" @onclick="ConfirmDelete">Delete</button>
        </div>

    </BodyContentTemplate>

</DxPopup>

<!-- ===================== DEVEXPRESS PRINT PREVIEW MODAL ===================== -->
<DevExpressPrintPreview
    @bind-Visible="showPrintPreview"
    Title="Print Dialog"
    DocumentTitle="Package Headers"
    PrintElementId="package-headers-print-area"
    IsMaximized="true">

    <div class="dx-report-header">
        <div class="dx-report-hotel-title">@(SelectedLeftItem?.Hotel ?? "TEST HOTEL")</div>
        <div class="dx-report-doc-title">Package Headers</div>
    </div>

    <div class="dx-report-meta-row" style="justify-content: flex-end;">
        <span>Date : @DateTime.Today.ToString("M/d/yyyy")</span>
    </div>

    <table class="dx-report-table">
        <thead>
            <tr>
                <th style="width: 50px; text-align: center;">Id</th>
                <th>Description</th>
                <th style="width: 140px;">Group</th>
                <th style="width: 140px;">Type</th>
                <th style="width: 100px;">Currency</th>
                <th style="width: 150px;">Article</th>
                <th style="width: 150px;">Posting Rhythm</th>
            </tr>
        </thead>
        <tbody>
            @if (Packages.Any())
            {
                int index = 1;
                @foreach (var pkg in Packages)
                {
                    <tr>
                        <td style="text-align: center;">@(index++)</td>
                        <td>@pkg.Description</td>
                        <td>@pkg.Group</td>
                        <td>@pkg.Type</td>
                        <td>@pkg.Currency</td>
                        <td>@pkg.Article</td>
                        <td>@pkg.PostingRhythm</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; color: #888; padding: 24px;">No Package Headers Data</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="dx-report-signatures">
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Prepared By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Checked By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Approved By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Authorized By</div>
        </div>
    </div>

    <div class="dx-report-footer">
        <span>ERP System</span>
    </div>
</DevExpressPrintPreview>

@code {
    [Inject]
    private PackageHeaderService Service { get; set; } = default!;

    private List<PackageHeaderModel> Packages = new();
    private DxGrid? Grid;
    private DxGrid? LeftGrid;
    private object? SelectedItemObj;
    private PackageHeaderModel? SelectedItem => SelectedItemObj as PackageHeaderModel;

    private bool showPrintPreview = false;

    // Left panel data
    private List<PackageHeaderListItem> packageHeaderListItems = new()
    {
        new PackageHeaderListItem { ParentId = "PKG-001", Hotel = "Hilton" },
        new PackageHeaderListItem { ParentId = "PKG-002", Hotel = "Marriott" },
        new PackageHeaderListItem { ParentId = "PKG-003", Hotel = "Sheraton" },
        new PackageHeaderListItem { ParentId = "PKG-004", Hotel = "Hyatt" },
        new PackageHeaderListItem { ParentId = "PKG-005", Hotel = "Radisson" }
    };

    private object? SelectedLeftItemObj;
    private PackageHeaderListItem? SelectedLeftItem => SelectedLeftItemObj as PackageHeaderListItem;

    // Left column click handler
    void OnLeftColumnClick(PackageHeaderListItem? clickedItem)
    {
        if (clickedItem is not null)
        {
            SelectedLeftItemObj = (clickedItem == SelectedLeftItem) ? null : clickedItem;
        }
    }

    void OnLeftCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && LeftGrid is not null)
        {
            var rowItem = LeftGrid.GetDataItem(e.VisibleIndex) as PackageHeaderListItem;
            if (rowItem is not null && rowItem == SelectedLeftItem)
            {
                e.CssClass = "row-manually-selected";
            }
        }
    }

    private bool ShowDialog;
    private string popupTitle = "Create Package Header";
    private PackageHeaderModel Current = new();
    private bool isEditMode;

    private bool ShowDeleteConfirm;
    private PackageHeaderModel? PendingDelete;

    protected override void OnInitialized()
    {
        Packages = Service.GetPackages();
    }

    // Right column click handler
    void OnColumnClick(PackageHeaderModel? clickedItem)
    {
        if (clickedItem is not null)
        {
            SelectedItemObj = (clickedItem == SelectedItem) ? null : clickedItem;
        }
    }

    void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && Grid is not null)
        {
            var rowItem = Grid.GetDataItem(e.VisibleIndex) as PackageHeaderModel;
            if (rowItem is not null && rowItem == SelectedItem)
            {
                e.CssClass = "row-manually-selected";
            }
        }
    }

    public void New()
    {
        Current = Service.CreateDefaultModel();
        isEditMode = false;
        popupTitle = "Create Package Header";
        ShowDialog = true;
        StateHasChanged();
    }

    public void Edit()
    {
        if (SelectedItem is null) return;
        Current = SelectedItem;
        isEditMode = true;
        popupTitle = "Update Package Header";
        ShowDialog = true;
        StateHasChanged();
    }

    public void Delete()
    {
        if (SelectedItem is null) return;
        PendingDelete = SelectedItem;
        ShowDeleteConfirm = true;
        StateHasChanged();
    }

    void ConfirmDelete()
    {
        if (PendingDelete is not null)
        {
            Service.DeletePackage(PendingDelete);
            Packages = Service.GetPackages();
            SelectedItemObj = null;
        }
        PendingDelete = null;
        ShowDeleteConfirm = false;
    }

    void CancelDelete()
    {
        PendingDelete = null;
        ShowDeleteConfirm = false;
    }

    private async Task HandleSave(PackageHeaderModel model)
    {
        Current = model;

        try
        {
            if (isEditMode)
            {
                Service.UpdatePackage(Current);
            }
            else
            {
                Service.AddPackage(Current);
            }

            Packages = Service.GetPackages();
            ShowDialog = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving package: {ex.Message}");
        }
    }

    private void HandlePopupNew()
    {
        Current = Service.CreateDefaultModel();
        isEditMode = false;
        popupTitle = "Create Package Header";
        StateHasChanged();
    }

    private void HandlePopupClose()
    {
        ShowDialog = false;
        StateHasChanged();
    }

    public void Print()
    {
        showPrintPreview = true;
        StateHasChanged();
    }
}