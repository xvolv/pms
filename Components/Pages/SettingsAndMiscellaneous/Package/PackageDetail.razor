@page "/package-detail"
@rendermode InteractiveServer

@using ERP.Components.Pages.SettingsAndMiscellaneous.Package.Models
@using ERP.Components.Pages.SettingsAndMiscellaneous.Package.Services
@using ERP.V7.WebPMS.Components.Shared
@using DevExpress.Blazor

<div class="page-shell">

    <!-- ===================== PACKAGE DETAIL (master-detail) ===================== -->

    <div class="master-detail">

        <div class="detail-list-panel">

            <!-- Header row: "*" flag column + "Package Header" title + sort arrow -->
            <div class="pd-tree-header">
                <div class="pd-tree-header-flag">*</div>
                <div class="pd-tree-header-title">
                    <span>Package Header</span>
                    <!-- <i class="bi bi-chevron-up pd-sort-arrow"></i> -->
                </div>
            </div>

            <div class="pd-tree-body">
                @foreach (var hotelGroup in packageGroups.GroupBy(g => g.Hotel))
                {
                    <div class="pd-group-row" @onclick="@(() => ToggleHotelGroup(hotelGroup.Key))">
                        <i class="@(expandedHotels.Contains(hotelGroup.Key) ? "bi bi-chevron-down" : "bi bi-chevron-right") pd-chevron"></i>
                        <span class="pd-group-title">Hotel: @hotelGroup.Key</span>
                    </div>

                    @if (expandedHotels.Contains(hotelGroup.Key))
                    {
                        @foreach (var group in hotelGroup)
                        {
                            <div class="pd-item-row @(selectedGroup == group ? "selected" : "")"
                                 @onclick="@(() => SelectGroup(group))">
                                <span class="pd-item-icon">&#128230;</span>
                                <span class="pd-item-name">@group.Name</span>
                            </div>
                        }
                    }
                }
            </div>

        </div>

        <div class="detail-grid-panel">

            <div class="grid-container">
                <DxGrid @ref="Grid"
                        Data="@(selectedGroup?.Details ?? new List<PackageDetailRow>())"
                        KeyFieldName="StartDate"
                        CssClass="erp-grid"
                        Width="100%"
                        ShowGroupPanel="false"
                        ShowFilterRow="false"
                        RowClick="@OnRowClick"
                        CustomizeElement="@OnCustomizeElement">

                    <Columns>
                        <DxGridDataColumn FieldName="StartDate" Caption="Start Date" />
                        <DxGridDataColumn FieldName="EndDate" Caption="End Date" />
                        <DxGridDataColumn FieldName="Price" Caption="Price" />
                        <DxGridDataColumn FieldName="Allowance" Caption="Allowance" />
                    </Columns>

                </DxGrid>
            </div>

        </div>

    </div>

</div>


<!-- ===================== PACKAGE DETAIL POPUP ===================== -->

<PackageDetailPopup Visible="@isCreatePopupVisible"
                   VisibleChanged="@((value) => isCreatePopupVisible = value)"
                   Model="@holidayModel"
                   Title="@popupTitle"
                   OnSave="HandleSave"
                   OnNew="HandlePopupNew"
                   OnClose="HandlePopupClose"
                   OnReset="HandleReset" />

<!-- ===================== DEVEXPRESS PRINT PREVIEW MODAL ===================== -->
<DevExpressPrintPreview
    @bind-Visible="showPrintPreview"
    Title="Print Dialog"
    DocumentTitle="@($"Package Details for {(selectedGroup?.Name ?? "Package")}")"
    PrintElementId="package-details-print-area"
    IsMaximized="true">

    <div class="dx-report-header">
        <div class="dx-report-hotel-title">@(selectedGroup?.Hotel ?? "TEST HOTEL")</div>
        <div class="dx-report-doc-title">Package Details for @(selectedGroup?.Name ?? "Test Package Header 1")</div>
    </div>

    <div class="dx-report-meta-row" style="justify-content: flex-end;">
        <span>Date : @DateTime.Today.ToString("M/d/yyyy")</span>
    </div>

    <table class="dx-report-table">
        <thead>
            <tr>
                <th style="width: 25%;">Start Date</th>
                <th style="width: 25%;">End Date</th>
                <th style="width: 25%; text-align: right;">Price</th>
                <th style="width: 25%; text-align: right;">Allowance</th>
            </tr>
        </thead>
        <tbody>
            @if (selectedGroup?.Details != null && selectedGroup.Details.Any())
            {
                @foreach (var row in selectedGroup.Details)
                {
                    <tr>
                        <td>@row.StartDate.ToString("M/d/yyyy")</td>
                        <td>@row.EndDate.ToString("M/d/yyyy")</td>
                        <td style="text-align: right;">@row.Price.ToString("0.00")</td>
                        <td style="text-align: right;">@row.Allowance.ToString("0.00")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align: center; color: #888; padding: 24px;">No Package Details Data</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="dx-report-signatures">
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Prepared By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Checked By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Approved By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Authorized By</div>
        </div>
    </div>

    <div class="dx-report-footer">
        <span>ERP System</span>
    </div>
</DevExpressPrintPreview>

@code {
    [Inject]
    private PackageDetailService Service { get; set; } = default!;

    private DxGrid? Grid;
    private object? SelectedItemObj;
    private PackageDetailRow? SelectedItem => SelectedItemObj as PackageDetailRow;

    private bool showPrintPreview = false;

    private List<PackageGroup> packageGroups = new();
    private PackageGroup? selectedGroup;
    private HolidayModel holidayModel = new();
    private bool isCreatePopupVisible = false;
    private PackageDetailRow? editingRow = null;
    private string popupTitle = "Create Package Detail";

    // NEW: tracks which "Hotel: X" groups are expanded in the left tree panel
    private HashSet<string> expandedHotels = new();

    private bool ShowDeleteConfirm = false;
    private PackageDetailRow? PendingDelete = null;

    protected override void OnInitialized()
    {
        packageGroups = Service.GetPackageGroups();
        selectedGroup = Service.GetFirstGroup();

        // Expand every hotel group by default (matches reference: groups start open)
        expandedHotels = packageGroups.Select(g => g.Hotel).Distinct().ToHashSet();

        ResetForm();
    }

    // NEW: toggles a hotel group open/closed in the tree panel
    private void ToggleHotelGroup(string hotel)
    {
        if (!expandedHotels.Add(hotel))
        {
            expandedHotels.Remove(hotel);
        }
    }

    private void SelectGroup(PackageGroup group)
    {
        selectedGroup = group;
        SelectedItemObj = null;
    }

    public void New()
    {
        if (selectedGroup is null) return;
        editingRow = null;
        popupTitle = "Create Package Detail";
        ResetForm();
        isCreatePopupVisible = true;
        StateHasChanged();
    }

    public void Edit()
    {
        if (selectedGroup is null || SelectedItem is null) return;
        editingRow = SelectedItem;
        popupTitle = "Edit Package Detail";
        holidayModel = Service.CreateModelFromRow(editingRow);
        isCreatePopupVisible = true;
        StateHasChanged();
    }

    public void Delete()
    {
        if (selectedGroup is null || SelectedItem is null) return;
        PendingDelete = SelectedItem;
        ShowDeleteConfirm = true;
        StateHasChanged();
    }

    void ConfirmDelete()
    {
        if (PendingDelete is not null && selectedGroup is not null)
        {
            selectedGroup.Details.Remove(PendingDelete);
            SelectedItemObj = null;
        }
        PendingDelete = null;
        ShowDeleteConfirm = false;
    }

    void CancelDelete()
    {
        PendingDelete = null;
        ShowDeleteConfirm = false;
    }

    void OnRowClick(GridRowClickEventArgs e)
    {
        var clickedItem = Grid?.GetDataItem(e.VisibleIndex) as PackageDetailRow;
        SelectedItemObj = (clickedItem is not null && clickedItem == SelectedItem) ? null : clickedItem;
    }

    void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && Grid is not null)
        {
            var rowItem = Grid.GetDataItem(e.VisibleIndex) as PackageDetailRow;
            if (rowItem is not null && rowItem == SelectedItem)
            {
                e.CssClass = "row-manually-selected";
            }
        }
    }

    private void ResetForm()
    {
        holidayModel = Service.CreateDefaultModel();
    }

    private void HandleReset(HolidayModel model)
    {
        holidayModel = model;
    }

    private async Task HandleSave(HolidayModel model)
    {
        holidayModel = model;

        if (selectedGroup is null) return;

        try
        {
            if (editingRow is not null)
            {
                Service.UpdateDetail(editingRow, holidayModel);
            }
            else
            {
                Service.AddDetail(selectedGroup, holidayModel);
            }

            isCreatePopupVisible = false;
            editingRow = null;
            StateHasChanged();
        }
        catch (ArgumentException ex)
        {
            // Handle validation errors
            Console.WriteLine($"Validation error: {ex.Message}");
        }
    }

    private void HandlePopupNew()
    {
        if (selectedGroup is null) return;
        editingRow = null;
        popupTitle = "Create Package Detail";
        ResetForm();
        StateHasChanged();
    }

    private void HandlePopupClose()
    {
        isCreatePopupVisible = false;
        StateHasChanged();
    }

    public void Print()
    {
        showPrintPreview = true;
        StateHasChanged();
    }
}


<!-- ===================== DELETE CONFIRMATION POPUP ===================== -->

<DxPopup @bind-Visible="@ShowDeleteConfirm"
         Width="360px"
         ShowFooter="false"
         ShowCloseButton="true"
         CloseOnOutsideClick="false">

    <HeaderTemplate>
        <div class="popup-header">
            <svg class="popup-header-icon" viewBox="0 0 24 24" width="25" height="25">
                <path fill="#c0392b" d="M12 2l1.9 6.3L20 10l-6.1 1.7L12 18l-1.9-6.3L4 10l6.1-1.7z" />
            </svg>
            <span class="popup-header-title">Confirm Delete</span>
        </div>
    </HeaderTemplate>

    <BodyContentTemplate>
        <div class="delete-confirm-content">
            <p>Are you sure you want to delete this package detail?</p>
            <div class="delete-confirm-buttons">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </BodyContentTemplate>

</DxPopup>