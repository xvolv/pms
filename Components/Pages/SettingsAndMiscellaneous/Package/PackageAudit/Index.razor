@page "/package-audit"
@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Shared

<div class="db-pr-container">

    <!-- ===================== TOP TOOLBAR ===================== -->
    <div class="db-pa-toolbar">
        <button class="db-pa-ok-print-btn" type="button" title="OK" @onclick="OnOk">
            <i class="bi bi-check-circle-fill"></i>
            <span>OK</span>
        </button>

        <HotelDropdown selectedHotel="@SelectedHotel" 
                      selectedHotelChanged="@((value) => SelectedHotel = value)" />

        <div class="db-pa-guest-package">
            <GuestDropdown SelectedGuestDisplay="@SelectedGuestDisplay"
                           SelectedGuestDisplayChanged="@((value) => SelectedGuestDisplay = value)"
                           SelectedGuestCode="@SelectedGuestCode"
                           SelectedGuestCodeChanged="@((value) => SelectedGuestCode = value)"
                           GuestData="@GuestLookupData" />

            <PackageDropdown SelectedPackage="@SelectedPackage"
                           SelectedPackageChanged="@((value) => SelectedPackage = value)"
                           PackageItems="@PackageListItems.ToList()" />
        </div>

        <button class="db-pa-ok-print-btn" type="button" title="Print" @onclick="OnPrint">
            <i class="bi bi-printer"></i>
            <span>Print</span>
        </button>

        <div class="db-pa-field">
            <label>Date</label>
            <DxDateEdit @bind-Date="SelectedDate" CssClass="db-pa-w-130" />
        </div>
    </div>

    <!-- ===================== MAIN GRID ===================== -->
    <div class="db-pa-grid-area">
        <DxGrid Data="@Data"
                KeyFieldName="SN"
                ShowFilterRow="false"
                PageSize="30"
                CssClass="db-pr-grid"
                Height="100%"
                SelectionMode="GridSelectionMode.Single"
                SelectedDataItem="@SelectedItem"
                SelectedDataItemChanged="@(e => SelectedItem = (PackageAuditModel?)e)">
            <Columns>
                <DxGridDataColumn FieldName="SN" Caption="SN" Width="60" />
                <DxGridDataColumn FieldName="VoucherCode" Caption="Voucher Code" Width="130" />
                <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="130" />
                <DxGridDataColumn FieldName="Room" Caption="Room" Width="90" />
                <DxGridDataColumn FieldName="RegNo" Caption="Reg. No." Width="110" />
                <DxGridDataColumn FieldName="Guest" Caption="Guest" MinWidth="180" />
                <DxGridDataColumn FieldName="NoOfAdult" Caption="# of Adult" Width="90" />
                <DxGridDataColumn FieldName="NoOfChild" Caption="# of Child" Width="90" />
            </Columns>
        </DxGrid>
    </div>
</div>

@code {
    // ============================================================
    // Toolbar fields
    // ============================================================
    string SelectedHotel = "Main Hotel";

    string? SelectedGuestDisplay;
    string? SelectedGuestCode;
    string? SelectedPackage;
    DateTime SelectedDate = new DateTime(2026, 8, 26);

    // ============================================================
    // Grid Data
    // ============================================================
    List<PackageAuditModel> Data = new();
    PackageAuditModel? SelectedItem;

    // ============================================================
    // Data
    // ============================================================
    List<GuestDropdown.GuestLookupModel> GuestLookupData = new(); // TODO: load real data

    List<string> PackageListItems = new()
    {
        "Test Package Header 1",
        "test header 2"
    };

    // ============================================================
    // Actions
    // ============================================================
    protected override void OnInitialized()
    {
        // TODO: load real data
        Data = new List<PackageAuditModel>();
    }

    void OnOk()
    {
        // TODO: apply filters and reload data
        LoadData();
    }

    void OnPrint()
    {
        // TODO: print logic
    }

    void LoadData()
    {
        // TODO: call your service using SelectedHotel, SelectedGuestCode, SelectedPackage, SelectedDate
        Data = new List<PackageAuditModel>();
    }

    // ============================================================
    // Models
    // ============================================================
    public class PackageAuditModel
    {
        public int SN { get; set; }
        public string VoucherCode { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string Room { get; set; } = "";
        public string RegNo { get; set; } = "";
        public string Guest { get; set; } = "";
        public int NoOfAdult { get; set; }
        public int NoOfChild { get; set; }
    }

}

<style>
    .db-pr-container {
        display: flex;
        flex-direction: column;
        gap: 5px;
        height: 100%;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 13px;
        background: #fff;
    }

    /* ===== Toolbar ===== */
    .db-pa-toolbar {
        display: flex;
        align-items: center;
        gap: 30px;
        padding: 8px 12px;
        background: #f0f0f0;
        border-bottom: 1px solid #ccc;
        flex-wrap: wrap;
    }

    .db-pa-ok-print-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4px 12px;
        cursor: pointer;
        font-size: 11px;
        min-width: 48px;
        border: none;
    }

    .db-pa-ok-print-btn i {
        font-size: 30px;
        color: #555;
        margin-bottom: 1px;
    }

    .db-pa-ok-print-btn:hover {
        background: #e8f0fe;
    }


    .db-pa-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
    }

    .db-pa-field label {
        font-size: 12px;
        color: #333;
        white-space: nowrap;
    }

    .db-pa-w-130 { width: 130px; }
    .db-pa-w-160 { width: 160px; }


    /* ===== Grid area ===== */
    .db-pa-grid-area {
        flex: 1;
        overflow: hidden;
        border: 1px solid #ccc;
        margin: 0;
    }

    /* ===== Shared dropdown styles (same as your other pages) ===== */
    .db-pr-dropdown-anchor {
        position: relative;
    }

    .db-pr-dropdown-popup {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        background: #fff;
        border: 1px solid #888;
        box-shadow: 2px 2px 8px rgba(0,0,0,0.3);
        width: 420px;
        display: flex;
        flex-direction: column;
    }

    .db-pr-dropdown-popup-wide {
        width: 560px;
    }

    .db-pr-dropdown-body {
        padding: 8px;
        display: flex;
        flex-direction: column;
    }

    .db-pr-dropdown-search-row {
        display: flex;
        gap: 8px;
        margin-bottom: 6px;
    }

    .db-pr-dropdown-search-input {
        flex: 1;
        border: 1px solid #999;
        padding: 3px 5px;
        font-size: 13px;
    }

    .db-pr-dropdown-find-btn {
        border: 1px solid #888;
        background: #fff;
        padding: 3px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    .db-pr-dropdown-list {
        min-height: 180px;
        max-height: 280px;
        overflow-y: auto;
    }

    .db-pr-dropdown-list-header {
        color: #555;
        padding: 3px 2px 5px 2px;
        font-size: 13px;
        border-bottom: 1px solid #eee;
    }

    .db-pr-dropdown-list-item {
        padding: 4px 6px;
        cursor: pointer;
        font-size: 13px;
    }

    .db-pr-dropdown-list-item:hover {
        background: #f0f4fa;
    }

    .db-pr-dropdown-list-item.db-pr-selected {
        background: #cce4f7;
        border: 1px solid #99c2e8;
    }

    .db-pr-dropdown-table {
        width: 100%;
        border-collapse: collapse;
