@page "/package-audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Shared

<div class="db-pr-container">

    <!-- ===================== TOP TOOLBAR ===================== -->
    <div class="db-pa-toolbar">
        <button class="db-pa-ok-print-btn" type="button" title="OK" @onclick="OnOk">
            <i class="bi bi-check-circle-fill"></i>
            <span>OK</span>
        </button>

        <HotelDropdown selectedHotel="@SelectedHotel" 
                      selectedHotelChanged="@((value) => SelectedHotel = value)" />

        <div class="db-pa-guest-package">
            <GuestDropdown SelectedGuestDisplay="@SelectedGuestDisplay"
                           SelectedGuestDisplayChanged="@((value) => SelectedGuestDisplay = value)"
                           SelectedGuestCode="@SelectedGuestCode"
                           SelectedGuestCodeChanged="@((value) => SelectedGuestCode = value)"
                           GuestData="@GuestLookupData" />

            <PackageDropdown SelectedPackage="@SelectedPackage"
                           SelectedPackageChanged="@((value) => SelectedPackage = value)"
                           PackageItems="@PackageListItems.ToList()" />
        </div>

        <button class="db-pa-ok-print-btn" type="button" title="Print" @onclick="OnPrint">
            <i class="bi bi-printer"></i>
            <span>Print</span>
        </button>

        <div class="db-pa-field">
            <label>Date</label>
            <DxDateEdit @bind-Date="SelectedDate" CssClass="db-pa-w-130" />
        </div>
    </div>

    <!-- ===================== MAIN GRID ===================== -->
    <div class="db-pa-grid-area">
        <DxGrid Data="@Data"
                KeyFieldName="SN"
                ShowFilterRow="false"
                PageSize="30"
                CssClass="db-pr-grid"
                Height="100%"
                SelectionMode="GridSelectionMode.Single"
                SelectedDataItem="@SelectedItem"
                SelectedDataItemChanged="@(e => SelectedItem = (PackageAuditModel?)e)">
            <Columns>
                <DxGridDataColumn FieldName="SN" Caption="SN" Width="60" />
                <DxGridDataColumn FieldName="VoucherCode" Caption="Voucher Code" Width="130" />
                <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="130" />
                <DxGridDataColumn FieldName="Room" Caption="Room" Width="90" />
                <DxGridDataColumn FieldName="RegNo" Caption="Reg. No." Width="110" />
                <DxGridDataColumn FieldName="Guest" Caption="Guest" MinWidth="180" />
                <DxGridDataColumn FieldName="NoOfAdult" Caption="# of Adult" Width="90" />
                <DxGridDataColumn FieldName="NoOfChild" Caption="# of Child" Width="90" />
            </Columns>
        </DxGrid>
    </div>
    <!-- ===================== DEVEXPRESS PRINT PREVIEW MODAL ===================== -->
    <DevExpressPrintPreview
        @bind-Visible="showPrintPreview"
        Title="Print Dialog"
        DocumentTitle="Package Audit"
        PrintElementId="package-audit-print-area"
        IsMaximized="true">

        <div class="dx-report-header">
            <div class="dx-report-hotel-title">@(string.IsNullOrWhiteSpace(SelectedHotel) ? "TEST HOTEL" : SelectedHotel)</div>
            <div class="dx-report-doc-title">Package Audit</div>
        </div>

        <div class="dx-report-meta-row" style="justify-content: flex-end;">
            <span>Date : @SelectedDate.ToString("M/d/yyyy")</span>
        </div>

        <table class="dx-report-table">
            <thead>
                <tr>
                    <th style="width: 45px; text-align: center;">SN</th>
                    <th style="width: 120px;">Voucher Code</th>
                    <th style="width: 120px;">Room Type</th>
                    <th style="width: 80px;">Room</th>
                    <th style="width: 110px;">Reg. No.</th>
                    <th>Guest</th>
                    <th style="width: 85px; text-align: right;"># of Adult</th>
                    <th style="width: 85px; text-align: right;"># of Child</th>
                </tr>
            </thead>
            <tbody>
                @if (Data.Any())
                {
                    @foreach (var row in Data)
                    {
                        <tr>
                            <td style="text-align: center;">@row.SN</td>
                            <td>@row.VoucherCode</td>
                            <td>@row.RoomType</td>
                            <td>@row.Room</td>
                            <td>@row.RegNo</td>
                            <td>@row.Guest</td>
                            <td style="text-align: right;">@row.NoOfAdult</td>
                            <td style="text-align: right;">@row.NoOfChild</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: #888; padding: 24px;">No Package Audit Data</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="dx-report-signatures">
            <div class="dx-report-sig-col">
                <div class="dx-report-sig-line"></div>
                <div class="dx-report-sig-text">Prepared By</div>
            </div>
            <div class="dx-report-sig-col">
                <div class="dx-report-sig-line"></div>
                <div class="dx-report-sig-text">Checked By</div>
            </div>
            <div class="dx-report-sig-col">
                <div class="dx-report-sig-line"></div>
                <div class="dx-report-sig-text">Approved By</div>
            </div>
            <div class="dx-report-sig-col">
                <div class="dx-report-sig-line"></div>
                <div class="dx-report-sig-text">Authorized By</div>
            </div>
        </div>

        <div class="dx-report-footer">
            <span>ERP System</span>
        </div>
    </DevExpressPrintPreview>
</div>

@code {
    // ============================================================
    // Toolbar fields
    // ============================================================
    string SelectedHotel = "TEST HOTEL";

    string? SelectedGuestDisplay;
    string? SelectedGuestCode;
    string? SelectedPackage;
    DateTime SelectedDate = DateTime.Today;

    // Print preview visibility
    bool showPrintPreview = false;

    // ============================================================
    // Grid Data
    // ============================================================
    List<PackageAuditModel> Data = new();
    PackageAuditModel? SelectedItem;

    // ============================================================
    // Data
    // ============================================================
    List<GuestDropdown.GuestLookupModel> GuestLookupData = new();

    List<string> PackageListItems = new()
    {
        "Test Package Header 1",
        "test header 2"
    };

    // ============================================================
    // Actions
    // ============================================================
    protected override void OnInitialized()
    {
        LoadData();
    }

    void OnOk()
    {
        LoadData();
    }

    void OnPrint()
    {
        showPrintPreview = true;
    }

    void LoadData()
    {
        Data = new List<PackageAuditModel>
        {
            new PackageAuditModel { SN = 1, VoucherCode = "VC-00101", RoomType = "Deluxe King", Room = "101", RegNo = "REG-1001", Guest = "John Doe", NoOfAdult = 2, NoOfChild = 0 },
            new PackageAuditModel { SN = 2, VoucherCode = "VC-00102", RoomType = "Standard Twin", Room = "102", RegNo = "REG-1002", Guest = "Jane Smith", NoOfAdult = 1, NoOfChild = 1 },
            new PackageAuditModel { SN = 3, VoucherCode = "VC-00103", RoomType = "Executive Suite", Room = "201", RegNo = "REG-1003", Guest = "Michael Johnson", NoOfAdult = 2, NoOfChild = 2 }
        };
    }

    // ============================================================
    // Models
    // ============================================================
    public class PackageAuditModel
    {
        public int SN { get; set; }
        public string VoucherCode { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string Room { get; set; } = "";
        public string RegNo { get; set; } = "";
        public string Guest { get; set; } = "";
        public int NoOfAdult { get; set; }
        public int NoOfChild { get; set; }
    }

}

<style>
    .db-pr-container {
        display: flex;
        flex-direction: column;
        gap: 5px;
        height: 100%;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 13px;
        background: #fff;
    }

    /* ===== Toolbar ===== */
    .db-pa-toolbar {
        display: flex;
        align-items: center;
        gap: 30px;
        padding: 8px 12px;
        background: #f0f0f0;
        border-bottom: 1px solid #ccc;
        flex-wrap: wrap;
    }

    .db-pa-ok-print-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4px 12px;
        cursor: pointer;
        font-size: 11px;
        min-width: 48px;
        border: none;
    }

    .db-pa-ok-print-btn i {
        font-size: 30px;
        color: #555;
        margin-bottom: 1px;
    }

    .db-pa-ok-print-btn:hover {
        background: #e8f0fe;
    }


    .db-pa-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
    }

    .db-pa-field label {
        font-size: 12px;
        color: #333;
        white-space: nowrap;
    }

    .db-pa-w-130 { width: 130px; }
    .db-pa-w-160 { width: 160px; }


    /* ===== Grid area ===== */
    .db-pa-grid-area {
        flex: 1;
        overflow: hidden;
        border: 1px solid #ccc;
        margin: 0;
    }

    /* ===== Shared dropdown styles (same as your other pages) ===== */
    .db-pr-dropdown-anchor {
        position: relative;
    }

    .db-pr-dropdown-popup {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        background: #fff;
        border: 1px solid #888;
        box-shadow: 2px 2px 8px rgba(0,0,0,0.3);
        width: 420px;
        display: flex;
        flex-direction: column;
    }

    .db-pr-dropdown-popup-wide {
        width: 560px;
    }

    .db-pr-dropdown-body {
        padding: 8px;
        display: flex;
        flex-direction: column;
    }

    .db-pr-dropdown-search-row {
        display: flex;
        gap: 8px;
        margin-bottom: 6px;
    }

    .db-pr-dropdown-search-input {
        flex: 1;
        border: 1px solid #999;
        padding: 3px 5px;
        font-size: 13px;
    }

    .db-pr-dropdown-find-btn {
        border: 1px solid #888;
        background: #fff;
        padding: 3px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    .db-pr-dropdown-list {
        min-height: 180px;
        max-height: 280px;
        overflow-y: auto;
    }

    .db-pr-dropdown-list-header {
        color: #555;
        padding: 3px 2px 5px 2px;
        font-size: 13px;
        border-bottom: 1px solid #eee;
    }

    .db-pr-dropdown-list-item {
        padding: 4px 6px;
        cursor: pointer;
        font-size: 13px;
    }

    .db-pr-dropdown-list-item:hover {
        background: #f0f4fa;
    }

    .db-pr-dropdown-list-item.db-pr-selected {
        background: #cce4f7;
        border: 1px solid #99c2e8;
    }

    .db-pr-dropdown-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .db-pr-dropdown-table th {
        text-align: left;
        border-bottom: 1px solid #ccc;
        padding: 4px 6px;
        background: #f8f8f8;
    }

    .db-pr-dropdown-table td {
        padding: 4px 6px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }

    .db-pr-dropdown-table tr:hover td {
        background: #f0f4fa;
    }

    .db-pr-dropdown-clear-row {
        border-top: 1px solid #ccc;
        padding: 6px 8px;
        display: flex;
        justify-content: flex-end;
    }

    .db-pr-dropdown-clear-btn {
        border: 1px solid #888;
        background: #fff;
        padding: 3px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    .db-pr-dropdown-footer-bar {
        background: #ececec;
        border-top: 1px solid #ccc;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 6px;
    }

    .db-pr-dropdown-footer-bar i {
        color: #555;
        font-size: 11px;
        cursor: pointer;
    }

    .db-pr-dropdown-resize-handle {
        transform: rotate(45deg);
    }

    .db-pr-text-muted {
        color: #888;
        font-style: italic;
        text-align: center;
        padding: 12px;
    }

    .db-pa-guest-package {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
    }
</style>