        padding: 4px 6px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }

    .db-pr-dropdown-table tr:hover td {
        background: #f0f4fa;
    }

    .db-pr-dropdown-clear-row {
        border-top: 1px solid #ccc;
        padding: 6px 8px;
        display: flex;
        justify-content: flex-end;
    }

    .db-pr-dropdown-clear-btn {
        border: 1px solid #888;
        background: #fff;
        padding: 3px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    .db-pr-dropdown-footer-bar {
        background: #ececec;
        border-top: 1px solid #ccc;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 6px;
    }

    .db-pr-dropdown-footer-bar i {
        color: #555;
        font-size: 11px;
        cursor: pointer;
    }

    .db-pr-dropdown-resize-handle {
        transform: rotate(45deg);
    }

    .db-pr-text-muted {
        color: #888;
        font-style: italic;
        text-align: center;
        padding: 12px;
    }

    .db-pa-guest-package {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
    }
</style>