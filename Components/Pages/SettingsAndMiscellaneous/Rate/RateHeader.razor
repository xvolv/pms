@using DevExpress.Blazor
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer

<div class="rh-page">

    <div class="rh-content">
        <!-- Left Section: Basic Information -->
        <div class="rh-section rh-left-section">
            <div class="rh-form-row">
                <label>Rate Name</label>
                <div class="rh-input-group">
                    <DxTextBox @bind-Text="@EditModel.RateName" CssClass="rh-input" />
                    <DxButton Text="R" Click="OnRateNameClick" CssClass="rh-small-btn" />
                </div>
            </div>

            <div class="rh-form-row">
                <label>Folio Text</label>
                <DxTextBox @bind-Text="@EditModel.FolioText" CssClass="rh-input" />
            </div>

            <div class="rh-form-row">
                <label>Hotel</label>
                <DxComboBox Data="@HotelOptions"
                            @bind-Value="@EditModel.Hotel"
                            CssClass="rh-input"
                            AllowUserInput="true" />
            </div>

            <div class="rh-form-row">
                <label>Rate Category</label>
                <DxComboBox Data="@RateCategoryOptions"
                            @bind-Value="@EditModel.RateCategory"
                            CssClass="rh-input"
                            AllowUserInput="true" />
            </div>

            <div class="rh-form-row-split">
                <div class="rh-form-col">
                    <label>Start Date</label>
                    <DxDateEdit @bind-Date="@EditModel.StartDate" CssClass="rh-input" />
                </div>
                <div class="rh-form-col">
                    <label>End Date</label>
                    <DxDateEdit @bind-Date="@EditModel.EndDate" CssClass="rh-input" />
                </div>
            </div>

            <div class="rh-form-row">
                <label>Article</label>
                <div class="rh-input-group">
                    <DxTextBox @bind-Text="@EditModel.Article" ReadOnly="true" CssClass="rh-input" />
                    <DxButton Text="..." Click="OnArticleLookupClick" CssClass="rh-small-btn" />
                </div>
            </div>

            <div class="rh-form-row">
                <label>Currency</label>
                <DxComboBox Data="@CurrencyOptions"
                            @bind-Value="@EditModel.Currency"
                            CssClass="rh-input"
                            AllowUserInput="true" />
            </div>

            <div class="rh-form-row">
                <label>Exchange</label>
                <DxComboBox Data="@ExchangeOptions"
                            @bind-Value="@EditModel.Exchange"
                            CssClass="rh-input"
                            AllowUserInput="true" />
            </div>

            <div class="rh-form-row">
                <label>Market</label>
                <DxComboBox Data="@MarketOptions"
                            @bind-Value="@EditModel.Market"
                            CssClass="rh-input"
                            AllowUserInput="true" />
            </div>

            <div class="rh-form-row">
                <label>Source</label>
                <DxComboBox Data="@SourceOptions"
                            @bind-Value="@EditModel.Source"
                            CssClass="rh-input"
                            AllowUserInput="true" />
            </div>
        </div>

        <!-- Middle Section: Numeric Fields -->
        <div class="rh-section rh-middle-section">
            <div class="rh-form-row">
                <label>Commission</label>
                <DxSpinEdit CssClass="dx-input-num" @bind-Value="@EditModel.Commission" />
            </div>

            <div class="rh-form-row">
                <label>Addition</label>
                <DxSpinEdit CssClass="dx-input-num" @bind-Value="@EditModel.Addition" />
            </div>

            <div class="rh-form-row-split">
                <div class="rh-form-col">
                    <label>Max. Occupancy</label>
                    <DxSpinEdit CssClass="dx-input-num" @bind-Value="@EditModel.MaxOccupancy" Min="1" />
                </div>
                <div class="rh-form-col">
                    <label>Min. Occupancy</label>
                    <DxSpinEdit CssClass="dx-input-num" @bind-Value="@EditModel.MinOccupancy" Min="1" />
                </div>
            </div>

            <div class="rh-form-row">
                <label>Multiplication</label>
                <DxSpinEdit CssClass="dx-input-num" @bind-Value="@EditModel.Multiplication" />
            </div>

            <div class="rh-form-row">
                <label>Remark</label>
                <DxMemo @bind-Text="@EditModel.Remark" Rows="4" CssClass="rh-input rh-memo" />
            </div>
        </div>

        <!-- Right Section: Components -->
        <div class="rh-section rh-right-section">
            <div class="rh-components-box">
                <div class="rh-components-title">Components</div>
                <div class="rh-components-list">
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.PackageComponent" Enabled="false" />
                        <span>Package</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.Negotiated" />
                        <span>Negotiated</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.DayType" />
                        <span>Day Type</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.SuppressRate" />
                        <span>Suppress Rate</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.PrintRate" />
                        <span>Print Rate</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.Discount" />
                        <span>Discount</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.Tiered" />
                        <span>Tiered</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.DayUse" />
                        <span>Day Use</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.Membership" />
                        <span>Membership</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.Complimentary" />
                        <span>Complimentary</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.HouseUse" />
                        <span>House Use</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.OwnerRate" />
                        <span>Owner Rate</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.ChannelAllowed" />
                        <span>Channel Allowed</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.BAR" />
                        <span>BAR</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.CateringPackage" />
                        <span>Catering Package</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.DailyRates" />
                        <span>Daily Rates</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.BenefitRateCode" />
                        <span>Benefit Rate Code</span>
                    </div>
                    <div class="rh-checkbox-item">
                        <DxCheckBox @bind-Checked="@EditModel.RegionalAvailability" />
                        <span>Regional Availability</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Section: Room Type and Package Tabs -->
    <div class="rh-bottom-section">
        <DxTabs @bind-ActiveTabIndex="@ActiveBottomTabIndex" CssClass="rh-bottom-tabs">
           
            <DxTabPage Text="Room Type">
                <div class="rh-grid-container">
                    <DxGrid Data="@RoomTypes"
                            SelectionMode="GridSelectionMode.Multiple"
                            CssClass="rh-grid"
                            ShowAlternatingRows="true"
                            KeyFieldName="Id"
                            SelectedDataItems="@SelectedRoomTypes">
                        <Columns>
                            <DxGridSelectionColumn />
                            <DxGridDataColumn FieldName="Name" Caption="Room Type" />
                        </Columns>
                    </DxGrid>
                </div>
            </DxTabPage>

            <DxTabPage Text="Package">
                <div class="rh-grid-container">
                    <DxGrid Data="@Packages"
                            SelectionMode="GridSelectionMode.Multiple"
                            CssClass="rh-grid"
                            ShowAlternatingRows="true"
                            KeyFieldName="Id"
                            SelectedDataItems="@SelectedPackages">
                        <Columns>
                            <DxGridSelectionColumn />
                            <DxGridDataColumn FieldName="Name" Caption="Package" />
                            <DxGridDataColumn FieldName="IsIncluded" Caption="Is Included" />
                            <DxGridDataColumn FieldName="Quantity" Caption="Quantity" />
                        </Columns>
                    </DxGrid>
                </div>
            </DxTabPage>
         
        </DxTabs>
    </div>
</div>

@* ===================== ARTICLE LOOKUP POPUP ===================== *@
<DxPopup @bind-Visible="@IsArticleLookupVisible"
         HeaderText="Article Lookup"
         Width="420px"
         CssClass="rh-lookup-popup"
         PopupCssClass="rh-lookup-popup-content"
         ShowFooter="false"
         AllowResize="true"
         ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="rh-lookup-search-row">
            <DxTextBox @bind-Text="@ArticleSearchText" CssClass="rh-lookup-search-input" />
            <DxButton Text="Find" Click="OnArticleFindClick" CssClass="rh-lookup-find-btn" />
        </div>

        <DxGrid Data="@FilteredArticleOptions"
                CssClass="rh-lookup-grid"
                ShowAlternatingRows="true"
                RowClick="OnArticleRowClick">
            <Columns>
                <DxGridDataColumn FieldName="Code" Caption="code" Width="40%" />
                <DxGridDataColumn FieldName="Name" Caption="name" Width="60%" />
            </Columns>
        </DxGrid>

        <div class="rh-lookup-footer">
            <DxButton Text="Clear" Click="OnArticleClearClick" CssClass="rh-lookup-clear-btn" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<style>
    .rh-page {
        font-family: Segoe UI, Arial, sans-serif;
        background: #fff;
        padding: 10px;
    }

    /* Simple Rate Header Display */
    .rh-simple-header {
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #d7d7d7;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .rh-simple-header label {
        font-size: 12px;
        color: #333;
        font-weight: 500;
    }

    .rh-current-header {
        font-size: 14px;
        color: #1d73d4;
        font-weight: 600;
    }

    .rh-content {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }

    .rh-section {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        min-width: 200px;
    }

    .rh-left-section {
        flex: 1;
        min-width: 250px;
    }

    .rh-middle-section {
        flex: 0.8;
        min-width: 200px;
    }

    .rh-right-section {
        flex: 1;
        min-width: 280px;
    }

    .rh-form-row {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .rh-form-row label {
        font-size: 12px;
        color: #333;
        font-weight: 500;
    }

    .rh-form-row-split {
        display: flex;
        gap: 10px;
    }

    .rh-form-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .rh-input {
        width: 100%;
    }

    .rh-input-group {
        display: flex;
        gap: 4px;
    }

    .rh-input-group .rh-input {
        flex: 1;
    }

    .rh-small-btn {
        min-width: 30px;
        padding: 0 8px;
    }

    .rh-memo {
        min-height: 80px;
    }

    .rh-components-box {
        border: 1px solid #d7d7d7;
        border-radius: 4px;
        padding: 10px;
        background: #f9f9f9;
        height: 100%;
    }

    .rh-components-title {
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 8px;
        color: #333;
    }

    .rh-components-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        height: 100%;
        overflow-y: auto;
        max-height: 400px;
    }

    .rh-checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
    }

    .rh-bottom-section {
        border-top: 1px solid #d7d7d7;
        padding-top: 10px;
        clear: both;
    }

    .rh-bottom-tabs {
        margin-bottom: 10px;
    }

    .rh-grid-container {
        border: 1px solid #d7d7d7;
        border-radius: 4px;
        overflow: hidden;
    }

    .rh-grid {
        width: 100%;
    }

    /* Alternating row stripes */
    .rh-grid .dxbl-grid-data-row:nth-of-type(even),
    .rh-lookup-grid .dxbl-grid-data-row:nth-of-type(even) {
        --dxbl-grid-cell-back: #f5f7fa;
        background-color: #f5f7fa;
    }

    /* ---- Article lookup popup ---- */
    .rh-lookup-search-row {
        display: flex;
        gap: 8px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .rh-lookup-search-input {
        flex: 1;
    }

    .rh-lookup-grid {
        width: 100%;
        max-height: 260px;
        overflow-y: auto;
    }

    .rh-lookup-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #e0e0e0;
    }

    /* =====================================================
       RESPONSIVE STYLES
    ===================================================== */

    /* Tablets and smaller screens */
    @@media (max-width: 1024px) {
        .rh-page {
            padding: 8px;
        }

        .rh-content {
            gap: 12px;
        }

        .rh-section {
            min-width: 180px;
        }

        .rh-left-section {
            min-width: 200px;
        }

        .rh-middle-section {
            min-width: 180px;
        }

        .rh-right-section {
            min-width: 220px;
        }

        .rh-components-list {
            max-height: 300px;
        }
    }

    /* Mobile devices */
    @@media (max-width: 768px) {
        .rh-page {
            padding: 6px;
        }

        .rh-simple-header {
            font-size: 11px;
        }

        .rh-simple-header label {
            font-size: 11px;
        }

        .rh-current-header {
            font-size: 13px;
        }

        .rh-content {
            flex-direction: column;
            gap: 12px;
        }

        .rh-section {
            flex: none;
            width: 100%;
            min-width: unset;
        }

        .rh-left-section,
        .rh-middle-section,
        .rh-right-section {
            min-width: unset;
            width: 100%;
        }

        .rh-form-row-split {
            flex-direction: column;
            gap: 8px;
        }

        .rh-form-col {
            width: 100%;
        }

        .rh-components-box {
            height: auto;
            max-height: 300px;
            overflow-y: auto;
        }

        .rh-components-list {
            max-height: 250px;
        }

        .rh-checkbox-item {
            font-size: 13px;
        }

        .rh-bottom-tabs ::deep .dxbl-tabs-item {
            padding: 8px 16px !important;
            font-size: 13px;
        }

        .rh-grid-container {
            overflow-x: auto;
        }

        .rh-grid ::deep .dxbl-grid-table {
            min-width: 400px;
        }

        .rh-lookup-search-row {
            flex-direction: column;
            gap: 6px;
        }

        .rh-lookup-find-btn {
            width: 100%;
        }

        ::deep .rh-lookup-popup-content {
            width: 95% !important;
            max-width: 420px;
            margin: 0 auto;
        }
    }

    /* Small mobile devices */
    @@media (max-width: 480px) {
        .rh-page {
            padding: 4px;
        }

        .rh-content {
            gap: 8px;
        }

        .rh-section {
            gap: 6px;
        }

        .rh-form-row {
            gap: 3px;
        }

        .rh-form-row label {
            font-size: 11px;
        }

        .rh-form-row-split {
            gap: 6px;
        }

        .rh-small-btn {
            min-width: 24px;
            padding: 0 4px;
            font-size: 12px;
        }

        .rh-components-title {
            font-size: 12px;
        }

        .rh-checkbox-item {
            font-size: 12px;
            gap: 6px;
        }

        .rh-components-box {
            padding: 8px;
            max-height: 250px;
        }

        .rh-components-list {
            max-height: 200px;
            gap: 4px;
        }

        .rh-bottom-tabs ::deep .dxbl-tabs-item {
            padding: 6px 10px !important;
            font-size: 12px;
        }

        .rh-grid ::deep .dxbl-grid-table {
            font-size: 12px;
            min-width: 300px;
        }

        .rh-memo {
            min-height: 60px;
        }

        .rh-lookup-grid ::deep .dxbl-grid-table {
            font-size: 12px;
            min-width: 250px;
        }

        ::deep .rh-lookup-popup-content {
            width: 98% !important;
            max-width: 350px;
        }
    }

    /* Landscape phones */
    @@media (max-height: 600px) and (orientation: landscape) {
        .rh-content {
            gap: 10px;
        }

        .rh-section {
            gap: 6px;
        }

        .rh-form-row {
            gap: 2px;
        }

        .rh-components-box {
            max-height: 200px;
        }

        .rh-components-list {
            max-height: 150px;
        }

        .rh-memo {
            min-height: 40px;
        }
    }

    /* Large screens */
    @@media (min-width: 1600px) {
        .rh-page {
            padding: 20px;
        }

        .rh-content {
            gap: 20px;
        }

        .rh-section {
            gap: 14px;
        }

        .rh-components-list {
            gap: 8px;
        }

        .rh-checkbox-item {
            font-size: 13px;
        }
    }

    /* Print styles */
    @@media print {
        .rh-page {
            padding: 0;
        }

        .rh-content {
            gap: 10px;
        }

        .rh-components-box {
            border: 1px solid #ccc;
            background: #fff;
        }

        .rh-bottom-section {
            border-top: 1px solid #ccc;
        }

        .rh-grid-container {
            border: 1px solid #ccc;
        }

        .rh-grid .dxbl-grid-data-row:nth-of-type(even),
        .rh-lookup-grid .dxbl-grid-data-row:nth-of-type(even) {
            --dxbl-grid-cell-back: #f0f0f0 !important;
            background-color: #f0f0f0 !important;
        }
    }
</style>

@code {
    private int ActiveBottomTabIndex = 0;

    // ---------- Parameters (data owned by parent Index.razor) ----------
    [Parameter] public List<RateHeaderOption> RateHeaderOptions { get; set; } = new();
    [Parameter] public int? SelectedRateHeaderId { get; set; }

    // ---------- Public methods for toolbar delegation ----------
    public void New()
    {
        EditModel = new RateHeaderEditModel();
        SelectedRoomTypes = new List<RoomTypeItem>();
        SelectedPackages = new List<PackageItem>();
        StateHasChanged();
    }

    public void Edit()
    {
        // Load selected item into EditModel
    }

    public void Delete()
    {
        OnDeleteRequest?.Invoke("Are you sure you want to delete this rate header?", () =>
        {
            // Delete selected item
        });
    }

    public void Save()
    {
        // Save changes
    }

    /// <summary>Called by Index.razor when the toolbar dropdown selection changes.</summary>
    public void ApplySelection(int? selectedId)
    {
        _lastAppliedSelectedId = selectedId;

        if (RateHeaderOptions == null || RateHeaderOptions.Count == 0)
        {
            RateHeaderOptions = BuildDefaultRateHeaderOptions();
        }

        if (selectedId.HasValue)
        {
            var selected = RateHeaderOptions.FirstOrDefault(r => r.Id == selectedId.Value);
            if (selected != null)
            {
                var source = selected.RateHeader;
                EditModel = new RateHeaderEditModel
                {
                    RateName = source.RateName,
                    FolioText = source.FolioText,
                    Hotel = source.Hotel,
                    RateCategory = source.RateCategory,
                    StartDate = source.StartDate,
                    EndDate = source.EndDate,
                    Article = source.Article,
                    Currency = source.Currency,
                    Exchange = source.Exchange,
                    Market = source.Market,
                    Source = source.Source,
                    Commission = source.Commission,
                    Addition = source.Addition,
                    MaxOccupancy = source.MaxOccupancy,
                    MinOccupancy = source.MinOccupancy,
                    Multiplication = source.Multiplication,
                    Remark = source.Remark,
                    PackageComponent = source.PackageComponent,
                    Negotiated = source.Negotiated,
                    DayType = source.DayType,
                    SuppressRate = source.SuppressRate,
                    PrintRate = source.PrintRate,
                    Discount = source.Discount,
                    Tiered = source.Tiered,
                    DayUse = source.DayUse,
                    Membership = source.Membership,
                    Complimentary = source.Complimentary,
                    HouseUse = source.HouseUse,
                    OwnerRate = source.OwnerRate,
                    ChannelAllowed = source.ChannelAllowed,
                    BAR = source.BAR,
                    CateringPackage = source.CateringPackage,
                    DailyRates = source.DailyRates,
                    BenefitRateCode = source.BenefitRateCode,
                    RegionalAvailability = source.RegionalAvailability
                };

                SelectedRoomTypes = RoomTypes.Where(r => selected.SelectedRoomTypeIds.Contains(r.Id)).ToList();
                SelectedPackages = Packages.Where(p => selected.SelectedPackageIds.Contains(p.Id)).ToList();
            }
            else
            {
                New();
            }
        }
        else
        {
            New();
        }
        StateHasChanged();
    }

    // Edit Model
    private RateHeaderEditModel EditModel = new();

    // Options
    private readonly List<string> RateCategoryOptions = new() { "Standard Rate", "Special Rate", "Group Room Rate" };
    private readonly List<string> HotelOptions = new() { "Main Hotel", "Branch Hotel", "Resort" };
    private readonly List<string> CurrencyOptions = new() { "Birr", "USD", "EUR", "GBP" };
    private readonly List<string> ExchangeOptions = new() { "Arrival Day Rate", "Reservation Day Rate", "Posting Date Rate" };
    private readonly List<string> MarketOptions = new() { "Corporate Business", "Leisure", "Group" };
    private readonly List<string> SourceOptions = new() { "Company Direct", "Travel Agent", "Online" };

    // ---------- Article Lookup (searchable code/name popup) ----------
    private bool IsArticleLookupVisible = false;
    private string ArticleSearchText = string.Empty;

    // ---------- Delete Confirmation Callback ----------
    [Parameter]
    public Action<string, Action>? OnDeleteRequest { get; set; }

    private readonly List<ArticleLookupItem> ArticleLookupOptions = new()
    {
        new ArticleLookupItem { Code = "SE-00001", Name = "ACCOMMODATION" },
        new ArticleLookupItem { Code = "SE-00002", Name = "SERVICE CHARGE" },
        new ArticleLookupItem { Code = "SE-00005", Name = "ROOM CHARGE" },
        new ArticleLookupItem { Code = "SE-00008", Name = "MEAL PLAN" },
        new ArticleLookupItem { Code = "SE-00012", Name = "AIRPORT TRANSFER" },
    };

    private List<ArticleLookupItem> FilteredArticleOptions =>
        string.IsNullOrWhiteSpace(ArticleSearchText)
            ? ArticleLookupOptions
            : ArticleLookupOptions
                .Where(a => a.Code.Contains(ArticleSearchText, StringComparison.OrdinalIgnoreCase)
                         || a.Name.Contains(ArticleSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private void OnArticleLookupClick()
    {
        ArticleSearchText = string.Empty;
        IsArticleLookupVisible = true;
    }

    private void OnArticleFindClick()
    {
        // FilteredArticleOptions recomputes automatically from ArticleSearchText.
    }

    private void OnArticleRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as ArticleLookupItem;
        if (item != null)
        {
            EditModel.Article = $"{item.Code} - {item.Name}";
            IsArticleLookupVisible = false;
        }
    }

    private void OnArticleClearClick()
    {
        EditModel.Article = string.Empty;
        IsArticleLookupVisible = false;
    }

    // Room Types with selection
