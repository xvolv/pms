    // Pending selection — replayed on first render if ApplySelection was called before the tab rendered
    private int? _pendingSelectionId;
    private int? _lastAppliedSelectedId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (RateHeaderOptions == null || RateHeaderOptions.Count == 0)
        {
            RateHeaderOptions = BuildDefaultRateHeaderOptions();
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (RateHeaderOptions == null || RateHeaderOptions.Count == 0)
        {
            RateHeaderOptions = BuildDefaultRateHeaderOptions();
        }

        if (SelectedRateHeaderId != _lastAppliedSelectedId)
        {
            ApplySelection(SelectedRateHeaderId);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _pendingSelectionId.HasValue)
        {
            ApplySelection(_pendingSelectionId);
            _pendingSelectionId = null;
            StateHasChanged();
        }
        
        // Also check if we have a selected rate header ID from parameters on first render
        if (firstRender && SelectedRateHeaderId.HasValue && _pendingSelectionId == null)
        {
            ApplySelection(SelectedRateHeaderId);
        }
    }

    public void Refresh()
    {
        New();
    }

