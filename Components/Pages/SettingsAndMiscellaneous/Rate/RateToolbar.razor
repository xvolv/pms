@rendermode InteractiveServer

<div class="erp-toolbar">
 @if (OnRefresh.HasDelegate)
    {
        <button class="toolbar-btn" @onclick="OnRefresh">
            <div class="toolbar-icon">
                <i class="bi bi-arrow-clockwise"></i>
            </div>
            <div class="toolbar-text">Refresh</div>
        </button>
    }

    @if (OnNew.HasDelegate)
    {
        <button class="toolbar-btn" @onclick="OnNew">
            <div class="toolbar-icon">
                <i class="bi bi-file-earmark-plus"></i>
            </div>
            <div class="toolbar-text">New</div>
        </button>
    }

    @if (OnEdit.HasDelegate)
    {
        <button class="toolbar-btn" @onclick="OnEdit">
            <div class="toolbar-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div class="toolbar-text">Edit</div>
        </button>
    }

    @if (OnSave.HasDelegate)
    {
        <button class="toolbar-btn" @onclick="OnSave">
            <div class="toolbar-icon">
                <i class="bi bi-floppy"></i>
            </div>
            <div class="toolbar-text">Save</div>
        </button>
    }

   

    @if (OnDelete.HasDelegate)
    {
        <button class="toolbar-btn" @onclick="OnDelete">
            <div class="toolbar-icon">
                <i class="bi bi-trash3"></i>
            </div>
            <div class="toolbar-text">Delete</div>
        </button>
    }

    @if (OnPrint.HasDelegate)
    {
        <button class="toolbar-btn toolbar-print" @onclick="OnPrint">
            <div class="toolbar-icon">
                <i class="bi bi-printer"></i>
            </div>
            <div class="toolbar-text">Print</div>
        </button>
    }

    @if (OnClose.HasDelegate)
    {
        <button class="toolbar-btn" @onclick="OnClose">
            <div class="toolbar-icon">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="toolbar-text">Close</div>
        </button>
    }

</div>

@code {
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnPrint { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}

<style>
    .erp-toolbar {
        display: flex;
        align-items: stretch;
        height: 74px;
        background: white;
        border: 1px solid #d6d6d6;
        border-radius: 5px;
        margin-top: 10px;
        margin-bottom: 10px;
        align-items: center;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 0 4px;
        gap: 2px;
        flex-shrink: 0;
    }

    .toolbar-btn {
        background: transparent !important;
        border: none !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        padding: 4px 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .toolbar-btn:hover {
        background: #f8f9fa !important;
        border: none !important;
    }

    /* Print button with left and right borders */
    .toolbar-btn.toolbar-print {
        border-left: 2px solid #d6d6d6 !important;
        border-right: 2px solid #d6d6d6 !important;
    }

    .toolbar-icon {
        font-size: 28px;
        line-height: 28px;
        color: #555;
    }

    .toolbar-icon i {
        font-size: 28px;
        transition: color 0.2s ease;
    }

    .toolbar-btn:hover .toolbar-icon i {
        color: #0d6efd;
    }

    .toolbar-text {
        margin-top: 4px;
        font-size: 11px;
        color: #444;
        font-weight: 500;
        transition: color 0.2s ease;
        white-space: nowrap;
    }

    .toolbar-btn:hover .toolbar-text {
        color: #0d6efd;
    }

    /* =====================================================
       RESPONSIVE STYLES
    ===================================================== */

    /* Tablets and smaller screens */
    @@media (max-width: 1024px) {
        .erp-toolbar {
            height: 66px;
            padding: 0 4px;
            gap: 1px;
        }

        .toolbar-btn {
            min-width: 60px;
            padding: 4px 8px;
        }

        .toolbar-icon {
            font-size: 24px;
            line-height: 24px;
        }

        .toolbar-icon i {
            font-size: 24px;
        }

        .toolbar-text {
            font-size: 10px;
            margin-top: 3px;
        }
    }

    /* Mobile devices */
    @@media (max-width: 768px) {
        .erp-toolbar {
            height: 58px;
            padding: 0 2px;
            gap: 1px;
            margin-top: 6px;
            margin-bottom: 6px;
            border-radius: 4px;
            flex-wrap: nowrap;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
        }

        .erp-toolbar::-webkit-scrollbar {
            height: 3px;
        }

        .erp-toolbar::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 3px;
        }

        .toolbar-btn {
            min-width: 50px;
            padding: 3px 6px;
        }

        .toolbar-icon {
            font-size: 20px;
            line-height: 20px;
        }

        .toolbar-icon i {
            font-size: 20px;
        }

        .toolbar-text {
            font-size: 9px;
            margin-top: 2px;
        }

        /* Print button borders on mobile - thinner */
        .toolbar-btn.toolbar-print {
            border-left: 1.5px solid #d6d6d6 !important;
            border-right: 1.5px solid #d6d6d6 !important;
        }

        /* Hide text on very small screens to save space */
        @@media (max-width: 480px) {
            .toolbar-btn {
                min-width: 44px;
                padding: 2px 4px;
            }

            .toolbar-icon {
                font-size: 18px;
                line-height: 18px;
            }

            .toolbar-icon i {
                font-size: 18px;
            }

            .toolbar-text {
                display: none;
            }

            /* Show only icons on very small screens */
            .toolbar-btn {
                min-width: 40px;
                padding: 4px 6px;
            }

            .erp-toolbar {
                height: 48px;
                padding: 0 2px;
                margin-top: 4px;
                margin-bottom: 4px;
            }

            .toolbar-btn.toolbar-print {
                border-left: 1px solid #d6d6d6 !important;
                border-right: 1px solid #d6d6d6 !important;
            }
        }
    }

    /* Very small mobile devices */
    @@media (max-width: 360px) {
        .erp-toolbar {
            height: 44px;
            padding: 0 2px;
            gap: 0px;
            margin-top: 3px;
            margin-bottom: 3px;
        }

        .toolbar-btn {
            min-width: 36px;
            padding: 2px 4px;
        }

        .toolbar-icon {
            font-size: 16px;
            line-height: 16px;
        }

        .toolbar-icon i {
            font-size: 16px;
        }
    }

    /* Landscape phones */
    @@media (max-height: 500px) and (orientation: landscape) {
        .erp-toolbar {
            height: 46px;
            padding: 0 2px;
            margin-top: 4px;
            margin-bottom: 4px;
        }

        .toolbar-btn {
            min-width: 44px;
            padding: 2px 6px;
        }

        .toolbar-icon {
            font-size: 18px;
            line-height: 18px;
        }

        .toolbar-icon i {
            font-size: 18px;
        }

        .toolbar-text {
            font-size: 8px;
            margin-top: 1px;
        }
    }

    /* Touch-friendly: larger tap targets on mobile */
    @@media (hover: none) and (pointer: coarse) {
        .toolbar-btn {
            min-height: 44px;
        }

        @@media (max-width: 480px) {
            .toolbar-btn {
                min-height: 38px;
                min-width: 38px;
            }
        }
    }

    /* Large screens */
    @@media (min-width: 1600px) {
        .erp-toolbar {
            height: 82px;
            padding: 0 8px;
            gap: 4px;
            margin-top: 12px;
            margin-bottom: 12px;
        }

        .toolbar-btn {
            min-width: 80px;
            padding: 6px 16px;
        }

        .toolbar-icon {
            font-size: 32px;
            line-height: 32px;
        }

        .toolbar-icon i {
            font-size: 32px;
        }

        .toolbar-text {
            font-size: 12px;
            margin-top: 5px;
        }
    }

    /* Print styles */
    @@media print {
        .erp-toolbar {
            display: none !important;
        }
    }
</style>