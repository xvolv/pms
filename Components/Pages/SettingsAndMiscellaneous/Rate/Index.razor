</style>

@code {
    // ---------- Component References ----------
    RateHeader? rateHeader;
    RateDetail? rateDetail;
    RateAvailability? rateAvailability;

    // ---------- Ribbon Tabs ----------
    private int ribbonActiveTab = 0;

    // ---------- Outer DxTabs ----------
    private int ActiveOuterTabIndex = 0;

    // ---------- Rate Category tab : DxGrid master-detail (tree-like via DetailRowTemplate) ----------
    private DxGrid? CategoryGridRef;
    private RateCategoryRow? SelectedCategoryRow;

    // Flat hardcoded demo data; ParentId null = root row, otherwise nested under that Id.
    private List<RateCategoryRow> AllCategories = new()
    {
        new RateCategoryRow { Id = 1, ParentId = null, Description = "Standard Rate", StartDate = new DateTime(2017,1,1),
EndDate = new DateTime(2018,12,31), Type = "Rate Class", Remark = "", RatePolicy = "" },
        new RateCategoryRow { Id = 2, ParentId = null, Description = "Special Rate", StartDate = new DateTime(2017,1,1), EndDate
= new DateTime(2018,12,31), Type = "Rate Class", Remark = "", RatePolicy = "" },
        new RateCategoryRow { Id = 3, ParentId = 2, Description = "Weekend Special", StartDate = new DateTime(2017,5,18),
EndDate = new DateTime(2017,5,31), Type = "Rate Class", Remark = "", RatePolicy = "" },
        new RateCategoryRow { Id = 4, ParentId = null, Description = "Group Room Rate", StartDate = new DateTime(2017,3,1),
EndDate = new DateTime(2018,4,7), Type = "Rate Class", Remark = "", RatePolicy = "" },
    };

    private List<RateCategoryRow> RootCategories => AllCategories.Where(c => c.ParentId == null).ToList();

    private List<RateCategoryRow> GetChildren(int parentId) => AllCategories.Where(c => c.ParentId == parentId).ToList();

    private void OnCategoryRowClick(GridRowClickEventArgs e)
    {
        SelectedCategoryRow = e.Grid?.GetDataItem(e.VisibleIndex) as RateCategoryRow;
    }

    private void OnCategoryCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as RateCategoryRow;
            if (item != null && SelectedCategoryRow != null && item.Id == SelectedCategoryRow.Id)
            {
                e.CssClass = "rc-row-selected";
            }
        }
    }

    // ---------- Popup / EditForm (Rate Category add/edit) ----------
    private bool IsPopupVisible = false;
    private RateCategoryEditModel EditModel = new();
    private EditContext? EditContext;
    private bool IsEditMode = false;

    // ---------- Confirmation Dialog ----------
    private bool showConfirmDialog = false;
    private DxConfirmDialog? confirmDialog;
    private string confirmMessage = "Are you sure you want to delete this item?";
    private Action? pendingDeleteAction;

    private readonly List<string> DescriptionOptions = new() { "Standard Rate", "Special Rate", "Weekend Special", "Group Room Rate" };
    private readonly List<string> TypeOptions = new() { "Rate Class", "Rate Header", "Rate Package" };

    private List<string> ParentOptions => AllCategories.Where(c => c.Id != EditModel.Id).Select(c =>
c.Description).ToList();

    // ---------- Toolbar Actions (delegated to child components) ----------
    void New()
    {
        if (ActiveOuterTabIndex == 0)
            OnNewClick();
        else if (ActiveOuterTabIndex == 1)
            rateHeader?.New();
        else if (ActiveOuterTabIndex == 2)
            rateDetail?.New();
        else if (ActiveOuterTabIndex == 3)
            rateAvailability?.New();
    }

    void Edit()
    {
        if (ActiveOuterTabIndex == 0)
            OnEditClick();
        else if (ActiveOuterTabIndex == 1)
            rateHeader?.Edit();
        else if (ActiveOuterTabIndex == 2)
            rateDetail?.Edit();
    }

    void Delete()
    {
        if (ActiveOuterTabIndex == 0)
            OnDeleteCategoryClick();
        else if (ActiveOuterTabIndex == 1)
            rateHeader?.Delete();
        else if (ActiveOuterTabIndex == 2)
            rateDetail?.Delete();
    }

    void Print()
    {
        if (ActiveOuterTabIndex == 0)
            OnPrintClick();
    }

    // ---------- Rate Category Toolbar Actions ----------
    void OnNewClick()
    {
        IsEditMode = false;
        EditModel = new RateCategoryEditModel();
        EditContext = new EditContext(EditModel);
        IsPopupVisible = true;
    }

    void OnEditClick()
    {
        if (SelectedCategoryRow == null)
        {
            return;
        }

        IsEditMode = true;
        EditModel = new RateCategoryEditModel
        {
            Id = SelectedCategoryRow.Id,
            Code = SelectedCategoryRow.Id.ToString(),
            Description = SelectedCategoryRow.Description,
            StartDate = SelectedCategoryRow.StartDate,
            EndDate = SelectedCategoryRow.EndDate,
            Parent = SelectedCategoryRow.ParentId.HasValue ? AllCategories.FirstOrDefault(c => c.Id ==
SelectedCategoryRow.ParentId)?.Description : "",
            Type = SelectedCategoryRow.Type,
            Remark = SelectedCategoryRow.Remark,
            RatePolicy = SelectedCategoryRow.RatePolicy
        };
        EditContext = new EditContext(EditModel);
        IsPopupVisible = true;
    }

    void OnDeleteCategoryClick()
    {
        if (SelectedCategoryRow == null)
        {
            return;
        }

        // Check if has children
        var children = GetChildren(SelectedCategoryRow.Id);
        if (children.Count > 0)
        {
            return; // Cannot delete parent with children
        }

        confirmMessage = "Are you sure you want to delete this rate category?";
        pendingDeleteAction = () =>
        {
            AllCategories.Remove(SelectedCategoryRow);
            SelectedCategoryRow = null;
        };
        showConfirmDialog = true;
    }

    void ShowDeleteConfirmation(string message, Action deleteAction)
    {
        confirmMessage = message;
        pendingDeleteAction = deleteAction;
        showConfirmDialog = true;
    }

    void OnConfirmDelete()
    {
        pendingDeleteAction?.Invoke();
        showConfirmDialog = false;
        pendingDeleteAction = null;
    }

    void OnCancelDelete()
    {
        showConfirmDialog = false;
        pendingDeleteAction = null;
    }

    void OnPrintClick()
    {
        // Hook up print/report logic here.
    }

    void OnSaveClick()
    {
        if (!EditContext?.Validate() ?? false)
        {
            return;
        }

        int? parentId = null;
        if (!string.IsNullOrEmpty(EditModel.Parent))
        {
            var parent = AllCategories.FirstOrDefault(c => c.Description == EditModel.Parent);
            parentId = parent?.Id;
        }

        if (IsEditMode)
        {
            var existing = AllCategories.FirstOrDefault(c => c.Id == EditModel.Id);
            if (existing != null)
            {
                existing.ParentId = parentId;
                existing.Description = EditModel.Description;
                existing.StartDate = EditModel.StartDate ?? DateTime.Today;
                existing.EndDate = EditModel.EndDate ?? DateTime.Today;
                existing.Type = EditModel.Type;
                existing.Remark = EditModel.Remark ?? "";
                existing.RatePolicy = EditModel.RatePolicy ?? "";
            }
        }
        else
        {
            int _codeSeed = AllCategories.Count > 0 ? AllCategories.Max(c => c.Id) + 1 : 1;

            var newCategory = new RateCategoryRow
            {
                Id = _codeSeed,
                ParentId = parentId,
                Description = EditModel.Description,
                StartDate = EditModel.StartDate ?? DateTime.Today,
                EndDate = EditModel.EndDate ?? DateTime.Today,
                Type = EditModel.Type,
                Remark = EditModel.Remark ?? "",
                RatePolicy = EditModel.RatePolicy ?? ""
            };
            AllCategories.Add(newCategory);
        }

        IsPopupVisible = false;
        SelectedCategoryRow = null;
    }

    void Save()
    {

    }

    void Refresh()
    {

    }

    void OnCloseClick()
    {
        IsPopupVisible = false;
