@page "/revenue"
@rendermode InteractiveServer

@inject NavigationManager Navigation
@using DevExpress.Blazor
@using System.ComponentModel.DataAnnotations

<PageTitle>Rate</PageTitle>
<div class="dashboard-wrapper">

    <div class="">

        <!-- Ribbon -->
        <DxTabs @bind-ActiveTabIndex="ribbonActiveTab" CssClass="custom-ribbon-tabs">

            <DxTabPage Text="Rate" />

        </DxTabs>

        <div class="sub-section">
            <!-- Toolbar -->
            <RateToolbar OnRefresh="Refresh" OnSave="Save" OnNew="New" OnEdit="Edit" OnDelete="Delete"
                         OnPrint="Print" />

  


            <!-- Work Area -->
            <div class="erp-content">

                <DxTabs @bind-ActiveTabIndex="@ActiveOuterTabIndex" CssClass="custom-content-tabs">

                    @* ---------------- Rate Category ---------------- *@
                    <DxTabPage Text="Rate Category">
                        <div class="rate-category-content">
                            <DxGrid @ref="CategoryGridRef" Data="@RootCategories" CssClass="rc-grid"
                                    AutoCollapseDetailRow="false" RowClick="OnCategoryRowClick"
                                    CustomizeElement="OnCategoryCustomizeElement">
                                <Columns>
                                    <DxGridDataColumn FieldName="Description" Width="34%" />
                                    <DxGridDataColumn FieldName="StartDate" Caption="Start Date" DisplayFormat="d"
                                                      Width="22%" />
                                    <DxGridDataColumn FieldName="EndDate" Caption="End Date" DisplayFormat="d"
                                                      Width="22%" />
                                    <DxGridDataColumn FieldName="Type" Width="22%" />
                                </Columns>
                                <DetailRowTemplate Context="masterContext">
                                    @{
                                        var parent = (RateCategoryRow)masterContext.DataItem; var children =
                                                GetChildren(parent.Id);
                                    }
                                    @if (children.Count > 0)
                                    {
                                        <DxGrid Data="@children" CssClass="rc-grid rc-grid-nested"
                                                RowClick="OnCategoryRowClick" CustomizeElement="OnCategoryCustomizeElement">
                                            <Columns>
                                                <DxGridDataColumn FieldName="Description" Width="34%" />
                                                <DxGridDataColumn FieldName="StartDate" Caption="Start Date"
                                                                  DisplayFormat="d" Width="22%" />
                                                <DxGridDataColumn FieldName="EndDate" Caption="End Date" DisplayFormat="d"
                                                                  Width="22%" />
                                                <DxGridDataColumn FieldName="Type" Width="22%" />
                                            </Columns>
                                        </DxGrid>
                                    }
                                    else
                                    {
                                        <div class="rc-no-children">No child rate categories.</div>
                                    }
                                </DetailRowTemplate>
                            </DxGrid>
                        </div>
                    </DxTabPage>

                    @* ---------------- Rate Header ---------------- *@
                    <DxTabPage Text="Rate Header">
                        <RateHeader @ref="rateHeader" OnDeleteRequest="ShowDeleteConfirmation" />
                    </DxTabPage>

                    @* ---------------- Rate Detail ---------------- *@
                    <DxTabPage Text="Rate Detail">
                        <RateDetail @ref="rateDetail" OnDeleteRequest="ShowDeleteConfirmation" />
                    </DxTabPage>

                    @* ---------------- Rate Availability ---------------- *@
                    <DxTabPage Text="Rate Availability">
                        <RateAvailability @ref="rateAvailability" OnDeleteRequest="ShowDeleteConfirmation" />
                    </DxTabPage>

                </DxTabs>

            </div>

        </div>
    </div>
</div>

@* ===================== RATE CATEGORY EDIT POPUP ===================== *@
<DxPopup @bind-Visible="@IsPopupVisible" Width="480px" ShowFooter="false" ShowCloseButton="true"
         CloseOnOutsideClick="false">

    <HeaderTemplate>
        <div class="popup-header">
            <svg class="popup-header-icon" viewBox="0 0 24 24" width="18" height="18">
                <path fill="#c0392b" d="M12 2l1.9 6.3L20 10l-6.1 1.7L12 18l-1.9-6.3L4 10l6.1-1.7z" />
            </svg>
            <span class="popup-header-title">Rate Category</span>
        </div>
    </HeaderTemplate>

    <BodyContentTemplate Context="popupContext">
        <RateToolbar OnNew="OnNewClick" OnSave="OnSaveClick" OnClose="OnCloseClick" />

        <EditForm EditContext="@EditContext">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="detail-form">
                <div class="detail-form-row">
                    <div class="detail-form-label">Code</div>
                    <DxTextBox @bind-Text="@EditModel.Code" ReadOnly="true" CssClass="code-box" Width="100%" />
                    <ValidationMessage For="@(() => EditModel.Code)" />
                </div>

                <div class="detail-form-row">
                    <div class="detail-form-label">Description</div>
                    <DxComboBox Data="@DescriptionOptions" @bind-Value="@EditModel.Description" CssClass="erp-combobox"
                                Width="100%" AllowUserInput="true" />
                    <ValidationMessage For="@(() => EditModel.Description)" />
                </div>

                <div class="detail-form-row two-col">
                    <div class="col">
                        <div class="detail-form-label">Start Date</div>
                        <DxDateEdit @bind-Date="@EditModel.StartDate" Width="100%" />
                        <ValidationMessage For="@(() => EditModel.StartDate)" />
                    </div>
                    <div class="col">
                        <div class="detail-form-label">End Date</div>
                        <DxDateEdit @bind-Date="@EditModel.EndDate" Width="100%" />
                        <ValidationMessage For="@(() => EditModel.EndDate)" />
                    </div>
                </div>

                <div class="detail-form-row two-col">
                    <div class="col">
                        <div class="detail-form-label">Parent</div>
                        <DxComboBox Data="@ParentOptions" @bind-Value="@EditModel.Parent" CssClass="erp-combobox"
                                    Width="100%" AllowUserInput="true" />
                    </div>
                    <div class="col">
                        <div class="detail-form-label">Type</div>
                        <DxComboBox Data="@TypeOptions" @bind-Value="@EditModel.Type" CssClass="erp-combobox"
                                    Width="100%" />
                        <ValidationMessage For="@(() => EditModel.Type)" />
                    </div>
                </div>

                <div class="detail-form-row">
                    <div class="detail-form-label">Remark</div>
                    <DxMemo @bind-Text="@EditModel.Remark" Rows="3" Width="100%" />
                </div>

                <div class="detail-form-row">
                    <div class="detail-form-label">Rate Policy</div>
                    <DxMemo @bind-Text="@EditModel.RatePolicy" Rows="5" Width="100%" />
                </div>
            </div>
        </EditForm>
    </BodyContentTemplate>
</DxPopup>

@* ===================== CONFIRMATION DIALOG ===================== *@
<DxConfirmDialog @ref="confirmDialog"
               Visible="@showConfirmDialog"
               Title="Confirm Delete"
               Message="@confirmMessage"
               OnConfirm="OnConfirmDelete"
               OnCancel="OnCancelDelete" />

<style>
    /* =====================================================
