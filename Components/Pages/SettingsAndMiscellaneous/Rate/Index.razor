    /* Selected row highlighting.
       DxGrid paints each cell's background via the --dxbl-grid-cell-back
       CSS variable, which normally overrides a plain background-color on
       the row/class. Overriding that variable (plus !important) makes sure
       this wins regardless of DevExpress's own row styling. */
    .rc-row-selected,
    .rc-row-selected td,
    .rc-row-selected .dxbl-grid-cell {
        --dxbl-grid-cell-back: #0078d4 !important;
        background-color: #0078d4 !important;
        color: white !important;
    }

    .rc-grid .dxbl-grid-data-row {
        cursor: pointer;
    }

    /* =====================================================
       POPUP STYLING (from Package page)
    ===================================================== */

