        /* Make popup full width on mobile */
        ::deep .dxbl-popup {
            width: 95% !important;
            max-width: 480px;
            margin: 0 auto;
        }

        ::deep .dxbl-popup-content {
            padding: 0 !important;
        }
    }

    /* Small mobile devices */
    @@media (max-width: 480px) {
        .custom-ribbon-tabs ::deep .dxbl-tabs-item {
            padding: 0 10px !important;
            font-size: 12px;
            height: 34px;
        }

        .custom-content-tabs ::deep .dxbl-tabs-item {
            padding: 6px 8px !important;
            font-size: 12px;
        }

        .erp-content {
            min-height: 400px;
            border-radius: 3px;
        }

        .rc-grid ::deep .dxbl-grid-table {
            font-size: 12px;
            min-width: 300px;
        }

        .detail-form {
            padding: 8px;
        }

        .popup-header {
            padding: 8px 10px;
        }

        .popup-header-title {
            font-size: 13px;
        }

        .detail-form-label {
            font-size: 10px;
        }

        .detail-form-row {
            margin-bottom: 8px;
        }
    }

    /* Landscape phones */
    @@media (max-height: 600px) and (orientation: landscape) {
        .erp-content {
            min-height: 250px;
        }

        .detail-form {
            padding: 8px;
        }

        .detail-form-row {
