        // FIX 2: Load mock data for Turndown and Discrepancy
        LoadTurndownData();
        LoadDiscrepancyData();
    }

    // ─── Task Assignment Methods ───
    void ToggleExpand(TaskAssignment ta) => expanded = expanded == ta ? null : ta;
    void ShowTaskSheetDetails() { showTaskSheetDetails = true; tsValidationMessage = ""; }
    void ClearAssignment() { selectedAssignment = null; expanded = null; }

    void GenerateTask()
    {
        tsValidationMessage = "";

        // FIX 3: Validation
        if (!tsOccupied && !tsVacant)
        {
            infoMessage = "Please Select Fo Status First!";
            infoIconClass = "bi-x-circle";
            showInfoPopup = true;
            return;
        }
        if (!tsClean && !tsDirty && !tsOutOfOrder && !tsOutOfService && !tsInspected && !tsPickup)
        {
            infoMessage = "Please Select House Keeping Status!";
            infoIconClass = "bi-exclamation-triangle";
            showInfoPopup = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedAttendantText))
        {
            tsValidationMessage = "Please select at least one attendant.";
            return;
        }

        // FIX 3: Actually add to list
        var selectedAttendants = attendants.Where(a => a.Selected).ToList();
        int roomsPerAttendant = 30 / Math.Max(selectedAttendants.Count, 1);

        var newAssignment = new TaskAssignment
        {
            TaskDate = tsTaskDate,
            Auto = true,
            TotalSheets = selectedAttendants.Count,
            TotalCredits = 0,
            Details = selectedAttendants.Select(a => new TaskDetail
            {
                AttendantCode = a.Code,
                AttendantName = a.FullName,
                TotalRooms = roomsPerAttendant,
                TotalCredit = 0
            }).ToList()
        };

        taskAssignments.Add(newAssignment);
        selectedAssignment = newAssignment;

        infoMessage = "Task Assigned. Open Task Sheet Window For Detail!";
        infoIconClass = "bi-info-circle";
        showInfoPopup = true;
        showTaskSheetDetails = false;

        // Reset selections
        tsOccupied = tsVacant = tsClean = tsDirty = tsOutOfOrder = tsOutOfService = tsInspected = tsPickup = false;
        selectAllAttendants = false;
        foreach (var a in attendants) a.Selected = false;
        selectedAttendantText = "";
    }

    void ConfirmAttendants()
    {
        var sel = attendants.Where(a => a.Selected).Select(a => a.FullName);
        selectedAttendantText = string.Join(", ", sel);
        showAttendantDropdown = false;
    }

    void ShowTaskSheetGrid() => showTaskSheetGrid = true;

    void SaveTaskSheet()
    {
        // FIX 3: Simulate saving by showing confirmation
        infoMessage = "Task Saved Successfully";
        infoIconClass = "bi-info-circle";
        showInfoPopup = true;
    }

    void ShowAddEmployee() { showAddEmployee = true; addEmpValidation = ""; }

    void SelectAddEmployee()
    {
        addEmpValidation = "";
        if (string.IsNullOrWhiteSpace(addEmpSelected))
        {
            addEmpValidation = "Please select an attendant.";
            return;
        }

        var att = attendants.FirstOrDefault(a => a.Code == addEmpSelected);
        if (att != null)
        {
            currentTaskSheetAttendant = att.FullName;
            // Add demo rooms for new attendant
            currentTaskSheetRooms = new List<RoomTask>(demoRooms);
        }
        showAddEmployee = false;
    }

    void ShowPrintPreview() => showPrintPreview = true;

    // ─── Turndown Methods ───
    void LoadTurndownData()
    {
        turndownData = new List<TurndownRecord>
        {
            new() { Room = "101", RoomType = "Standard Room", HouseKeepingStatus = "Dirty", Name = "John Smith", ResStatus = "Arrived", TurndownStatus = "Required" },
            new() { Room = "102", RoomType = "Executive", HouseKeepingStatus = "Clean", Name = "Jane Doe", ResStatus = "Stay Over", TurndownStatus = "Completed" },
            new() { Room = "103", RoomType = "Standard Room", HouseKeepingStatus = "Inspected", Name = "Robert Brown", ResStatus = "Arrival", TurndownStatus = "Not Required" },
            new() { Room = "201", RoomType = "Standard Room", HouseKeepingStatus = "Dirty", Name = "Alice Johnson", ResStatus = "Stay Over", TurndownStatus = "Required" },
            new() { Room = "202", RoomType = "Executive", HouseKeepingStatus = "Clean", Name = "Michael White", ResStatus = "Arrived", TurndownStatus = "Completed" },
            new() { Room = "301", RoomType = "Standard Room", HouseKeepingStatus = "Pickup", Name = "Sarah Connor", ResStatus = "Due Out", TurndownStatus = "Required" }
        };
    }

    List<TurndownRecord> FilterTurndown()
    {
        var query = turndownData.AsEnumerable();

        if (tdRequired && !tdNotRequired)
            query = query.Where(x => x.TurndownStatus == "Required");
        else if (!tdRequired && tdNotRequired)
            query = query.Where(x => x.TurndownStatus == "Not Required");

        if (tdArrivals)
            query = query.Where(x => x.ResStatus == "Arrival");
        if (tdArrived)
            query = query.Where(x => x.ResStatus == "Arrived");
        if (tdStayOver)
            query = query.Where(x => x.ResStatus == "Stay Over");

        if (!string.IsNullOrWhiteSpace(tdFromRoom))
            query = query.Where(x => string.Compare(x.Room, tdFromRoom) >= 0);
        if (!string.IsNullOrWhiteSpace(tdToRoom))
            query = query.Where(x => string.Compare(x.Room, tdToRoom) <= 0);
        if (!string.IsNullOrWhiteSpace(tdRoomType))
            query = query.Where(x => x.RoomType == tdRoomType);

        return query.ToList();
    }

    void SaveTurndown()
    {
        infoMessage = "Turndown data saved successfully.";
        infoIconClass = "bi-info-circle";
        showInfoPopup = true;
    }

    void ClearTurndownFilters()
    {
        tdRequired = tdNotRequired = tdArrivals = tdArrived = tdStayOver = false;
        tdFromRoom = tdToRoom = tdRoomType = null;
