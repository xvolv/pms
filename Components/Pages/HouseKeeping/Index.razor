@* @page "/housekeeping"
@using System.Collections.Generic
@using System.Linq
@using System.ComponentModel.DataAnnotations

<style>
    /* ─── Base / Layout ─── */
    * { box-sizing: border-box; }
    .erp-page { display: flex; height: 100vh; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; font-size: 12px; color: #333; overflow: hidden; }

    /* ─── Sidebar ─── */
    .erp-sidebar { display: flex; flex-direction: row; align-items: center; padding-top: 4px; }
    .sb-btn { width: 52px; height: 64px; display: flex; flex-direction: row; align-items: center; justify-content: center; cursor: pointer; margin-bottom: 2px; border: 1px solid transparent; border-radius: 2px; color: #555; }
    .sb-btn:hover { background: #d0d0d0; border-color: #aaa; }
    .sb-btn.active { background: #c0c0c0; border-color: #909090; font-weight: 600; color: #000; }
    .sb-btn i { font-size: 18px; margin-bottom: 2px; }
    .sb-btn span { font-size: 10px; line-height: 1; }
    .sb-group { border: 1px solid #bbb; margin: 2px; background: #f0f0f0; }
    .sb-group-title { background: #00a8e8; color: white; font-size: 10px; font-weight: bold; padding: 4px 2px; text-align: center; }
    .sb-item { padding: 6px 4px; font-size: 10px; cursor: pointer; border-bottom: 1px solid #ddd; white-space: nowrap; }
    .sb-item:hover { background: #e0e0e0; }
    .sb-item.active { background: #0078d7; color: white; }

    /* ─── Header ─── */
    .erp-header { height: 36px; background: white; border-bottom: 1px solid #00a8e8; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; }
    .erp-logo { color: #00a8e8; font-size: 16px; font-weight: 500; display: flex; align-items: center; gap: 6px; }
    .win-btns { color: #888; font-size: 14px; letter-spacing: 4px; }

    /* ─── Tabs ─── */
    .erp-tabs { display: flex; background: #f5f5f5; border-bottom: 1px solid #bbb; padding: 2px 4px 0 4px; gap: 2px; }
    .erp-tab { padding: 6px 18px; background: #e0e0e0; border: 1px solid #bbb; border-bottom: none; cursor: pointer; font-size: 12px; color: #555; position: relative; top: 1px; }
    .erp-tab.active { background: white; border-top: 2px solid #00a8e8; color: #00a8e8; font-weight: 600; }
    .erp-tab .close-x { margin-left: 8px; font-size: 11px; color: #888; }

    /* ─── Toolbar ─── */
    .erp-toolbar { background: #f5f5f5; border-bottom: 1px solid #bbb; padding: 4px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .tb-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 58px; height: 52px; border: 1px solid #bbb; background: linear-gradient(to bottom, #fff 0%, #f0f0f0 100%); cursor: pointer; border-radius: 2px; font-size: 11px; color: #333; }
    .tb-btn:hover { background: linear-gradient(to bottom, #f0f8ff 0%, #e0e0e0 100%); border-color: #0078d7; }
    .tb-btn i { font-size: 20px; margin-bottom: 2px; color: #555; }
    .tb-btn.red i { color: #c00; }
    .tb-sep { width: 1px; height: 40px; background: #ccc; margin: 0 4px; }
    .tb-label { font-size: 12px; color: #333; margin: 0 4px; }

    /* ─── Filter Row ─── */
    .filter-row { background: #f9f9f9; border-bottom: 1px solid #ddd; padding: 6px 10px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .filter-group { display: flex; align-items: center; gap: 4px; }
    .filter-label { font-size: 11px; color: #555; min-width: 50px; }

    /* ─── Grids ─── */
    .erp-grid { width: 100%; border-collapse: collapse; font-size: 12px; }
    .erp-grid th { background: linear-gradient(to bottom, #f5f5f5 0%, #e8e8e8 100%); border: 1px solid #bbb; padding: 6px 8px; text-align: left; font-weight: 600; color: #333; }
    .erp-grid td { border: 1px solid #ddd; padding: 5px 8px; color: #333; background: white; }
    .erp-grid tr:hover td { background: #f0f8ff; }
    .erp-grid tr.selected td { background: #0078d7 !important; color: white !important; }
    .erp-grid tr.selected td * { color: white !important; }
    .detail-grid { width: 100%; border-collapse: collapse; margin: 4px 0; }
    .detail-grid th { background: #f0f0f0; border: 1px solid #ccc; padding: 4px 6px; font-size: 11px; }
    .detail-grid td { border: 1px solid #ddd; padding: 4px 6px; font-size: 11px; background: #fafafa; }
    .expand-btn { cursor: pointer; color: #0078d7; font-weight: bold; display: inline-block; width: 14px; }

    /* ─── Status Bar ─── */
    .status-bar { background: #f0f0f0; border-top: 1px solid #bbb; padding: 4px 10px; font-size: 11px; color: #555; display: flex; justify-content: space-between; }

    /* ─── Popup / Modal Styles ─── */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 1050; }
    .modal-box { background: white; border: 1px solid #888; box-shadow: 0 4px 20px rgba(0,0,0,0.3); display: flex; flex-direction: column; min-width: 420px; }
    .modal-header { background: white; border-bottom: 1px solid #00a8e8; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between; color: #00a8e8; font-size: 14px; }
    .modal-header .title { display: flex; align-items: center; gap: 6px; }
    .modal-body { padding: 12px; background: #f5f5f5; }
    .modal-footer { padding: 8px 12px; background: #f0f0f0; border-top: 1px solid #ddd; display: flex; justify-content: flex-end; gap: 6px; }
    .win-btn { width: 20px; height: 18px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; color: #666; font-size: 12px; }
    .win-btn:hover { background: #e0e0e0; color: #000; }

    /* ─── Form Styles ─── */
    .form-frame { border: 1px solid #bbb; background: white; padding: 10px; margin-bottom: 10px; }
    .form-legend { font-size: 12px; font-weight: 600; color: #555; padding: 0 6px; }
    .form-row { display: flex; align-items: center; margin-bottom: 6px; gap: 8px; }
    .form-label { width: 90px; font-size: 11px; color: #444; text-align: right; }
    .form-input { flex: 1; }
    .chk-row { display: flex; gap: 16px; flex-wrap: wrap; margin: 6px 0; }
    .chk-item { display: flex; align-items: center; gap: 4px; font-size: 11px; }

    /* ─── Info Message Box ─── */
    .info-box { background: white; border: 1px solid #888; width: 320px; box-shadow: 0 4px 15px rgba(0,0,0,0.25); }
    .info-header { background: white; border-bottom: 1px solid #00a8e8; padding: 8px 12px; color: #00a8e8; font-size: 14px; display: flex; justify-content: space-between; align-items: center; }
    .info-body { padding: 20px; display: flex; align-items: center; gap: 12px; font-size: 12px; color: #333; }
    .info-icon { font-size: 32px; }
    .info-icon.error { color: #c00; }
    .info-icon.warn { color: #f0ad4e; }
    .info-icon.info { color: #5bc0de; }
    .info-footer { padding: 10px; display: flex; justify-content: center; background: #f5f5f5; border-top: 1px solid #ddd; }

    /* ─── Print Preview ─── */
    .print-page { background: white; border: 2px solid #00a8e8; padding: 20px; width: 720px; margin: 0 auto; font-size: 11px; }
    .print-header { text-align: center; margin-bottom: 10px; }
    .print-title { font-size: 14px; font-weight: bold; margin-bottom: 4px; }
    .print-sub { font-size: 11px; color: #555; }
    .print-table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    .print-table th, .print-table td { border: 1px solid #333; padding: 3px 6px; font-size: 10px; }
    .print-table th { background: #e8e8e8; }

    /* ─── Misc ─── */
    .yellow-col { background: #fffbcc !important; }
    ::deep .dxbl-edit-btn { height: 24px !important; }
    .scroll-box { max-height: 300px; overflow-y: auto; border: 1px solid #ccc; background: white; }
    .room-list { list-style: none; margin: 0; padding: 0; }
    .room-list li { padding: 4px 8px; border-bottom: 1px solid #eee; cursor: pointer; }
    .room-list li:hover { background: #e0f0ff; }
    .room-list li.selected { background: #0078d7; color: white; }

    /* FIX 1: Ensure checkbox labels are always visible */
    ::deep .dxbl-checkbox-text { color: #333 !important; font-size: 11px !important; margin-left: 4px !important; }
    ::deep .dxbl-checkbox { align-items: center !important; }
    .chk-row ::deep .dxbl-checkbox { margin-right: 4px; }
    .validation-msg { color: #c00; font-size: 11px; margin-top: 4px; margin-left: 90px; }
    .field-error { border-color: #c00 !important; }
</style>

<div class="erp-page">
    <!-- ═════════════════ SIDEBAR ═════════════════ -->
    <div class="erp-sidebar">
        <div class="sb-btn"><i class="bi bi-menu-button-wide"></i><span>Main Menu</span></div>

        <div class="sb-group">
            <div class="sb-group-title">House Keeping</div>
            <div class="sb-item @(activeModule=="TaskAssignment"?"active":"")" @onclick='()=>activeModule="TaskAssignment"'>Task Assignment</div>
            <div class="sb-item @(activeModule=="Discrepancy"?"active":"")" @onclick='()=>activeModule="Discrepancy"'>Discrepancy</div>
            <div class="sb-item @(activeModule=="Turndown"?"active":"")" @onclick='()=>activeModule="Turndown"'>Turndown Management</div>
        </div>

        <div class="sb-btn"><i class="bi bi-star"></i><span>Favorites</span></div>
        <div class="sb-btn"><i class="bi bi-search"></i><span>Search</span></div>
    </div>

    <!-- ═════════════════ MAIN CONTENT ═════════════════ -->
    <div style="flex:1; display:flex; flex-direction:column; min-width:0;">
     
        <!-- ═══════ TASK ASSIGNMENT ═══════ -->
        @if (activeModule == "TaskAssignment")
        {
            <div style="flex:1; display:flex; flex-direction:column; overflow:auto;">
                <!-- Toolbar -->
                <div class="erp-toolbar">
                    <div class="tb-btn" @onclick="ShowTaskSheetDetails"><i class="bi bi-person-plus" style="color:#5cb85c;"></i><span>Assign Task</span></div>
                    <div class="tb-btn" @onclick="ShowTaskSheetGrid"><i class="bi bi-card-list" style="color:#5bc0de;"></i><span>Task Sheet</span></div>
                    <div class="tb-btn" @onclick="ShowPrintPreview"><i class="bi bi-printer"></i><span>Print</span></div>
                    <div class="tb-btn red" @onclick="ClearAssignment"><i class="bi bi-x-circle"></i><span>Cancel</span></div>
                    <div class="tb-sep"></div>
                    <div class="filter-group">
                        <span class="tb-label">Task Date</span>
                        <DxDateEdit @bind-Date="taskDateFilter" CssClass="form-input" style="width:120px;" />
                    </div>
                    <div class="filter-group">
                        <span class="tb-label">Month</span>
                        <DxComboBox Data="@months" @bind-Value="selectedMonth" style="width:100px;" />
                    </div>
                </div>

                <!-- Grid -->
                <div style="flex:1; overflow:auto; padding:4px;">
                    <table class="erp-grid">
                        <thead>
                            <tr>
                                <th style="width:20px;"></th>
                                <th>Task Date</th>
                                <th>Auto</th>
                                <th>Total Sheets</th>
                                <th>Total Credits</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ta in taskAssignments)
                            {
                                var isSel = selectedAssignment == ta;
                                <tr class="@(isSel?"selected":"")" @onclick="()=>selectedAssignment=ta">
                                    <td><span class="expand-btn" @onclick:stopPropagation @onclick="()=>ToggleExpand(ta)">@(expanded==ta?"⊟":"⊞")</span></td>
                                    <td>@ta.TaskDate.ToString("M/d/yyyy")</td>
                                    <td>@(ta.Auto?"Yes":"No")</td>
                                    <td>@ta.TotalSheets</td>
                                    <td>@ta.TotalCredits</td>
                                </tr>
                                @if (expanded == ta)
                                {
                                    <tr>
                                        <td colspan="5" style="padding:0; background:#f9f9f9;">
                                            <div style="padding:6px 30px;">
                                                <div style="font-size:11px; color:#0078d7; margin-bottom:4px;">task Detail</div>
                                                <table class="detail-grid">
                                                    <thead><tr><th>Attendant Code</th><th>Attendant Name</th><th>Total Rooms</th><th>Total Credit</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var d in ta.Details)
                                                        {
                                                            <tr><td>@d.AttendantCode</td><td>@d.AttendantName</td><td>@d.TotalRooms</td><td>@d.TotalCredit</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            @if (!taskAssignments.Any())
                            {
                                <tr><td colspan="5" style="text-align:center; color:#888; padding:20px;">No records to display</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Status -->
                <div class="status-bar">
                    <div>◄◄ ◄ <b>Record @(taskAssignments.Any()?Math.Min(taskAssignments.IndexOf(selectedAssignment)+1, taskAssignments.Count):0) of @taskAssignments.Count</b> ► ►►</div>
                    <div>Total Sheet: <b>@taskAssignments.Sum(x=>x.TotalSheets)</b> &nbsp;&nbsp; Total Credit: <b>@taskAssignments.Sum(x=>x.TotalCredits)</b></div>
                </div>
            </div>
        }

        <!-- ═══════ TURNDOWN MANAGEMENT ═══════ -->
        @if (activeModule == "Turndown")
        {
            <div style="flex:1; display:flex; flex-direction:column; overflow:auto;">
                <div class="erp-toolbar">
                    <div class="tb-btn" @onclick="SaveTurndown"><i class="bi bi-save" style="color:#337ab7;"></i><span>Save</span></div>
                    <div class="tb-btn" @onclick="LoadTurndownData"><i class="bi bi-arrow-clockwise" style="color:#5cb85c;"></i><span>Refresh</span></div>
                    <div class="tb-btn" @onclick="()=>showPrintPreview=true"><i class="bi bi-printer"></i><span>Print</span></div>
                    <div class="tb-btn red" @onclick="ClearTurndownFilters"><i class="bi bi-x-circle"></i><span>Cancel</span></div>
                    <div class="tb-sep"></div>
                    <div class="chk-row" style="margin:0;">
                        <DxCheckBox @bind-Checked="tdRequired" Text="Required" />
                        <DxCheckBox @bind-Checked="tdNotRequired" Text="Not Required" />
                        <DxCheckBox @bind-Checked="tdArrivals" Text="Arrivals" />
                        <DxCheckBox @bind-Checked="tdArrived" Text="Arrived" />
                        <DxCheckBox @bind-Checked="tdStayOver" Text="Stay Over" />
                    </div>
                    <div class="tb-sep"></div>
                    <span class="tb-label">From Room</span>
                    <DxComboBox Data="@roomList" @bind-Value="tdFromRoom" style="width:70px;" />
                    <span class="tb-label">To Room</span>
                    <DxComboBox Data="@roomList" @bind-Value="tdToRoom" style="width:70px;" />
                    <span class="tb-label">Room Type</span>
                    <DxComboBox Data="@roomTypes" @bind-Value="tdRoomType" style="width:100px;" />
                    <span class="tb-label">Date</span>
                    <DxDateEdit @bind-Date="tdDate" style="width:120px;" />
                </div>

                <div style="flex:1; overflow:auto; padding:4px;">
                    <div style="background:#f5f5f5; border:1px solid #ddd; padding:4px; color:#888; font-style:italic; margin-bottom:4px;">Drag a column header here to group by that column</div>
                    <table class="erp-grid">
                        <thead>
                            <tr><th>Room</th><th>Room Type</th><th>HouseKeeping Status</th><th>Name</th><th>Res. Status</th><th>Turndown status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in FilteredTurndownData)
                            {
                                <tr>
                                    <td>@r.Room</td>
                                    <td>@r.RoomType</td>
                                    <td>@r.HouseKeepingStatus</td>
                                    <td>@r.Name</td>
                                    <td>@r.ResStatus</td>
                                    <td>
                                        <DxComboBox Data="@turndownStatuses" @bind-Value="r.TurndownStatus" style="width:120px;" />
                                    </td>
                                </tr>
                            }
                            @if (!FilteredTurndownData.Any())
                            {
                                <tr><td colspan="6" style="text-align:center; color:#888; padding:20px;">No records to display</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="status-bar">
                    <div>◄◄ ◄ <b>Record @(FilteredTurndownData.Any()?1:0) of @FilteredTurndownData.Count</b> ► ►►</div>
                    <div></div>
                </div>
            </div>
        }

        <!-- ═══════ DISCREPANCY ═══════ -->
        @if (activeModule == "Discrepancy")
        {
            <div style="flex:1; display:flex; flex-direction:column; overflow:auto;">
                <div class="erp-toolbar">
                    <div class="tb-btn" @onclick="ShowNewDiscrepancy"><i class="bi bi-file-earmark" style="color:#337ab7;"></i><span>New</span></div>
                    <div class="tb-btn" @onclick="LoadDiscrepancyData"><i class="bi bi-arrow-clockwise" style="color:#5cb85c;"></i><span>Refresh</span></div>
                    <div class="tb-btn" @onclick="()=>showPrintPreview=true"><i class="bi bi-printer"></i><span>Print</span></div>
                    <div class="tb-btn red" @onclick="ClearDiscrepancyFilters"><i class="bi bi-x-circle"></i><span>Cancel</span></div>
                    <div class="tb-sep"></div>
                    <div class="chk-row" style="margin:0;">
                        <DxCheckBox @bind-Checked="discSleeps" Text="Sleeps" />
                        <DxCheckBox @bind-Checked="discSkips" Text="Skips" />
                        <DxCheckBox @bind-Checked="discPerson" Text="Person Discrepancy" />
                        <DxCheckBox @bind-Checked="discSleepPerson" Text="Sleep/Person" />
                        <DxCheckBox @bind-Checked="discSkipPerson" Text="Skip/Person" />
                        <DxCheckBox @bind-Checked="discDueOut" Text="Due Out Only" />
                    </div>
                    <div class="tb-sep"></div>
                    <span class="tb-label">Floor</span>
                    <DxComboBox Data="@floors" @bind-Value="discFloor" style="width:100px;" />
                    <span class="tb-label">Room</span>
                    <DxComboBox Data="@roomList" @bind-Value="discRoom" style="width:70px;" />
                    <span class="tb-label">Room Type</span>
                    <DxComboBox Data="@roomTypes" @bind-Value="discRoomType" style="width:100px;" />
                    <span class="tb-label">Date</span>
                    <DxDateEdit @bind-Date="discDate" style="width:120px;" />
                </div>

                <div style="flex:1; overflow:auto; padding:4px;">
                    <div style="background:#f5f5f5; border:1px solid #ddd; padding:4px; color:#888; font-style:italic; margin-bottom:4px;">Drag a column header here to group by that column</div>
                    <table class="erp-grid">
                        <thead>
                            <tr>
                                <th>Room Number</th><th>Room Type</th><th>Room Status</th><th>HouseKeeping Status</th>
                                <th>FO Status</th><th>Res. Status</th><th>FO Person</th><th>HK Person</th><th>Discrepancy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in FilteredDiscrepancyData)
                            {
                                <tr>
                                    <td>@d.RoomNumber</td><td>@d.RoomType</td><td>@d.RoomStatus</td><td>@d.HouseKeepingStatus</td>
                                    <td>@d.FoStatus</td><td>@d.ResStatus</td><td>@d.FoPerson</td><td>@d.HkPerson</td><td>@d.Discrepancy</td>
                                </tr>
                            }
                            @if (!FilteredDiscrepancyData.Any())
                            {
                                <tr><td colspan="9" style="text-align:center; color:#888; padding:20px;">No records to display</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="status-bar">
                    <div>◄◄ ◄ <b>Record @(FilteredDiscrepancyData.Any()?1:0) of @FilteredDiscrepancyData.Count</b> ► ►►</div>
                    <div></div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ═════════════════ POPUP: Task Sheet Details ═════════════════ -->
@if (showTaskSheetDetails)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width:520px;">
            <div class="modal-header">
                <div class="title"><span style="color:#e00; font-size:18px;">❋</span> Task Sheet Details</div>
                <div><span class="win-btn">_</span><span class="win-btn">□</span><span class="win-btn" @onclick="()=>showTaskSheetDetails=false">✕</span></div>
            </div>
            <div class="modal-body">
                <div style="display:flex; gap:8px; margin-bottom:10px;">
                    <div class="tb-btn" style="width:50px; height:44px;" @onclick="GenerateTask"><i class="bi bi-file-earmark-gear" style="font-size:18px;"></i><span style="font-size:9px;">Generate</span></div>
                    <div class="tb-btn red" style="width:50px; height:44px;" @onclick="()=>showTaskSheetDetails=false"><i class="bi bi-x-circle" style="font-size:18px;"></i><span style="font-size:9px;">Cancel</span></div>
                    <div class="form-row" style="margin:0; margin-left:8px;">
                        <span class="tb-label">Task Date</span>
                        <DxDateEdit @bind-Date="tsTaskDate" style="width:120px;" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(tsValidationMessage))
                {
                    <div class="validation-msg">@tsValidationMessage</div>
                }

                <div class="form-frame">
                    <div class="chk-row">
                        <DxCheckBox @bind-Checked="tsOccupied" Text="Occupied" />
                        <DxCheckBox @bind-Checked="tsVacant" Text="Vacant" />
                        <DxCheckBox @bind-Checked="tsClean" Text="Clean" />
                        <DxCheckBox @bind-Checked="tsDirty" Text="Dirty" />
                        <DxCheckBox @bind-Checked="tsOutOfOrder" Text="Out Of Order" />
                        <DxCheckBox @bind-Checked="tsOutOfService" Text="Out Of Service" />
                        <DxCheckBox @bind-Checked="tsInspected" Text="Inspected" />
                        <DxCheckBox @bind-Checked="tsPickup" Text="Pickup" />
                    </div>
                </div>

                <fieldset class="form-frame" style="position:relative;">
                    <legend class="form-legend">Task Assignment Values</legend>
                    <div class="form-row">
                        <span class="form-label">Attendants</span>
                        <div style="flex:1; display:flex;">
                            <input type="text" class="form-control" style="flex:1; font-size:12px;" value="@selectedAttendantText" readonly />
                            <button class="btn btn-outline-secondary" style="border-radius:0;" @onclick="()=>showAttendantDropdown=!showAttendantDropdown"><i class="bi bi-chevron-down"></i></button>
                        </div>
                    </div>
                    @if (showAttendantDropdown)
                    {
                        <div style="border:1px solid #bbb; background:white; position:absolute; left:90px; right:10px; top:60px; z-index:10; box-shadow:0 4px 8px rgba(0,0,0,0.15);">
                            <div style="background:#0078d7; color:white; padding:4px 8px; font-size:11px;">
                                <DxCheckBox @bind-Checked="selectAllAttendants" Text="(Select All)" TextCssClass="text-white" />
                            </div>
                            @foreach (var a in attendants)
                            {
                                <div style="padding:4px 8px; border-bottom:1px solid #eee;">
