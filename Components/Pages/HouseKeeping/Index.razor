    void LoadDiscrepancyData()
    {
        discrepancyData = new List<DiscrepancyRecord>
        {
            new() { RoomNumber = "201", RoomType = "Standard Room", RoomStatus = "Dirty", HouseKeepingStatus = "Occupied", FoStatus = "Occupied", ResStatus = "Stay Over", FoPerson = 2, HkPerson = 2, Discrepancy = "" },
            new() { RoomNumber = "305", RoomType = "Executive", RoomStatus = "Clean", HouseKeepingStatus = "Vacant", FoStatus = "Occupied", ResStatus = "Due Out", FoPerson = 1, HkPerson = 0, Discrepancy = "Skip" },
            new() { RoomNumber = "104", RoomType = "Standard Room", RoomStatus = "Dirty", HouseKeepingStatus = "Occupied", FoStatus = "Vacant", ResStatus = "Stay Over", FoPerson = 2, HkPerson = 3, Discrepancy = "Sleep/Person" },
            new() { RoomNumber = "302", RoomType = "Executive", RoomStatus = "Clean", HouseKeepingStatus = "Vacant", FoStatus = "Occupied", ResStatus = "Arrived", FoPerson = 1, HkPerson = 1, Discrepancy = "Skip" },
            new() { RoomNumber = "205", RoomType = "Standard Room", RoomStatus = "Inspected", HouseKeepingStatus = "Occupied", FoStatus = "Vacant", ResStatus = "Stay Over", FoPerson = 2, HkPerson = 2, Discrepancy = "Sleep" }
        };
    }

    List<DiscrepancyRecord> FilterDiscrepancy()
    {
        var query = discrepancyData.AsEnumerable();

        if (discSleeps)
            query = query.Where(x => x.Discrepancy.Contains("Sleep"));
        if (discSkips)
            query = query.Where(x => x.Discrepancy.Contains("Skip") && !x.Discrepancy.Contains("Sleep"));
        if (discPerson)
            query = query.Where(x => x.Discrepancy.Contains("Person"));
        if (discSleepPerson)
            query = query.Where(x => x.Discrepancy == "Sleep/Person");
        if (discSkipPerson)
            query = query.Where(x => x.Discrepancy == "Skip/Person");
        if (discDueOut)
            query = query.Where(x => x.ResStatus == "Due Out");

        if (!string.IsNullOrWhiteSpace(discFloor))
            query = query.Where(x => x.RoomNumber.StartsWith(discFloor switch { "Floor - 1" => "1", "Floor - 3" => "3", _ => x.RoomNumber }));
        if (!string.IsNullOrWhiteSpace(discRoom))
            query = query.Where(x => x.RoomNumber == discRoom);
        if (!string.IsNullOrWhiteSpace(discRoomType))
            query = query.Where(x => x.RoomType == discRoomType);

        return query.ToList();
    }

    void ClearDiscrepancyFilters()
    {
        discSleeps = discSkips = discPerson = discSleepPerson = discSkipPerson = discDueOut = false;
        discFloor = discRoom = discRoomType = null;
    }

    void ShowNewDiscrepancy()
    {
        showNewDiscrepancy = true;
        newDiscValidation = "";
        newDiscRoom = null;
        newDiscRoomType = null;
        newDiscRoomStatus = null;
        newDiscFoStatus = null;
        newDiscHkStatus = null;
        newDiscResStatus = null;
        newDiscFoPerson = null;
        newDiscHkPerson = 0;
        newDiscRemark = "";
        newDiscText = "";
    }

    void SaveNewDiscrepancy()
    {
        newDiscValidation = "";

        // FIX 3: Validation
        if (string.IsNullOrWhiteSpace(newDiscRoom))
            newDiscValidation = "Room is required.";
        else if (string.IsNullOrWhiteSpace(newDiscRoomStatus))
            newDiscValidation = "Room Status is required.";
        else if (string.IsNullOrWhiteSpace(newDiscFoStatus))
            newDiscValidation = "FO Status is required.";
        else if (string.IsNullOrWhiteSpace(newDiscHkStatus))
            newDiscValidation = "HK Status is required.";

        if (!string.IsNullOrEmpty(newDiscValidation))
            return;

        // FIX 3: Actually add to list
        var disc = new DiscrepancyRecord
        {
            RoomNumber = newDiscRoom,
            RoomType = newDiscRoomType ?? "Standard Room",
            RoomStatus = newDiscRoomStatus,
            HouseKeepingStatus = newDiscHkStatus,
            FoStatus = newDiscFoStatus,
            ResStatus = newDiscResStatus ?? "Not Reserved",
            FoPerson = int.TryParse(newDiscFoPerson, out var fp) ? fp : 0,
            HkPerson = newDiscHkPerson,
            Discrepancy = newDiscText ?? ""
        };

        // Auto-calculate discrepancy type if not provided
        if (string.IsNullOrWhiteSpace(disc.Discrepancy))
        {
            if (disc.HouseKeepingStatus == "Occupied" && disc.FoStatus == "Vacant")
                disc.Discrepancy = "Sleep";
            else if (disc.HouseKeepingStatus == "Vacant" && disc.FoStatus == "Occupied")
                disc.Discrepancy = "Skip";
            else if (disc.FoPerson != disc.HkPerson)
                disc.Discrepancy = "Person";
        }

        discrepancyData.Add(disc);
        showNewDiscrepancy = false;

        infoMessage = "Discrepancy saved successfully.";
        infoIconClass = "bi-info-circle";
        showInfoPopup = true;
    }

