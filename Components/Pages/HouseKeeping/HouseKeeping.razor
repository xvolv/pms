@page "/housekeeping"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ERP.V7.WebPMS.Components.Pages.HouseKeeping.Models
@using ERP.V7.WebPMS.Components.Pages.HouseKeeping.Panels
@inject NavigationManager NavigationManager

<PageTitle>House Keeping</PageTitle>

<div class="dashboard-wrapper">
    <div class="top-tab-header">
        <div class="tab-item active" style="position: relative; padding-right: 2.5rem;">
            House Keeping
            <i class="bi bi-x fs-4" @onclick="ClosePage"
               style="position: absolute; top: -6px; right: 3px; cursor: pointer;"></i>
        </div>
    </div>

    <div class="dashboard-content">
        <DxTabs ActiveTabIndex="@activeTabIndex" ActiveTabIndexChanged="@OnTabChanged" CssClass="hk-tabs">
            <DxTabPage Text="Task Assignment" />
            <DxTabPage Text="Room Management" />
            <DxTabPage Text="Discrepancy" />
            <DxTabPage Text="Turndown Management" />

        </DxTabs>

        @switch (activeTabIndex)
        {
            case 0:
                <PermissionGate Category="House Keeping" Permission="Task Assignment">
                    <TaskAssignmentPanel State="@state" OnChanged="Refresh" />
                </PermissionGate>
                break;
            case 1:
                <PermissionGate Category="House Keeping" Permission="Room Management">
                    <RoomManagementPanel State="@state" OnChanged="Refresh" />
                </PermissionGate>
                break;
            case 2:
                <PermissionGate Category="House Keeping" Permission="Discrepancy">
                    <DiscrepancyPanel State="@state" OnChanged="Refresh" />
                </PermissionGate>
                break;
            case 3:
                <PermissionGate Category="House Keeping" Permission="Turndown Management">
                    <TurndownPanel State="@state" OnChanged="Refresh" />
                </PermissionGate>
                break;
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public int? Tab { get; set; }

    private HouseKeepingState state = HouseKeepingState.CreateSample();
    private int activeTabIndex;

    protected override void OnParametersSet()
    {
        activeTabIndex = Tab is >= 0 and <= 3 ? Tab.Value : 0;
    }

    private void OnTabChanged(int newIndex)
    {
        activeTabIndex = newIndex;
        NavigationManager.NavigateTo($"/housekeeping?tab={newIndex}", replace: true);
    }

    private void Refresh() => StateHasChanged();

    private void ClosePage() => NavigationManager.NavigateTo("/");
}
