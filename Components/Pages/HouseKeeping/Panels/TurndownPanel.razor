@using ERP.V7.WebPMS.Components.Pages.HouseKeeping.Models
@using ERP.V7.WebPMS.Components.Pages.HouseKeeping.Dialogs

<div class="rt-toolbar hk-toolbar">
    <button type="button" class="rt-toolbar-btn" @onclick="Save">
        <i class="bi bi-save text-secondary"></i>
        <span>Save</span>
    </button>
    <button type="button" class="rt-toolbar-btn" @onclick="Refresh">
        <i class="bi bi-arrow-clockwise text-secondary"></i>
        <span>Refresh</span>
    </button>
    <button type="button" class="rt-toolbar-btn" @onclick="() => showPrintPreview = true">
        <i class="bi bi-printer text-secondary"></i>
        <span>Print</span>
    </button>
    <button type="button" class="rt-toolbar-btn" @onclick="ClearFilters">
        <i class="bi bi-x-circle text-secondary"></i>
        <span>Cancel</span>
    </button>
    <div class="hk-toolbar-sep"></div>
    <div class="hk-chk-box">
        <div class="hk-chk-box-title">Filter By</div>

        <div class="hk-chk-grid">
            @* savethis *@

            <DxCheckBox @bind-Checked="required">Required</DxCheckBox>
            <DxCheckBox @bind-Checked="notRequired">Not Required</DxCheckBox>
            <DxCheckBox @bind-Checked="arrivals">Arrivals</DxCheckBox>
            <DxCheckBox @bind-Checked="arrived">Arrived</DxCheckBox>
            <DxCheckBox @bind-Checked="stayOver">Stay Over</DxCheckBox>
        </div>
    </div>
    <div class="hk-toolbar-sep"></div>
    <div class="hk-toolbar-filters hk-filter-box">
        <span class="tb-label">From Room</span>
        <DxComboBox Data="@State.RoomList" @bind-Value="fromRoom" CssClass="rt-detail-input" style="width:90px;" />
        <span class="tb-label">To Room</span>
        <DxComboBox Data="@State.RoomList" @bind-Value="toRoom" CssClass="rt-detail-input" style="width:90px;" />
        <span class="tb-label">Room Type</span>
        <DxComboBox Data="@State.RoomTypes" @bind-Value="roomType" CssClass="rt-detail-input" style="width:120px;" />
        <span class="tb-label">Date</span>
        <DxDateEdit @bind-Date="date" CssClass="rt-detail-input" style="width:140px;" />
    </div>
</div>

<div class="na-step-card">
    <div class="rt-grid-area" @onclick:stopPropagation="true">
        @if (FilteredTurndowns.Count == 0)
        {
            <div class="rt-placeholder">No records to display.</div>
        }
        else
        {
            <DxGrid Data="@FilteredTurndowns" KeyFieldName="Id" CssClass="rt-grid">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(TurndownRow.Room)" Caption="Room" Width="12%" />
                    <DxGridDataColumn FieldName="@nameof(TurndownRow.RoomType)" Caption="Room Type" Width="16%" />
                    <DxGridDataColumn FieldName="@nameof(TurndownRow.HouseKeepingStatus)" Caption="HouseKeeping Status"
                                      Width="16%" />
                    <DxGridDataColumn FieldName="@nameof(TurndownRow.Name)" Caption="Name" Width="18%" />
                    <DxGridDataColumn FieldName="@nameof(TurndownRow.ResStatus)" Caption="Res. Status" Width="16%" />
                    <DxGridDataColumn FieldName="@nameof(TurndownRow.TurndownStatus)" Caption="Turndown Status" Width="22%">
                        <CellDisplayTemplate>
                            @{
                                var row = (TurndownRow)context.DataItem;
                            }
                            <DxComboBox Data="@State.TurndownStatuses" @bind-Value="row.TurndownStatus"
                                        CssClass="rt-detail-input" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>

            <div class="rt-footer">@FilteredTurndowns.Count record(s)</div>
        }
    </div>
</div>

<PrintPreviewDialog Visible="@showPrintPreview" Assignment="@State.TaskAssignments.LastOrDefault()"
                    OnClose="() => showPrintPreview = false" />

<InfoDialog Visible="@showInfoPopup" Title="Information" Message="Turndown data saved successfully."
            OnOk="() => showInfoPopup = false" />

@code {
    [Parameter] public HouseKeepingState State { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool required, notRequired, arrivals, arrived, stayOver;
    private string? fromRoom, toRoom, roomType;
    private DateTime date = DateTime.Today;
    private bool showPrintPreview;
    private bool showInfoPopup;

    private List<TurndownRow> FilteredTurndowns
    {
        get
        {
            var query = State.Turndowns.AsEnumerable();

            if (required && !notRequired)
                query = query.Where(x => x.TurndownStatus == "Required");
            else if (!required && notRequired)
                query = query.Where(x => x.TurndownStatus == "Not Required");

            if (arrivals)
                query = query.Where(x => x.ResStatus == "Arrival");
            if (arrived)
                query = query.Where(x => x.ResStatus == "Arrived");
            if (stayOver)
                query = query.Where(x => x.ResStatus == "Stay Over");

            if (!string.IsNullOrWhiteSpace(fromRoom))
                query = query.Where(x => string.Compare(x.Room, fromRoom) >= 0);
            if (!string.IsNullOrWhiteSpace(toRoom))
                query = query.Where(x => string.Compare(x.Room, toRoom) <= 0);
            if (!string.IsNullOrWhiteSpace(roomType))
                query = query.Where(x => x.RoomType == roomType);

            return query.ToList();
        }
    }

    private void Save()
    {
        showInfoPopup = true;
    }

    private async Task Refresh() => await OnChanged.InvokeAsync();

    private async Task ClearFilters()
    {
        required = notRequired = arrivals = arrived = stayOver = false;
        fromRoom = toRoom = roomType = null;
        await OnChanged.InvokeAsync();
    }
}
