@using DevExpress.Blazor

<div class="transactions-tab">
    <DxTabs @bind-ActiveTabIndex="ActiveTxTab" CssClass="db-sub-tabs">
        <DxTabPage Text="Cash Receipt">
            <Transactions Title="Cash Receipt" TransactionType="CashReceipt" />
        </DxTabPage>
        <DxTabPage Text="Credit Sales">
            <Transactions Title="Credit Sales" TransactionType="CreditSales" />
        </DxTabPage>
        <DxTabPage Text="Cash Sales">
            <Transactions Title="Cash Sales" TransactionType="CashSales" />
        </DxTabPage>
        <DxTabPage Text="Rebate">
            <Transactions Title="Rebate" TransactionType="Rebate" />
        </DxTabPage>
        <DxTabPage Text="Debit Note">
            <Transactions Title="Debit Note" TransactionType="DebitNote" />
        </DxTabPage>
        <DxTabPage Text="Paid Out">
            <Transactions Title="Paid Out" TransactionType="PaidOut" />
        </DxTabPage>
        <DxTabPage Text="Refund">
            <Transactions Title="Refund" TransactionType="Refund" />
        </DxTabPage>
        <DxTabPage Text="Daily Room Charge">
            <Transactions Title="Daily Room Charge" TransactionType="DailyRoomCharge" />
        </DxTabPage>
        <DxTabPage Text="Cash Sales Summary">
            <Transactions Title="Cash Sales Summary" TransactionType="CashSalesSummary" />
        </DxTabPage>
        <DxTabPage Text="Event Requirement">
            <Transactions Title="Event Requirement" TransactionType="EventRequirement" />
        </DxTabPage>
        <DxTabPage Text="Service Request">
            <Transactions Title="Service Request" TransactionType="ServiceRequest" />
        </DxTabPage>
        <DxTabPage Text="Lost and Found">
            <Transactions Title="Lost and Found" TransactionType="LostAndFound" />
        </DxTabPage>
        <DxTabPage Text="Daily Resident Summary">
            <Transactions Title="Daily Resident Summary" TransactionType="DailyResidentSummary" />
        </DxTabPage>
        <DxTabPage Text="Check Out">
            <Transactions Title="Check Out" TransactionType="CheckOut" />
        </DxTabPage>
        <DxTabPage Text="Package Consumption">
            <Transactions Title="Package Consumption" TransactionType="PackageConsumption" />
        </DxTabPage>
        <DxTabPage Text="Log Book">
            <Transactions Title="Log Book" TransactionType="LogBook" />
        </DxTabPage>
    </DxTabs>
</div>

@code {
    int ActiveTxTab = 0; // Cash Receipt as default
}