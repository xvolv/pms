@using DevExpress.Blazor
@using ERP.V7.WebPMS.Services.DocumentBrowser
@using CNET_V7_Domain.Domain.SettingSchema
@using CNET_V7_Domain.Domain.ViewSchema
@using System.Text
@inject IDocumentBrowserService DocumentBrowserService
@inject IJSRuntime JSRuntime

<div class="db-pr-container">

    <!-- ===================== FILTER BAR ===================== -->
    <div class="db-pr-filter-bar">
        <div class="db-pr-toolbar-row">
            <button class="db-pr-toolbar-btn" type="button" title="Show" @onclick="() => LoadDataAsync(true)" disabled="@IsLoading">
                <i class="bi bi-eye"></i>
                <span>Show</span>
            </button>
            <button class="db-pr-toolbar-btn" type="button" title="Export" @onclick="OnExport" disabled="@(FilteredData.Count == 0 || IsLoading)">
                <i class="bi bi-file-earmark-arrow-down"></i>
                <span>Export</span>
            </button>
            <button class="db-pr-toolbar-btn" type="button" title="Print" @onclick="OnPrint" disabled="@(FilteredData.Count == 0 || IsLoading)">
                <i class="bi bi-printer"></i>
                <span>Print</span>
            </button>

            <!-- Search By -->
            <div class="db-pr-search-by-col">
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Search By</label>
                    <div class="lookup-field db-pr-w-150">
                        <DxTextBox @bind-Text="SearchBy" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="Search By" />
                        <button type="button" class="lookup-toggle-btn" @onclick="ToggleSearchByPopup">▾</button>
                    </div>

                    @if (ShowSearchByPopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input"
                                           @bind="SearchByPopupFilter" @bind:event="oninput" placeholder="Search..." />
                                    <button type="button" class="db-pr-dropdown-find-btn"
                                            @onclick="@(() => { })">Find</button>
                                </div>
                                <div class="db-pr-dropdown-list">
                                    <div class="db-pr-dropdown-list-header">Search By</div>
                                    @foreach (var item in SearchByListItems.Where(MatchesFilter(SearchByPopupFilter)))
                                    {
                                        <div class="db-pr-dropdown-list-item @(SearchBy == item ? "db-pr-selected" : "")"
                                             @onclick="() => SelectSearchBy(item)">
                                            @item
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn"
                                        @onclick="@(() => SearchByPopupFilter = string.Empty)">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowSearchByPopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(SearchBy) && SearchBy != "Show Filter Panel")
                {
                    <div class="db-pr-filter-row">
                        <label>@SearchBy</label>
                        <DxTextBox @bind-Text="SearchByValue" CssClass="w-100" />
                    </div>
                }
            </div>
        </div>

        <!-- Filter fields -->
        <div class="db-pr-filter-fields">
            <div class="db-pr-filter-col">
                <div class="db-pr-filter-row">
                    <label>Voucher Code</label>
                    <DxTextBox NullText="Voucher Code" @bind-Text="VoucherCode" CssClass="w-100" />
                </div>

                <!-- Consignee -->
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Consignee</label>
                    <div class="lookup-field db-pr-w-150">
                        <DxTextBox @bind-Text="ConsigneeDisplay" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn" @onclick="ToggleConsigneePopup">▾</button>
                    </div>

                    @if (ShowConsigneePopup)
                    {
                        <div class="db-pr-dropdown-popup db-pr-dropdown-popup-wide">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input"
                                           @bind="ConsigneePopupFilter" @bind:event="oninput" placeholder="Search consignee..." />
                                    <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                </div>
                                <table class="db-pr-dropdown-table">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!FilteredConsigneeList.Any())
                                        {
                                            <tr><td colspan="2" class="db-pr-text-muted">No records</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in FilteredConsigneeList)
                                            {
                                                <tr @onclick="() => SelectConsignee(row)">
                                                    <td>@row.Code</td>
                                                    <td>@row.FullName</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn" @onclick="ClearConsignee">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowConsigneePopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>

                <!-- Object State -->
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Object State</label>
                    <div class="lookup-field db-pr-w-130">
                        <DxTextBox Text="@ObjectStateDisplay" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn" @onclick="ToggleObjectStatePopup">▾</button>
                    </div>

                    @if (ShowObjectStatePopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <label class="db-pr-dropdown-checkbox-item db-pr-select-all">
                                    <input type="checkbox" checked="@IsAllObjectStatesSelected"
                                           @onchange="ToggleSelectAllObjectStates" />
                                    <span>(Select All)</span>
                                </label>
                                @foreach (var item in ObjectStateList)
                                {
                                    <label class="db-pr-dropdown-checkbox-item">
                                        <input type="checkbox"
                                               checked="@PendingObjectStateIds.Contains(item.Id)"
                                               @onchange="e => ToggleObjectState(item.Id, (bool)(e.Value ?? false))" />
                                        <span>@item.Description</span>
                                    </label>
                                }
                            </div>
                            <div class="db-pr-checkbox-popup-footer">
                                <button type="button" class="db-pr-dropdown-ok-btn" @onclick="ApplyObjectStateSelection">OK</button>
                                <button type="button" class="db-pr-dropdown-cancel-btn"
                                        @onclick="() => ShowObjectStatePopup = false">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="db-pr-filter-col">
                <!-- Consignee Unit -->
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Consignee Unit</label>
                    <div class="lookup-field db-pr-w-150">
                        <DxTextBox @bind-Text="ConsigneeUnit" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn" @onclick="ToggleConsigneeUnitPopup">▾</button>
                    </div>

                    @if (ShowConsigneeUnitPopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input"
                                           @bind="ConsigneeUnitPopupFilter" @bind:event="oninput" placeholder="Search..." />
                                    <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                </div>
                                <div class="db-pr-dropdown-list">
                                    <div class="db-pr-dropdown-list-header">Consignee Unit</div>
                                    @foreach (var item in ConsigneeUnitListItems.Where(MatchesFilter(ConsigneeUnitPopupFilter)))
                                    {
                                        <div class="db-pr-dropdown-list-item @(ConsigneeUnit == item ? "db-pr-selected" : "")"
                                             @onclick="() => SelectConsigneeUnit(item)">
                                            @item
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn"
                                        @onclick="@(() => ConsigneeUnitPopupFilter = string.Empty)">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowConsigneeUnitPopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>

                <!-- Device -->
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Device</label>
                    <div class="lookup-field db-pr-w-150">
                        <DxTextBox @bind-Text="Device" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn" @onclick="ToggleDevicePopup">▾</button>
                    </div>

                    @if (ShowDevicePopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input"
                                           @bind="DevicePopupFilter" @bind:event="oninput" placeholder="Search..." />
                                    <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                </div>
                                <div class="db-pr-dropdown-list">
                                    <div class="db-pr-dropdown-list-header">Device</div>
                                    @foreach (var item in DeviceListItems.Where(MatchesFilter(DevicePopupFilter)))
                                    {
                                        <div class="db-pr-dropdown-list-item @(Device == item ? "db-pr-selected" : "")"
                                             @onclick="() => SelectDevice(item)">
                                            @item
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn"
                                        @onclick="@(() => DevicePopupFilter = string.Empty)">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowDevicePopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>

                <!-- User -->
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>User</label>
                    <div class="lookup-field db-pr-w-150">
                        <DxTextBox @bind-Text="User" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn" @onclick="ToggleUserPopup">▾</button>
                    </div>

                    @if (ShowUserPopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input"
                                           @bind="UserPopupFilter" @bind:event="oninput" placeholder="Search..." />
                                    <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                </div>
                                <div class="db-pr-dropdown-list">
                                    <div class="db-pr-dropdown-list-header">User Name</div>
                                    @foreach (var item in UserListItems.Where(MatchesFilter(UserPopupFilter)))
                                    {
                                        <div class="db-pr-dropdown-list-item @(User == item ? "db-pr-selected" : "")"
                                             @onclick="() => SelectUser(item)">
                                            @item
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn"
                                        @onclick="@(() => UserPopupFilter = string.Empty)">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowUserPopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Date Criteria -->
            <div class="db-pr-filter-col">
                <div class="db-pr-filter-row">
                    <label>Date Criteria</label>
                    <DxComboBox NullText="Date Criteria"
                                Data="@DateCriteriaOptions"
                                Value="@DateCriteria"
                                ValueChanged="@((string val) => OnDateCriteriaChanged(val))"
                                CssClass="erp-combobox" />
                </div>

                @if (DateCriteria == "Daily")
                {
                    <div class="db-pr-filter-row">
                        <label>Current Date</label>
                        <DxDateEdit @bind-Date="CurrentDate" CssClass="db-pr-w-130" />
                    </div>
                }
                else if (DateCriteria == "At the day of")
                {
                    <div class="db-pr-filter-row">
                        <label>At the day of</label>
                        <DxDateEdit @bind-Date="AtTheDayOf" CssClass="db-pr-w-130" />
                    </div>
                }
                else if (DateCriteria is "Weekly" or "Monthly" or "Annually" or "Date Range")
                {
                    <div class="db-pr-filter-row">
                        <label>From</label>
                        <DxDateEdit @bind-Date="FromDate" CssClass="db-pr-w-130" ReadOnly="@(DateCriteria != "Date Range")" />
                    </div>
                    <div class="db-pr-filter-row">
                        <label>To</label>
                        <DxDateEdit @bind-Date="ToDate" CssClass="db-pr-w-130" ReadOnly="@(DateCriteria != "Date Range")" />
                    </div>
                }
                else if (DateCriteria is "Period Code" or "Period Range")
                {
                    <div class="db-pr-filter-row">
                        <label>Period</label>
                        <DxTextBox @bind-Text="PeriodCode" NullText="Period" CssClass="db-pr-w-130" />
                    </div>
                }
            </div>
        </div>

        <button class="db-pr-clear-btn" type="button" @onclick="ClearFilters">
            <i class="bi bi-arrow-repeat"></i>
            <span>Clear Search History</span>
        </button>
    </div>

    <!-- ===================== MAIN GRID + DETAIL ===================== -->
    <div class="db-pr-main-content">
        <div class="db-pr-grid-area position-relative">
            @if (IsLoading)
            {
                <LoadingSpinner Height="350px" Text="@($"Loading {Title} records...")" />
            }
            else
            {
                <DxGrid Data="@FilteredData"
                        KeyFieldName="Id"
                        ShowFilterRow="@(SearchBy == "Show Filter Panel")"
                        PageSize="20"
                        CssClass="db-pr-grid"
                        SelectionMode="GridSelectionMode.Single"
                        SelectedDataItem="@SelectedItem"
                        SelectedDataItemChanged="@(e => SelectedItem = (VwVoucherHeaderDTO?)e)">
                    <Columns>
                        <DxGridDataColumn FieldName="Code" Caption="@GetColumnCaption("Code", "Code")" Width="130" />
                        
                        @if (TransactionType != "CashSales")
                        {
                            <DxGridDataColumn FieldName="Consignee1FullName" Caption="@GetColumnCaption("Consignee1FullName", "Customer Name")" MinWidth="180" />
                            <DxGridDataColumn FieldName="Tin" Caption="@GetColumnCaption("Tin", "TIN")" Width="120" />
                            <DxGridDataColumn FieldName="IssuedDate" Caption="@GetColumnCaption("IssuedDate", "Issued Date")" Width="130" DisplayFormat="d" />
                            <DxGridDataColumn FieldName="Consignee2FullName" Caption="@GetColumnCaption("Consignee2FullName", "Origin Branch")" Width="150" />
                        }
                        else
                        {
                            <DxGridDataColumn FieldName="IssuedDate" Caption="@GetColumnCaption("IssuedDate", "Issued Date")" Width="130" DisplayFormat="d" />
                        }

                        <DxGridDataColumn FieldName="GrandTotal" Caption="@GetColumnCaption("GrandTotal", "Grand Total")" Width="130" DisplayFormat="n2" />
                        <DxGridDataColumn FieldName="LastUserUserName" Caption="@GetColumnCaption("LastUserUserName", "User Name")" Width="130" />
                        <DxGridDataColumn FieldName="MachineName" Caption="@GetColumnCaption("MachineName", "Device Name")" Width="140" />
                        <DxGridDataColumn FieldName="LastStateDescription" Caption="@GetColumnCaption("LastStateDescription", "Last State")" Width="120" />
                    </Columns>
                </DxGrid>
                <div class="db-pr-record-info">
                    Record @(FilteredData.Count == 0 ? 0 : (SelectedItemIndex >= 0 ? SelectedItemIndex + 1 : 1)) of @FilteredData.Count
                </div>
            }
        </div>

        <!-- Right detail panel -->
        <div class="db-pr-detail-panel @(IsDetailCollapsed ? "db-pr-collapsed" : "")">
            <div class="db-pr-detail-header">
                @if (!IsDetailCollapsed)
                {
                    <span class="db-pr-panel-title">@Title Detail</span>
                    <div class="db-pr-panel-actions" @onclick:stopPropagation="true">
                        <button type="button" title="Collapse" @onclick="() => IsDetailCollapsed = true">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                else
                {
                    <span class="db-pr-panel-title" @onclick="() => IsDetailCollapsed = false">
                        @Title Detail
                    </span>
                }
            </div>
            <div class="db-pr-detail-body">
                @if (SelectedItem != null)
                {
                    <p><strong>Code:</strong> @SelectedItem.Code</p>
                    @if (!string.IsNullOrEmpty(SelectedItem.Consignee1FullName))
                    {
                        <p><strong>Customer:</strong> @SelectedItem.Consignee1FullName</p>
                    }
                    <p><strong>Issued Date:</strong> @SelectedItem.IssuedDate.ToString("d")</p>
                    <p><strong>Grand Total:</strong> @SelectedItem.GrandTotal.ToString("n2")</p>
                    <p><strong>User:</strong> @SelectedItem.LastUserUserName</p>
                    <p><strong>Device:</strong> @SelectedItem.MachineName</p>
                    <p><strong>Last State:</strong> @SelectedItem.LastStateDescription</p>
                }
                else
                {
                    <span class="db-pr-text-muted">Select a record</span>
                }
            </div>
        </div>
    </div>

    <!-- ===================== LINE ITEM DETAIL ===================== -->
    <div class="db-pr-requested-services @(IsLineItemCollapsed ? "db-pr-collapsed" : "")">
        <div class="db-pr-rs-header" @onclick="() => IsLineItemCollapsed = !IsLineItemCollapsed">
            <span>Line Item Detail</span>
            <div class="db-pr-panel-actions" @onclick:stopPropagation="true">
                <button type="button" title="Pin"><i class="bi bi-pin-angle"></i></button>
                <button type="button" title="@(IsLineItemCollapsed ? "Expand" : "Collapse")"
                        @onclick="() => IsLineItemCollapsed = !IsLineItemCollapsed">
                    <i class="bi @(IsLineItemCollapsed ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>
        @if (!IsLineItemCollapsed)
        {
            <DxGrid Data="@LineItems" PageSize="5" CssClass="db-pr-grid-small">
                <Columns>
                    <DxGridDataColumn FieldName="ItemCode" Caption="Item Code" Width="110" />
                    <DxGridDataColumn FieldName="Description" Caption="Description" />
                    <DxGridDataColumn FieldName="Qty" Caption="Qty" Width="70" />
                    <DxGridDataColumn FieldName="UnitPrice" Caption="Unit Price" Width="100" DisplayFormat="n2" />
                    <DxGridDataColumn FieldName="LineTotal" Caption="Line Total" Width="100" DisplayFormat="n2" />
                </Columns>
            </DxGrid>
        }
    </div>

    <!-- ===================== REQUESTED SERVICES ===================== -->
    <div class="db-pr-requested-services @(IsServicesCollapsed ? "db-pr-collapsed" : "")">
        <div class="db-pr-rs-header" @onclick="() => IsServicesCollapsed = !IsServicesCollapsed">
            <span>Requested Services</span>
            <div class="db-pr-panel-actions" @onclick:stopPropagation="true">
                <button type="button" title="Pin"><i class="bi bi-pin-angle"></i></button>
                <button type="button" title="@(IsServicesCollapsed ? "Expand" : "Collapse")"
                        @onclick="() => IsServicesCollapsed = !IsServicesCollapsed">
                    <i class="bi @(IsServicesCollapsed ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>
        @if (!IsServicesCollapsed)
        {
            <DxGrid Data="@RequestedServices" PageSize="5" CssClass="db-pr-grid-small">
                <Columns>
                    <DxGridDataColumn FieldName="Service" Caption="Service" />
                    <DxGridDataColumn FieldName="TargetTime" Caption="Target Time" Width="140" />
                </Columns>
            </DxGrid>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Cash Receipt";
    [Parameter] public string TransactionType { get; set; } = "CashReceipt";
    [Parameter] public int DefinitionId { get; set; } = 197;

    int _lastLoadedDefinitionId = 0;

    // Live API Data
    List<VwVoucherHeaderDTO> Data = new();
    VwVoucherHeaderDTO? SelectedItem;
    List<FieldFormatDTO> ColumnFormats = new();
    List<SystemConstantDTO> ObjectStateList = new();
    List<VwConsigneeViewDTO> ConsigneeLookupList = new();
    List<LineItemModel> LineItems = new();
    List<RequestedServiceModel> RequestedServices = new();

    string GetColumnCaption(string fieldName, string defaultCaption)
    {
        if (ColumnFormats == null || ColumnFormats.Count == 0)
            return defaultCaption;

        var format = ColumnFormats.FirstOrDefault(f =>
            string.Equals(f.Caption, fieldName, StringComparison.OrdinalIgnoreCase));

        return !string.IsNullOrWhiteSpace(format?.Caption) ? format.Caption : defaultCaption;
    }

    bool IsLoading = true;
    DateTime? ServerTime = DateTime.Today;

    int SelectedItemIndex => SelectedItem != null ? FilteredData.IndexOf(SelectedItem) : -1;

    // Panels state
    bool IsDetailCollapsed = true;
    bool IsLineItemCollapsed = true;
    bool IsServicesCollapsed = true;

    // Filter values
    string? SearchBy = "Show Filter Panel";
    string? SearchByValue;
    string? VoucherCode;
    string? ConsigneeUnit;
    string? Device;
    string? User;
    string? PeriodCode;
    string? DateCriteria = "Show All";

    DateTime CurrentDate = DateTime.Today;
    DateTime AtTheDayOf = DateTime.Today;
    DateTime FromDate = DateTime.Today;
    DateTime ToDate = DateTime.Today;

    string[] DateCriteriaOptions = { "Show All", "Daily", "Weekly", "Monthly", "Annually", "At the day of", "Date Range", "Period Code", "Period Range", "None" };

    // Search By popup
    string[] SearchByListItems = { "Show Filter Panel", "Consignee", "Device", "User", "Consignee Unit", "Is Active" };
    bool ShowSearchByPopup;
    string SearchByPopupFilter = "";

    void ToggleSearchByPopup()
    {
        CloseAllPopups(except: nameof(ShowSearchByPopup));
        ShowSearchByPopup = !ShowSearchByPopup;
    }

    void SelectSearchBy(string item)
    {
        SearchBy = item;
        SearchByValue = string.Empty;
        ShowSearchByPopup = false;
    }

    // Consignee popup
    string? ConsigneeDisplay;
    bool ShowConsigneePopup;
    string ConsigneePopupFilter = "";

    IEnumerable<VwConsigneeViewDTO> FilteredConsigneeList =>
        ConsigneeLookupList.Where(c => string.IsNullOrEmpty(ConsigneePopupFilter) ||
                                       (c.FullName != null && c.FullName.Contains(ConsigneePopupFilter, StringComparison.OrdinalIgnoreCase)) ||
                                       (c.Code != null && c.Code.Contains(ConsigneePopupFilter, StringComparison.OrdinalIgnoreCase)));

    void ToggleConsigneePopup()
    {
        CloseAllPopups(except: nameof(ShowConsigneePopup));
        ShowConsigneePopup = !ShowConsigneePopup;
    }

    void SelectConsignee(VwConsigneeViewDTO row)
    {
        ConsigneeDisplay = $"{row.Code} - {row.FullName}";
        ShowConsigneePopup = false;
    }

    void ClearConsignee()
    {
        ConsigneeDisplay = null;
        ConsigneePopupFilter = string.Empty;
    }

    // Object State popup
    HashSet<int> SelectedObjectStateIds = new();
    HashSet<int> PendingObjectStateIds = new();
    bool ShowObjectStatePopup;

    string ObjectStateDisplay
    {
        get
        {
            if (SelectedObjectStateIds.Count == 0) return "";
            var descriptions = ObjectStateList.Where(s => SelectedObjectStateIds.Contains(s.Id)).Select(s => s.Description).Where(d => !string.IsNullOrEmpty(d));
            return string.Join(", ", descriptions);
        }
    }

