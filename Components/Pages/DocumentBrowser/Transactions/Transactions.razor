    // Filtered In-Memory View
    List<VwVoucherHeaderDTO> FilteredData
    {
        get
        {
            var result = Data.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(ConsigneeDisplay))
            {
                var consigneeName = ConsigneeDisplay.Split('-').LastOrDefault()?.Trim() ?? ConsigneeDisplay;
                result = result.Where(r => r.Consignee1FullName != null && r.Consignee1FullName.Contains(consigneeName, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(Device))
            {
                result = result.Where(r => r.MachineName != null && r.MachineName.Equals(Device, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(User))
            {
                result = result.Where(r => r.LastUserUserName != null && r.LastUserUserName.Equals(User, StringComparison.OrdinalIgnoreCase));
            }

            if (SelectedObjectStateIds.Count > 0)
            {
                var selectedDescriptions = ObjectStateList.Where(s => SelectedObjectStateIds.Contains(s.Id)).Select(s => s.Description).ToHashSet(StringComparer.OrdinalIgnoreCase);
                result = result.Where(r => r.LastStateDescription != null && selectedDescriptions.Contains(r.LastStateDescription));
            }

            return result.ToList();
        }
    }

    // Date Criteria
    async Task OnDateCriteriaChanged(string newCriteria)
    {
        DateCriteria = newCriteria;
        IsLoading = true;
        StateHasChanged();
        await ApplyDateCriteriaDefaultsAsync();
        await LoadDataAsync();
    }

    async Task ApplyDateCriteriaDefaultsAsync()
    {
        ServerTime = await DocumentBrowserService.GetServerTimeAsync() ?? DateTime.Today;
        var now = ServerTime.Value;

        if (DateCriteria == "Daily")
        {
            CurrentDate = now;
            FromDate = now;
            ToDate = now;
        }
        else if (DateCriteria is "None" or "Show All")
        {
            // No bounds
        }
        else if (DateCriteria == "Weekly")
        {
            var diff = (7 + (now.DayOfWeek - DayOfWeek.Monday)) % 7;
            FromDate = now.AddDays(-1 * diff).Date;
            ToDate = now.Date;
        }
        else if (DateCriteria == "Monthly")
        {
            FromDate = new DateTime(now.Year, now.Month, 1);
            ToDate = now.Date;
        }
        else if (DateCriteria == "Annually")
        {
            FromDate = new DateTime(now.Year, 1, 1);
            ToDate = now.Date;
        }
        else if (DateCriteria == "At the day of")
        {
            AtTheDayOf = now.Date;
        }
        else if (DateCriteria == "Date Range")
        {
            FromDate = now.AddDays(-30).Date;
            ToDate = now.Date;
        }
    }

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        ResolveDefinitionId();
        _lastLoadedDefinitionId = DefinitionId;
        await LoadLookupsAsync();
        await ApplyDateCriteriaDefaultsAsync();
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ResolveDefinitionId();
        if (_lastLoadedDefinitionId != DefinitionId)
        {
            IsLoading = true;
            StateHasChanged();
            _lastLoadedDefinitionId = DefinitionId;
            await LoadLookupsAsync();
            await LoadDataAsync();
        }
    }

    void ResolveDefinitionId()
    {
        if (DefinitionId <= 0)
        {
            DefinitionId = TransactionType switch
            {
                "CashReceipt" => 197,
                "CreditSales" => 111,
                "CashSales" => 106,
                "Rebate" => 344,
                "DebitNote" => 194,
                "PaidOut" => 353,
                "Refund" => 121,
                "DailyRoomCharge" => 346,
                "CashSalesSummary" => 105,
                "EventRequirement" => 348,
                "ServiceRequest" => 355,
                "LostAndFound" => 350,
                "DailyResidentSummary" => 345,
                "CheckOut" => 343,
                "PackageConsumption" => 352,
                "LogBook" => 351,
                _ => 197
            };
        }
    }

    async Task LoadLookupsAsync()
    {
        try
        {
            var formatsTask = DocumentBrowserService.GetFieldFormatsAsync(DefinitionId);
            var objectStatesTask = DocumentBrowserService.GetObjectStatesAsync();
            var consigneesTask = DocumentBrowserService.GetConsigneeHeaderFormattedViewAsync(new ConsigneeFilterCriteria { GslType = 28 });

            await Task.WhenAll(formatsTask, objectStatesTask, consigneesTask);

            ColumnFormats = await formatsTask;
            ObjectStateList = await objectStatesTask;
            ConsigneeLookupList = await consigneesTask;
        }
        catch
        {
            // Handled gracefully
        }
    }

    // Load Data
    public async Task LoadDataAsync(bool forceRefresh = false)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var filter = new TransactionFilterCriteria
            {
                DefinitionId = DefinitionId,
                FieldFormatType = 1617,
                VoucherCode = VoucherCode
            };

            if (DateCriteria == "Daily")
            {
                filter.FromDate = CurrentDate;
                filter.ToDate = null;
            }
            else if (DateCriteria == "At the day of")
            {
                filter.FromDate = AtTheDayOf;
                filter.ToDate = null;
            }
            else if (DateCriteria is "Weekly" or "Monthly" or "Annually" or "Date Range")
            {
                filter.FromDate = FromDate;
                filter.ToDate = ToDate;
            }
            else if (DateCriteria is "Show All" or "None")
            {
                filter.FromDate = null;
                filter.ToDate = null;
            }

            var result = await DocumentBrowserService.GetVoucherHeaderFormattedViewAsync(filter, forceRefresh);
            Data = result ?? new List<VwVoucherHeaderDTO>();
            SelectedItem = Data.FirstOrDefault();
        }
        catch
        {
            Data = new List<VwVoucherHeaderDTO>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Export Data
    async Task OnExport()
    {
        var records = FilteredData.ToList();
        if (records.Count == 0) return;

        var sb = new StringBuilder();
        if (TransactionType == "CashSales")
        {
            sb.AppendLine("Code,Issued Date,Grand Total,User Name,Device Name,Last State");
            foreach (var r in records)
            {
                sb.AppendLine($"\"{r.Code}\",\"{r.IssuedDate:d}\",\"{r.GrandTotal:n2}\",\"{r.LastUserUserName}\",\"{r.MachineName}\",\"{r.LastStateDescription}\"");
            }
        }
        else
        {
            sb.AppendLine("Code,Customer Name,TIN,Issued Date,Origin Branch,Grand Total,User Name,Device Name,Last State");
            foreach (var r in records)
            {
                sb.AppendLine($"\"{r.Code}\",\"{r.Consignee1FullName}\",\"{r.Tin}\",\"{r.IssuedDate:d}\",\"{r.Consignee2FullName}\",\"{r.GrandTotal:n2}\",\"{r.LastUserUserName}\",\"{r.MachineName}\",\"{r.LastStateDescription}\"");
            }
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"{Title.Replace(" ", "_")}_Document_Browser_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            var link = document.createElement('a');
            link.download = '{filename}';
            link.href = 'data:text/csv;base64,{base64}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }

