@using DevExpress.Blazor

<div class="grid-with-detail">
    <!-- Filter bar – more fields like the screenshots -->
    <div class="db-filter-bar">
        <DxToolbar>
            <Items>
                <DxToolbarItem IconCssClass="oi oi-eye" Text="Show" />
                <DxToolbarItem IconCssClass="oi oi-data-transfer-download" Text="Export" />
                <DxToolbarItem IconCssClass="oi oi-print" Text="Print" />
            </Items>
        </DxToolbar>

        <div class="filter-fields">
            <DxComboBox NullText="Search By" Data="@SearchByOptions" @bind-Value="SearchBy" />
            <DxTextBox NullText="Voucher Code" @bind-Text="VoucherCode" />
            <DxComboBox NullText="Consignee" Data="@ConsigneeOptions" @bind-Value="Consignee" />
            <DxComboBox NullText="Object State" Data="@ObjectStateOptions" @bind-Value="ObjectState" />
            <DxComboBox NullText="Consignee Unit" Data="@ConsigneeUnitOptions" @bind-Value="ConsigneeUnit" />
            <DxComboBox NullText="Device" Data="@DeviceOptions" @bind-Value="Device" />
            <DxComboBox NullText="User" Data="@UserOptions" @bind-Value="User" />
            <DxComboBox NullText="Date Criteria" Data="@DateCriteriaOptions" @bind-Value="DateCriteria" />
            <DxDateEdit @bind-Date="CurrentDate" />
            <DxButton Text="Clear Search History" IconCssClass="oi oi-reload" Click="ClearFilters" />
        </div>
    </div>

    <div class="main-content">
        <div class="grid-area">
            <DxGrid Data="@Data" KeyFieldName="Code" CssClass="db-grid"
                    SelectionMode="GridSelectionMode.Single"
                    SelectedDataItem="@SelectedItem"
                    SelectedDataItemChanged="@(e => SelectedItem = (CashReceiptModel?)e)">
                <Columns>
        <DxGridDataColumn FieldName="Code" Caption="Code" Width="100" />
        <DxGridDataColumn FieldName="IssuedDate" Caption="Issued Date" Width="120" DisplayFormat="d" />
        <DxGridDataColumn FieldName="GrandTotal" Caption="Grand Total" Width="120" DisplayFormat="n2" />
        <DxGridDataColumn FieldName="UserName" Caption="User Name" Width="130" />
        <DxGridDataColumn FieldName="DeviceName" Caption="Device Name" Width="140" />
        <DxGridDataColumn FieldName="LastState" Caption="Last State" Width="120" />
    </Columns>
            </DxGrid>
            <div class="record-info">Record 0 of 0</div>
        </div>

        <div class="detail-panel">
            <div class="detail-header">@Title Detail</div>
            <div class="detail-body">…</div>
        </div>
    </div>

    <div class="line-item-detail">
        <div class="rs-header">Line Item Detail</div>
        <!-- another small DxGrid -->
    </div>
    <div class="requested-services">
        <div class="rs-header">Requested Services</div>
        <!-- small DxGrid -->
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Cash Receipt";

    // filter options from screenshots
    string[] SearchByOptions = { "Show Filter Panel", "From Store", "To Store", "Is Issued", "Is Void", "Grand Total", "Additional Charge", "Discount", "Sub Total", "VAT", "FS Number", "MRC Number", "Extension 1" };
    string[] ObjectStateOptions = { "(Select All)", "Approved", "Assigned", "Audited", "Checked", "Delivered", "Done" };
    string[] ConsigneeUnitOptions = { "MAIN TEST HOTEL" };
    string[] DeviceOptions = { "DESKTOP-JDV9NWL", "DESKTOP-DND1SE2", "DESKTOP-OP05VH4" };
    string[] UserOptions = { "CNET ADMIN" };
    string[] DateCriteriaOptions = { "Daily", "Weekly", "Monthly", "At the day of", "Annually", "Date Range", "Period Code", "Period Range", "None", "Show All" };
    string[] ConsigneeOptions = { "(Select All)" };

    List<CashReceiptModel> Data = new();
    CashReceiptModel? SelectedItem;

    // filter fields
    string? SearchBy, VoucherCode, Consignee, ObjectState, ConsigneeUnit, Device, User, DateCriteria = "Daily";
    DateTime CurrentDate = new DateTime(2026, 8, 24);

    void ClearFilters()
    {
        SearchBy = VoucherCode = Consignee = ObjectState = ConsigneeUnit = Device = User = null;
        DateCriteria = "Daily";
        CurrentDate = DateTime.Today;
    }

    public class CashReceiptModel
    {
        public string Code { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string TIN { get; set; } = "";
        public DateTime? IssuedDate { get; set; }
        public string OriginBranch { get; set; } = "";
        public decimal GrandTotal { get; set; }
        public string UserName { get; set; } = "";
        public string DeviceName { get; set; } = "";
        public string LastState { get; set; } = "";
    }
}