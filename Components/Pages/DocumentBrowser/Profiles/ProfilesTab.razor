@using DevExpress.Blazor

<div class="db-pr-tabs-wrapper">
    <DxTabs @bind-ActiveTabIndex="ActiveProfileTab" CssClass="db-pr-sub-tabs">
        <DxTabPage Text="Guest">
            <Profiles IsGuest="true" ProfileType="Guest" />
        </DxTabPage>
        <DxTabPage Text="Contact">
            <Profiles IsGuest="false" ProfileType="Contact" />
        </DxTabPage>
        <DxTabPage Text="Company">
            <Profiles IsGuest="false" ProfileType="Company" />
        </DxTabPage>
        <DxTabPage Text="Travel Agent">
            <Profiles IsGuest="false" ProfileType="TravelAgent" />
        </DxTabPage>
        <DxTabPage Text="Group">
            <Profiles IsGuest="false" ProfileType="Group" />
        </DxTabPage>
        <DxTabPage Text="Source">
            <Profiles IsGuest="false" ProfileType="Source" />
        </DxTabPage>
    </DxTabs>
</div>

@code {
    int ActiveProfileTab = 0;
}