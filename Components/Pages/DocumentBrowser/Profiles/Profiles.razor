@using DevExpress.Blazor
@using ERP.V7.WebPMS.Services.DocumentBrowser
@using CNET_V7_Domain.Domain.SettingSchema
@using CNET_V7_Domain.Domain.ViewSchema
@using System.Text
@inject IDocumentBrowserService DocumentBrowserService
@inject IJSRuntime JSRuntime

<div class="db-pr-container">
    <!-- Filter bar -->
    <div class="db-pr-filter-bar">
        <div class="db-pr-toolbar-row">
            <button class="db-pr-toolbar-btn" type="button" title="Show" @onclick="LoadDataAsync" disabled="@IsLoading">
                <i class="bi bi-eye"></i>
                <span>Show</span>
            </button>
            <button class="db-pr-toolbar-btn" type="button" title="Export" @onclick="ExportDataAsync" disabled="@(Data.Count == 0 || IsLoading)">
                <i class="bi bi-file-earmark-arrow-down"></i>
                <span>Export</span>
            </button>

            <div class="db-pr-search-by-col">
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Search By</label>
                    <div class="lookup-field db-pr-w-150">
                        <DxTextBox @bind-Text="SearchBy" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="Search By" />
                        <button type="button" class="lookup-toggle-btn"
                                @onclick="ToggleSearchByPopup">▾</button>
                    </div>
                    @if (ShowSearchByPopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input" @bind="SearchByPopupFilter" @bind:event="oninput" placeholder="Search..." />
                                    <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                </div>
                                <div class="db-pr-dropdown-list">
                                    <div class="db-pr-dropdown-list-header">Search By</div>
                                    @foreach (var item in SearchByListItems.Where(MatchesFilter(SearchByPopupFilter)))
                                    {
                                        <div class="db-pr-dropdown-list-item @(SearchBy == item ? "db-pr-selected" : "")"
                                             @onclick="() => SelectSearchBy(item)">
                                            @item
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn" @onclick="@(() => SearchByPopupFilter = string.Empty)">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowSearchByPopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>

                @if (SearchBy == "Business Type")
                {
                    <div class="db-pr-filter-row db-pr-dropdown-anchor">
                        <label>Business Type</label>
                        <div class="lookup-field db-pr-w-150">
                            <DxTextBox @bind-Text="BusinessType" ReadOnly="true" Width="100%"
                                       CssClass="erp-combobox lookup-input" NullText="" />
                            <button type="button" class="lookup-toggle-btn"
                                    @onclick="ToggleBusinessTypePopup">▾</button>
                        </div>
                        @if (ShowBusinessTypePopup)
                        {
                            <div class="db-pr-dropdown-popup">
                                <div class="db-pr-dropdown-body">
                                    <div class="db-pr-dropdown-search-row">
                                        <input class="db-pr-dropdown-search-input" @bind="BusinessTypePopupFilter" @bind:event="oninput" placeholder="Search..." />
                                        <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                    </div>
                                    <div class="db-pr-dropdown-list">
                                        <div class="db-pr-dropdown-list-header">Business Type</div>
                                        @foreach (var item in BusinessTypeListItems.Where(MatchesFilter(BusinessTypePopupFilter)))
                                        {
                                            <div class="db-pr-dropdown-list-item @(BusinessType == item ? "db-pr-selected" : "")"
                                                 @onclick="() => SelectBusinessType(item)">
                                                @item
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="db-pr-dropdown-clear-row">
                                    <button type="button" class="db-pr-dropdown-clear-btn" @onclick="@(() => BusinessTypePopupFilter = string.Empty)">Clear</button>
                                </div>
                                <div class="db-pr-dropdown-footer-bar">
                                    <i class="bi bi-x-lg" @onclick="() => ShowBusinessTypePopup = false"></i>
                                    <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (SearchBy == "Address")
                {
                    <div class="db-pr-filter-row db-pr-dropdown-anchor">
                        <label>Address</label>
                        <div class="lookup-field db-pr-w-150">
                            <DxTextBox @bind-Text="Address" ReadOnly="true" Width="100%"
                                       CssClass="erp-combobox lookup-input" NullText="" />
                            <button type="button" class="lookup-toggle-btn"
                                    @onclick="ToggleAddressPopup">▾</button>
                        </div>
                        @if (ShowAddressPopup)
                        {
                            <div class="db-pr-dropdown-popup">
                                <div class="db-pr-dropdown-body">
                                    <div class="db-pr-dropdown-search-row">
                                        <input class="db-pr-dropdown-search-input" @bind="AddressPopupFilter" @bind:event="oninput" placeholder="Search..." />
                                        <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                    </div>
                                    <div class="db-pr-dropdown-list">
                                        <div class="db-pr-dropdown-list-header">Address</div>
                                        @foreach (var item in AddressListItems.Where(MatchesFilter(AddressPopupFilter)))
                                        {
                                            <div class="db-pr-dropdown-list-item @(Address == item ? "db-pr-selected" : "")"
                                                 @onclick="() => SelectAddress(item)">
                                                @item
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="db-pr-dropdown-clear-row">
                                    <button type="button" class="db-pr-dropdown-clear-btn" @onclick="@(() => AddressPopupFilter = string.Empty)">Clear</button>
                                </div>
                                <div class="db-pr-dropdown-footer-bar">
                                    <i class="bi bi-x-lg" @onclick="() => ShowAddressPopup = false"></i>
                                    <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="db-pr-filter-row w-100">
                        <label>Text Edit</label>
                        <DxTextBox @bind-Text="AddressTextEditValue" CssClass="w-100" />
                    </div>
                }
                else if (SearchBy == "Tin")
                {
                    <div class="db-pr-filter-row w-100">
                        <label>TIN</label>
                        <DxTextBox @bind-Text="TinFilterValue" NullText="TIN" CssClass="w-100" />
                    </div>
                }
            </div>
        </div>

        <div class="db-pr-filter-fields">
            <div class="db-pr-filter-col">
                <div class="db-pr-filter-row">
                    <label>Consignee Code</label>
                    <DxTextBox NullText="Consignee Code" @bind-Text="ConsigneeCode" CssClass="w-100" />
                </div>
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Preference</label>
                    <div class="lookup-field db-pr-w-130">
                        <DxTextBox Text="@PreferenceDisplay" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn"
                                @onclick="TogglePreferencePopup">▾</button>
                    </div>
                    @if (ShowPreferencePopup)
                    {
                        <div class="db-pr-dropdown-popup db-pr-dropdown-popup-wide">
                            <div class="db-pr-dropdown-body">
                                <div class="db-pr-dropdown-search-row">
                                    <input class="db-pr-dropdown-search-input" @bind="PreferencePopupFilter" @bind:event="oninput" placeholder="Search preference..." />
                                    <button type="button" class="db-pr-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                                </div>
                                <table class="db-pr-dropdown-table">
                                    <thead>
                                        <tr>
                                            <th style="width:60px;">ID</th>
                                            <th>Description</th>
                                            <th style="width:80px;">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!FilteredPreferences.Any())
                                        {
                                            <tr>
                                                <td colspan="3" class="db-pr-text-muted">No records</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in FilteredPreferences)
                                            {
                                                <tr @onclick="() => SelectPreference(row)" class="@(SelectedPreferenceId == row.Id ? "db-pr-selected-tr" : "")">
                                                    <td>@row.Id</td>
                                                    <td>@row.Description</td>
                                                    <td>@row.Value</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="db-pr-dropdown-clear-row">
                                <button type="button" class="db-pr-dropdown-clear-btn" @onclick="ClearPreference">Clear</button>
                            </div>
                            <div class="db-pr-dropdown-footer-bar">
                                <i class="bi bi-x-lg" @onclick="() => ShowPreferencePopup = false"></i>
                                <i class="bi bi-grip-horizontal db-pr-dropdown-resize-handle"></i>
                            </div>
                        </div>
                    }
                </div>
                <div class="db-pr-filter-row db-pr-dropdown-anchor">
                    <label>Object State</label>
                    <div class="lookup-field db-pr-w-130">
                        <DxTextBox Text="@ObjectStateDisplay" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" NullText="" />
                        <button type="button" class="lookup-toggle-btn"
                                @onclick="ToggleObjectStatePopup">▾</button>
                    </div>
                    @if (ShowObjectStatePopup)
                    {
                        <div class="db-pr-dropdown-popup">
                            <div class="db-pr-dropdown-body">
                                <label class="db-pr-dropdown-checkbox-item db-pr-select-all">
                                    <input type="checkbox" checked="@IsAllObjectStatesSelected" @onchange="ToggleSelectAllObjectStates" />
                                    <span>(Select All)</span>
                                </label>
                                @foreach (var item in ObjectStateList)
                                {
                                    <label class="db-pr-dropdown-checkbox-item">
                                        <input type="checkbox" checked="@PendingObjectStateIds.Contains(item.Id)"
                                               @onchange="e => ToggleObjectState(item.Id, (bool)(e.Value ?? false))" />
                                        <span>@item.Description</span>
                                    </label>
                                }
                            </div>
                            <div class="db-pr-checkbox-popup-footer">
                                <button type="button" class="db-pr-dropdown-ok-btn" @onclick="ApplyObjectStateSelection">OK</button>
                                <button type="button" class="db-pr-dropdown-cancel-btn" @onclick="() => ShowObjectStatePopup = false">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="db-pr-filter-col">
                <div class="db-pr-filter-row">
                    <label>Date Criteria</label>
                    <DxComboBox NullText="Date Criteria" Data="@DateCriteriaOptions"
                                Value="@DateCriteria"
                                ValueChanged="@((string val) => OnDateCriteriaChanged(val))"
                                CssClass="erp-combobox" />
                </div>
                @if (DateCriteria == "Daily")
                {
                    <div class="db-pr-filter-row">
                        <label>Current Date</label>
                        <DxDateEdit @bind-Date="CurrentDate" CssClass="db-pr-w-130" />
                    </div>
                }
                else if (DateCriteria == "At the day of")
                {
                    <div class="db-pr-filter-row">
                        <label>At the day of</label>
                        <DxDateEdit @bind-Date="AtTheDayOf" CssClass="db-pr-w-130" />
                    </div>
                }
                else if (DateCriteria == "Weekly" || DateCriteria == "Monthly" || DateCriteria == "Annually" || DateCriteria == "Date Range")
                {
                    <div class="db-pr-filter-row">
                        <label>From</label>
                        <DxDateEdit @bind-Date="FromDate" CssClass="db-pr-w-130" ReadOnly="@(DateCriteria != "Date Range")" />
                    </div>
                    <div class="db-pr-filter-row">
                        <label>To</label>
                        <DxDateEdit @bind-Date="ToDate" CssClass="db-pr-w-130" ReadOnly="@(DateCriteria != "Date Range")" />
                    </div>
                }
                else if (DateCriteria == "Period Code" || DateCriteria == "Period Range")
                {
                    <div class="db-pr-filter-row">
                        <label>Period</label>
                        <DxTextBox @bind-Text="PeriodCode" NullText="Period" CssClass="db-pr-w-130" />
                    </div>
                }
            </div>
        </div>

        <button class="db-pr-clear-btn" type="button" @onclick="ClearFilters">
            <i class="bi bi-arrow-repeat"></i>
            <span>Clear Search History</span>
        </button>
    </div>

    <div class="db-pr-main-content">
        <div class="db-pr-grid-area position-relative">
            @if (IsLoading)
            {
                <LoadingSpinner Height="350px" Text="@($"Loading {ProfileType} records...")" />
            }
            else
            {
                <DxGrid Data="@FilteredData"
                        KeyFieldName="Id"
                        ShowFilterRow="@(SearchBy == "Show Filter Panel")"
                        PageSize="20"
                        CssClass="db-pr-grid"
                        SelectionMode="GridSelectionMode.Single"
                        SelectedDataItem="@SelectedItem"
                        SelectedDataItemChanged="@(e => SelectedItem = (VwConsigneeViewDTO?)e)">
                    <Columns>
                        <DxGridDataColumn FieldName="Code" Caption="Code" Width="120" />
                        <DxGridDataColumn FieldName="FullName" Caption="Full Name" Width="260" />
                        
                        @if (GslTypeId == 27 || GslTypeId == 30)
                        {
                            <!-- Guest & Contact columns -->
                            <DxGridDataColumn FieldName="StartDate" Caption="DOB" Width="110" DisplayFormat="d" />
                            <DxGridDataColumn FieldName="Nationality" Caption="Nationality" Width="130" />
                            <DxGridDataColumn FieldName="NationalId" Caption="National ID" Width="130" />
                            <DxGridDataColumn FieldName="GenderDescription" Caption="Gender" Width="90" />
                        }
                        else
                        {
                            <!-- Company, Agent, Group, Source columns -->
                            <DxGridDataColumn FieldName="Tin" Caption="TIN" Width="120" />
                            <DxGridDataColumn FieldName="BusinessTypeDesc" Caption="Business Type" Width="160" />
                        }
                        
                        <DxGridDataColumn FieldName="ChildPreferenceDescrption" Caption="Category" Width="130" />
                        <DxGridDataColumn FieldName="ObjectStateDescription" Caption="State" Width="110" />
                        <DxGridDataColumn FieldName="Phone1" Caption="Phone" Width="130" />
                        <DxGridDataColumn FieldName="City" Caption="City" Width="130" />
                    </Columns>
                </DxGrid>
                <div class="db-pr-record-info">
                    Record @(FilteredData.Count == 0 ? 0 : (SelectedItemIndex >= 0 ? SelectedItemIndex + 1 : 1)) of @FilteredData.Count
                </div>
            }
        </div>

        <!-- Right detail panel — collapsible, closed by default -->
        <div class="db-pr-detail-panel @(IsDetailCollapsed ? "db-pr-collapsed" : "")">
            <div class="db-pr-detail-header">
                @if (!IsDetailCollapsed)
                {
                    <span class="db-pr-panel-title">@GetDetailTitle()</span>
                    <div class="db-pr-panel-actions" @onclick:stopPropagation="true">
                        <button type="button" title="Collapse" @onclick="() => IsDetailCollapsed = true">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
                else
                {
                    <span class="db-pr-panel-title" @onclick="() => IsDetailCollapsed = false">@GetDetailTitle()</span>
                }
            </div>
            <div class="db-pr-detail-body">
                @if (SelectedItem != null)
                {
                    <p><strong>Code:</strong> @SelectedItem.Code</p>
                    <p><strong>Name:</strong> @SelectedItem.FullName</p>
                    
                    @if (GslTypeId == 27 || GslTypeId == 30)
                    {
                        <p><strong>DOB:</strong> @SelectedItem.StartDate?.ToString("d")</p>
                        <p><strong>Nationality:</strong> @SelectedItem.Nationality</p>
                        <p><strong>National ID:</strong> @SelectedItem.NationalId</p>
                        <p><strong>Gender:</strong> @SelectedItem.GenderDescription</p>
                    }
                    else
                    {
                        <p><strong>TIN:</strong> @SelectedItem.Tin</p>
                        <p><strong>Business Type:</strong> @SelectedItem.BusinessTypeDesc</p>
                    }
                    
                    <p><strong>Category:</strong> @SelectedItem.ChildPreferenceDescrption</p>
                    <p><strong>State:</strong> @SelectedItem.ObjectStateDescription</p>
                    <p><strong>Phone:</strong> @SelectedItem.Phone1</p>
                    <p><strong>City:</strong> @SelectedItem.City</p>
                }
                else
                {
                    <span class="db-pr-text-muted">Select a record</span>
                }
            </div>
        </div>
    </div>

    <!-- Bottom Requested Services — collapsible, closed by default -->
    <div class="db-pr-requested-services @(IsServicesCollapsed ? "db-pr-collapsed" : "")">
        <div class="db-pr-rs-header" @onclick="() => IsServicesCollapsed = !IsServicesCollapsed">
            <span>Requested Services</span>
            <div class="db-pr-panel-actions" @onclick:stopPropagation="true">
                <button type="button" title="Pin"><i class="bi bi-pin-angle"></i></button>
                <button type="button" title="@(IsServicesCollapsed ? "Expand" : "Collapse")"
                        @onclick="() => IsServicesCollapsed = !IsServicesCollapsed">
                    <i class="bi @(IsServicesCollapsed ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
        </div>
        @if (!IsServicesCollapsed)
        {
            <DxGrid Data="@RequestedServices" PageSize="5" CssClass="db-pr-grid-small">
                <Columns>
                    <DxGridDataColumn FieldName="Service" Caption="Service" />
                    <DxGridDataColumn FieldName="TargetTime" Caption="Target Time" Width="140" />
                </Columns>
            </DxGrid>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsGuest { get; set; } = true;
    [Parameter] public string ProfileType { get; set; } = "Guest"; // Guest, Contact, Company, TravelAgent, Group, Source
    [Parameter] public int GslTypeId { get; set; } = 27; // 27=Guest, 30=Contact, 28=Company, 31=Agent, 41=Group, 42=Source

    int _lastLoadedGslTypeId = 0;

    // Live API Data directly from CNET_V7_Domain
    List<VwConsigneeViewDTO> Data = new();
    VwConsigneeViewDTO? SelectedItem;
    List<FieldFormatDTO> ColumnFormats = new();
    List<PreferenceDTO> PreferenceList = new();
    List<SystemConstantDTO> ObjectStateList = new();
    List<RequestedServiceModel> RequestedServices = new();

    bool IsLoading = true;
    DateTime? ServerTime = DateTime.Today;

    int SelectedItemIndex => SelectedItem != null ? FilteredData.IndexOf(SelectedItem) : -1;

    // Both panels are closed by default
    bool IsDetailCollapsed = true;
    bool IsServicesCollapsed = true;

    string GetDetailTitle()
    {
        if (ProfileType == "Source")
        {
            return "Business source Detail";
        }
        return $"{ProfileType} Detail";
    }

    string? SearchBy = "Show Filter Panel";
    string? ConsigneeCode;
    string? PeriodCode;
    string? DateCriteria = "Show All";
    string? TinFilterValue;

    DateTime CurrentDate = DateTime.Today;
    DateTime AtTheDayOf = DateTime.Today;
    DateTime FromDate = DateTime.Today;
    DateTime ToDate = DateTime.Today;

    string[] DateCriteriaOptions = { "Show All", "Daily", "Weekly", "Monthly", "Annually", "At the day of", "Date Range", "Period Code", "Period Range", "None" };

    // ---- Search By popup ----
    string[] SearchByListItems = { "Show Filter Panel", "Business Type", "Tin", "Address", "Is Active" };
    bool ShowSearchByPopup;
    string SearchByPopupFilter = "";

    void ToggleSearchByPopup()
    {
        CloseAllPopups(except: nameof(ShowSearchByPopup));
        ShowSearchByPopup = !ShowSearchByPopup;
    }

    void SelectSearchBy(string item)
    {
        SearchBy = item;
        ShowSearchByPopup = false;
        if (item != "Business Type")
        {
            BusinessType = null;
        }
        if (item != "Address")
        {
            Address = null;
            AddressTextEditValue = string.Empty;
        }
        if (item != "Tin")
        {
            TinFilterValue = string.Empty;
        }
    }

    // ---- Business Type popup ----
    string[] BusinessTypeListItems = { "Domain Based", "Governmental", "Liablity Limited Company (LLC)", "None Governmental", "Private", "Private Limited Company (PLC)", "Share Company (S.C.)", "Sole Proprites" };
    string? BusinessType;
    bool ShowBusinessTypePopup;
    string BusinessTypePopupFilter = "";

    void ToggleBusinessTypePopup()
    {
        CloseAllPopups(except: nameof(ShowBusinessTypePopup));
        ShowBusinessTypePopup = !ShowBusinessTypePopup;
    }

    void SelectBusinessType(string item)
    {
        BusinessType = item;
        ShowBusinessTypePopup = false;
    }

    // ---- Address popup + Text Edit ----
    string[] AddressListItems = { "Phone", "Email" };
    string? Address;
    bool ShowAddressPopup;
    string AddressPopupFilter = "";
    string AddressTextEditValue = "";

    void ToggleAddressPopup()
    {
        CloseAllPopups(except: nameof(ShowAddressPopup));
        ShowAddressPopup = !ShowAddressPopup;
    }

    void SelectAddress(string item)
    {
        Address = item;
        ShowAddressPopup = false;
    }

    // ---- Preference popup ----
    int? SelectedPreferenceId;
    string PreferenceDisplay => PreferenceList.FirstOrDefault(p => p.Id == SelectedPreferenceId)?.Description ?? "";
    bool ShowPreferencePopup;
    string PreferencePopupFilter = "";

    IEnumerable<PreferenceDTO> FilteredPreferences =>
        PreferenceList.Where(p => string.IsNullOrEmpty(PreferencePopupFilter) ||
                                  (p.Description != null && p.Description.Contains(PreferencePopupFilter, StringComparison.OrdinalIgnoreCase)) ||
                                  p.Id.ToString().Contains(PreferencePopupFilter));

    void TogglePreferencePopup()
    {
        CloseAllPopups(except: nameof(ShowPreferencePopup));
        ShowPreferencePopup = !ShowPreferencePopup;
    }

    void SelectPreference(PreferenceDTO row)
    {
        SelectedPreferenceId = row.Id;
        ShowPreferencePopup = false;
    }

    void ClearPreference()
    {
        SelectedPreferenceId = null;
        PreferencePopupFilter = string.Empty;
    }

    // ---- Object State popup ----
    HashSet<int> SelectedObjectStateIds = new();
    HashSet<int> PendingObjectStateIds = new();
    bool ShowObjectStatePopup;

    string ObjectStateDisplay
    {
        get
        {
            if (SelectedObjectStateIds.Count == 0) return "";
            var descriptions = ObjectStateList.Where(s => SelectedObjectStateIds.Contains(s.Id)).Select(s => s.Description).Where(d => !string.IsNullOrEmpty(d));
            return string.Join(", ", descriptions);
        }
    }

    bool IsAllObjectStatesSelected => ObjectStateList.Count > 0 && PendingObjectStateIds.Count == ObjectStateList.Count;

    void ToggleObjectStatePopup()
    {
        if (!ShowObjectStatePopup)
        {
            PendingObjectStateIds = new HashSet<int>(SelectedObjectStateIds);
            CloseAllPopups(except: nameof(ShowObjectStatePopup));
        }
        ShowObjectStatePopup = !ShowObjectStatePopup;
    }

    void ToggleSelectAllObjectStates(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        PendingObjectStateIds = isChecked ? new HashSet<int>(ObjectStateList.Select(s => s.Id)) : new HashSet<int>();
    }

    void ToggleObjectState(int id, bool isChecked)
    {
        if (isChecked)
        {
            PendingObjectStateIds.Add(id);
        }
        else
        {
            PendingObjectStateIds.Remove(id);
        }
    }

    void ApplyObjectStateSelection()
    {
        SelectedObjectStateIds = new HashSet<int>(PendingObjectStateIds);
        ShowObjectStatePopup = false;
    }

    // ---- Filtered In-Memory View ----
    List<VwConsigneeViewDTO> FilteredData
    {
        get
        {
            var result = Data.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(BusinessType))
            {
                result = result.Where(r => r.BusinessTypeDesc != null && r.BusinessTypeDesc.Equals(BusinessType, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(TinFilterValue))
            {
                result = result.Where(r => r.Tin != null && r.Tin.Contains(TinFilterValue, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(AddressTextEditValue))
            {
                if (Address == "Phone")
                {
                    result = result.Where(r => r.Phone1 != null && r.Phone1.Contains(AddressTextEditValue, StringComparison.OrdinalIgnoreCase));
                }
            }

            if (SelectedObjectStateIds.Count > 0)
            {
                var selectedDescriptions = ObjectStateList.Where(s => SelectedObjectStateIds.Contains(s.Id)).Select(s => s.Description).ToHashSet(StringComparer.OrdinalIgnoreCase);
                result = result.Where(r => r.ObjectStateDescription != null && selectedDescriptions.Contains(r.ObjectStateDescription));
            }

            return result.ToList();
        }
    }

    // ---- Date Criteria Logic ----
    async Task OnDateCriteriaChanged(string newCriteria)
    {
        DateCriteria = newCriteria;
        IsLoading = true;
        StateHasChanged();
        await ApplyDateCriteriaDefaultsAsync();
        await LoadDataAsync();
    }

    async Task ApplyDateCriteriaDefaultsAsync()
    {
        ServerTime = await DocumentBrowserService.GetServerTimeAsync() ?? DateTime.Today;
        var now = ServerTime.Value;

        if (DateCriteria == "Daily")
        {
            CurrentDate = now;
            FromDate = now;
            ToDate = now;
        }
        else if (DateCriteria == "None" || DateCriteria == "Show All")
        {
            // No date bounds
        }
        else if (DateCriteria == "Weekly")
        {
            var diff = (7 + (now.DayOfWeek - DayOfWeek.Monday)) % 7;
            FromDate = now.AddDays(-1 * diff).Date;
            ToDate = now.Date;
        }
        else if (DateCriteria == "Monthly")
        {
            FromDate = new DateTime(now.Year, now.Month, 1);
            ToDate = now.Date;
        }
        else if (DateCriteria == "Annually")
        {
            FromDate = new DateTime(now.Year, 1, 1);
            ToDate = now.Date;
        }
        else if (DateCriteria == "At the day of")
        {
            AtTheDayOf = now.Date;
        }
        else if (DateCriteria == "Date Range")
        {
            FromDate = now.AddDays(-30).Date;
            ToDate = now.Date;
        }
    }

    // ---- Lifecycle ----
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        ResolveGslTypeId();
        _lastLoadedGslTypeId = GslTypeId;
        await LoadLookupsAsync();
        await ApplyDateCriteriaDefaultsAsync();
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ResolveGslTypeId();
        if (_lastLoadedGslTypeId != GslTypeId)
        {
            IsLoading = true;
            StateHasChanged();
            _lastLoadedGslTypeId = GslTypeId;
            await LoadLookupsAsync();
            await LoadDataAsync();
        }
    }

    void ResolveGslTypeId()
    {
        if (GslTypeId <= 0)
        {
            GslTypeId = ProfileType switch
            {
                "Guest" => 27,
                "Contact" => 30,
                "Company" => 28,
                "TravelAgent" => 31,
                "Agent" => 31,
                "Group" => 41,
                "Source" => 42,
                _ => 27
            };
        }
    }

    async Task LoadLookupsAsync()
    {
        try
        {
            var formatsTask = DocumentBrowserService.GetFieldFormatsAsync(GslTypeId);
            var preferencesTask = DocumentBrowserService.GetPreferencesAsync(GslTypeId);
            var objectStatesTask = DocumentBrowserService.GetObjectStatesAsync();

            await Task.WhenAll(formatsTask, preferencesTask, objectStatesTask);

            ColumnFormats = await formatsTask;
            PreferenceList = await preferencesTask;
            ObjectStateList = await objectStatesTask;
        }
        catch (Exception)
        {
            // Handled gracefully
        }
    }

    // ---- Fetch Data via API ----
    public async Task LoadDataAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var filter = new ConsigneeFilterCriteria
            {
                GslType = GslTypeId,
                FieldFormatType = 1617,
                ConsigneeCode = ConsigneeCode,
                ChildPreferenceId = SelectedPreferenceId,
                ObjectStateId = SelectedObjectStateIds.Count == 1 ? (int?)SelectedObjectStateIds.First() : null
            };

            if (DateCriteria == "Daily")
            {
                filter.FromDate = CurrentDate;
                filter.ToDate = CurrentDate;
            }
            else if (DateCriteria == "At the day of")
            {
                filter.FromDate = AtTheDayOf;
                filter.ToDate = AtTheDayOf;
            }
            else if (DateCriteria == "Weekly" || DateCriteria == "Monthly" || DateCriteria == "Annually" || DateCriteria == "Date Range")
            {
                filter.FromDate = FromDate;
                filter.ToDate = ToDate;
            }
            else if (DateCriteria == "Show All" || DateCriteria == "None")
            {
                filter.FromDate = null;
                filter.ToDate = null;
            }

            var result = await DocumentBrowserService.GetConsigneeHeaderFormattedViewAsync(filter);
            Data = result ?? new List<VwConsigneeViewDTO>();
            SelectedItem = Data.FirstOrDefault();
        }
        catch (Exception)
        {
            Data = new List<VwConsigneeViewDTO>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ---- Export Data ----
    async Task ExportDataAsync()
    {
        var records = FilteredData.ToList();
        if (records.Count == 0) return;

        var sb = new StringBuilder();
        if (GslTypeId == 27 || GslTypeId == 30)
        {
            sb.AppendLine("Code,Full Name,DOB,Nationality,National ID,Gender,Category,State,Phone,City");
            foreach (var r in records)
            {
                sb.AppendLine($"\"{r.Code}\",\"{r.FullName}\",\"{r.StartDate:d}\",\"{r.Nationality}\",\"{r.NationalId}\",\"{r.GenderDescription}\",\"{r.ChildPreferenceDescrption}\",\"{r.ObjectStateDescription}\",\"{r.Phone1}\",\"{r.City}\"");
            }
        }
        else
        {
            sb.AppendLine("Code,Full Name,TIN,Business Type,Category,State,Phone,City");
            foreach (var r in records)
            {
                sb.AppendLine($"\"{r.Code}\",\"{r.FullName}\",\"{r.Tin}\",\"{r.BusinessTypeDesc}\",\"{r.ChildPreferenceDescrption}\",\"{r.ObjectStateDescription}\",\"{r.Phone1}\",\"{r.City}\"");
            }
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"{ProfileType}_Document_Browser_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            var link = document.createElement('a');
            link.download = '{filename}';
            link.href = 'data:text/csv;base64,{base64}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }

    // ---- Reset / Clear ----
    async Task ClearFilters()
    {
        SearchBy = "Show Filter Panel";
        ConsigneeCode = null;
        SelectedPreferenceId = null;
        BusinessType = null;
        Address = null;
        AddressTextEditValue = string.Empty;
        TinFilterValue = string.Empty;
        SelectedObjectStateIds.Clear();
        PendingObjectStateIds.Clear();
        DateCriteria = "Show All";

        CloseAllPopups(except: "");
        await ApplyDateCriteriaDefaultsAsync();
        await LoadDataAsync();
    }

    void CloseAllPopups(string except)
    {
        if (except != nameof(ShowSearchByPopup)) ShowSearchByPopup = false;
        if (except != nameof(ShowBusinessTypePopup)) ShowBusinessTypePopup = false;
        if (except != nameof(ShowAddressPopup)) ShowAddressPopup = false;
        if (except != nameof(ShowPreferencePopup)) ShowPreferencePopup = false;
        if (except != nameof(ShowObjectStatePopup)) ShowObjectStatePopup = false;
    }

    Func<string, bool> MatchesFilter(string filterText) =>
        item => string.IsNullOrEmpty(filterText) || item.Contains(filterText, StringComparison.OrdinalIgnoreCase);

    public class RequestedServiceModel
    {
        public string Service { get; set; } = "";
        public string TargetTime { get; set; } = "";
    }
}

