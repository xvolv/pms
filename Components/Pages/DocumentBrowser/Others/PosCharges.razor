@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.DocumentBrowser.Models

<div class="rst-toolbar">
    <button type="button" class="rt-toolbar-btn" @onclick="OnShow">
        <i class="bi bi-eye text-secondary"></i>
        <span>Show</span>
    </button>
    <button type="button" class="rt-toolbar-btn" @onclick="OnTransfer">
        <i class="bi bi-arrow-left-right text-secondary"></i>
        <span>Transfer</span>
    </button>
    <button type="button" class="rt-toolbar-btn" @onclick="OnRemove">
        <i class="bi bi-eraser text-secondary"></i>
        <span>Remove</span>
    </button>
    <button type="button" class="rt-toolbar-btn" @onclick="OnPrint">
        <i class="bi bi-printer text-secondary"></i>
        <span>Print</span>
    </button>

    <div class="rst-filters rst-field-group">
        <div class="rst-filter-row">
            <span class="tb-label" style="width: 45px;">Date</span>
            <DxDateEdit @bind-Date="SelectedDate" CssClass="rt-detail-input" style="width:130px;" />
        </div>
        <div class="rst-filter-row">
            <span class="tb-label" style="width: 45px;">Hotel</span>
            <DxComboBox Data="@Hotels" @bind-Value="SelectedHotel" CssClass="rt-detail-input" style="width:170px;" />
        </div>
    </div>
</div>

<div class="rt-grid-area">
    <div class="ri-table-wrap">
        <table class="ri-table">
            <thead>
                <tr>
                    <th>SN</th>
                    <th>Registration</th>
                    <th>Voucher Code</th>
                    <th>Guest</th>
                    <th>Room Type</th>
                    <th>Room</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Data.Count == 0)
                {
                    <tr>
                        <td colspan="7"><div class="rt-placeholder">No data to display</div></td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Data)
                    {
                        <tr class="@(SelectedItem == row ? "rt-row-selected" : "")" @onclick="() => SelectedItem = row">
                            <td>@row.SN</td>
                            <td>@row.Registration</td>
                            <td>@row.VoucherCode</td>
                            <td>@row.Guest</td>
                            <td>@row.RoomType</td>
                            <td>@row.Room</td>
                            <td>@row.Amount.ToString("n2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="rt-footer" style="text-align: right;">
        SUM = @(Data.Count == 0 ? "" : Sum.ToString("n2"))
    </div>
</div>

<!-- Bottom Requested Services — collapsible, closed by default -->
<div class="db-pr-requested-services @(IsServicesCollapsed ? "db-pr-collapsed" : "")">
    <div class="db-pr-rs-header" @onclick="() => IsServicesCollapsed = !IsServicesCollapsed">
        <span>Requested Services</span>
        <div class="db-pr-panel-actions" @onclick:stopPropagation="true">
            <button type="button" title="Pin"><i class="bi bi-pin-angle"></i></button>
            <button type="button" title="@(IsServicesCollapsed ? "Expand" : "Collapse")"
                    @onclick="() => IsServicesCollapsed = !IsServicesCollapsed">
                <i class="bi @(IsServicesCollapsed ? "bi-chevron-up" : "bi-chevron-down")"></i>
            </button>
        </div>
    </div>
    @if (!IsServicesCollapsed)
    {
        <DxGrid Data="@RequestedServices" PageSize="5" CssClass="db-pr-grid-small">
            <Columns>
                <DxGridDataColumn FieldName="Service" Caption="Service" />
                <DxGridDataColumn FieldName="TargetTime" Caption="Target Time" Width="140" />
            </Columns>
        </DxGrid>
    }
</div>

@code {
