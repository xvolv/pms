@using ERP.V7.WebPMS.Components.Pages.Reports.Models

@foreach (var reportSection in Sections)
{
    <div class="rp-sec-section-title">@reportSection.Title</div>
    <table class="hk-print-table rp-sec-table">
        <thead>
            <tr>
                @for (var i = 0; i < reportSection.Columns.Length; i++)
                {
                    <th class="@(IsRightAlign(reportSection, i) ? "rp-sec-right" : "")">@reportSection.Columns[i]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in reportSection.Rows)
            {
                <tr>
                    @for (var i = 0; i < row.Length; i++)
                    {
                        <td class="@(IsRightAlign(reportSection, i) ? "rp-sec-right" : "")">@row[i]</td>
                    }
                </tr>
            }
            @if (reportSection.TotalRow is not null)
            {
                <tr class="rp-sec-total-row">
                    @for (var i = 0; i < reportSection.TotalRow.Length; i++)
                    {
                        <td class="@(IsRightAlign(reportSection, i) ? "rp-sec-right" : "")">@reportSection.TotalRow[i]</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<ReportSection> Sections { get; set; } = new();

    private static bool IsRightAlign(ReportSection section, int columnIndex) =>
        columnIndex < section.RightAlign.Length && section.RightAlign[columnIndex];
}
