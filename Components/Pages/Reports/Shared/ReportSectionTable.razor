@using ERP.V7.WebPMS.Components.Pages.Reports.Models

@foreach (var section in Sections)
{
    <div class="rp-sec-section-title">@section.Title</div>
    <table class="hk-print-table rp-sec-table">
        <thead>
            <tr>
                @for (var i = 0; i < section.Columns.Length; i++)
                {
                    <th class="@(IsRightAlign(section, i) ? "rp-sec-right" : "")">@section.Columns[i]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in section.Rows)
            {
                <tr>
                    @for (var i = 0; i < row.Length; i++)
                    {
                        <td class="@(IsRightAlign(section, i) ? "rp-sec-right" : "")">@row[i]</td>
                    }
                </tr>
            }
            @if (section.TotalRow is not null)
            {
                <tr class="rp-sec-total-row">
                    @for (var i = 0; i < section.TotalRow.Length; i++)
                    {
                        <td class="@(IsRightAlign(section, i) ? "rp-sec-right" : "")">@section.TotalRow[i]</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<ReportSection> Sections { get; set; } = new();

    private static bool IsRightAlign(ReportSection section, int columnIndex) =>
        columnIndex < section.RightAlign.Length && section.RightAlign[columnIndex];
}
