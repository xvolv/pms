@using ERP.V7.WebPMS.Components.Pages.Reports.Models

@foreach (var section in Sections)
{
    <div class="rp-db-section-title">@section.Title</div>
    <table class="hk-print-table rp-db-table">
        <thead>
            <tr>
                @foreach (var column in section.Columns)
                {
                    <th class="@(column is "SN" or "Particulars" or "Machine Name" or "Cashier" or "Room Type" ? "" : "rp-db-right")">@column</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in section.Rows)
            {
                <tr>
                    @for (var i = 0; i < row.Length; i++)
                    {
                        <td class="@(i is 0 or 1 ? "" : "rp-db-right")">@row[i]</td>
                    }
                </tr>
            }
            @if (section.TotalRow is not null)
            {
                <tr class="rp-db-total-row">
                    @for (var i = 0; i < section.TotalRow.Length; i++)
                    {
                        <td class="@(i is 0 or 1 ? "" : "rp-db-right")">@section.TotalRow[i]</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<DailyBusinessSection> Sections { get; set; } = new();
}
