@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>@ReportName</h2>
            <p>@ReportDescription</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.RegNo)" Caption="Reg_No" Width="11%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.RoomType)" Caption="Room Type" Width="9%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.Room)" Caption="Room" Width="6%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.Guest)" Caption="Guest" Width="14%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.Company)" Caption="Company" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.IdNumber)" Caption="ID_Number" Width="9%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.ArrivalDate)" Caption="Arrival Date" Width="9%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.DepartureDate)" Caption="Departure Date" Width="9%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.ResType)" Caption="Res_Type" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.PaymentMethod)" Caption="Payment Method" Width="7%" />
                <DxGridDataColumn FieldName="@nameof(GuestStayRow.Market)" Caption="Market" Width="6%" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">@rows.Count guest(s) on @date.ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="@ReportName" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public string ReportName { get; set; } = "";
    [Parameter] public string ReportDescription { get; set; } = "";
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string[] PreviewColumns =
    {
        "Reg_No", "Room Type", "Room", "Guest", "Company", "ID_Number", "Arrival Date", "Departure Date",
        "Res_Type", "Payment Method", "Market",
    };

    private DateTime date = DateTime.Today;
    private List<GuestStayRow> rows = new();
    private bool showPreview;

    private List<string[]> PreviewRows => rows.Select(r => new[]
    {
        r.RegNo, r.RoomType, r.Room, r.Guest, r.Company, r.IdNumber,
        r.ArrivalDate.ToString("dd-MMM-yyyy"), r.DepartureDate.ToString("dd-MMM-yyyy"),
        r.ResType, r.PaymentMethod, r.Market,
    }).ToList();

    protected override void OnParametersSet()
    {
        if (rows.Count == 0 && !string.IsNullOrEmpty(ReportName))
        {
            rows = ReportsState.CreateGuestStaySample(ReportName, date);
        }
    }

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        rows = ReportsState.CreateGuestStaySample(ReportName, date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
