@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>Arrival List</h2>
            <p>Guests expected to arrive on the next business date.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.Sn)" Caption="#" Width="5%" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.RegNo)" Caption="Reservation No" Width="13%" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.Guest)" Caption="Guest" Width="16%" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.Company)" Caption="Company" Width="14%" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.Room)" Caption="Room" Width="7%" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.RoomType)" Caption="Room Type" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.ArrivalDate)" Caption="Arrival" Width="10%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.DepartureDate)" Caption="Departure" Width="10%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(ArrivalListRow.Agent)" Caption="Agent" Width="10%" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">@rows.Count arrival(s) expected on @date.AddDays(1).ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="Arrival List" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string[] PreviewColumns =
        { "#", "Reservation No", "Guest", "Company", "Room", "Room Type", "Arrival", "Departure", "Agent" };

    private DateTime date = DateTime.Today;
    private List<ArrivalListRow> rows = ReportsState.CreateArrivalListSample(DateTime.Today);
    private bool showPreview;

    private List<string[]> PreviewRows => rows.Select(r => new[]
    {
        r.Sn.ToString(), r.RegNo, r.Guest, r.Company, r.Room, r.RoomType,
        r.ArrivalDate.ToString("dd-MMM-yyyy"), r.DepartureDate.ToString("dd-MMM-yyyy"), r.Agent,
    }).ToList();

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        rows = ReportsState.CreateArrivalListSample(date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
