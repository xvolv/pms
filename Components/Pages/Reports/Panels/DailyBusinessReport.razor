@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>Daily Business Report</h2>
            <p>Total transactions made on the given date, with month and year-to-date totals compared to the prior year.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area rp-wide-grid-area">
        <DailyBusinessReportTable Sections="@sections" />
        <div class="rt-footer">Daily Business Report for @date.ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="Daily Business Report" OnClose="() => showPreview = false">
    <CustomBody>
        <DailyBusinessReportTable Sections="@sections" />
    </CustomBody>
</ReportPreviewDialog>

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private DateTime date = DateTime.Today;
    private List<DailyBusinessSection> sections = ReportsState.CreateDailyBusinessSections(DateTime.Today);
    private bool showPreview;

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        sections = ReportsState.CreateDailyBusinessSections(date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
