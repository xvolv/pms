@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>Task Assignment Report</h2>
            <p>Task assignment summary information for the given date.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(TaskAssignmentRow.TaskDate)" Caption="Task Date" Width="20%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(TaskAssignmentRow.Task)" Caption="Task" Width="30%" />
                <DxGridDataColumn FieldName="@nameof(TaskAssignmentRow.InAuto)" Caption="In Auto" Width="15%" />
                <DxGridDataColumn FieldName="@nameof(TaskAssignmentRow.TotalSheets)" Caption="Total Sheets" Width="17%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(TaskAssignmentRow.TotalCredits)" Caption="Total Credits" Width="18%"
                                   TextAlignment="GridTextAlignment.Right" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">@rows.Count task(s) on @date.ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="Task Assignment Report" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string[] PreviewColumns = { "Task Date", "Task", "In Auto", "Total Sheets", "Total Credits" };

    private DateTime date = DateTime.Today;
    private List<TaskAssignmentRow> rows = ReportsState.CreateTaskAssignmentSample(DateTime.Today);
    private bool showPreview;

    private List<string[]> PreviewRows => rows.Select(r => new[]
        { r.TaskDate.ToString("dd-MMM-yyyy"), r.Task, r.InAuto, r.TotalSheets.ToString(), r.TotalCredits.ToString() }).ToList();

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        rows = ReportsState.CreateTaskAssignmentSample(date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
