@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>Managerial Flash</h2>
            <p>Overall hotel rooms and room sales status, compared with the previous month and year.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.Sn)" Caption="SN" Width="4%" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.ReportItem)" Caption="Report Item" Width="30%" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.CurrentYearDay)" Caption="@($"{date.Year} Day")" Width="11%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.CurrentYearMonth)" Caption="@($"{date.Year} Month")" Width="11%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.CurrentYearToDate)" Caption="@($"{date.Year} Year")" Width="11%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.PriorYearDay)" Caption="@($"{date.Year - 1} Day")" Width="11%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.PriorYearMonth)" Caption="@($"{date.Year - 1} Month")" Width="11%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(ManagerialFlashItemRow.PriorYearToDate)" Caption="@($"{date.Year - 1} Year")" Width="11%"
                                   TextAlignment="GridTextAlignment.Right" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">Managerial Flash for @date.ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="Managerial Flash" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private DateTime date = DateTime.Today;
    private List<ManagerialFlashItemRow> rows = ReportsState.CreateManagerialFlashItems(DateTime.Today);
    private bool showPreview;

    private string[] PreviewColumns =>
    [
        "SN", "Report Item", $"{date.Year} Day", $"{date.Year} Month", $"{date.Year} Year",
        $"{date.Year - 1} Day", $"{date.Year - 1} Month", $"{date.Year - 1} Year",
    ];

    private List<string[]> PreviewRows => rows.Select(r => new[]
    {
        r.Sn.ToString(), r.ReportItem, r.CurrentYearDay, r.CurrentYearMonth, r.CurrentYearToDate,
        r.PriorYearDay, r.PriorYearMonth, r.PriorYearToDate,
    }).ToList();

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        rows = ReportsState.CreateManagerialFlashItems(date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
