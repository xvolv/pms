@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>City Ledger</h2>
            <p>Non-guest transactions tracked by the back-office accounting department.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.PeriodRange" InitialDate="@DateTime.Today" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(CityLedgerRow.RegNo)" Caption="Reg No" Width="18%" />
                <DxGridDataColumn FieldName="@nameof(CityLedgerRow.Date)" Caption="Date" Width="14%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(CityLedgerRow.Guest)" Caption="Guest" Width="22%" />
                <DxGridDataColumn FieldName="@nameof(CityLedgerRow.Company)" Caption="Company" Width="28%" />
                <DxGridDataColumn FieldName="@nameof(CityLedgerRow.SubTotal)" Caption="Sub Total" Width="18%"
                                   DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">@rows.Count entr(ies) - @periodLabel - sub total @rows.Sum(r => r.SubTotal).ToString("N2")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="City Ledger" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string[] PreviewColumns = { "Reg No", "Date", "Guest", "Company", "Sub Total" };

    private List<CityLedgerRow> rows = ReportsState.CreateCityLedgerSample(DateTime.Today, DateTime.Today);
    private string periodLabel = "Daily - " + DateTime.Today.ToString("dd-MMM-yyyy");
    private bool showPreview;

    private List<string[]> PreviewRows => rows.Select(r => new[]
    {
        r.RegNo, r.Date.ToString("dd-MMM-yyyy"), r.Guest, r.Company, r.SubTotal.ToString("N2"),
    }).ToList();

    private void Generate(ReportCriteria criteria)
    {
        DateTime start;
        DateTime end;

        switch (criteria.PeriodType)
        {
            case "Date Range":
                start = criteria.RangeStart;
                end = criteria.RangeEnd;
                break;
            case "Weekly":
                start = criteria.RangeStart;
                end = start.AddDays(6);
                break;
            case "Monthly":
                start = criteria.RangeStart;
                end = start.AddMonths(1).AddDays(-1);
                break;
            case "Annually":
                start = criteria.RangeStart;
                end = start.AddYears(1).AddDays(-1);
                break;
            case "Show all":
                end = DateTime.Today;
                start = end.AddDays(-30);
                break;
            default:
                start = criteria.RangeStart;
                end = criteria.RangeStart;
                break;
        }

        rows = ReportsState.CreateCityLedgerSample(start, end);
        periodLabel = criteria.PeriodType == "Date Range" || criteria.PeriodType == "Show all"
            ? $"{criteria.PeriodType} - {start:dd-MMM-yyyy} to {end:dd-MMM-yyyy}"
            : $"{criteria.PeriodType} - {start:dd-MMM-yyyy}";
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
