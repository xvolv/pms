@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
        </button>
        <div>
            <h2>Checkout Report</h2>
            <p>List of guests checked out on the given date, with registration and payment details.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.RegNo)" Caption="Reg_No" Width="7%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.Room)" Caption="Room" Width="5%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.RoomCount)" Caption="Room Count" Width="6%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.RoomType)" Caption="Room Type" Width="7%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.Company)" Caption="Company" Width="9%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.Guest)" Caption="Guest" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.Adult)" Caption="Adult" Width="5%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.Child)" Caption="Child" Width="5%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.ArrivalDate)" Caption="Arrival Date" Width="7%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.DepartureDate)" Caption="Departure Date" Width="7%"
                                   DisplayFormat="dd-MMM-yyyy" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.RateCode)" Caption="Rate Code" Width="6%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.PaymentType)" Caption="Payment Type" Width="7%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.User)" Caption="User" Width="8%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.ActualRtc)" Caption="Actual RTC" Width="6%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.MarketCode)" Caption="Market Code" Width="7%" />
                <DxGridDataColumn FieldName="@nameof(CheckoutReportRow.RateAmount)" Caption="Rate Amount" Width="6%"
                                   DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">@rows.Count checkout(s) on @date.ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="Checkout Report" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string[] PreviewColumns =
    {
        "Reg_No", "Room", "Room Count", "Room Type", "Company", "Guest", "Adult", "Child",
        "Arrival Date", "Departure Date", "Rate Code", "Payment Type", "User", "Actual RTC", "Market Code", "Rate Amount",
    };

    private DateTime date = DateTime.Today;
    private List<CheckoutReportRow> rows = ReportsState.CreateCheckoutReportSample(DateTime.Today);
    private bool showPreview;

    private List<string[]> PreviewRows => rows.Select(r => new[]
    {
        r.RegNo, r.Room, r.RoomCount.ToString(), r.RoomType, r.Company, r.Guest, r.Adult.ToString(), r.Child.ToString(),
        r.ArrivalDate.ToString("dd-MMM-yyyy"), r.DepartureDate.ToString("dd-MMM-yyyy"), r.RateCode, r.PaymentType,
        r.User, r.ActualRtc, r.MarketCode, r.RateAmount.ToString("N2"),
    }).ToList();

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        rows = ReportsState.CreateCheckoutReportSample(date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
