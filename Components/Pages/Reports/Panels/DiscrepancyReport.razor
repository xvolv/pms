@using ERP.V7.WebPMS.Components.Pages.Reports.Models
@using ERP.V7.WebPMS.Components.Pages.Reports.Shared

<div class="na-step-card rp-report-card">
    <div class="na-step-header rp-report-header">
        <button type="button" class="rt-toolbar-btn rp-back-btn" @onclick="Back">
            <i class="bi bi-arrow-left text-secondary"></i>
            
        </button>
        <div>
            <h2>Discrepancy Report</h2>
            <p>Discrepancies between front office and housekeeping room status recordings on the given date.</p>
        </div>
    </div>

    <ReportCriteriaBar Mode="ReportCriteriaMode.SimpleDate" InitialDate="@date" OnGenerate="Generate" />

    <div class="rt-grid-area">
        <DxGrid Data="@rows" KeyFieldName="Id" CssClass="rt-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.RoomNo)" Caption="Room No" Width="8%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.RoomType)" Caption="Room Type" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.RoomStatus)" Caption="Room Status" Width="13%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.HkStatus)" Caption="HK Status" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.FoStatus)" Caption="FO Status" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.ResStatus)" Caption="Res Status" Width="11%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.FoPerson)" Caption="FO Person" Width="9%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.HkPerson)" Caption="HK Person" Width="9%"
                                   TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.Discrepancy)" Caption="Discrepancy" Width="10%" />
                <DxGridDataColumn FieldName="@nameof(DiscrepancyReportRow.Date)" Caption="Date" Width="10%"
                                   DisplayFormat="dd-MMM-yyyy" />
            </Columns>
        </DxGrid>

        <div class="rt-footer">@rows.Count discrepancy(ies) on @date.ToString("dd-MMM-yyyy")</div>
    </div>
</div>

<ReportPreviewDialog Visible="@showPreview" Title="Discrepancy Report" Columns="@PreviewColumns" Rows="@PreviewRows"
                      OnClose="() => showPreview = false" />

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string[] PreviewColumns =
    {
        "Room No", "Room Type", "Room Status", "HK Status", "FO Status", "Res Status", "FO Person", "HK Person",
        "Discrepancy", "Date",
    };

    private DateTime date = DateTime.Today;
    private List<DiscrepancyReportRow> rows = ReportsState.CreateDiscrepancyReportSample(DateTime.Today);
    private bool showPreview;

    private List<string[]> PreviewRows => rows.Select(r => new[]
    {
        r.RoomNo, r.RoomType, r.RoomStatus, r.HkStatus, r.FoStatus, r.ResStatus, r.FoPerson.ToString(),
        r.HkPerson.ToString(), r.Discrepancy, r.Date.ToString("dd-MMM-yyyy"),
    }).ToList();

    private void Generate(ReportCriteria criteria)
    {
        date = criteria.Date;
        rows = ReportsState.CreateDiscrepancyReportSample(date);
        showPreview = true;
    }

    private async Task Back() => await OnBack.InvokeAsync();
}
