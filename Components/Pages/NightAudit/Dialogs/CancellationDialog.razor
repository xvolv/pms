@using ERP.V7.WebPMS.Components.Pages.NightAudit.Models

@if (Visible && Registration != null)
{
    <div class="rt-modal-backdrop">
        <div class="rt-modal na-cancel-modal">
            <div class="rt-modal-header">
                <span class="rt-modal-header-title">Cancellation</span>
                <button class="rt-modal-close-btn" @onclick="Close" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="rt-toolbar na-modal-toolbar">
                <button type="button" class="rt-toolbar-btn" @onclick="Cancel">
                    <i class="bi bi-x-circle text-secondary"></i>
                    <span>Cancel</span>
                </button>
                <button type="button" class="rt-toolbar-btn" @onclick="Close">
                    <i class="bi bi-arrow-return-left text-secondary"></i>
                    <span>Close</span>
                </button>
            </div>

            <div class="rt-modal-body">
                <div class="na-cancel-banner">You are cancelling the guest below</div>

                <div class="na-checkout-columns">
                    <div class="na-checkout-col">
                        <div class="rt-detail-row">
                            <label>Reg. No</label>
                            <DxTextBox Text="@Registration.RegNo" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Guest</label>
                            <DxTextBox Text="@Registration.Guest" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Company</label>
                            <DxTextBox Text="@Registration.Company" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Room</label>
                            <DxTextBox Text="@Registration.Room" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Payment Type</label>
                            <DxTextBox Text="@Registration.PaymentType" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Total Bill</label>
                            <DxTextBox Text="@Registration.TotalBill.ToString("N2")" ReadOnly="true"
                                       CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Paid</label>
                            <DxTextBox Text="@Registration.Paid.ToString("N2")" ReadOnly="true"
                                       CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Remaining</label>
                            <DxTextBox Text="@Registration.Remaining.ToString("N2")" ReadOnly="true"
                                       CssClass="rt-detail-input" />
                        </div>
                    </div>
                    <div class="na-checkout-col">
                        <div class="rt-detail-row">
                            <label>Departure</label>
                            <DxTextBox Text="@Registration.DepartureDate.ToString("dd-MMM-yyyy")" ReadOnly="true"
                                       CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Agent</label>
                            <DxTextBox Text="@Registration.Agent" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Source</label>
                            <DxTextBox Text="@Registration.Source" ReadOnly="true" CssClass="rt-detail-input" />
                        </div>
                        <div class="rt-detail-row">
                            <label>Reason</label>
                            <DxComboBox Data="@Reasons" @bind-Value="@selectedReason" NullText="-- Select Reason --"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="rt-detail-input" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<InfoDialog Visible="@isCancellationSuccessVisible" Title="Information"
            Message="Reservation cancelled successfully!!!" OnOk="() => isCancellationSuccessVisible = false" />

@code {
    private bool isCancellationSuccessVisible;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public NightAuditRegistration? Registration { get; set; }
    [Parameter] public List<string> Reasons { get; set; } = new();
    [Parameter] public EventCallback<string> OnCancelReservation { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? selectedReason;

    protected override void OnParametersSet()
    {
        if (!Visible)
            selectedReason = null;
    }

    private async Task Cancel()
    {
        if (string.IsNullOrEmpty(selectedReason))
            return;

        var reason = selectedReason;
        selectedReason = null;

        await OnCancelReservation.InvokeAsync(reason);
        isCancellationSuccessVisible = true;

    }

    private async Task Close() => await OnClose.InvokeAsync();
}
