@using ERP.V7.WebPMS.Components.Pages.NightAudit.Models
@using ERP.V7.WebPMS.Components.Pages.NightAudit.Dialogs

<div class="rt-toolbar">
    <button type="button" class="rt-toolbar-btn" @onclick="Refresh">
        <i class="bi bi-arrow-clockwise text-secondary"></i>
        <span>Refresh</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(Posts.Count == 0 || Posted)" @onclick="() => isAuthVisible = true">
        <i class="bi bi-send-check text-secondary"></i>
        <span>Post</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(Posts.Count == 0)" @onclick="Print">
        <i class="bi bi-printer text-secondary"></i>
        <span>Print</span>
    </button>
</div>

<div class="na-step-card">
    <div class="na-step-header">
        <h2>Room and Tax Post</h2>
        <p>Posts room charges and tax for every in-house registration. Expand a row with the + icon to see the
            line items (room charge, tax and any packages) that will be posted along with it.</p>
    </div>

    <div class="rt-grid-area" @onclick:stopPropagation="true">
        @if (Posts.Count == 0)
        {
            <div class="rt-placeholder">No in-house registrations require room and tax posting.</div>
        }
        else
        {
            <table class="na-post-table">
                <thead>
                    <tr>
                        <th style="width:4%;"></th>
                        <th style="width:5%;">
                            <input type="checkbox" class="na-post-checkbox" checked="@AllSelected" @onchange="ToggleSelectAll" />
                        </th>
                        <th style="width:6%;">SN</th>
                        <th style="width:14%;">Registration No</th>
                        <th style="width:10%;">Room</th>
                        <th style="width:25%;">Consignee</th>
                        <th class="na-post-amount">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Posts)
                    {
                        <tr class="na-post-row">
                            <td>
                                @if (row.LineItems.Count > 0)
                                {
                                    <i class="bi @(row.IsExpanded ? "bi-dash-square" : "bi-plus-square") na-post-toggle"
                                       @onclick="() => row.IsExpanded = !row.IsExpanded"></i>
                                }
                            </td>
                            <td>
                                <input type="checkbox" class="na-post-checkbox" checked="@row.Selected"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelected(row, e))" />
                            </td>
                            <td>@row.Sn</td>
                            <td>@row.RegNo</td>
                            <td>@row.Room</td>
                            <td>@row.Guest</td>
                            <td class="na-post-amount">@row.Amount.ToString("N2")</td>
                        </tr>
                        @if (row.IsExpanded && row.LineItems.Count > 0)
                        {
                            <tr class="na-post-lineitems-row">
                                <td></td>
                                <td colspan="6">
                                    <div class="na-post-lineitems">
                                        <div class="na-post-lineitems-title">Line Items</div>
                                        <table class="na-post-lineitems-table">
                                            <thead>
                                                <tr>
                                                    <th>Article Code</th>
                                                    <th>Name</th>
                                                    <th class="na-post-amount">Unit Amount</th>
                                                    <th class="na-post-amount">Quantity</th>
                                                    <th class="na-post-amount">Total Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in row.LineItems)
                                                {
                                                    <tr>
                                                        <td>@item.ArticleCode</td>
                                                        <td>@item.Name</td>
                                                        <td class="na-post-amount">@item.UnitAmount.ToString("N2")</td>
                                                        <td class="na-post-amount">@item.Quantity.ToString("N2")</td>
                                                        <td class="na-post-amount">@item.TotalAmount.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="rt-footer">
                @Posts.Count(p => p.Selected) registration(s) selected ・ Total to post = @TotalToPost.ToString("N2")
                @(Posted ? " ・ Posted" : "")
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="profile-status-bar">@statusMessage</div>
    }
</div>

<AuthorizationDialog Visible="@isAuthVisible" OnAuthorized="DoPost" OnCancel="() => isAuthVisible = false" />

@code {
    [Parameter] public List<RoomTaxPostRow> Posts { get; set; } = new();
    [Parameter] public bool Posted { get; set; }
    [Parameter] public EventCallback<bool> PostedChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public Func<List<RoomTaxPostRow>>? ReloadSample { get; set; }

    private bool isAuthVisible;
    private string? statusMessage;

    private bool AllSelected => Posts.Count > 0 && Posts.All(p => p.Selected);

    private decimal TotalToPost => Posts.Where(p => p.Selected).Sum(p => p.Amount);

    private void ToggleSelected(RoomTaxPostRow row, ChangeEventArgs e)
    {
        row.Selected = e.Value is bool value && value;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var value = e.Value is bool v && v;
        foreach (var row in Posts)
            row.Selected = value;
    }

    private async Task DoPost()
    {
        isAuthVisible = false;
        Posted = true;
        statusMessage = $"Room and tax posted for {Posts.Count(p => p.Selected)} registration(s). Total posted = {TotalToPost:N2}.";
        await PostedChanged.InvokeAsync(Posted);
        await OnChanged.InvokeAsync();
    }

    private async Task Print()
    {
        statusMessage = "Room and tax post report sent to printer.";
    }

    private async Task Refresh()
    {
        statusMessage = null;
        if (ReloadSample != null)
        {
            Posts.Clear();
            Posts.AddRange(ReloadSample());
        }
        await OnChanged.InvokeAsync();
    }
}
