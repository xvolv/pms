@using ERP.V7.WebPMS.Components.Pages.NightAudit.Models

<div class="rt-toolbar">
    <button type="button" class="rt-toolbar-btn" disabled="@(selected == null)" @onclick="ClearSelected">
        <i class="bi bi-check2-circle text-secondary"></i>
        <span>Clear</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(HeldBills.Count == 0)" @onclick="ClearAll">
        <i class="bi bi-check2-all text-secondary"></i>
        <span>Clear All</span>
    </button>
</div>

<div class="na-step-card">
    <div class="na-step-header">
        <h2>Clear Held Bills</h2>
        <p>Bills that were placed on hold and are still attached to a registration. Review and clear each one
            before continuing.</p>
    </div>

    <div class="rt-grid-area" @onclick:stopPropagation="true">
        @if (HeldBills.Count == 0)
        {
            <div class="rt-placeholder">
                <i class="bi bi-check-circle-fill" style="color:gray; font-size:1.4rem;"></i>
                <div style="margin-top:6px;">There are no held bills for this business date.</div>
            </div>
        }
        else
        {
            <DxGrid @ref="grid" Data="@HeldBills" KeyFieldName="Id" CssClass="rt-grid" RowClick="@OnRowClick"
                    CustomizeElement="@OnCustomizeElement">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.RegNo)" Caption="Reg. No" Width="12%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.Guest)" Caption="Guest" Width="18%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.Room)" Caption="Room" Width="8%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.BillNo)" Caption="Bill No" Width="12%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.Amount)" Caption="Amount" Width="10%"
                                      DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.HeldDate)" Caption="Held Date" Width="10%"
                                      DisplayFormat="dd-MMM-yyyy" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.HeldBy)" Caption="Held By" Width="10%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.Reason)" Caption="Reason" Width="20%" />
                </Columns>
            </DxGrid>

            <div class="rt-footer">@HeldBills.Count held bill(s) remaining</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="profile-status-bar">@statusMessage</div>
    }
</div>

@code {
    [Parameter] public List<HeldBillRow> HeldBills { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private IGrid? grid;
    private HeldBillRow? selected;
    private string? statusMessage;

    private void OnRowClick(GridRowClickEventArgs e)
    {
        var row = (HeldBillRow)grid!.GetDataItem(e.VisibleIndex);
        selected = selected?.Id == row.Id ? null : row;
    }

    private void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow)
            return;

        var row = (HeldBillRow)grid!.GetDataItem(e.VisibleIndex);
        if (selected?.Id == row.Id)
            e.CssClass = "rt-row-selected";
    }

    private async Task ClearSelected()
    {
        if (selected == null)
            return;

        statusMessage = $"Held bill {selected.BillNo} cleared.";
        HeldBills.Remove(selected);
        selected = null;
        await OnChanged.InvokeAsync();
    }

    private async Task ClearAll()
    {
        statusMessage = $"{HeldBills.Count} held bill(s) cleared.";
        HeldBills.Clear();
        selected = null;
        await OnChanged.InvokeAsync();
    }
}
