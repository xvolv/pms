@using ERP.V7.WebPMS.Components.Pages.NightAudit.Models

<div class="rt-toolbar">
    <button type="button" class="rt-toolbar-btn" @onclick="Refresh">
        <i class="bi bi-arrow-clockwise text-secondary"></i>
        <span>Refresh</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(selected == null)" @onclick="Push">
        <i class="bi bi-send-check text-secondary"></i>
        <span>Push</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(selected == null)" @onclick="Void">
        <i class="bi bi-x-octagon text-secondary"></i>
        <span>Void</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(selected == null)" @onclick="Print">
        <i class="bi bi-printer text-secondary"></i>
        <span>Print</span>
    </button>
</div>

<div class="na-step-card">
    <div class="na-step-header">
        <h2>Clear Held Bills</h2>
        <p>Bills that were placed on hold and are still attached to a registration. Review and clear each one
            before continuing.</p>
    </div>

    <div class="rt-grid-area" @onclick:stopPropagation="true">
        @if (HeldBills.Count == 0)
        {
            <div class="rt-placeholder">
                <i class="bi bi-check-circle-fill" style="color:gray; font-size:1.4rem;"></i>
                <div style="margin-top:6px;">There are no held bills for this business date.</div>
            </div>
        }
        else
        {
            <DxGrid @ref="grid" Data="@HeldBills" KeyFieldName="Id" CssClass="rt-grid" RowClick="@OnRowClick"
                    CustomizeElement="@OnCustomizeElement">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.Sn)" Caption="SN" Width="6%"
                                      TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.VoucherNo)" Caption="Voucher Number" Width="20%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.DeviceName)" Caption="Device Name" Width="18%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.WaiterName)" Caption="Waiter Name" Width="16%" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.HeldDate)" Caption="Date" Width="12%"
                                      DisplayFormat="dd-MMM-yyyy" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.Amount)" Caption="Amount" Width="14%"
                                      DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="@nameof(HeldBillRow.HeldBy)" Caption="Held By" Width="14%" />
                </Columns>
            </DxGrid>

            <div class="rt-footer">@HeldBills.Count held bill(s) remaining</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="profile-status-bar">@statusMessage</div>
    }
</div>

@code {
    [Parameter] public List<HeldBillRow> HeldBills { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public Func<List<HeldBillRow>>? ReloadSample { get; set; }

    private IGrid? grid;
    private HeldBillRow? selected;
    private string? statusMessage;

    private void OnRowClick(GridRowClickEventArgs e)
    {
        var row = (HeldBillRow)grid!.GetDataItem(e.VisibleIndex);
        selected = selected?.Id == row.Id ? null : row;
    }

    private void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow)
            return;

        var row = (HeldBillRow)grid!.GetDataItem(e.VisibleIndex);
        if (selected?.Id == row.Id)
            e.CssClass = "rt-row-selected";
    }

    private async Task Push()
    {
        if (selected == null)
            return;

        statusMessage = $"Held bill {selected.VoucherNo} pushed to the guest folio.";
        HeldBills.Remove(selected);
        selected = null;
        await OnChanged.InvokeAsync();
    }

    private async Task Void()
    {
        if (selected == null)
            return;

        statusMessage = $"Held bill {selected.VoucherNo} voided.";
        HeldBills.Remove(selected);
        selected = null;
        await OnChanged.InvokeAsync();
    }

    private async Task Print()
    {
        if (selected == null)
            return;

        statusMessage = $"Held bill {selected.VoucherNo} sent to printer.";
    }

    private async Task Refresh()
    {
        selected = null;
        statusMessage = null;
        if (ReloadSample != null)
        {
            HeldBills.Clear();
            HeldBills.AddRange(ReloadSample());
        }
        await OnChanged.InvokeAsync();
    }
}
