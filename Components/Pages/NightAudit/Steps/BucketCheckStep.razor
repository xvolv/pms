@using ERP.V7.WebPMS.Components.Pages.NightAudit.Models

<div class="rt-toolbar">
    <button type="button" class="rt-toolbar-btn" @onclick="Refresh">
        <i class="bi bi-arrow-clockwise text-secondary"></i>
        <span>Refresh</span>
    </button>
    <button type="button" class="rt-toolbar-btn" disabled="@(BucketChecks.Count == 0)" @onclick="PrintReport">
        <i class="bi bi-printer text-secondary"></i>
        <span>Print</span>
    </button>
</div>

<div class="na-step-card">
    <div class="na-step-header">
        <h2>Bucket Check</h2>
        <p>Compares the information on each guest's Registration Card against what is currently in the system
            (room, departure date, occupancy and rate). Print the report if needed, then click Next to save it and
            continue.</p>
        </div>

        <div class="rt-grid-area na-bucket-grid-area" @onclick:stopPropagation="true">
            @if (BucketChecks.Count == 0)
            {
                <div class="rt-placeholder">No in-house registrations to reconcile.</div>
            }
            else
            {
                <DxGrid Data="@BucketChecks" KeyFieldName="Id" CssClass="rt-grid na-bucket-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Selected)" Caption="" Width="40px">
                            <CellDisplayTemplate>
                                @{
                                    var row = (BucketCheckRow)context.DataItem;
                                }
                                <input type="checkbox" class="na-bucket-checkbox" checked="@row.Selected"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelected(row, e))" />
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Sn)" Caption="SN" Width="50px"
                                          TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.RegNo)" Caption="Reg. No" Width="110px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Room)" Caption="Room" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Guest)" Caption="Guest Name" Width="170px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Company)" Caption="Company" Width="150px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Arrival)" Caption="Arrival" Width="160px"
                                          DisplayFormat="dd-MMM-yyyy" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Departure)" Caption="Departure" Width="160px"
                                          DisplayFormat="dd-MMM-yyyy" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Adults)" Caption="Adult" Width="80px"
                                          TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Children)" Caption="Child" Width="100px"
                                          TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.RoomType)" Caption="Room Type" Width="130px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Currency)" Caption="Currency" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.ActualRtc)" Caption="Actual RTC" Width="100px" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.RateAmount)" Caption="Rate Amount" Width="140px"
                                          DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.UnitRoomRate)" Caption="Unit Room Rate"
                                          Width="110px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(BucketCheckRow.Variance)" Caption="Variance" Width="100px"
                                          TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate>
                                @{
                                    var row = (BucketCheckRow)context.DataItem;
                                }
                                <span
                                class="@(row.Variance != 0 ? "na-bucket-variance-alert" : "")">@row.Variance.ToString("N2")</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>

                <div class="rt-footer">@BucketChecks.Count registration(s) checked against the system</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="profile-status-bar">@statusMessage</div>
        }
    </div>

@code {
    [Parameter] public List<BucketCheckRow> BucketChecks { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public Func<List<BucketCheckRow>>? ReloadSample { get; set; }

    private string? statusMessage;

    private void ToggleSelected(BucketCheckRow row, ChangeEventArgs e)
    {
        row.Selected = e.Value is bool value && value;
    }

    private void PrintReport()
    {
        statusMessage = "Bucket check report sent to printer.";
    }

    private async Task Refresh()
    {
        statusMessage = null;
        if (ReloadSample != null)
        {
            BucketChecks.Clear();
            BucketChecks.AddRange(ReloadSample());
        }
        await OnChanged.InvokeAsync();
    }
}
