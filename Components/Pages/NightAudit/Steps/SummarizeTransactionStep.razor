@using ERP.V7.WebPMS.Components.Pages.NightAudit.Models

<div class="na-step">
    <div class="na-step-header">
        <h2>Summarize Transaction</h2>
        <p>Summarizes all of today's transactions into a single summary voucher.</p>
    </div>

    <div class="rt-toolbar">
        <button type="button" class="rt-toolbar-btn" @onclick="Summarize">
            <i class="bi bi-journal-check text-secondary"></i>
            <span>Summarize</span>
        </button>
    </div>

    <div class="rt-grid-area">
        <div class="na-summary-voucher">
            <div class="na-summary-row">
                <span>Total Room Charges</span>
                <strong>@RoomChargeTotal.ToString("N2")</strong>
            </div>
            <div class="na-summary-row">
                <span>Total Tax</span>
                <strong>@TaxTotal.ToString("N2")</strong>
            </div>
            <div class="na-summary-row na-summary-total">
                <span>Summary Voucher Total</span>
                <strong>@((RoomChargeTotal + TaxTotal).ToString("N2"))</strong>
            </div>
        </div>

        <div class="rt-validation-summary" style="margin-top:14px;">
            This function is not yet fully implemented in the CNET PMS. The voucher above is recorded for the audit
            trail only; you may continue to the next step at any time.
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="profile-status-bar">@statusMessage</div>
    }
</div>

@code {
    [Parameter] public List<RoomTaxPostRow> Posts { get; set; } = new();
    [Parameter] public bool Summarized { get; set; }
    [Parameter] public EventCallback<bool> SummarizedChanged { get; set; }

    private string? statusMessage;

    private decimal RoomChargeTotal => Posts.Sum(p => p.RoomCharge);
    private decimal TaxTotal => Posts.Sum(p => p.Tax);

    private async Task Summarize()
    {
        Summarized = true;
        statusMessage = "Transactions summarized into a single summary voucher.";
        await SummarizedChanged.InvokeAsync(Summarized);
    }
}
