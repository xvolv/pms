@page "/room-inventory"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ERP.V7.WebPMS.Components.Pages.RoomInventory.Models
@inject NavigationManager NavigationManager

<PageTitle>Room Inventory</PageTitle>

<PermissionGate Category="Document Browser" Permission="Room Inventory">
<div class="dashboard-wrapper">
    <div class="top-tab-header">
        <div class="tab-item active" style="position: relative; padding-right: 2.5rem;">
            Room Inventory
            <i class="bi bi-x fs-4" @onclick="ClosePage"
               style="position: absolute; top: -6px; right: 3px; cursor: pointer;"></i>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="rt-toolbar hk-toolbar">
            <button type="button" class="rt-toolbar-btn" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise text-secondary"></i>
                <span>Refresh</span>
            </button>

            <div class="hk-filter-group hk-filter-group-stack">
                <div class="hk-filter-subgroup">
                    <span class="tb-label" style="width: 47px;">Hotel</span>
                    <DxComboBox Data="@hotels" @bind-Value="selectedHotel" CssClass="rt-detail-input"
                                style="width:170px;" />
                </div>
                <div class="hk-filter-subgroup">
                    <span class="tb-label">Month</span>
                    <DxComboBox Data="@months" @bind-Value="selectedMonth" @bind-Value:after="GenerateInventory"
                                CssClass="rt-detail-input" style="width:410px; margin-bottom:2px;" />
                    <span class="tb-label">Year</span>
                    <DxComboBox Data="@years" @bind-Value="selectedYear" @bind-Value:after="GenerateInventory"
                                CssClass="rt-detail-input" style="width:90px;" />
                </div>
            </div>

            <button type="button" class="rt-toolbar-btn" @onclick="OpenPrintPreview">
                <i class="bi bi-printer text-secondary"></i>
                <span>Print Preview</span>
            </button>
        </div>

        <DxTabs @bind-ActiveTabIndex="activeTabIndex" CssClass="ri-tabs">
            <DxTabPage Text="Monthly Room Inventory" />
            <DxTabPage Text="Daily Room Inventory" />
        </DxTabs>

        @if (activeTabIndex == 0)
        {
            <div class="na-step-card">
                <div class="rt-grid-area ri-table-wrap">
                    <table class="ri-table">
                        <thead>
                            <tr>
                                <th class="ri-sticky-col">Room Type</th>
                                @for (int d = 1; d <= DaysInMonth; d++)
                                {
                                    <th>@d</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in inventoryRows)
                            {
                                <tr>
                                    <td class="ri-sticky-col">@row.RoomType</td>
                                    @for (int d = 1; d <= DaysInMonth; d++)
                                    {
                                        var day = d;
                                        <td>
                                            <input type="number" class="ri-cell-input" value="@row.DailyCounts[day]"
                                                   @onchange="@(e => UpdateCount(row, day, e.Value))" />
                                        </td>
                                    }
                                </tr>
                            }
                            @* <tr class="ri-remarks-row">
                                <td class="ri-sticky-col">Remarks</td>
                                @for (int d = 1; d <= DaysInMonth; d++)
                                {
                                    var day = d;
                                    <td>
                                        <input type="text" class="ri-cell-input" value="@GetRemark(day)"
                                               @onchange="@(e => SetRemark(day, e.Value?.ToString() ?? ""))" />
                                    </td>
                                }
                            </tr> *@
                        </tbody>
                        <tfoot>
                            <tr class="ri-total-row">
                                <td class="ri-sticky-col">Total</td>
                                @for (int d = 1; d <= DaysInMonth; d++)
                                {
                                    <td>@GetTotal(d)</td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="ri-chart-card">
                <DxChart Data="@ChartData" Height="320px" Width="100%">
                    <DxChartArgumentAxis>
                        <DxChartAxisLabel />
                    </DxChartArgumentAxis>

                    <DxChartSplineAreaSeries T="RoomInventoryChartPoint" TArgument="int" TValue="int"
                                             ArgumentField="@(x => x.Day)" ValueField="@(x => x.Total)" Name="Total Room Inventory"
                                             Color="@chartColor">
                        <DxChartSeriesPoint Visible="true" />
                    </DxChartSplineAreaSeries>
                </DxChart>
            </div>
        }
        else
        {
            <div class="na-step-card">
                <div class="rt-grid-area ri-table-wrap">
                    <table class="ri-table">
                        <thead>
                            <tr>
                                <th class="ri-sticky-col">Room Type</th>
                                <th>Total Room</th>
                                <th>Total Registration</th>
                                <th>InHouse Room</th>
                                <th>Stay Over Room</th>
                                <th>Due Out Room</th>
                                <th>Check Out Room</th>
                                <th>6PM Room</th>
                                <th>Real Time Available</th>
                                <th>Forcasted Available</th>
                                <th>Real Time Occ.</th>
                                <th>Forcasted Occ.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in dailyInventoryRows)
                            {
                                <tr>
                                    <td class="ri-sticky-col">@row.RoomType</td>
                                    <td>@row.TotalRoom</td>
                                    <td>@row.TotalRegistration</td>
                                    <td>@row.InHouseRoom</td>
                                    <td>@row.StayOverRoom</td>
                                    <td>@row.DueOutRoom</td>
                                    <td>@row.CheckOutRoom</td>
                                    <td>@row.SixPMRoom</td>
                                    <td>@row.RealTimeAvailable</td>
                                    <td>@row.ForecastedAvailable</td>
                                    <td>@row.RealTimeOccPercent.ToString("n2") %</td>
                                    <td>@row.ForecastedOccPercent.ToString("n2") %</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="ri-total-row">
                                <td class="ri-sticky-col">Total</td>
                                <td>@dailyInventoryRows.Sum(r => r.TotalRoom)</td>
                                <td>@dailyInventoryRows.Sum(r => r.TotalRegistration)</td>
                                <td>@dailyInventoryRows.Sum(r => r.InHouseRoom)</td>
                                <td>@dailyInventoryRows.Sum(r => r.StayOverRoom)</td>
                                <td>@dailyInventoryRows.Sum(r => r.DueOutRoom)</td>
                                <td>@dailyInventoryRows.Sum(r => r.CheckOutRoom)</td>
                                <td>@dailyInventoryRows.Sum(r => r.SixPMRoom)</td>
                                <td>@dailyInventoryRows.Sum(r => r.RealTimeAvailable)</td>
                                <td>@dailyInventoryRows.Sum(r => r.ForecastedAvailable)</td>
                                <td>@DailyTotalOccPercent(r => r.RealTimeAvailable).ToString("n2") %</td>
                                <td>@DailyTotalOccPercent(r => r.ForecastedAvailable).ToString("n2") %</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="ri-chart-card" style="display:flex; gap:24px; flex-wrap:wrap;">
                <div style="flex:1; min-width:280px;">
                    <div class="chart-title">Real Time Occupancy</div>
                    <DxPieChart Data="@RealTimeOccupancyData" Height="320px" Width="100%"
                                CustomizeSeriesPoint="@CustomizeOccupancyPointColor">
                        <DxChartLegend Visible="false" />
                        <DxPieChartSeries T="OccupancySlice" TArgument="string" TValue="decimal"
                                          ArgumentField="@(x => x.Name)" ValueField="@(x => x.Value)" Name="Real Time Occupancy">
                            <DxChartSeriesLabel Visible="true" Position="RelativePosition.Outside">
                                <DxChartSeriesLabelConnector Visible="true" />
                            </DxChartSeriesLabel>
                        </DxPieChartSeries>
                    </DxPieChart>
                    <div class="legend-manual">
                        @foreach (var (slice, idx) in RealTimeOccupancyData.Select((s, i) => (s, i)))
                        {
                            <span class="leg-item">
                                <span class="dot" style="background:@(idx == 0 ? "#43a047" : "#e53935");"></span>
                                @slice.Name: @slice.Value.ToString("n2") %
                            </span>
                        }
                    </div>
                </div>
                <div style="flex:1; min-width:280px;">
                    <div class="chart-title">Forcasted Occupancy</div>
                    <DxPieChart Data="@ForecastedOccupancyData" Height="320px" Width="100%"
                                CustomizeSeriesPoint="@CustomizeOccupancyPointColor">
                        <DxChartLegend Visible="false" />
                        <DxPieChartSeries T="OccupancySlice" TArgument="string" TValue="decimal"
                                          ArgumentField="@(x => x.Name)" ValueField="@(x => x.Value)" Name="Forcasted Occupancy">
                            <DxChartSeriesLabel Visible="true" Position="RelativePosition.Outside">
                                <DxChartSeriesLabelConnector Visible="true" />
                            </DxChartSeriesLabel>
                        </DxPieChartSeries>
                    </DxPieChart>
                    <div class="legend-manual">
                        @foreach (var (slice, idx) in ForecastedOccupancyData.Select((s, i) => (s, i)))
                        {
                            <span class="leg-item">
                                <span class="dot" style="background:@(idx == 0 ? "#43a047" : "#e53935");"></span>
                                @slice.Name: @slice.Value.ToString("n2") %
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
</PermissionGate>

