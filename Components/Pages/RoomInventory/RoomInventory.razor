@code {
    private int activeTabIndex = 0;

    private List<string> hotels = new() { "MAIN TEST HOTEL" };
    private string? selectedHotel;

    private List<string> months = new()
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December",
    };
    private string? selectedMonth;

    private List<int> years = new();
    private int selectedYear;

    private List<RoomInventoryRow> inventoryRows = new();
    private Dictionary<int, string> remarks = new();
    private bool showPrintPreview;
    private System.Drawing.Color chartColor = System.Drawing.Color.FromArgb(0x44, 0x72, 0xc4);

    private List<DailyRoomInventoryRow> dailyInventoryRows = new();

    private int SelectedMonthNumber => months.IndexOf(selectedMonth ?? "January") + 1;
    private int DaysInMonth => DateTime.DaysInMonth(selectedYear, SelectedMonthNumber);

    private List<RoomInventoryChartPoint> ChartData =>
        Enumerable.Range(1, DaysInMonth).Select(d => new RoomInventoryChartPoint { Day = d, Total = GetTotal(d) }).ToList();

    private decimal DailyTotalOccPercent(Func<DailyRoomInventoryRow, int> availableSelector)
    {
        var totalRooms = dailyInventoryRows.Sum(r => r.TotalRoom);
        var totalAvailable = dailyInventoryRows.Sum(availableSelector);
        return totalRooms == 0 ? 0 : Math.Round((decimal)totalAvailable / totalRooms * 100, 2);
    }

    private List<OccupancySlice> BuildOccupancyPie(Func<DailyRoomInventoryRow, int> availableSelector)
    {
        var totalRooms = dailyInventoryRows.Sum(r => r.TotalRoom);
        var available = dailyInventoryRows.Sum(availableSelector);
        var occupied = totalRooms - available;
        decimal availPct = totalRooms == 0 ? 0 : Math.Round((decimal)available / totalRooms * 100, 2);
        decimal occPct = totalRooms == 0 ? 0 : Math.Round((decimal)occupied / totalRooms * 100, 2);

        return new List<OccupancySlice>
        {
            new() { Name = $"Availability ({available})", Value = availPct },
            new() { Name = $"Occupancy ({occupied})", Value = occPct },
        };
    }

    private List<OccupancySlice> RealTimeOccupancyData => BuildOccupancyPie(r => r.RealTimeAvailable);
    private List<OccupancySlice> ForecastedOccupancyData => BuildOccupancyPie(r => r.ForecastedAvailable);

    private void CustomizeOccupancyPointColor(DevExpress.Blazor.ChartSeriesPointCustomizationSettings settings)
    {
        var argument = settings.Point.Argument?.ToString() ?? "";
        settings.PointAppearance.Color = argument.StartsWith("Availability")
            ? System.Drawing.Color.FromArgb(0x43, 0xa0, 0x47)
            : System.Drawing.Color.FromArgb(0xe5, 0x39, 0x35);
    }

    protected override void OnInitialized()
    {
        selectedHotel = hotels.FirstOrDefault();
        selectedYear = DateTime.Today.Year;
        selectedMonth = months[DateTime.Today.Month - 1];
        years = Enumerable.Range(DateTime.Today.Year - 1, 4).ToList();
        GenerateInventory();
        GenerateDailyInventory();
    }

    private void GenerateInventory()
    {
        var newRows = new List<RoomInventoryRow>();

        foreach (var (type, count) in new (string, int)[] { ("Standard", 10), ("Delux", 10) })
        {
            var row = new RoomInventoryRow { RoomType = type };

            for (int d = 1; d <= DaysInMonth; d++)
            {
                if (d == 15)
                    row.DailyCounts[d] = 9;
                else if (d >= 20)
                    row.DailyCounts[d] = 3;
                else
                    row.DailyCounts[d] = 0;
            }

            newRows.Add(row);
        }

        inventoryRows = newRows;
        remarks.Clear();
    }

    private void UpdateCount(RoomInventoryRow row, int day, object? value)
    {
        if (int.TryParse(value?.ToString(), out var count))
            row.DailyCounts[day] = count;
    }

    private void GenerateDailyInventory()
    {
        dailyInventoryRows = new List<DailyRoomInventoryRow>
        {
            new()
            {
                RoomType = "Standard",
                TotalRoom = 7,
                TotalRegistration = 1,
                InHouseRoom = 1,
                StayOverRoom = 1,
                DueOutRoom = 0,
                CheckOutRoom = 0,
                SixPMRoom = 0,
                RealTimeAvailable = 6,
                ForecastedAvailable = 6,
            },
            new()
            {
                RoomType = "Delux",
                TotalRoom = 7,
                TotalRegistration = 0,
                InHouseRoom = 0,
                StayOverRoom = 0,
                DueOutRoom = 0,
                CheckOutRoom = 0,
                SixPMRoom = 0,
                RealTimeAvailable = 7,
                ForecastedAvailable = 7,
            },
        };
    }

    private int GetTotal(int day) => inventoryRows.Sum(r => r.DailyCounts.TryGetValue(day, out var c) ? c : 0);

    private string GetRemark(int day) => remarks.TryGetValue(day, out var r) ? r : "";

    private void SetRemark(int day, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            remarks.Remove(day);
        else
            remarks[day] = value;
    }

    private void Refresh() => GenerateInventory();

    private void OpenPrintPreview() => showPrintPreview = true;

    private void ClosePage() => NavigationManager.NavigateTo("/dashboard");

    private class RoomInventoryChartPoint
    {
        public int Day { get; set; }
        public int Total { get; set; }
    }

    private class DailyRoomInventoryRow
    {
        public string RoomType { get; set; } = "";
        public int TotalRoom { get; set; }
        public int TotalRegistration { get; set; }
        public int InHouseRoom { get; set; }
        public int StayOverRoom { get; set; }
        public int DueOutRoom { get; set; }
        public int CheckOutRoom { get; set; }
        public int SixPMRoom { get; set; }
        public int RealTimeAvailable { get; set; }
        public int ForecastedAvailable { get; set; }

        public decimal RealTimeOccPercent =>
            TotalRoom == 0 ? 0 : Math.Round((decimal)RealTimeAvailable / TotalRoom * 100, 2);

        public decimal ForecastedOccPercent =>
            TotalRoom == 0 ? 0 : Math.Round((decimal)ForecastedAvailable / TotalRoom * 100, 2);
    }

    private class OccupancySlice
    {
        public string Name { get; set; } = "";
        public decimal Value { get; set; }
    }
}
