    // ---- Room Search Methods ----
    void OpenRoomSearch()
    {
        isMultiRoomSearch = false;
        showRoomSearch = true;
    }

    void OpenMultiRoomSearch()
    {
        isMultiRoomSearch = true;
        selectedRooms.Clear();
        showRoomSearch = true;
    }

    void SelectRoom()
    {
        if (selectedRoom == null) return;

        if (selectedRoom.HKStatus == "Dirty")
        {
            ValidationMessage = "The selected room is Dirty. Please, select another room.";
            return;
        }

        // Update both NewReg and CheckInReg room values
        NewReg.Room = selectedRoom.Room;
        CheckInReg.Room = selectedRoom.Room;

        showRoomSearch = false;
    }

    void SelectMultipleRooms(List<Components.Shared.RoomItem> rooms)
    {
        if (rooms == null || rooms.Count == 0) return;

        int nights = (CheckInReg.Departure - CheckInReg.Arrival).Days;
        if (nights < 1) nights = 1;

        var existingRooms = rooms.Where(r => Lines.Any(l => l.Room == r.Room)).Select(r => r.Room).ToList();
        if (existingRooms.Count > 0)
        {
            ValidationMessage = $"Room(s) {string.Join(", ", existingRooms)} is already added to the registration list.";
        }

        foreach (var r in rooms)
        {
            if (!Lines.Any(l => l.Room == r.Room))
            {
                var newLine = new RegistrationLine
                {
                    Room = r.Room,
                    RoomType = r.RoomType,
                    Guest = CheckInReg.Guest ?? "",
                    Arrival = CheckInReg.Arrival,
                    Departure = CheckInReg.Departure,
                    NoOfNight = nights,
                    Adult = CheckInReg.Adult,
                    Child = CheckInReg.Child,
                    Rate = CheckInReg.Rate ?? "",
                    Amount = CheckInReg.RateAmount,
                    TotalAmount = CheckInReg.RateAmount * nights
                };
                Lines.Add(newLine);
            }
        }
        StateHasChanged();
    }

    // ---- Rate Search Methods ----
    void OpenRateSearch() => showRateSearch = true;

    void OpenLineRateLookup(RegistrationLine line)
    {
        activeLineForRateLookup = line;
        rateStartDate = line.Arrival;
        rateEndDate = line.Departure;
        showRateSearch = true;
    }

    void SearchRates() { }
    void ShowRateInfo() { }

    void OnRateRowClick(GridRowClickEventArgs e)
    {
        selectedRateRow = e.Grid?.GetDataItem(e.VisibleIndex);
    }

    void OnRateCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && selectedRateRow != null)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex);
            if (item != null)
            {
                var itemNameProp = item.GetType().GetProperty("Name");
                var selectedNameProp = selectedRateRow.GetType().GetProperty("Name");

                var itemName = itemNameProp?.GetValue(item)?.ToString();
                var selectedName = selectedNameProp?.GetValue(selectedRateRow)?.ToString();

                if (itemName == selectedName)
                    e.CssClass = "rate-row-selected";
            }
        }
    }

    void SelectRate()
    {
        if (selectedRateRow != null)
        {
            // Handle dynamic object - use reflection to get properties
            var nameProp = selectedRateRow.GetType().GetProperty("Name");
            var standardRoomProp = selectedRateRow.GetType().GetProperty("StandardRoom");

            var name = nameProp?.GetValue(selectedRateRow)?.ToString() ?? "";
            var standardRoom = standardRoomProp?.GetValue(selectedRateRow)?.ToString() ?? "";

            decimal.TryParse(standardRoom, out decimal rateAmount);

            if (activeLineForRateLookup != null)
            {
                activeLineForRateLookup.Rate = name;
                if (rateAmount > 0)
                {
                    activeLineForRateLookup.Amount = rateAmount;
                    activeLineForRateLookup.TotalAmount = rateAmount * activeLineForRateLookup.NoOfNight;
                }
                activeLineForRateLookup = null;
            }
            else
            {
                NewReg.Rate = name;
                CheckInReg.Rate = name;
                if (rateAmount > 0)
                {
                    NewReg.RateAmount = rateAmount;
                    CheckInReg.RateAmount = rateAmount;
                }
            }
        }
        showRateSearch = false;
    }

