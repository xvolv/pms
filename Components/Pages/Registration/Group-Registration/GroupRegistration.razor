@page "/group-registration"
@using static RegistrationLinesGrid
@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Shared
@using ERP.V7.WebPMS.Components.Pages.Profile.Company.Models
@using ERP.V7.WebPMS.Components.Pages.Profile.Group.Models
@using ERP.V7.WebPMS.Components.Pages.Profile.Shared
@using ERP.V7.WebPMS.Components.Pages.Profile.Company
@using ERP.V7.WebPMS.Components.Pages.Profile.Group
@using ERP.V7.WebPMS.Components.Pages.Profile.Guest

<div class="grpreg-page">

    @* ---------------- Toolbar ---------------- *@
    <div class="grpreg-toolbar">
        <div class="grpreg-tbtn" @onclick="OnNew">
            <i class="bi bi-file-earmark-plus grpreg-icon grpreg-icon-dark"></i>
            <span>New</span>
        </div>
        
        @if (Master.State == "Inhouse")
        {
            <div class="grpreg-tbtn" title="Check In" @onclick="OnCheckIn">
                <i class="bi bi-check-circle-fill grpreg-icon grpreg-icon-green"></i>
                <span>Check In</span>
            </div>
        }
        else
        {
            <div class="grpreg-tbtn" title="Save" @onclick="OnSave">
                <i class="bi bi-floppy grpreg-icon grpreg-icon-blue"></i>
                <span>Save</span>
            </div>
        }

        <div class="grpreg-tbsep"></div>

        <div class="grpreg-field-inline">
            <i class="bi bi-flag-fill grpreg-icon-flag"></i>
            <label>State</label>
            <DxComboBox Data="@StateOptions" @bind-Value="@Master.State" CssClass="erp-combobox" />
        </div>

        <div class="grpreg-field-inline">
            <HotelDropdown @bind-selectedHotel="Master.Hotel" />
        </div>

        <div class="grpreg-tb-spacer"></div>
    </div>

    @* ---------------- Master Information ---------------- *@
    <div class="grpreg-section-header">Master Information</div>

    <div class="grpreg-master-form">
        <div class="grpreg-master-col">
            <div class="grpreg-form-row">
                <label>Customer</label>
                <div class="lookup-field">
                    <DxTextBox @bind-Text="Master.Customer" ReadOnly="true" Width="100%"
                               CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Customer"))" />
                    <button type="button" class="lookup-toggle-btn"
                            @onclick="@(() => OpenLookup("Customer"))">▾</button>
                </div>
            </div>
            <div class="grpreg-form-row">
                <label>Purpose of Travel</label>
                <div class="lookup-field">
                    <DxTextBox @bind-Text="Master.PurposeOfTravel" ReadOnly="true" Width="100%"
                               CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Purpose"))" />
                    <button type="button" class="lookup-toggle-btn" @onclick="@(() => OpenLookup("Purpose"))">▾</button>
                </div>
            </div>
            <div class="grpreg-form-row">
                <label>Arrival Date</label>
                <DxDateEdit @bind-Date="@Master.ArrivalDate" CssClass="erp-combobox w-100" DisplayFormat="M/d/yyyy"
                            DropDownBodyCssClass="grpreg-dropdown-body" />
            </div>
            <div class="grpreg-form-row">
                <label>Departure Date</label>
                <DxDateEdit @bind-Date="@Master.DepartureDate" CssClass="erp-combobox w-100" DisplayFormat="M/d/yyyy"
                            DropDownBodyCssClass="grpreg-dropdown-body" />
            </div>
            <div class="grpreg-form-row">
                <label>No of Night</label>
                <DxSpinEdit @bind-Value="@Master.NoOfNight" CssClass="dx-input-num w-100" MinValue="1" />
            </div>
        </div>

        <div class="grpreg-master-col">
            <div class="grpreg-form-row">
                <label>Group</label>
                <div class="lookup-field">
                    <DxTextBox @bind-Text="Master.Group" ReadOnly="true" Width="100%"
                               CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Group"))" />
                    <button type="button" class="lookup-toggle-btn" @onclick="@(() => OpenLookup("Group"))">▾</button>
                </div>
            </div>
            <div class="grpreg-form-row">
                <label>Date</label>
                <DxTextBox Text="@Master.Date.ToString("M/d/yyyy h:mm:ss tt")" ReadOnly="true"
                           CssClass="erp-combobox w-100" />
            </div>
            <div class="grpreg-form-row">
                <label>Arrival Time</label>
                <DxTimeEdit @bind-Time="@Master.ArrivalTime" CssClass="dx-input-num w-100" Format="t" />
            </div>
            <div class="grpreg-form-row">
                <label>Departure Time</label>
                <DxTimeEdit @bind-Time="@Master.DepartureTime" CssClass="dx-input-num w-100" Format="t" />
            </div>
            <div class="grpreg-form-row">
                <label>Payment Method</label>
                <div class="lookup-field">
                    <DxTextBox @bind-Text="Master.PaymentMethod" ReadOnly="true" Width="100%"
                               CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("PaymentMethod"))" />
                    <button type="button" class="lookup-toggle-btn"
                            @onclick="@(() => OpenLookup("PaymentMethod"))">▾</button>
                </div>
            </div>
        </div>
    </div>
    <br />
    @* ---------------- Tabs ---------------- *@
    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" CssClass="grpreg-tabs">
        <DxTabPage Text="New Registrations" />
        <DxTabPage Text="Existing Registrations" />
        <DxTabPage Text="Registations By Room" />
    </DxTabs>


    <div class="grpreg-tabcontent">

        @if (ActiveTabIndex == 0)
        {
            @* -------- New Registrations -------- *@
            <div class="grpreg-input-row">
                <div class="grpreg-input-cell">
                    <label>Guest</label>
                    <div class="lookup-field">
                        <DxTextBox @bind-Text="NewReg.Guest" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Guest"))" />
                        <button type="button" class="lookup-toggle-btn" @onclick="@(() => OpenLookup("Guest"))">▾</button>
                    </div>
                </div>
                <div class="grpreg-input-cell">
                    <label>Arrival</label>
                    <DxDateEdit @bind-Date="@NewReg.Arrival" CssClass="erp-combobox w-100" DisplayFormat="M/d/yyyy"
                                DropDownBodyCssClass="grpreg-dropdown-body" />
                </div>
                <div class="grpreg-input-cell">
                    <label>Departure</label>
                    <DxDateEdit @bind-Date="@NewReg.Departure" CssClass="erp-combobox w-100" DisplayFormat="M/d/yyyy"
                                DropDownBodyCssClass="grpreg-dropdown-body" />
                </div>
                <div class="grpreg-input-cell grpreg-input-cell-sm">
                    <label>Adult</label>
                    <DxSpinEdit @bind-Value="@NewReg.Adult" CssClass="dx-input-num w-100" MinValue="0" />
                </div>
                <div class="grpreg-input-cell grpreg-input-cell-sm">
                    <label>Child</label>
                    <DxSpinEdit @bind-Value="@NewReg.Child" CssClass="dx-input-num w-100" MinValue="0" />
                </div>
                <div class="grpreg-input-cell">
                    <label>Room</label>
                    <div class="lookup-field">
                        <DxTextBox @bind-Text="NewReg.Room" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" Click="OpenRoomSearch" />
                        <button type="button" class="lookup-toggle-btn" @onclick="OpenRoomSearch">▾</button>
                    </div>
                </div>
                <div class="grpreg-input-cell">
                    <label>Rate</label>
                    <div class="lookup-field">
                        <DxTextBox @bind-Text="NewReg.Rate" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" Click="OpenRateSearch" />
                        <button type="button" class="lookup-toggle-btn" @onclick="OpenRateSearch">▾</button>
                    </div>
                </div>
                <div class="grpreg-input-cell">
                    <label>Rate Amount</label>
                    <DxSpinEdit Value="@NewReg.RateAmount" ReadOnly="true" CssClass="dx-input-num w-100"
                                DisplayFormat="N2" />
                </div>
            </div>

            <div class="grpreg-actions-row">
                <button type="button" class="grpreg-action-btn" @onclick="AddNewRegistrationLine">
                    <i class="bi bi-plus-circle-fill grpreg-icon-green-sm"></i> Add
                </button>
                <button type="button" class="grpreg-action-btn" @onclick="RemoveSelectedLine">
                    <i class="bi bi-x-circle-fill grpreg-icon-red-sm"></i> Remove
                </button>
            </div>

            <RegistrationLinesGrid Lines="@Lines" @bind-SelectedLine="@SelectedLine" />
        }
        else if (ActiveTabIndex == 1)
        {
            @* -------- Existing Registrations -------- *@
            <div class="grpreg-input-row">
                <div class="grpreg-input-cell grpreg-existing-lookup-cell">
                    <label>Registrations</label>
                    <div class="lookup-field">
                        <DxTextBox @bind-Text="SelectedLookupItemCode" ReadOnly="true" Width="100%"
                                   CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Registration"))" />
                        <button type="button" class="lookup-toggle-btn"
                                @onclick="@(() => OpenLookup("Registration"))">▾</button>
                    </div>
                </div>
            </div>

            <div class="grpreg-actions-row">
                <button type="button" class="grpreg-action-btn" @onclick="AddExistingRegistrationLine">
                    <i class="bi bi-plus-circle-fill grpreg-icon-green-sm"></i> Add
                </button>
                <button type="button" class="grpreg-action-btn" @onclick="RemoveSelectedLine">
                    <i class="bi bi-x-circle-fill grpreg-icon-red-sm"></i> Remove
                </button>
            </div>

            <RegistrationLinesGrid Lines="@Lines" @bind-SelectedLine="@SelectedLine" />
        }
        else
        {
            @* -------- Registrations By Room (Check-in) -------- *@
            <div class="grpreg-byroom-wrap">
                <div class="grpreg-byroom-fields">
                    <div class="grpreg-input-row">
                        <div class="grpreg-input-cell grpreg-input-cell-wide">
                            <label>Guest's</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="CheckInReg.Guest" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Guest"))" />
                                <button type="button" class="lookup-toggle-btn"
                                        @onclick="@(() => OpenLookup("Guest"))">▾</button>
                            </div>
                        </div>
                        <div class="grpreg-input-cell">
                            <label>Arrival Date</label>
                            <DxDateEdit @bind-Date="@CheckInReg.Arrival" CssClass="erp-combobox w-100"
                                        DisplayFormat="M/d/yyyy" DropDownBodyCssClass="grpreg-dropdown-body" />
                        </div>
                        <div class="grpreg-input-cell">
                            <label>Default Rate</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="CheckInReg.Rate" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="OpenRateSearch" />
                                <button type="button" class="lookup-toggle-btn" @onclick="OpenRateSearch">▾</button>
                            </div>
                        </div>
                    </div>

                    <div class="grpreg-input-row">
                        <div class="grpreg-input-cell grpreg-input-cell-sm">
                            <label>Adult</label>
                            <DxSpinEdit @bind-Value="@CheckInReg.Adult" CssClass="dx-input-num w-100" MinValue="0" />
                        </div>
                        <div class="grpreg-input-cell grpreg-input-cell-sm">
                            <label>Child</label>
                            <DxSpinEdit @bind-Value="@CheckInReg.Child" CssClass="dx-input-num w-100" MinValue="0" />
                        </div>
                        <div class="grpreg-input-cell">
                            <label>Departure Date</label>
                            <DxDateEdit @bind-Date="@CheckInReg.Departure" CssClass="erp-combobox w-100"
                                        DisplayFormat="M/d/yyyy" DropDownBodyCssClass="grpreg-dropdown-body" />
                        </div>
                        <div class="grpreg-input-cell">
                            <label>Rate Amount</label>
                            <DxSpinEdit Value="@CheckInReg.RateAmount" ReadOnly="true" CssClass="dx-input-num w-100"
                                        DisplayFormat="N2" />
                        </div>
                    </div>
                </div>

                <div class="grpreg-select-rooms-btn" @onclick="OpenMultiRoomSearch">
                    <i class="bi bi-check-circle-fill grpreg-icon-green-lg"></i>
                    <span>Select Room's</span>
                </div>
            </div>

            <div class="grpreg-actions-row">
                <button type="button" class="grpreg-action-btn" @onclick="AddCheckInRegistrationLine">
                    <i class="bi bi-plus-circle-fill grpreg-icon-green-sm"></i> Add
                </button>
                <button type="button" class="grpreg-action-btn" @onclick="RemoveSelectedLine">
                    <i class="bi bi-x-circle-fill grpreg-icon-red-sm"></i> Remove
                </button>
            </div>

            <RegistrationLinesGrid Lines="@Lines" @bind-SelectedLine="@SelectedLine" AllowGuestModal="true"
                                   AllowFullEdit="true" GuestOptions="@GuestNameList" OnGuestLookupClick="OpenLineGuestLookup"
                                   OnRateLookupClick="OpenLineRateLookup" />
        }
    </div>

    @* ============== LOOKUP PANELS ============== *@
    <!-- ===================== LOOKUP POPUP MODALS ===================== -->
    <CompanySearchPopup @bind-Visible="ShowCustomerLookup"
                        Customers="@Customers"
                        OnSelect="SelectCustomer"
                        OnAddNew="AddNewCompany"
                        OnClear="ClearCustomer" />

    <GuestSearchPopup @bind-Visible="ShowGuestLookup"
                       Guests="@Guests"
                       OnSelect="SelectGuest"
                       OnAddNew="AddNewGuest"
                       OnClear="ClearGuest" />

    <GroupSearchPopup @bind-Visible="ShowGroupLookup"
                      Groups="@Groups"
                      OnSelect="SelectGroup"
                      OnAddNew="AddNewGroup"
                      OnClear="ClearGroup" />

    <RegistrationSearchPopup @bind-Visible="ShowRegistrationsLookup"
                             Items="@LookupItems"
                             OnSelect="SelectRegistrationLookup"
                             OnClear="ClearRegistrationsLookup" />

        <DxPopup @bind-Visible="ShowErrorPopup" HeaderText="Information" Width="420px" CloseOnOutsideClick="true"
                 ShowCloseButton="true" CloseOnEscape="true">
            <BodyContentTemplate>
                <div style="display:flex; align-items:center; gap:16px; padding:20px 16px;">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size:32px; color:#dc3545; flex-shrink:0;"></i>
                    <span style="font-size:14px; color:#212529; font-weight:500; line-height:1.4;">@ValidationMessage</span>
                </div>
                <div
                    style="display:flex; justify-content:flex-end; padding:10px 16px; background:#f8f9fa; border-top:1px solid #e9ecef;">
                    <button type="button" class="btn btn-primary btn-sm" style="min-width:80px;"
                            @onclick="() => ShowErrorPopup = false">OK</button>
                </div>
            </BodyContentTemplate>
        </DxPopup>

        <!-- ===================== ROOM SEARCH POPUP ===================== -->
        <RoomSearchPopup @bind-Visible="showRoomSearch" GuestName="@CheckInReg.Guest" MultiSelect="@isMultiRoomSearch"
                         @bind-SelectedRoom="selectedRoom" SelectedRooms="@selectedRooms" OnSelect="SelectRoom"
                         OnSelectMulti="SelectMultipleRooms" />

        <!-- ===================== RATE SEARCH POPUP ===================== -->
        <RateSearchPopup @bind-Visible="showRateSearch" StartDate="rateStartDate" EndDate="rateEndDate"
                         RateSearchRows="rateSearchRows" OnSelect="SelectRate" OnSearch="SearchRates" OnRateInfo="ShowRateInfo"
                         OnRowClick="OnRateRowClick" OnCustomizeElement="OnRateCustomizeElement" />

        <!-- ===================== FORM MODALS ===================== -->
        <DxPopup @bind-Visible="ShowCompanyModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
                 HeaderText="Add New Company" CloseOnEscape="true">
            <BodyContentTemplate>
                <Company IsModal="true" OnSaved="HandleCompanySaved" OnClose="() => ShowCompanyModal = false" />
            </BodyContentTemplate>
        </DxPopup>

        <DxPopup @bind-Visible="ShowGroupModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
                 HeaderText="Add New Group" CloseOnEscape="true">
            <BodyContentTemplate>
                <Group IsModal="true" OnSaved="HandleGroupSaved" OnClose="() => ShowGroupModal = false" />
            </BodyContentTemplate>
        </DxPopup>

        <DxPopup @bind-Visible="ShowGuestModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
                 HeaderText="Add New Guest" CloseOnEscape="true">
            <BodyContentTemplate>
                <Guest IsModal="true" OnSaved="HandleGuestSaved" OnClose="() => ShowGuestModal = false" />
            </BodyContentTemplate>
        </DxPopup>
    </div>

@code {
    int ActiveTabIndex { get; set; }

    bool ShowErrorPopup { get; set; }
    string _validationMessage = "";
    string ValidationMessage
    {
        get => _validationMessage;
        set
        {
            _validationMessage = value;
            if (!string.IsNullOrWhiteSpace(value))
            {
                ShowErrorPopup = true;
            }
        }
    }



    // ---- Global Components State ----
    // Room Search
    bool showRoomSearch = false;
    bool isMultiRoomSearch = false;
    Components.Shared.RoomItem? selectedRoom;
    List<Components.Shared.RoomItem> selectedRooms = new();
    RegistrationLine? activeLineForGuestLookup;
    RegistrationLine? activeLineForRateLookup;

    List<string> GuestNameList => Guests.Select(g => FormatGuestName(g)).Concat(new[] { "JANE", "JANE DOE", "ABEBE KEBEDE",
"JOHN SMITH", "Solomon Tuffa Bereket", "miskir engida engida" }).Distinct().ToList();

    // Rate Search
    bool showRateSearch = false;
    DateTime? rateStartDate = DateTime.Today;
    DateTime? rateEndDate = DateTime.Today.AddDays(1);
    object? selectedRateRow;
    List<object> rateSearchRows = new()
    {
        new { Name = "Physical Inventory", StandardRoom = "16", Executive = "13", PseudoRooms = "5" },
        new { Name = "Standard Rate", StandardRoom = "275.00", Executive = "", PseudoRooms = "" },
        new { Name = "Special Rate", StandardRoom = "300.00", Executive = "", PseudoRooms = "" },
        new { Name = "Posting Date Rate", StandardRoom = "200.00", Executive = "", PseudoRooms = "" },
        new { Name = "Arrival Date Rate", StandardRoom = "300.00", Executive = "", PseudoRooms = "" },
    };

    MasterInfo Master { get; set; } = new()
    {
        Date = DateTime.Now,
        ArrivalDate = DateTime.Today,
        DepartureDate = DateTime.Today.AddDays(1),
        NoOfNight = 1,
        ArrivalTime = TimeSpan.Zero,
        DepartureTime = TimeSpan.Zero,
        State = "Inhouse",
        Hotel = "1",
        PaymentMethod = "Cash",
        Group = "JANE",
        Customer = "RED CLOUD ICT SOLUTIONS PLC"
    };

    NewRegistrationInput NewReg { get; set; } = new()
    {
        Arrival = DateTime.Today,
        Departure = DateTime.Today.AddDays(1),
        Adult = 1,
        Child = 0
    };

    CheckInRegistrationInput CheckInReg { get; set; } = new()
    {
        Arrival = DateTime.Today,
        Departure = DateTime.Today.AddDays(1),
        Adult = 1,
        Child = 0
    };

    List<RegistrationLine> Lines { get; set; } = new();
    RegistrationLine? SelectedLine { get; set; }

    // ---- Lookups visibility ----
    bool ShowCustomerLookup { get; set; }
    bool ShowPurposeLookup { get; set; }
    bool ShowGuestLookup { get; set; }
    bool ShowRegistrationsLookup { get; set; }
    bool ShowGroupLookup { get; set; }
    bool ShowPaymentMethodLookup { get; set; }
    bool GuestLookupForCheckIn { get; set; }

    // ---- Form modals visibility ----
    bool ShowCompanyModal { get; set; }
    bool ShowGroupModal { get; set; }
    bool ShowGuestModal { get; set; }

    string CustomerSearchText { get; set; } = "";
    string PurposeSearchText { get; set; } = "";
    string GuestSearchText { get; set; } = "";
    string LookupSearchText { get; set; } = "";
    string GroupSearchText { get; set; } = "";
    string PaymentMethodSearchText { get; set; } = "";
    RegistrationLookupItem? SelectedLookupItem { get; set; }

    string? SelectedLookupItemCode
    {
        get => SelectedLookupItem?.Code;
        set => SelectedLookupItem = LookupItems.FirstOrDefault(i => i.Code == value);
    }

    void OnSelectedLookupItemCodeChanged(string? code)
    {
        SelectedLookupItem = LookupItems.FirstOrDefault(i => i.Code == code);
    }

    // Unified lookup method
    void OpenLookup(string lookupType)
    {
        switch (lookupType)
        {
            case "Customer":
                ShowCustomerLookup = true;
                break;
            case "Purpose":
                ShowPurposeLookup = true;
                break;
            case "Guest":
                GuestLookupForCheckIn = ActiveTabIndex == 2; // Check-in tab
                ShowGuestLookup = true;
                break;
            case "Registration":
                ShowRegistrationsLookup = true;
                break;
            case "Group":
                ShowGroupLookup = true;
                break;
            case "PaymentMethod":
                ShowPaymentMethodLookup = true;
                break;
        }
    }

    // ---- Mock data (MVP) ----
    List<CustomerItem> Customers { get; set; } = new List<CustomerItem>()
    {
        new() { Code = "PCU00000", FirstName = "RED CLOUD ICT SOLUTIONS PLC", MiddleName = "RED CLOUD ICT SOL...", Tin = "0076217301" }
    };

    List<string> PurposeOptions { get; set; } = new List<string>()
    {
        "Business", "Conference", "Education", "Medical", "Pleasure", "Tourism",
        "Transit", "Vacation", "Wedding", "Holiday", "Shopping"
    };

    List<GuestItem> Guests { get; set; } = new List<GuestItem>()
    {
        new() { FirstName = "JANE", MiddleName = "DOE", Tin = "" },
        new() { FirstName = "ABEBE", MiddleName = "KEBEDE", Tin = "" },
        new() { FirstName = "TEST", MiddleName = "", Tin = "" }
    };

    List<GroupItem> Groups { get; set; } = new List<GroupItem>()
    {
        new() { Code = "GRP-001", Name = "JANE", Description = "Jane Tour Group" },
        new() { Code = "GRP-002", Name = "ABEBE", Description = "Abebe Corporate Group" }
    };

    List<RegistrationLookupItem> LookupItems { get; set; } = new List<RegistrationLookupItem>()
    {
        new() { Code = "REG-00000-26", Guest = "JANE DOE", RoomNumber = "101", RoomType = "Standard" },
        new() { Code = "REG-00001-26", Guest = "JANE DOE", RoomNumber = "205", RoomType = "Delux" },
        new() { Code = "REG-00002-26", Guest = "JANE DOE", RoomNumber = "207", RoomType = "Delux" },
        new() { Code = "REG-00003-26", Guest = "JANE DOE", RoomNumber = "208", RoomType = "Delux" },
        new() { Code = "REG-00004-26", Guest = "JANE DOE", RoomNumber = "209", RoomType = "Delux" },
        new() { Code = "REG-00005-26", Guest = "JANE DOE", RoomNumber = "210", RoomType = "Delux" },
        new() { Code = "REG-00006-26", Guest = "JANE DOE", RoomNumber = "102", RoomType = "Standard" },
        new() { Code = "REG-00007-26", Guest = "JANE DOE", RoomNumber = "103", RoomType = "Standard" }
    };

    List<string> StateOptions { get; set; } = new List<string>() { "Waiting List", "6PM", "Guaranteed", "Inhouse" };
    List<string> GroupOptions { get; set; } = new List<string>() { "JANE", "ABEBE", "KEBEDE", "OTHER GROUP" };
    List<string> PaymentMethodOptions { get; set; } = new List<string>() { "Cash", "Credit Card", "Bank Transfer" };
    List<string> RateOptions { get; set; } = new List<string>() { "RACK", "CORP", "GROUP", "PROMO", "Rate 1" };



    void OnNew()
    {
        Master = new MasterInfo
        {
            Date = DateTime.Now,
            ArrivalDate = DateTime.Today,
            DepartureDate = DateTime.Today.AddDays(1),
            NoOfNight = 1,
            ArrivalTime = TimeSpan.Zero,
            DepartureTime = TimeSpan.Zero,
            State = "Inhouse",
            Hotel = "1",
            PaymentMethod = "Cash"
        };
        Lines.Clear();
        SelectedLine = null;
        NewReg = new() { Arrival = DateTime.Today, Departure = DateTime.Today.AddDays(1), Adult = 1 };
        CheckInReg = new() { Arrival = DateTime.Today, Departure = DateTime.Today.AddDays(1), Adult = 1 };
        ValidationMessage = "";
    }

    void OnCheckIn()
    {
        if (Lines.Count == 0)
        {
            ValidationMessage = "Add at least one registration line before Check In.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Master.Customer))
        {
            ValidationMessage = "Customer is required.";
            return;
        }
        var unassignedRateLine = Lines.FirstOrDefault(l => string.IsNullOrWhiteSpace(l.Rate));
        if (unassignedRateLine != null)
        {
            ValidationMessage = $"Rate must be selected for all registration lines before Check In (Room {unassignedRateLine.Room} has no rate).";
            return;
        }
        Master.State = "Inhouse";
        ValidationMessage = $"Check-In successful for {Lines.Count} room(s). State set to Inhouse.";
    }

    void OnSave()
    {
        if (string.IsNullOrWhiteSpace(Master.Customer))
        {
            ValidationMessage = "Customer is required.";
            return;
        }
        ValidationMessage = $"Registration saved successfully for state: {Master.State}.";
    }

    void OnClose()
    {
        // In a real app navigate away / close the form
        ValidationMessage = "Close requested.";
    }

    void OnSelectRooms()
    {
        ValidationMessage = "Use the Room search button to select a room.";
    }

    bool ValidateLine(string? guest, DateTime arrival, DateTime departure, int adult, string? room, string? rate)
    {
        if (string.IsNullOrWhiteSpace(guest))
        {
            ValidationMessage = "Guest is required.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(room))
        {
            ValidationMessage = "Room is required.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(rate))
        {
            ValidationMessage = "Rate is required.";
            return false;
        }
        if (departure <= arrival)
        {
            ValidationMessage = "Departure must be after Arrival.";
            return false;
        }
        if (adult < 1)
        {
            ValidationMessage = "At least 1 Adult is required.";
            return false;
        }
        ValidationMessage = "";
        return true;
    }



    void AddNewRegistrationLine()
    {
        if (!ValidateLine(NewReg.Guest, NewReg.Arrival, NewReg.Departure, NewReg.Adult, NewReg.Room, NewReg.Rate)) return;
        if (Lines.Any(l => l.Room == NewReg.Room))
        {
            ValidationMessage = $"Room {NewReg.Room} is already added to the registration list.";
            return;
        }

        var nights = (NewReg.Departure - NewReg.Arrival).Days;
        Lines.Add(new RegistrationLine
        {
            RoomType = "",
            Room = NewReg.Room ?? "",
            Guest = NewReg.Guest ?? "",
            Adult = NewReg.Adult,
            Child = NewReg.Child,
            Arrival = NewReg.Arrival,
            Departure = NewReg.Departure,
            NoOfNight = nights,
            Rate = NewReg.Rate ?? "",
            Amount = NewReg.RateAmount,
            TotalAmount = NewReg.RateAmount * nights
        });
    }

    void AddExistingRegistrationLine()
    {
        if (SelectedLookupItem == null)
        {
            ValidationMessage = "Select a registration first.";
            return;
        }
        Lines.Add(new RegistrationLine
        {
            RoomType = SelectedLookupItem.RoomType,
            Room = SelectedLookupItem.RoomNumber,
            Guest = SelectedLookupItem.Guest,
            Adult = 1,
            Child = 0,
            Arrival = Master.ArrivalDate,
            Departure = Master.DepartureDate,
            NoOfNight = Master.NoOfNight,
            Rate = "",
            Amount = 0,
            TotalAmount = 0
        });
        ValidationMessage = "";
    }

    void AddCheckInRegistrationLine()
    {
        if (!ValidateLine(CheckInReg.Guest, CheckInReg.Arrival, CheckInReg.Departure, CheckInReg.Adult, CheckInReg.Room,
CheckInReg.Rate)) return;
        if (Lines.Any(l => l.Room == CheckInReg.Room))
        {
            ValidationMessage = $"Room {CheckInReg.Room} is already added to the registration list.";
            return;
        }

        var nights = (CheckInReg.Departure - CheckInReg.Arrival).Days;
        Lines.Add(new RegistrationLine
        {
            RoomType = "",
            Room = CheckInReg.Room ?? "",
            Guest = CheckInReg.Guest ?? "",
            Adult = CheckInReg.Adult,
            Child = CheckInReg.Child,
            Arrival = CheckInReg.Arrival,
            Departure = CheckInReg.Departure,
            NoOfNight = nights,
            Rate = CheckInReg.Rate ?? "",
            Amount = CheckInReg.RateAmount,
            TotalAmount = CheckInReg.RateAmount * nights
        });
    }

    void RemoveSelectedLine()
    {
        if (SelectedLine == null) return;
        Lines.Remove(SelectedLine);
        SelectedLine = null;
    }

    // =====================================================
