    // ---- Form Modal Save Handlers ----
    void HandleCompanySaved(CompanyRow company)
    {
        // Create a CustomerItem from the saved company
        var newCustomer = new CustomerItem
        {
            Code = company.CorpId,
            FirstName = company.Name,
            MiddleName = company.Name.Length > 30 ? company.Name.Substring(0, 30) + "..." : company.Name,
            Tin = company.TinNo
        };

        // Add to the Customers list if it exists
        if (Customers == null)
        {
            Customers = new List<CustomerItem>();
        }
        Customers.Add(newCustomer);

        // Select the newly created customer
        Master.Customer = company.Name;
        Master.SelectedCustomerCode = company.CorpId;

        ShowCompanyModal = false;
    }

    void HandleGroupSaved(GroupRow group)
    {
        // Create a GroupItem from the saved group
        var newGroup = new GroupItem
        {
            Code = group.GroupId,
            Name = group.Name,
            Description = group.GroupType
        };

        // Add to the Groups list if it exists
        if (Groups == null)
        {
            Groups = new List<GroupItem>();
        }
        Groups.Add(newGroup);

        // Select the newly created group
        Master.Group = group.Name;

        ShowGroupModal = false;
    }

    void HandleGuestSaved(PersonProfileRow guest)
    {
        // Create a GuestItem from the saved guest
        var newGuest = new GuestItem
        {
            FirstName = guest.FirstName,
            MiddleName = guest.MiddleName,
            Tin = guest.PassportNum
        };

        // Add to the Guests list if it exists
        if (Guests == null)
        {
            Guests = new List<GuestItem>();
        }
        Guests.Add(newGuest);

        // Select the newly created guest based on context
        var guestName = string.IsNullOrWhiteSpace(guest.MiddleName) ? guest.FirstName : $"{guest.FirstName} {guest.MiddleName}";

        if (activeLineForGuestLookup != null)
        {
            activeLineForGuestLookup.Guest = guestName;
            activeLineForGuestLookup = null;
        }
        else if (GuestLookupForCheckIn)
        {
            CheckInReg.Guest = guestName;
        }
        else
        {
            NewReg.Guest = guestName;
        }

        ShowGuestModal = false;
    }

