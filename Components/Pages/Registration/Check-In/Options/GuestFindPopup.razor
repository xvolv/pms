@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="Guest" Width="480px"
         CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="amend-toolbar">
            <button type="button" class="ci-btn" @onclick="HandleClose">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <div style="display:flex; gap:8px; margin-bottom:8px;">
            <DxTextBox Width="100%" SizeMode="SizeMode.Small" />
            <DxButton Text="Find" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" />
        </div>
        <table class="multi-table" style="width:100%;">
            <thead>
                <tr><th>Full Name</th><th>Passport</th></tr>
            </thead>
            <tbody>
                @foreach (var name in GuestNames)
                {
                    <tr style="cursor:pointer;" @onclick="() => HandleSelect(name)">
                        <td>@name</td>
                        <td>EP155353</td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="margin-top:10px; display:flex; gap:8px; justify-content:flex-end;">
            <DxButton Text="Add New" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Primary"
                      Click="HandleAddNew" />
            <DxButton Text="Clear" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" />
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public List<string> GuestNames { get; set; } = new();

    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback OnAddNew { get; set; }

    protected override void OnParametersSet()
    {
        if (!GuestNames.Any())
        {
            GuestNames = new List<string>
            {
                "Solomon Tuffa Bereket", "miskir engida engida", "Solman Jack Jemes",
                "Taddeses ARABA Mola", "teshome mola", "Leo Rojas", "nathan w/mickael",
                "muse zemedkun", "abel kaleab", "Dog Snoop", "bayu abenezer", "Selase bonjour Bete"
            };
        }
    }

    async Task HandleSelect(string name)
    {
        await OnSelect.InvokeAsync(name);
        await VisibleChanged.InvokeAsync(false);
    }

    async Task HandleAddNew() => await OnAddNew.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}
