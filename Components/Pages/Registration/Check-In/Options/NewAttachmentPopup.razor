@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="New Attachment" Width="520px"
         CloseOnOutsideClick="false" ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div class="amend-toolbar">
            <button type="button" class="ci-btn" @onclick="HandleSave">
                <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-floppy"></i></div>
                <div class="ci-text">Save</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleBrowse">
                <div class="ci-icon" style="color:#555;"><i class="bi bi-folder2-open"></i></div>
                <div class="ci-text">Browse</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleScan">
                <div class="ci-icon" style="color:#555;"><i class="bi bi-printer"></i></div>
                <div class="ci-text">Scan</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleCamera">
                <div class="ci-icon" style="color:#555;"><i class="bi bi-camera"></i></div>
                <div class="ci-text">Camera</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleEdit">
                <div class="ci-icon" style="color:#555;"><i class="bi bi-pencil"></i></div>
                <div class="ci-text">Edit</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleClose">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <div class="amend-form">
            <div class="amend-row">
                <label>Url</label>
                <DxTextBox @bind-Text="Url" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row">
                <label></label>
                <DxCheckBox @bind-Checked="IsUrlOnly">Url Only</DxCheckBox>
            </div>
            <div class="amend-row">
                <label>Description</label>
                <DxTextBox @bind-Text="Description" SizeMode="SizeMode.Small" />
            </div>
        </div>
        
        <!-- Preview Section - Shows image directly in popup -->
        <div style="margin-top:10px; border:1px solid #ccc; height:180px; display:flex; align-items:center; justify-content:center; background:#f9f9f9; overflow:hidden; position:relative;">
            @if (!string.IsNullOrEmpty(Url) && IsValidUrl(Url))
            {
                if (IsImageUrl(Url))
                {
                    <img src="@Url" alt="Preview" style="max-width:100%; max-height:100%; object-fit:contain;" />
                }
                else
                {
                    <div style="text-align:center; padding:10px;">
                        <i class="bi bi-file-earmark" style="font-size:48px; color:#888;"></i>
                        <div style="margin-top:8px; font-size:14px; color:#555;">File Preview</div>
                        <div style="font-size:12px; color:#999; margin-top:4px;">@Url</div>
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(Url) && !IsValidUrl(Url))
            {
                <div style="text-align:center; padding:10px;">
                    <i class="bi bi-exclamation-triangle" style="font-size:36px; color:#f57c00;"></i>
                    <div style="margin-top:8px; font-size:14px; color:#888;">Invalid URL</div>
                </div>
            }
            else
            {
                <span style="color:#888;">No preview available</span>
            }
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private string Url { get; set; } = "C:\\Users\\user\\Pictures\\";
    private string Description { get; set; } = string.Empty;
    private bool IsUrlOnly { get; set; } = true;

    async Task HandleSave() => await OnSave.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
    
    async Task HandleBrowse()
    {
        // Implement browse logic
    }
    
    async Task HandleScan()
    {
        // Implement scan logic
    }
    
    async Task HandleCamera()
    {
        // Implement camera logic
    }
    
    async Task HandleEdit()
    {
        // Implement edit logic
    }

    private bool IsValidUrl(string url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out _);
    }

    private bool IsImageUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var lowerUrl = url.ToLower();
        return lowerUrl.EndsWith(".jpg") || 
               lowerUrl.EndsWith(".jpeg") || 
               lowerUrl.EndsWith(".png") || 
               lowerUrl.EndsWith(".gif") || 
               lowerUrl.EndsWith(".bmp") || 
               lowerUrl.EndsWith(".webp") ||
               lowerUrl.EndsWith(".svg") ||
               lowerUrl.Contains("data:image") ||
               lowerUrl.Contains("blob:") ||
               lowerUrl.Contains("http") && (lowerUrl.Contains(".jpg") || lowerUrl.Contains(".png") || lowerUrl.Contains(".jpeg"));
    }
}