@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible"
         HeaderText="@($"Travel Detail ({RegistrationNo})")"
         Width="460px" CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="amend-toolbar">
            <button type="button" class="ci-btn" @onclick="HandleReset">
                <div class="ci-icon" style="color:#555;"><i class="bi bi-arrow-counterclockwise"></i></div>
                <div class="ci-text">Reset</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleSave">
                <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-floppy"></i></div>
                <div class="ci-text">Save</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleClose">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <div style="margin-bottom:8px;">
            <DxButton Text="Arrival" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" />
            <DxButton Text="Departure" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
        </div>
        <div class="amend-form">
            <div class="amend-row"><label>Pick Up Required</label>
                <DxComboBox Data="@YesNoList" @bind-Value="PickupRequired" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Transportation Type</label>
                <DxComboBox Data="@TransportTypes" @bind-Value="TransportType" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Station Code</label>
                <DxComboBox Data="@TransportTypes" @bind-Value="TransportType" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Carrier Code</label>
                <DxComboBox Data="@CarrierCodes" @bind-Value="CarrierCode" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Transportation #</label>
                <DxTextBox @bind-Text="TransportNo" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Arrival Date</label>
                <DxDateEdit @bind-Date="ArrivalDate" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Pick Up Time</label>
                <DxTextBox Text="@PickupTime.ToString(@"hh\:mm\:ss")" SizeMode="SizeMode.Small" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string? RegistrationNo { get; set; }
    [Parameter] public string? PickupRequired { get; set; }
    [Parameter] public string? TransportType { get; set; }
    [Parameter] public string? CarrierCode { get; set; }
    [Parameter] public string TransportNo { get; set; } = "";
    [Parameter] public DateTime? ArrivalDate { get; set; }
    [Parameter] public TimeSpan PickupTime { get; set; }

    [Parameter] public List<string> YesNoList { get; set; } = new();
    [Parameter] public List<string> TransportTypes { get; set; } = new();
    [Parameter] public List<string> CarrierCodes { get; set; } = new();

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    async Task HandleSave() => await OnSave.InvokeAsync();
    async Task HandleReset() => await OnReset.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}
