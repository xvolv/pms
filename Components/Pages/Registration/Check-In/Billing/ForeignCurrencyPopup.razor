@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="Foreign Exchange Transaction" Width="720px" CloseOnOutsideClick="false"
         ShowCloseButton="false" CloseOnEscape="true">
    <BodyContentTemplate>
        <div class="fe-container">
            <!-- Toolbar -->
            <div class="amend-toolbar">
                <button type="button" class="ci-btn" @onclick="HandleSave">
                    <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-floppy"></i></div>
                    <div class="ci-text">Save</div>
                </button>
                <button type="button" class="ci-btn" @onclick="HandleDelete">
                    <div class="ci-icon" style="color:#c62828;"><i class="bi bi-file-earmark-x"></i></div>
                    <div class="ci-text">Delete</div>
                </button>
                <button type="button" class="ci-btn" @onclick="HandleClear">
                    <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-eraser"></i></div>
                    <div class="ci-text">Clear</div>
                </button>
                <button type="button" class="ci-btn" @onclick="OpenPrintModal">
                    <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-printer"></i></div>
                    <div class="ci-text">Print</div>
                </button>
                <button type="button" class="ci-btn" @onclick="HandleClose">
                    <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                    <div class="ci-text">Cancel</div>
                </button>
            </div>

            <!-- Top Summary Fields -->
            <div class="fe-summary-grid">
                <div class="fe-summary-col">
                    <div class="fe-field-row">
                        <label class="fe-lbl">Voucher No.</label>
                        <input class="fe-input" value="@VoucherNo" readonly />
                    </div>
                    <div class="fe-field-row">
                        <label class="fe-lbl">Payment</label>
                        <input class="fe-input fe-input-num" value="@Payment.ToString("N2")" readonly />
                    </div>
                </div>
                <div class="fe-summary-col">
                    <div class="fe-field-row">
                        <label class="fe-lbl">Total Amount</label>
                        <input class="fe-input fe-input-num" value="@CalculatedTotalAmount.ToString("N2")" readonly />
                    </div>
                    <div class="fe-field-row">
                        <label class="fe-lbl">Remaining Amount</label>
                        <input class="fe-input fe-input-num" value="@CalculatedRemaining.ToString("N2")" readonly />
                    </div>
                </div>
            </div>

            <!-- Foreign Currency Table -->
            <div class="fe-table-wrapper">
                <table class="fe-table">
                    <thead>
                        <tr>
                            <th style="width: 35px; text-align: center;">SN</th>
                            <th style="width: 110px;">Currency</th>
                            <th style="width: 85px; text-align: right;">Amount</th>
                            <th style="width: 80px; text-align: right;">Rate</th>
                            <th style="width: 95px; text-align: right;">Total Amount</th>
                            <th style="width: 55px; text-align: center;">Assign</th>
                            <th>Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Rows)
                        {
                            <tr>
                                <td style="text-align: center;">@r.SN</td>
                                <td>
                                    <DxComboBox CssClass="erp-combobox" Data="@Currencies" @bind-Value="r.Currency"
                                                SizeMode="SizeMode.Small" />
                                </td>
                                <td>
                                    <input type="number" class="fe-tbl-input" style="text-align: right;" value="@r.Amount"
                                           @onchange="@((ChangeEventArgs e) => OnAmountChange(r, e))" />
                                </td>
                                <td>
                                    <input type="number" class="fe-tbl-input" style="text-align: right;" value="@r.Rate"
                                           @onchange="@((ChangeEventArgs e) => OnRateChange(r, e))" />
                                </td>
                                <td style="text-align: right; padding-right: 8px;">
                                    @r.TotalAmount.ToString("N2")
                                </td>
                                <td style="text-align: center;">
                                    <input type="checkbox" @bind="r.Assign" />
                                </td>
                                <td>
                                    <input class="fe-tbl-input" @bind="r.Remark" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Print Modal Placeholder -->
<DxPopup @bind-Visible="showPrintModal" HeaderText="Print Preview - Foreign Exchange" Width="720px"
         CloseOnOutsideClick="false" ShowCloseButton="false" CloseOnEscape="true">
    <BodyContentTemplate>
        <div class="print-placeholder-container">
            <div class="print-btn-bar">
                <button type="button" class="fe-btn" onclick="window.print()">
                    <div class="fe-btn-icon text-primary"><i class="bi bi-printer"></i></div>
                    <div class="fe-btn-text">Print</div>
                </button>
                <button type="button" class="fe-btn" @onclick="@(() => showPrintModal = false)">
                    <div class="fe-btn-icon text-danger"><i class="bi bi-x-square-fill"></i></div>
                    <div class="fe-btn-text">Close</div>
                </button>
            </div>

            <div class="print-sheet-paper">
                <div class="print-header-center">
                    <div class="print-hotel-title">TEST HOTEL</div>
                    <div class="print-report-subtitle">FOREIGN EXCHANGE TRANSACTION RECEIPT</div>
                    <div class="print-date-stamp">Date: @DateTime.Today.ToString("M/d/yyyy")</div>
                </div>

                <div class="print-info-grid">
                    <div><b>Voucher No:</b> @VoucherNo</div>
                    <div><b>Payment Required:</b> @Payment.ToString("N2")</div>
                    <div><b>Total Converted:</b> @CalculatedTotalAmount.ToString("N2")</div>
                    <div><b>Remaining:</b> @CalculatedRemaining.ToString("N2")</div>
                </div>

                <table class="print-data-table">
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>Currency</th>
                            <th style="text-align: right;">Amount</th>
                            <th style="text-align: right;">Rate</th>
                            <th style="text-align: right;">Total (Birr)</th>
                            <th>Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Rows)
                        {
                            <tr>
                                <td>@r.SN</td>
                                <td>@r.Currency</td>
                                <td style="text-align: right;">@r.Amount.ToString("N2")</td>
                                <td style="text-align: right;">@r.Rate.ToString("N4")</td>
                                <td style="text-align: right;">@r.TotalAmount.ToString("N2")</td>
                                <td>@r.Remark</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="print-signatures-box">
                    <div class="sig-unit">
                        <div class="sig-line-solid"></div>
                        <div class="sig-title">Cashier</div>
                    </div>
                    <div class="sig-unit">
                        <div class="sig-line-solid"></div>
                        <div class="sig-title">Guest / Customer</div>
                    </div>
                    <div class="sig-unit">
                        <div class="sig-line-solid"></div>
                        <div class="sig-title">Authorized Officer</div>
                    </div>
                </div>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<style>
    .fe-container {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }



    .fe-summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 12px;
    }

    .fe-summary-col {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .fe-field-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .fe-lbl {
        width: 110px;
        font-size: 11.5px;
        color: #334155;
        font-weight: 500;
        text-align: right;
    }

    .fe-input {
        flex: 1;
        height: 22px;
        padding: 1px 6px;
        font-size: 11.5px;
        border: 1px solid #cbd5e1;
        border-radius: 2px;
        background: #f8fafc;
    }

    .fe-input-num {
        text-align: right;
    }

    .fe-table-wrapper {
        border: 1px solid #cbd5e1;
        border-radius: 2px;
        max-height: 240px;
        overflow-y: auto;
        background: #fff;
    }

    .fe-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
    }

    .fe-table th {
        background: #f1f5f9;
        color: #334155;
        font-weight: 600;
        padding: 5px 6px;
        border-bottom: 1px solid #cbd5e1;
        border-right: 1px solid #cbd5e1;
        text-align: left;
    }

    .fe-table td {
        padding: 2px 4px;
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        color: #1e293b;
    }

    .fe-tbl-input {
        width: 100%;
        height: 22px;
        padding: 1px 4px;
        font-size: 11px;
        border: 1px solid #cbd5e1;
        border-radius: 2px;
        box-sizing: border-box;
    }

    /* Print Preview */
    .print-placeholder-container {
        font-family: Arial, sans-serif;
    }

    .print-btn-bar {
        display: flex;
        gap: 6px;
        margin-bottom: 10px;
    }

    .print-sheet-paper {
        border: 1px dashed #94a3b8;
        padding: 20px;
        background: #fff;
    }

    .print-header-center {
        text-align: center;
        margin-bottom: 16px;
    }

    .print-hotel-title {
        font-size: 16px;
        font-weight: bold;
    }

    .print-report-subtitle {
        font-size: 13px;
        font-weight: bold;
        margin-top: 2px;
    }

    .print-date-stamp {
        font-size: 11px;
        margin-top: 4px;
        color: #475569;
    }

    .print-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        font-size: 11.5px;
        margin-bottom: 14px;
        padding: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .print-data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
        margin-bottom: 30px;
    }

    .print-data-table th,
    .print-data-table td {
        border: 1px solid #cbd5e1;
        padding: 4px 6px;
    }

    .print-data-table th {
        background: #f1f5f9;
    }

    .print-signatures-box {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 40px;
    }

    .sig-unit {
        text-align: center;
    }

    .sig-line-solid {
        border-top: 1.5px solid #334155;
        margin-bottom: 4px;
    }

    .sig-title {
        font-size: 11px;
        font-weight: bold;
        color: #334155;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string VoucherNo { get; set; } = "CRV-00000-26";
    [Parameter] public decimal Payment { get; set; } = 300.00m;
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public decimal Remaining { get; set; }
    [Parameter] public List<ForeignCurrencyRow> Rows { get; set; } = new();
    [Parameter]
    public List<string> Currencies { get; set; } = new() { "US Dollar", "Euro", "Pound", "Dirham", "Birr",
"Yen", "Yuan" };
    [Parameter] public EventCallback OnSave { get; set; }

    bool showPrintModal = false;

    decimal CalculatedTotalAmount => Rows.Sum(r => r.TotalAmount);
    decimal CalculatedRemaining => Math.Max(0, Payment - CalculatedTotalAmount);

    protected override void OnParametersSet()
    {
        if (!Rows.Any())
        {
            Rows = new List<ForeignCurrencyRow>
            {
                new() { SN = 1, Currency = "US Dollar", Amount = 0, Rate = 0, TotalAmount = 0, Assign = false, Remark = "" }
            };
        }
    }

    void OnAmountChange(ForeignCurrencyRow row, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var amt))
        {
            row.Amount = amt;
            row.TotalAmount = Math.Round(row.Amount * row.Rate, 2);
            StateHasChanged();
        }
    }

    void OnRateChange(ForeignCurrencyRow row, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var r))
        {
            row.Rate = r;
            row.TotalAmount = Math.Round(row.Amount * row.Rate, 2);
            StateHasChanged();
        }
    }

    void HandleDelete()
    {
        if (Rows.Count > 1)
        {
            Rows.RemoveAt(Rows.Count - 1);
        }
        else if (Rows.Count == 1)
        {
            Rows[0].Amount = 0;
            Rows[0].Rate = 0;
            Rows[0].TotalAmount = 0;
            Rows[0].Remark = "";
        }
    }

    void HandleClear()
    {
        foreach (var r in Rows)
        {
            r.Amount = 0;
            r.Rate = 0;
            r.TotalAmount = 0;
            r.Assign = false;
            r.Remark = "";
        }
    }

    void OpenPrintModal()
    {
        showPrintModal = true;
    }

    async Task HandleSave() => await OnSave.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}

