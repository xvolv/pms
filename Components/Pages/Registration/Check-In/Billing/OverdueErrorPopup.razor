@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="CNET_v2016" Width="400px"
         CloseOnOutsideClick="true" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-x-circle" style="font-size:28px; color:#c62828;"></i>
            <p>You can't make manual charge for over-due outs!</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
                      Click="HandleClose" />
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}
