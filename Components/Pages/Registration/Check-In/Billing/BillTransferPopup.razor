@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn
@using ERP.V7.WebPMS.Components.Shared

<DxPopup @bind-Visible="Visible"
         HeaderVisible="false"
         ShowCloseButton="false"
         Width="1050px"
         CloseOnOutsideClick="false"
         CloseOnEscape="true"
         CssClass="bill-transfer-popup">
    <BodyContentTemplate>
        <div class="bt-container">
            <!-- Window Title Bar -->
            <div class="bt-titlebar">
                <span class="bt-title-text">Bill Transfer</span>
                <i class="bi bi-x bt-title-close" @onclick="HandleClose" title="Close"></i>
            </div>

            <!-- Blue Header Accent Bar -->
            <div class="bt-header-accent"></div>

            <!-- Toolbar (matching Reference Image 1 & 5) -->
            <div class="bt-toolbar">
                <button type="button" class="bt-tb-btn" @onclick="HandleRefresh">
                    <i class="bi bi-arrow-clockwise bt-icon-refresh"></i>
                    <span>Refresh</span>
                </button>

                <!-- Print Dropdown Button -->
                <div class="bt-dropdown-wrapper">
                    <button type="button" class="bt-tb-btn" @onclick="TogglePrintMenu">
                        <div class="bt-print-box">
                            <i class="bi bi-printer bt-icon-print"></i>
                            <i class="bi bi-caret-down-fill bt-icon-caret"></i>
                        </div>
                        <span>Print</span>
                    </button>

                    @if (showPrintMenu)
                    {
                        <div class="bt-dropdown-menu" @onclick:stopPropagation="true">
                            <div class="bt-dropdown-item" @onclick="@(() => OpenPrint("All"))">
                                All
                            </div>
                            <div class="bt-dropdown-item" @onclick="@(() => OpenPrint("RoomCharge"))">
                                Room Charge
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="bt-tb-btn" @onclick="HandleClose">
                    <div class="bt-close-icon-box">
                        <i class="bi bi-x"></i>
                    </div>
                    <span>Close</span>
                </button>

                <div class="bt-divider"></div>

                <!-- To / From Dropdown Selection Area -->
                <div class="bt-target-group">
                    <span class="bt-label">@(FromOthers ? "From" : "To")</span>
                    <div class="bt-custom-dropdown" @onclick="HandleOpenTargetSearch">
                        <input type="text" class="bt-dropdown-input" value="@(FromOthers ? (SelectedFromRegistrations.Any() ? $"{SelectedFromRegistrations.Count} selected" : "Select Registrations") : ToGuest)" readonly placeholder="" />
                        <span class="bt-dropdown-arrow"><i class="bi bi-caret-down-fill"></i></span>
                    </div>
                </div>

                <!-- From Others Switch & Select All (stacked vertically) -->
                <div class="bt-toggle-stack">
                    <div class="bt-switch-row">
                        <span class="bt-switch-label">From Others</span>
                        <label class="bt-toggle-switch">
                            <input type="checkbox" checked="@FromOthers" @onchange="OnToggleFromOthers" />
                            <span class="bt-toggle-slider"></span>
                        </label>
                    </div>
                    <div class="bt-select-all-row">
                        <span class="bt-switch-label">Select All</span>
                        <input type="checkbox" class="bt-chk" checked="@SelectAll" @onchange="@((ChangeEventArgs e) => HandleSelectAll((bool)(e.Value ?? false)))" />
                    </div>
                </div>

                <div class="bt-divider"></div>

                <button type="button" class="bt-tb-btn" @onclick="HandleTransfer">
                    <div class="bt-transfer-icon-box">
                        <span class="bt-ab-red">A</span>
                        <span class="bt-ab-green">B</span>
                        <div class="bt-ab-arrow">
                            <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                    <span>Transfer Bill</span>
                </button>

                <button type="button" class="bt-tb-btn" @onclick="HandleReturn">
                    <i class="bi bi-arrow-90deg-left bt-icon-return"></i>
                    <span>Return Bill</span>
                </button>

                <div class="bt-divider"></div>

                <!-- Window & Currency Stacked Column-wise -->
                <div class="bt-combos-column">
                    <div class="bt-combo-row">
                        <span class="bt-combo-lbl">Window</span>
                        <DxComboBox CssClass="erp-combobox" Data="@WindowOptions" @bind-Value="Window" Width="115px" SizeMode="SizeMode.Small" />
                    </div>
                    <div class="bt-combo-row">
                        <span class="bt-combo-lbl">Currency</span>
                        <DxComboBox CssClass="erp-combobox" Data="@CurrencyOptions" @bind-Value="Currency" Width="115px" SizeMode="SizeMode.Small" />
                    </div>
                </div>
            </div>

            <!-- Metadata Info Grid -->
            <div class="bt-info-section">
                <div class="bt-info-left">
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">Guest Name</label>
                        <input type="text" class="bt-field-val" value="@GuestName" readonly />
                    </div>
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">Reg. No</label>
                        <input type="text" class="bt-field-val" value="@RegNo" readonly />
                    </div>
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">Company</label>
                        <input type="text" class="bt-field-val" value="@Company" readonly />
                    </div>
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">FS Num.</label>
                        <input type="text" class="bt-field-val" value="@FsNum" @onchange="@(e => FsNum = e.Value?.ToString() ?? "")" />
                    </div>
                </div>

                <div class="bt-info-right">
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">Arrival Date</label>
                        <input type="text" class="bt-field-val" value="@(Arrival?.ToString("ddd, dd MMMM yyyy hh:mm tt") ?? "")" readonly />
                    </div>
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">Departure Date</label>
                        <input type="text" class="bt-field-val" value="@(Departure?.ToString("ddd, dd MMMM yyyy hh:mm tt") ?? "")" readonly />
                    </div>
                    <div class="bt-field-row">
                        <label class="bt-field-lbl">TIN</label>
                        <input type="text" class="bt-field-val" value="@Tin" @onchange="@(e => Tin = e.Value?.ToString() ?? "")" />
                    </div>
                </div>
            </div>

            <!-- Tab Header -->
            <div class="bt-tab-strip">
                <div class="bt-tab active">Guest Ledger</div>
            </div>

            <!-- Content Area with Tables and Right-Aligned Total Forms -->
            <div class="bt-content-body">
                <!-- SECTION 1: Room Charges -->
                <div class="bt-sec-title">Room Charges</div>
                <div class="bt-grid-scroll">
                    <table class="bt-table">
                        <thead>
                            <tr>
                                <th style="width:28px; text-align:center;">
                                    <input type="checkbox" checked="@RoomCharges.All(x => x.Selected)" @onchange="@((ChangeEventArgs e) => ToggleAllRoomCharges((bool)(e.Value ?? false)))" />
                                </th>
                                <th style="width:35px; text-align:center;">SN</th>
                                <th style="width:85px;">Date</th>
                                <th style="width:110px;">Room No.</th>
                                <th style="width:100px;">Room Type</th>
                                <th style="width:100px;">Room Rate</th>
                                <th style="width:80px; text-align:center;">No. Of Adult</th>
                                <th style="width:80px; text-align:center;">No. Of Child</th>
                                <th>Remark</th>
                                <th style="width:90px; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (RoomCharges != null && RoomCharges.Any())
                            {
                                @foreach (var r in RoomCharges)
                                {
                                    <tr class="@(r.Selected ? "bt-row-selected" : "")" @onclick="() => r.Selected = !r.Selected">
                                        <td style="text-align:center;" @onclick:stopPropagation="true">
                                            <input type="checkbox" @bind="r.Selected" />
                                        </td>
                                        <td style="text-align:center;">@r.SN</td>
                                        <td>@r.Date.ToString("M/d/yyyy")</td>
                                        <td>@(r.RoomNo + (string.IsNullOrEmpty(r.Guest) ? "" : $" [{r.Guest}]"))</td>
                                        <td>@r.RoomType</td>
                                        <td>@r.RoomRate</td>
                                        <td style="text-align:center;">@r.Adults</td>
                                        <td style="text-align:center;">@r.Child</td>
                                        <td>@r.Remark</td>
                                        <td style="text-align:right;">@r.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Room Charge Summary Form (matching Image 5) -->
                <div class="bt-summary-container">
                    <table class="bt-summary-form">
                        <tr>
                            <td class="sum-lbl">Subtotal</td>
                            <td class="sum-val"><input type="text" value="@RoomSubtotal.ToString("N2")" readonly /></td>
                        </tr>
                        <tr>
                            <td class="sum-lbl">Discount</td>
                            <td class="sum-val"><input type="text" value="@Discount.ToString("N2")" readonly /></td>
                        </tr>
                        <tr>
                            <td class="sum-lbl">Service Charge</td>
                            <td class="sum-val"><input type="text" value="@RoomService.ToString("N2")" readonly /></td>
                        </tr>
                        <tr>
                            <td class="sum-lbl">VAT</td>
                            <td class="sum-val"><input type="text" value="@RoomVat.ToString("N2")" readonly /></td>
                        </tr>
                        <tr>
                            <td class="sum-lbl font-bold">Grand Total</td>
                            <td class="sum-val"><input type="text" value="@RoomGrand.ToString("N2")" readonly class="font-bold" /></td>
                        </tr>
                    </table>
                </div>

                <!-- SECTION 2: Extra Bills -->
                <div class="bt-sec-title-row">
                    <span class="bt-sec-title">Extra Bills</span>
                    <label class="bt-expand-lbl">
                        <input type="checkbox" @bind="ExpandAllExtra" /> Expand All
                    </label>
                </div>
                <div class="bt-grid-scroll">
                    <table class="bt-table">
                        <thead>
                            <tr>
                                <th style="width:28px; text-align:center;">
                                    <input type="checkbox" checked="@ExtraBills.All(x => x.Selected)" @onchange="@((ChangeEventArgs e) => ToggleAllExtraBills((bool)(e.Value ?? false)))" />
                                </th>
                                <th style="width:35px; text-align:center;">SN</th>
                                <th style="width:75px;">Room No.</th>
                                <th style="width:85px;">Date</th>
                                <th style="width:100px;">Invoice ID</th>
                                <th style="width:80px; text-align:right;">Ser. Charge</th>
                                <th style="width:75px; text-align:right;">Discount</th>
                                <th style="width:75px; text-align:right;">VAT</th>
                                <th style="width:85px; text-align:right;">Sub Total</th>
                                <th>Remark</th>
                                <th style="width:90px; text-align:right;">Grand Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ExtraBills != null && ExtraBills.Any())
                            {
                                @foreach (var e in ExtraBills)
                                {
                                    <tr class="@(e.Selected ? "bt-row-selected" : "")" @onclick="() => e.Selected = !e.Selected">
                                        <td style="text-align:center;" @onclick:stopPropagation="true">
                                            <input type="checkbox" @bind="e.Selected" />
                                        </td>
                                        <td style="text-align:center;">@e.SN</td>
                                        <td>@e.RoomNo</td>
                                        <td>@e.Date.ToString("M/d/yyyy")</td>
                                        <td>@e.InvoiceId</td>
                                        <td style="text-align:right;">@e.SerCharge.ToString("N2")</td>
                                        <td style="text-align:right;">@e.Discount.ToString("N2")</td>
                                        <td style="text-align:right;">@e.Vat.ToString("N2")</td>
                                        <td style="text-align:right;">@e.SubTotal.ToString("N2")</td>
                                        <td>@e.Remark</td>
                                        <td style="text-align:right;">@e.GrandTotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bt-summary-container">
                    <table class="bt-summary-form">
                        <tr>
                            <td class="sum-lbl">Total Extra Bill</td>
                            <td class="sum-val"><input type="text" value="@TotalExtra.ToString("N2")" readonly /></td>
                        </tr>
                    </table>
                </div>

                <!-- SECTION 3: Payment History -->
                <div class="bt-sec-title">Payment History</div>
                <div class="bt-grid-scroll">
                    <table class="bt-table">
                        <thead>
                            <tr>
                                <th style="width:28px; text-align:center;">
                                    <input type="checkbox" checked="@PaymentHistory.All(x => x.Selected)" @onchange="@((ChangeEventArgs e) => ToggleAllPayments((bool)(e.Value ?? false)))" />
                                </th>
                                <th style="width:35px; text-align:center;">SN</th>
                                <th style="width:85px;">Date</th>
                                <th style="width:110px;">Receipt No.</th>
                                <th style="width:100px;">Voucher Type</th>
                                <th style="width:110px;">Received By</th>
                                <th>Remark</th>
                                <th style="width:90px; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PaymentHistory != null && PaymentHistory.Any())
                            {
                                @foreach (var p in PaymentHistory)
                                {
                                    <tr class="@(p.Selected ? "bt-row-selected" : "")" @onclick="() => p.Selected = !p.Selected">
                                        <td style="text-align:center;" @onclick:stopPropagation="true">
                                            <input type="checkbox" @bind="p.Selected" />
                                        </td>
                                        <td style="text-align:center;">@p.SN</td>
                                        <td>@p.Date.ToString("M/d/yyyy")</td>
                                        <td>@p.ReceiptNo</td>
                                        <td>@p.VoucherType</td>
                                        <td>@p.ReceivedBy</td>
                                        <td>@p.Remark</td>
                                        <td style="text-align:right;">@p.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bt-summary-container">
                    <table class="bt-summary-form">
                        <tr>
                            <td class="sum-lbl">Total Credit</td>
                            <td class="sum-val"><input type="text" value="300.00" readonly /></td>
                        </tr>
                        <tr>
                            <td class="sum-lbl">Total Paid</td>
                            <td class="sum-val"><input type="text" value="@TotalPaid.ToString("N2")" readonly /></td>
                        </tr>
                        <tr>
                            <td class="sum-lbl">Total Refund</td>
                            <td class="sum-val"><input type="text" value="0.00" readonly /></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Bottom Status Footer -->
            <div class="bt-footer-bar">
                <span>Total Room Charge = @RoomGrand.ToString("N2")</span>
                <span>Total Extra Bills = @TotalExtra.ToString("N0")</span>
                <span>Total Payments = @TotalPaid.ToString("N0")</span>
                <span><b>TOTAL SELECTED = @TotalSelected.ToString("N2")</b></span>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Printable Guest Ledger Dialog (All / Room Charge) -->
<GuestLedgerPrintPopup
    @bind-Visible="showLedgerPrint"
    PrintMode="@currentPrintMode"
    GuestName="@GuestName"
    RegNo="@RegNo"
    Company="@Company"
    TinNo="@Tin"
    FsNo="@FsNum"
    ArrivalDate="@Arrival"
    DepartureDate="@Departure"
    RoomCharges="@RoomCharges"
    ExtraBills="@ExtraBills"
    PaymentHistory="@PaymentHistory" />

<!-- Registration Search / Find Popup (Global component from Shared directory) -->
<RegistrationSearchPopup
    @bind-Visible="showRegistrationSearch"
    IsMultiSelect="@FromOthers"
    Items="@RegistrationSearchList"
    SelectedItem="@selectedLookupItem"
    SelectedItemChanged="@(item => selectedLookupItem = item)"
    OnSelect="HandleSelectLookupItem"
    OnMultiSelectCompleted="HandleMultiSelectLookupCompleted" />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public RegistrationRow? TargetRegistration { get; set; }
    [Parameter] public string GuestName { get; set; } = "BEREKET BEKELE WOLDEAMANUEL";
    [Parameter] public string RegNo { get; set; } = "REG-00008-26";
    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string FsNum { get; set; } = "";
    [Parameter] public string Tin { get; set; } = "";
    [Parameter] public DateTime? Arrival { get; set; } = new DateTime(2026, 8, 27, 14, 15, 0);
    [Parameter] public DateTime? Departure { get; set; } = new DateTime(2026, 9, 16, 12, 0, 0);
    [Parameter] public string? ToGuest { get; set; }
    [Parameter] public EventCallback<string?> ToGuestChanged { get; set; }
    [Parameter] public string? Window { get; set; } = "All";
    [Parameter] public string? Currency { get; set; } = "Birr";
    [Parameter] public bool FromOthers { get; set; }
    [Parameter] public bool SelectAll { get; set; }
    [Parameter] public decimal Discount { get; set; } = 0.00m;

    [Parameter] public List<TransferChargeRow> RoomCharges { get; set; } = new();
    [Parameter] public List<ExtraBillRow> ExtraBills { get; set; } = new();
    [Parameter] public List<PaymentHistoryRow> PaymentHistory { get; set; } = new();
    [Parameter] public List<string> WindowOptions { get; set; } = new() { "All", "Window 1", "Window 2", "Window 3", "Window 4", "Window 5", "Window 6", "Window 7" };
    [Parameter] public List<string> CurrencyOptions { get; set; } = new() { "Birr", "USD", "EUR" };
    [Parameter] public List<RegistrationLookupItem> RegistrationSearchList { get; set; } = new();
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback OnOpenGuestFind { get; set; }
    [Parameter] public EventCallback<bool> OnSelectAll { get; set; }
    [Parameter] public EventCallback OnTransfer { get; set; }
    [Parameter] public EventCallback OnReturn { get; set; }

    bool showPrintMenu = false;
    bool showLedgerPrint = false;
    string currentPrintMode = "All";
    bool ExpandAllExtra = false;

    bool showRegistrationSearch = false;
    RegistrationLookupItem? selectedLookupItem;
    List<RegistrationLookupItem> SelectedFromRegistrations = new();

    decimal RoomSubtotal => RoomCharges.Sum(x => x.Amount);
    decimal RoomService => Math.Round(RoomSubtotal * 0.10m, 2);
    decimal RoomVat => Math.Round((RoomSubtotal + RoomService) * 0.15m, 2);
    decimal RoomGrand => RoomSubtotal + RoomService + RoomVat;
    decimal TotalExtra => ExtraBills.Sum(x => x.GrandTotal);
    decimal TotalPaid => PaymentHistory.Where(p => p.Amount > 0).Sum(p => p.Amount);
    decimal TotalSelected => RoomCharges.Where(x => x.Selected).Sum(x => x.Amount)
                           + ExtraBills.Where(x => x.Selected).Sum(x => x.GrandTotal)
                           + PaymentHistory.Where(x => x.Selected).Sum(x => Math.Abs(x.Amount));

    protected override void OnParametersSet()
    {
        if (TargetRegistration != null)
        {
            if (string.IsNullOrEmpty(GuestName) || GuestName == "BEREKET BEKELE WOLDEAMANUEL") 
                GuestName = TargetRegistration.Guest ?? "BEREKET BEKELE WOLDEAMANUEL";
            if (string.IsNullOrEmpty(RegNo) || RegNo == "REG-00008-26") 
                RegNo = TargetRegistration.Registration ?? "REG-00008-26";
            if (string.IsNullOrEmpty(Company)) 
                Company = TargetRegistration.Company ?? "";
            if (!Arrival.HasValue) 
                Arrival = TargetRegistration.Arrival;
            if (!Departure.HasValue) 
                Departure = TargetRegistration.Departure;
        }

        if (Visible)
        {
            if (!RoomCharges.Any())
            {
                var arr = Arrival ?? DateTime.Today;
                RoomCharges = new List<TransferChargeRow>
                {
                    new() { SN = 1, Date = new DateTime(2026, 8, 19), RoomNo = "101", RoomType = "Standard", RoomRate = "Rate 1", Adults = 1, Child = 0, Amount = 86.96m, Selected = true, Guest = "JANE DOE" },
                    new() { SN = 2, Date = new DateTime(2026, 8, 19), RoomNo = "205", RoomType = "Delux", RoomRate = "Rate 1", Adults = 1, Child = 0, Amount = 86.96m, Selected = true, Guest = "JANE DOE" },
                    new() { SN = 3, Date = new DateTime(2026, 8, 20), RoomNo = "205", RoomType = "Delux", RoomRate = "Rate 1", Adults = 1, Child = 0, Amount = 86.96m, Selected = true, Guest = "JANE DOE" }
                };
            }
            if (!RegistrationSearchList.Any())
            {
                RegistrationSearchList = new List<RegistrationLookupItem>
                {
                    new() { Code = "REG-00000-26", RoomNumber = "101", Guest = "JANE DOE", RoomType = "Standard", Company = "", Selected = true },
                    new() { Code = "REG-00001-26", RoomNumber = "205", Guest = "JANE DOE", RoomType = "Delux", Company = "RED CLOUD ICT S...", Selected = false },
                    new() { Code = "REG-00002-26", RoomNumber = "207", Guest = "JANE DOE", RoomType = "Delux", Company = "RED CLOUD ICT S...", Selected = false },
                    new() { Code = "REG-00003-26", RoomNumber = "208", Guest = "JANE DOE", RoomType = "Delux", Company = "", Selected = false },
                    new() { Code = "REG-00004-26", RoomNumber = "209", Guest = "JANE DOE", RoomType = "Delux", Company = "", Selected = false },
                    new() { Code = "REG-00005-26", RoomNumber = "210", Guest = "JANE DOE", RoomType = "Delux", Company = "", Selected = false },
                    new() { Code = "REG-00006-26", RoomNumber = "102", Guest = "JANE DOE", RoomType = "Standard", Company = "", Selected = false },
                    new() { Code = "REG-00007-26", RoomNumber = "103", Guest = "JANE DOE", RoomType = "Standard", Company = "", Selected = false }
                };
            }
        }
    }

    void OnToggleFromOthers(ChangeEventArgs e)
    {
        FromOthers = (bool)(e.Value ?? false);
        if (!FromOthers)
        {
            SelectedFromRegistrations.Clear();
        }
    }

    void HandleOpenTargetSearch()
    {
        showRegistrationSearch = true;
    }

    void HandleSelectLookupItem(RegistrationLookupItem item)
    {
        if (item != null)
        {
            ToGuest = $"{item.Code}";
            ToGuestChanged.InvokeAsync(ToGuest);
        }
        showRegistrationSearch = false;
    }

    void HandleMultiSelectLookupCompleted(List<RegistrationLookupItem> list)
    {
        SelectedFromRegistrations = list;
        showRegistrationSearch = false;
    }

    void TogglePrintMenu() => showPrintMenu = !showPrintMenu;

    void OpenPrint(string mode)
    {
        currentPrintMode = mode;
        showPrintMenu = false;
        showLedgerPrint = true;
    }

    void ToggleAllRoomCharges(bool v)
    {
        foreach (var r in RoomCharges) r.Selected = v;
    }

    void ToggleAllExtraBills(bool v)
    {
        foreach (var e in ExtraBills) e.Selected = v;
    }

    void ToggleAllPayments(bool v)
    {
        foreach (var p in PaymentHistory) p.Selected = v;
    }

    async Task HandleSelectAll(bool v)
    {
        SelectAll = v;
        ToggleAllRoomCharges(v);
        ToggleAllExtraBills(v);
        ToggleAllPayments(v);
        await OnSelectAll.InvokeAsync(v);
    }

    async Task HandleRefresh() => await OnRefresh.InvokeAsync();
    async Task HandleTransfer() => await OnTransfer.InvokeAsync();
    async Task HandleReturn() => await OnReturn.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}

<style>
    .bill-transfer-popup .dxbl-popup-body-content {
        padding: 0 !important;
    }

    .bill-transfer-popup .dxbl-popup {
        border-radius: 0;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
    }

    .bt-container {
        display: flex;
        flex-direction: column;
        background: #f7f9fa;
        font-family: Arial, "Segoe UI", sans-serif;
        color: #222;
    }

    /* Window Title */
    .bt-titlebar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 28px;
        padding: 0 10px;
        background: #ffffff;
        border-bottom: 1px solid #e1e4e8;
    }

    .bt-title-text {
        font-size: 13px;
        font-weight: 500;
        color: #222;
    }

    .bt-title-close {
        cursor: pointer;
        font-size: 18px;
        color: #666;
    }

    .bt-title-close:hover {
        color: #d9534f;
    }

