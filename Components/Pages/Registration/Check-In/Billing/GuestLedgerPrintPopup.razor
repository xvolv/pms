@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn
@inject IJSRuntime JSRuntime

<DxPopup @bind-Visible="Visible"
         HeaderVisible="false"
         ShowCloseButton="false"
         Width="950px"
         CloseOnOutsideClick="true"
         CloseOnEscape="true"
         CssClass="guest-ledger-print-popup">
    <BodyContentTemplate>
        <div class="print-dialog-container">
            <!-- Printable Clean Sheet -->
            <div class="print-sheet @(IsRoomChargeOnly ? "watermark-attachment" : "watermark-non-fiscal")" id="guest-ledger-print-area">
                
                <!-- Page Top Actions (Close button on print page, hidden during actual print) -->
                <div class="print-page-topbar no-print">
                    <button type="button" class="print-page-close-btn" @onclick="CloseDialog" title="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Document Header (matching Reference Images 2 & 3) -->
                <div class="ledger-header">
                    <div class="ledger-hotel-left">
                        <h2>@HotelName</h2>
                    </div>
                    <div class="ledger-hotel-right">
                        <div class="hotel-line font-bold">@HotelName</div>
                        <div class="hotel-line">Branch: Head Office</div>
                        <div class="hotel-line">Tel:</div>
                        <div class="hotel-line">Fax:</div>
                        <div class="hotel-line">Web:</div>
                        <div class="hotel-line">Email:</div>
                        <div class="hotel-line">POBox</div>
                        <div class="hotel-line">Addis Ababa ,Ethiopia</div>
                    </div>
                </div>

                <!-- TIN / VAT & Title Line with Divider Lines -->
                <div class="ledger-title-strip">
                    <div class="tin-vat-info">
                        <span>TIN: 0000000000-01</span>
                        <span class="ms-4">VAT:</span>
                    </div>
                    <div class="ledger-title-box">
                        <span class="title-line-left"></span>
                        <span class="title-text">@(IsRoomChargeOnly ? "Guest Ledger (Room Charge Only)" : "Guest Ledger")</span>
                        <span class="title-line-right"></span>
                    </div>
                </div>

                <!-- Customer Details Grid Table -->
                <table class="cust-info-table">
                    <tbody>
                        <tr>
                            <td class="lbl-cell" style="width:18%;">Customer Name</td>
                            <td class="val-cell" style="width:37%;">@GuestName</td>
                            <td class="lbl-cell" style="width:18%;">TIN No</td>
                            <td class="val-cell" style="width:27%;">@TinNo</td>
                        </tr>
                        <tr>
                            <td class="lbl-cell">Registration No</td>
                            <td class="val-cell">@RegNo</td>
                            <td class="lbl-cell">Arrival Date</td>
                            <td class="val-cell">@(ArrivalDate?.ToString("ddd, dd MMMM yyyy hh:mm tt") ?? "")</td>
                        </tr>
                        <tr>
                            <td class="lbl-cell">Plan</td>
                            <td class="val-cell">@Plan</td>
                            <td class="lbl-cell">Departure Date</td>
                            <td class="val-cell">@(DepartureDate?.ToString("ddd, dd MMMM yyyy hh:mm tt") ?? "")</td>
                        </tr>
                        <tr>
                            <td class="lbl-cell">FS No.</td>
                            <td class="val-cell">@FsNo</td>
                            <td class="lbl-cell"></td>
                            <td class="val-cell"></td>
                        </tr>
                        <tr>
                            <td class="lbl-cell">Company</td>
                            <td class="val-cell">@Company</td>
                            <td class="lbl-cell"></td>
                            <td class="val-cell"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- SECTION 1: Room Charge -->
                <div class="section-title">Room Charge</div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:65px;">Selection</th>
                            <th style="width:35px;">SN</th>
                            <th style="width:75px;">Date</th>
                            <th style="width:65px;">Room No.</th>
                            <th style="width:90px;">Room Type</th>
                            <th style="width:85px;">Room Rate</th>
                            <th style="width:80px;">No. Of Adult</th>
                            <th style="width:80px;">No. Of Child</th>
                            <th>Remark</th>
                            <th style="width:80px; text-align:right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (RoomCharges != null && RoomCharges.Any())
                        {
                            @foreach (var rc in RoomCharges)
                            {
                                <tr>
                                    <td style="text-align:center;">
                                        <input type="checkbox" checked="@rc.Selected" disabled />
                                    </td>
                                    <td style="text-align:center;">@rc.SN</td>
                                    <td>@rc.Date.ToString("M/d/yyyy")</td>
                                    <td style="text-align:center;">@rc.RoomNo</td>
                                    <td>@rc.RoomType</td>
                                    <td>@rc.RoomRate</td>
                                    <td style="text-align:center;">@rc.Adults</td>
                                    <td style="text-align:center;">@rc.Child</td>
                                    <td>@rc.Remark</td>
                                    <td style="text-align:right;">@rc.Amount.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <!-- Room Charge Totals (Right Aligned Box) -->
                <div class="totals-wrapper">
                    <table class="totals-table">
                        <tr>
                            <td class="tot-lbl">SubTotal :</td>
                            <td class="tot-val">@RoomSubtotal.ToString("N1")</td>
                        </tr>
                        <tr>
                            <td class="tot-lbl">Discount:</td>
                            <td class="tot-val">@Discount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="tot-lbl">ServiceCharge:</td>
                            <td class="tot-val">@RoomService.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="tot-lbl">VAT[15%]:</td>
                            <td class="tot-val">@RoomVat.ToString("N2")</td>
                        </tr>
                        <tr class="grand-tot-row">
                            <td class="tot-lbl font-bold">Grand Total :</td>
                            <td class="tot-val font-bold">ETB @RoomGrand.ToString("N1")</td>
                        </tr>
                    </table>
                </div>

                @if (!IsRoomChargeOnly)
                {
                    <!-- SECTION 2: Extra Bill History -->
                    <div class="section-title mt-3">Extra Bill History</div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width:65px;">Selection</th>
                                <th style="width:35px;">SN</th>
                                <th style="width:65px;">Room No.</th>
                                <th style="width:75px;">Date</th>
                                <th style="width:85px;">Invoice ID</th>
                                <th style="width:75px; text-align:right;">Ser. Charge</th>
                                <th style="width:65px; text-align:right;">Discount</th>
                                <th style="width:65px; text-align:right;">VAT</th>
                                <th style="width:75px; text-align:right;">Sub Total</th>
                                <th>Remark</th>
                                <th style="width:80px; text-align:right;">Grand Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ExtraBills != null && ExtraBills.Any())
                            {
                                @foreach (var eb in ExtraBills)
                                {
                                    <tr>
                                        <td style="text-align:center;">
                                            <input type="checkbox" checked="@eb.Selected" disabled />
                                        </td>
                                        <td style="text-align:center;">@eb.SN</td>
                                        <td style="text-align:center;">@eb.RoomNo</td>
                                        <td>@eb.Date.ToString("M/d/yyyy")</td>
                                        <td>@eb.InvoiceId</td>
                                        <td style="text-align:right;">@eb.SerCharge.ToString("N2")</td>
                                        <td style="text-align:right;">@eb.Discount.ToString("N2")</td>
                                        <td style="text-align:right;">@eb.Vat.ToString("N2")</td>
                                        <td style="text-align:right;">@eb.SubTotal.ToString("N2")</td>
                                        <td>@eb.Remark</td>
                                        <td style="text-align:right;">@eb.GrandTotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div class="totals-wrapper">
                        <table class="totals-table">
                            <tr>
                                <td class="tot-lbl font-bold" style="width:140px;">Total OtherBill:</td>
                                <td class="tot-val font-bold">@TotalExtra.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>

                    <!-- SECTION 3: Payment History -->
                    <div class="section-title mt-3">Payment History</div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width:65px;">Selection</th>
                                <th style="width:35px;">SN</th>
                                <th style="width:75px;">Date</th>
                                <th style="width:95px;">Receipt No.</th>
                                <th style="width:95px;">Voucher Type</th>
                                <th style="width:95px;">Received By</th>
                                <th>Remark</th>
                                <th style="width:80px; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PaymentHistory != null && PaymentHistory.Any())
                            {
                                @foreach (var ph in PaymentHistory)
                                {
                                    <tr>
                                        <td style="text-align:center;">
                                            <input type="checkbox" checked="@ph.Selected" disabled />
                                        </td>
                                        <td style="text-align:center;">@ph.SN</td>
                                        <td>@ph.Date.ToString("M/d/yyyy")</td>
                                        <td>@ph.ReceiptNo</td>
                                        <td>@ph.VoucherType</td>
                                        <td>@ph.ReceivedBy</td>
                                        <td>@ph.Remark</td>
                                        <td style="text-align:right;">@ph.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div class="totals-wrapper">
                        <table class="totals-table">
                            <tr>
                                <td class="tot-lbl">Total Paid:</td>
                                <td class="tot-val">@TotalPaid.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="tot-lbl">Total Credit:</td>
                                <td class="tot-val">0.00</td>
                            </tr>
                            <tr>
                                <td class="tot-lbl">Refund:</td>
                                <td class="tot-val">0.00</td>
                            </tr>
                            <tr class="grand-tot-row">
                                <td class="tot-lbl font-bold">Remaining Balance:</td>
                                <td class="tot-val font-bold">ETB @((RoomGrand + TotalExtra - TotalPaid).ToString("N1"))</td>
                            </tr>
                        </table>
                    </div>
                }

                <!-- Signatures Row (3 columns) -->
                <div class="ledger-signatures-container">
                    <div class="sig-box">
                        <div class="sig-title">@HotelName @HotelName</div>
                        <div class="sig-line"></div>
                        <div class="sig-sub">Prepare By</div>
                    </div>
                    <div class="sig-box">
                        <div class="sig-line"></div>
                        <div class="sig-sub">GSR'S Signature</div>
                    </div>
                    <div class="sig-box">
                        <div class="sig-line"></div>
                        <div class="sig-sub">Guest's Signature</div>
                        <div class="sig-name">@GuestName</div>
                    </div>
                </div>

                <!-- Document Footer -->
                <div class="ledger-footer-line">
                    <span>ERP System</span>
                    <span>Page 1</span>
                </div>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string PrintMode { get; set; } = "All"; // "All" or "RoomCharge"
    [Parameter] public string HotelName { get; set; } = "TEST HOTEL";
    [Parameter] public string GuestName { get; set; } = "BEREKET BEKELE WOLDEAMANUEL";
    [Parameter] public string RegNo { get; set; } = "REG-00008-26";
    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string TinNo { get; set; } = "";
    [Parameter] public string FsNo { get; set; } = "";
    [Parameter] public string Plan { get; set; } = "";
    [Parameter] public DateTime? ArrivalDate { get; set; }
    [Parameter] public DateTime? DepartureDate { get; set; }
    [Parameter] public decimal Discount { get; set; } = 0.00m;

    [Parameter] public List<TransferChargeRow> RoomCharges { get; set; } = new();
    [Parameter] public List<ExtraBillRow> ExtraBills { get; set; } = new();
    [Parameter] public List<PaymentHistoryRow> PaymentHistory { get; set; } = new();

    bool IsRoomChargeOnly => string.Equals(PrintMode, "RoomCharge", StringComparison.OrdinalIgnoreCase);

    decimal RoomSubtotal => RoomCharges.Sum(x => x.Amount);
    decimal RoomService => Math.Round(RoomSubtotal * 0.10m, 2);
    decimal RoomVat => Math.Round((RoomSubtotal + RoomService) * 0.15m, 2);
    decimal RoomGrand => RoomSubtotal + RoomService + RoomVat;
    decimal TotalExtra => ExtraBills.Sum(x => x.GrandTotal);
    decimal TotalPaid => PaymentHistory.Where(p => p.Amount > 0).Sum(p => p.Amount);

    async Task CloseDialog()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
    }
}

<style>
    .guest-ledger-print-popup .dxbl-popup-body-content {
        padding: 0 !important;
        background: #ffffff;
    }

    .guest-ledger-print-popup .dxbl-popup {
        border-radius: 4px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .print-dialog-container {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        font-family: Arial, "Segoe UI", sans-serif;
        padding: 10px 0 20px 0;
        max-height: 88vh;
        overflow-y: auto;
        position: relative;
    }

    .print-sheet {
        background: #ffffff;
        margin: 0 auto;
        padding: 12px 32px 24px 32px;
        width: 100%;
        max-width: 900px;
        box-sizing: border-box;
        color: #000000;
        position: relative;
    }

    /* Watermark styling */
    .watermark-non-fiscal {
        background-image: repeating-linear-gradient(
            -30deg,
            rgba(200, 200, 200, 0.12),
            rgba(200, 200, 200, 0.12) 150px,
            transparent 150px,
            transparent 300px
        );
        position: relative;
    }

    .watermark-non-fiscal::before {
        content: "NON FISCAL";
        position: absolute;
        top: 28%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-15deg);
        font-size: 80px;
        font-weight: 900;
        color: rgba(220, 220, 220, 0.28);
        pointer-events: none;
        letter-spacing: 12px;
        z-index: 0;
    }

    .watermark-non-fiscal::after {
        content: "NON FISCAL";
        position: absolute;
        top: 72%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-15deg);
        font-size: 80px;
        font-weight: 900;
        color: rgba(220, 220, 220, 0.28);
        pointer-events: none;
        letter-spacing: 12px;
        z-index: 0;
    }

    .watermark-attachment::before {
        content: "Attachment";
        position: absolute;
        top: 52%;
        left: 45%;
        transform: translate(-50%, -50%) rotate(-42deg);
        font-size: 110px;
        font-weight: bold;
        color: rgba(210, 210, 210, 0.35);
        pointer-events: none;
        letter-spacing: 4px;
        z-index: 0;
    }

    .print-page-topbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 2px;
    }

    .print-page-close-btn {
        background: transparent;
        border: none;
        color: #555;
        font-size: 16px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: color 0.15s, background-color 0.15s;
    }

    .print-page-close-btn:hover {
        color: #d9271e;
        background-color: #f1f3f5;
    }

    /* Header */
    .ledger-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }

    .ledger-hotel-left h2 {
        font-size: 18px;
        font-weight: bold;
        margin: 0;
        color: #000;
        letter-spacing: 0.5px;
    }

    .ledger-hotel-right {
        text-align: left;
        font-size: 10px;
        line-height: 1.35;
        color: #000;
        min-width: 140px;
    }

    .font-bold {
        font-weight: bold;
    }

    /* Title Strip */
    .ledger-title-strip {
        display: flex;
        align-items: center;
        margin-bottom: 6px;
        position: relative;
        z-index: 1;
    }

    .tin-vat-info {
        font-size: 10.5px;
        font-weight: bold;
        width: 45%;
    }

    .ledger-title-box {
        display: flex;
        align-items: center;
        width: 55%;
        text-align: right;
    }

    .title-line-left {
        flex: 1;
        border-top: 1.5px solid #000;
        margin-right: 8px;
    }

    .title-line-right {
        width: 25px;
        border-top: 1.5px solid #000;
        margin-left: 8px;
    }

    .title-text {
        font-size: 14px;
        font-weight: bold;
        white-space: nowrap;
    }

    /* Customer Info Table */
    .cust-info-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10.5px;
        margin-bottom: 10px;
        position: relative;
        z-index: 1;
    }

    .cust-info-table td {
        border: 1px solid #bfbfbf;
        padding: 3px 6px;
        color: #000;
    }

    .cust-info-table .lbl-cell {
        font-weight: bold;
        background-color: #ffffff;
    }

    .cust-info-table .val-cell {
        background-color: #ffffff;
    }

    /* Section & Data Tables */
    .section-title {
        font-size: 11px;
        font-weight: bold;
        margin: 6px 0 2px 0;
        color: #000;
        position: relative;
        z-index: 1;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
        position: relative;
        z-index: 1;
    }

    .data-table th, .data-table td {
        border: 1px solid #bfbfbf;
        padding: 3px 5px;
        color: #000;
    }

    .data-table th {
        background-color: #d9d9d9;
        font-weight: bold;
        text-align: center;
    }

    .data-table td {
        background-color: transparent;
    }

    /* Totals */
    .totals-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 2px;
        position: relative;
        z-index: 1;
    }

    .totals-table {
        border-collapse: collapse;
        font-size: 10px;
        min-width: 200px;
    }

    .totals-table td {
        border: 1px solid #bfbfbf;
        padding: 2px 6px;
    }

    .totals-table .tot-lbl {
        text-align: right;
        background-color: #ffffff;
        font-weight: 500;
    }

    .totals-table .tot-val {
        text-align: right;
        background-color: #ffffff;
        width: 75px;
    }

    .grand-tot-row td {
        border-top: 1.5px solid #888;
    }

    /* Signatures */
    .ledger-signatures-container {
        display: flex;
        justify-content: space-between;
        margin-top: 45px;
        margin-bottom: 25px;
        position: relative;
        z-index: 1;
    }

    .sig-box {
        width: 30%;
        text-align: center;
        font-size: 10.5px;
    }

    .sig-title {
        font-size: 9.5px;
        font-weight: bold;
        margin-bottom: 2px;
    }

    .sig-line {
        border-top: 1.5px solid #000;
        margin-bottom: 3px;
        width: 100%;
    }

    .sig-sub {
        font-weight: bold;
        font-size: 10.5px;
    }

    .sig-name {
        font-size: 10px;
        font-weight: bold;
        margin-top: 2px;
    }

    /* Footer */
    .ledger-footer-line {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid #999;
        padding-top: 4px;
        margin-top: 16px;
        font-size: 10.5px;
        color: #333;
        position: relative;
        z-index: 1;
    }

    @@media print {
        body * {
            visibility: hidden;
        }
        #guest-ledger-print-area, #guest-ledger-print-area * {
            visibility: visible;
        }
        #guest-ledger-print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 15px;
            box-shadow: none;
        }
    }
</style>
