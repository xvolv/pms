@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<!-- ==================== MAIN MANUAL CHARGE POPUP ==================== -->
<DxPopup @bind-Visible="Visible" HeaderText="Manual Charge" Width="1020px" CloseOnOutsideClick="false"
         ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <!-- Top Toolbar -->
        <div class="amend-toolbar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
            <div style="display:flex; gap:6px; align-items:center;">
                <button type="button" class="ci-btn" @onclick="HandleNew">
                    <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-file-earmark-plus"></i></div>
                    <div class="ci-text">New</div>
                </button>
                <button type="button" class="ci-btn" @onclick="HandleSave">
                    <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-floppy"></i></div>
                    <div class="ci-text">Save</div>
                </button>
                <button type="button" class="ci-btn" @onclick="OpenRateSummary">
                    <div class="ci-icon" style="color:#e0a52c;"><i class="bi bi-card-checklist"></i></div>
                    <div class="ci-text">Rate Summary</div>
                </button>
            </div>

            <!-- Guest & TIN info in Toolbar -->
            <div style="display:flex; gap:8px; align-items:center;">
                <div style="display:flex; align-items:center; gap:4px;">
                    <span style="font-size:11px; color:#475569; font-weight:500;">Guest</span>
                    <input class="mc-input-sm" style="width: 120px;" @bind="GuestCode" />
                </div>
                <div style="display:flex; align-items:center; gap:4px;">
                    <span style="font-size:11px; color:#475569; font-weight:500;">Company</span>
                    <input class="mc-input-sm" style="width: 120px;" @bind="Company" />
                </div>
                <div style="display:flex; align-items:center; gap:4px;">
                    <span style="font-size:11px; color:#475569; font-weight:500;">TIN No.</span>
                    <input class="mc-input-sm" style="width: 110px;" @bind="TinNo" />
                </div>
                <div style="display:flex; align-items:center; gap:4px; margin-left:4px;">
                    <label class="mc-check-lbl">
                        Is TIN No. Mandatory?
                        <input type="checkbox" style="margin-left: 4px;" @bind="IsTinMandatory" />
                    </label>
                </div>
            </div>

            <div>
                <button type="button" class="ci-btn" @onclick="HandleClose">
                    <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                    <div class="ci-text">Close</div>
                </button>
            </div>
        </div>

        <!-- Main Body Panels -->
        <div class="mc-body-grid">
            <!-- Left Column -->
            <div class="mc-left-panel">
                <div class="mc-form-card">
                    <div class="mc-form-row">
                        <label class="mc-lbl">Article</label>
                        <div class="lookup-field" style="flex:1;">
                            <DxTextBox @bind-Text="Article" ReadOnly="true" Width="100%"
                                       CssClass="erp-combobox lookup-input" Click="HandleOpenArticleFind" />
                            <button type="button" class="lookup-toggle-btn" @onclick="HandleOpenArticleFind">▾</button>
                        </div>
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl">Qty.</label>
                        <DxSpinEdit CssClass="dx-input-num" Value="@Qty"
                                    ValueChanged="@((int v) => { Qty = v; RecalculateLineTotal(); })" MinValue="1"
                                    SizeMode="SizeMode.Small" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl">Amount</label>
                        <DxSpinEdit CssClass="dx-input-num" Value="@Amount"
                                    ValueChanged="@((decimal v) => { Amount = v; RecalculateLineTotal(); })" MinValue="0"
                                    SizeMode="SizeMode.Small" DisplayFormat="N2" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl">Total</label>
                        <input class="mc-input" value="@LineTotal.ToString("N2")" readonly
                               style="background: #f8fafc;" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl">Note</label>
                        <input class="mc-input" @bind="Note" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl">Remark</label>
                        <input class="mc-input" @bind="Remark" />
                    </div>
                </div>

                <!-- Add / Remove Buttons -->
                <div class="mc-action-btns">
                    <button type="button" class="mc-table-btn" @onclick="HandleAddLine">
                        <i class="bi bi-plus-circle text-primary"></i> Add
                    </button>
                    <button type="button" class="mc-table-btn" @onclick="HandleRemoveLine">
                        <i class="bi bi-dash-circle text-primary"></i> Remove
                    </button>
                </div>

                <!-- Table -->
                <div class="mc-table-container">
                    <table class="mc-table">
                        <thead>
                            <tr>
                                <th style="width: 35px;">SN</th>
                                <th>Description</th>
                                <th style="width: 85px; text-align: right;">Unit Price</th>
                                <th style="width: 45px; text-align: center;">Qty</th>
                                <th style="width: 70px; text-align: right;">Tax</th>
                                <th style="width: 85px; text-align: right;">Total Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Lines.Any())
                            {
                                <tr>
                                    <td colspan="6" style="text-align:center; color:#94a3b8; padding: 24px;">No charge items added</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var line in Lines)
                                {
                                    <tr class="@(SelectedLine == line ? "mc-row-selected" : "")"
                                        @onclick="() => SelectedLine = line">
                                        <td style="text-align: center;">@line.SN</td>
                                        <td>@line.Description</td>
                                        <td style="text-align: right;">@line.UnitPrice.ToString("N2")</td>
                                        <td style="text-align: center;">@line.Qty</td>
                                        <td style="text-align: right;">@line.Tax.ToString("N2")</td>
                                        <td style="text-align: right;">@line.TotalPrice.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column -->
            <div class="mc-right-panel">
                <div class="mc-form-card">
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Date</label>
                        <DxDateEdit @bind-Date="Date" SizeMode="SizeMode.Small" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">No.</label>
                        <input class="mc-input" value="@No" readonly style="background: #f8fafc;" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Charge Type</label>
                        <DxComboBox CssClass="erp-combobox" Data="@ChargeTypes" @bind-Value="ChargeType"
                                    SizeMode="SizeMode.Small" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Transaction Type</label>
                        <DxComboBox CssClass="erp-combobox" Data="@TransactionTypes"
                                    @bind-Value="TransactionType" SizeMode="SizeMode.Small" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Currency</label>
                        <DxComboBox CssClass="erp-combobox" Data="@Currencies" @bind-Value="Currency"
                                    SizeMode="SizeMode.Small" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Registration</label>
                        <input class="mc-input" value="@Registration" readonly style="background: #f8fafc;" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Room</label>
                        <input class="mc-input" value="@Room" readonly style="background: #f8fafc;" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Reference</label>
                        <input class="mc-input" @bind="Reference" />
                    </div>
                    <div class="mc-form-row">
                        <label class="mc-lbl-r">Window</label>
                        <DxComboBox CssClass="erp-combobox" Data="@WindowList" @bind-Value="Window"
                                    SizeMode="SizeMode.Small" />
                    </div>

                    <!-- Totals Block with Shaded Slate Headers -->
                    <div class="mc-totals-section">
                        <div class="mc-total-row">
                            <span class="mc-total-lbl">Subtotal</span>
                            <input class="mc-total-val" value="@Subtotal.ToString("N2")" readonly />
                        </div>
                        <div class="mc-total-row">
                            <span class="mc-total-lbl">Discount</span>
                            <input class="mc-total-val" value="@Discount.ToString("N2")" readonly />
                        </div>
                        <div class="mc-total-row">
                            <span class="mc-total-lbl">Additional Charge</span>
                            <input class="mc-total-val" value="@AdditionalCharge.ToString("N2")" readonly />
                        </div>
                        <div class="mc-total-row">
                            <span class="mc-total-lbl">VAT</span>
                            <input class="mc-total-val" value="@Vat.ToString("N2")" readonly />
                        </div>
                        <div class="mc-total-row">
                            <span class="mc-total-lbl">Grand Total</span>
                            <input class="mc-total-val" value="@GrandTotal.ToString("N2")" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ==================== ARTICLE FIND POPUP ==================== -->
<ArticleFindPopup @bind-Visible="showArticleFind" Articles="@Articles" OnSelect="HandleSelectArticle" />

<!-- ==================== RATE SUMMARY MODAL ==================== -->
<DxPopup @bind-Visible="showRateSummary" HeaderText="Rate Summery" Width="960px" CloseOnOutsideClick="false"
         ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div class="rs-modal-container">
            <!-- Rate Summary Toolbar -->
            <div class="amend-toolbar">
                <button type="button" class="ci-btn" @onclick="OpenDailyRateDetail">
                    <div class="ci-icon" style="color:#e0a52c;"><i class="bi bi-file-earmark-text"></i></div>
                    <div class="ci-text">Detail</div>
                </button>
                <button type="button" class="ci-btn" @onclick="OpenRateSummaryPrint">
                    <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-printer"></i></div>
                    <div class="ci-text">Print</div>
                </button>
                <button type="button" class="ci-btn" @onclick="@(() => showRateSummary = false)">
                    <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                    <div class="ci-text">Close</div>
                </button>
            </div>

            <!-- Rate Summary Table -->
            <div class="rs-table-wrapper">
                <table class="rs-table">
                    <thead>
                        <tr>
                            <th style="width: 35px;">SN</th>
                            <th style="width: 80px;">Day</th>
                            <th style="width: 90px;">Date</th>
                            <th style="width: 75px; text-align: center;">Rate Code</th>
                            <th style="text-align: right;">Room Revenue</th>
                            <th style="text-align: right;">Package</th>
                            <th style="text-align: right;">Subtotal</th>
                            <th style="text-align: right;">Service Charge</th>
                            <th style="text-align: right;">VAT</th>
                            <th style="text-align: right;">Grand Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in RateRows)
                        {
                            <tr class="@(selectedRateRow == row ? "rs-row-selected" : "")"
                                @onclick="() => selectedRateRow = row" @ondblclick="OpenDailyRateDetail">
                                <td style="text-align: center;">@row.SN</td>
                                <td>@row.Day</td>
                                <td>@row.Date.ToString("M/d/yyyy")</td>
                                <td style="text-align: center;">@row.RateCode</td>
                                <td style="text-align: right;">@row.RoomRevenue.ToString("F2")</td>
                                <td style="text-align: right;">@row.Package.ToString("F2")</td>
                                <td style="text-align: right;">@row.Subtotal.ToString("F2")</td>
                                <td style="text-align: right;">@row.ServiceCharge.ToString("F2")</td>
                                <td style="text-align: right;">@row.Vat.ToString("F2")</td>
                                <td style="text-align: right;">@row.GrandTotal.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Bottom Summary Section -->
            <div class="rs-bottom-summary">
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Total Cost of Stay</span>
                    <input class="rs-sum-val" value="@TotalCostOfStay.ToString("F2")" readonly />
                </div>
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Total Deducted</span>
                    <input class="rs-sum-val" value="@TotalDeducted.ToString("F2")" readonly />
                </div>
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Outstanding Stay Total</span>
                    <input class="rs-sum-val" value="@OutstandingStayTotal.ToString("F2")" readonly />
                </div>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ==================== DAILY RATE DETAIL MODAL ==================== -->
<DxPopup @bind-Visible="showDailyRateDetail" HeaderText="Daily Rate Detail" Width="680px" CloseOnOutsideClick="false"
         ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div class="dr-modal-container">
            <div class="amend-toolbar" style="margin-bottom: 8px;">
                <button type="button" class="ci-btn" @onclick="@(() => showDailyRateDetail = false)">
                    <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                    <div class="ci-text">Close</div>
                </button>
            </div>

            <div class="dr-table-wrapper">
                <table class="rs-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Article Code</th>
                            <th>Description</th>
                            <th style="width: 130px; text-align: right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="rs-row-selected">
                            <td>@(selectedRateRow?.RateCode ?? "4")</td>
                            <td>Room Revenue</td>
                            <td style="text-align: right;">@((selectedRateRow?.GrandTotal ?? 100.00m).ToString("F2"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="rs-bottom-summary" style="margin-top: 14px;">
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Sub Total</span>
                    <input class="rs-sum-val" value="@((selectedRateRow?.Subtotal ?? 86.96m).ToString("F2"))" readonly />
                </div>
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Ser. Charge</span>
                    <input class="rs-sum-val" value="@((selectedRateRow?.ServiceCharge ?? 0.00m).ToString("F2"))" readonly />
                </div>
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Discount</span>
                    <input class="rs-sum-val" value="0.00" readonly />
                </div>
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">VAT</span>
                    <input class="rs-sum-val" value="@((selectedRateRow?.Vat ?? 13.04m).ToString("F2"))" readonly />
                </div>
                <div class="rs-sum-row">
                    <span class="rs-sum-lbl">Grand Total</span>
                    <input class="rs-sum-val" value="@((selectedRateRow?.GrandTotal ?? 100.00m).ToString("F2"))" readonly />
                </div>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ==================== RATE SUMMARY PRINT REPORT MODAL ==================== -->
<DxPopup @bind-Visible="showRateSummaryPrint" HeaderText="Rate Summary - Print" Width="980px"
         CloseOnOutsideClick="false" ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div class="amend-toolbar" style="margin-bottom: 10px;">
            <button type="button" class="ci-btn" onclick="window.print()">
                <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-printer"></i></div>
                <div class="ci-text">Print Document</div>
            </button>
            <button type="button" class="ci-btn" @onclick="@(() => showRateSummaryPrint = false)">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>

        <div class="rate-print-sheet" id="rate-summary-print-area">
            <div class="print-header-block">
                <div class="print-hotel-name">TEST HOTEL</div>
                <div class="print-doc-title">Rate Summary</div>
                <div class="print-date-line">Date : @DateTime.Today.ToString("M/d/yyyy")</div>
            </div>

            <table class="print-grid-table">
                <thead>
                    <tr>
                        <th style="width: 35px;">SN</th>
                        <th style="width: 75px;">Day</th>
                        <th style="width: 85px;">Date</th>
                        <th style="width: 75px; text-align: center;">Rate Code</th>
                        <th style="text-align: right;">Room Revenue</th>
                        <th style="text-align: right;">Package</th>
                        <th style="text-align: right;">Subtotal</th>
                        <th style="text-align: right;">Service Charge</th>
                        <th style="text-align: right;">VAT</th>
                        <th style="text-align: right;">Grand Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in RateRows)
                    {
                        <tr>
                            <td style="text-align: center;">@row.SN</td>
                            <td>@row.Day</td>
                            <td>@row.Date.ToString("M/d/yyyy")</td>
                            <td style="text-align: center;">@row.RateCode</td>
                            <td style="text-align: right;">@row.RoomRevenue.ToString("F2")</td>
                            <td style="text-align: right;">@row.Package.ToString("F2")</td>
                            <td style="text-align: right;">@row.Subtotal.ToString("F2")</td>
                            <td style="text-align: right;">@row.ServiceCharge.ToString("F2")</td>
                            <td style="text-align: right;">@row.Vat.ToString("F2")</td>
                            <td style="text-align: right;">@row.GrandTotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="print-signatures-row">
                <div class="print-sig-col">
                    <div class="sig-line"></div>
                    <div class="sig-lbl">Prepared By</div>
                </div>
                <div class="print-sig-col">
                    <div class="sig-line"></div>
                    <div class="sig-lbl">Checked By</div>
                </div>
                <div class="print-sig-col">
                    <div class="sig-line"></div>
                    <div class="sig-lbl">Approved By</div>
                </div>
                <div class="print-sig-col">
                    <div class="sig-line"></div>
                    <div class="sig-lbl">Authorized By</div>
                </div>
            </div>

            <div class="print-footer-brand">
                ERP System
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

    <style>
        /* Manual Charge Modal Styles */
        .mc-field-inline {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .mc-field-lbl {
            font-size: 11px;
            color: #475569;
            font-weight: 500;
        }

        .mc-input-sm {
            height: 22px;
            padding: 1px 4px;
            font-size: 11px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            background: #fff;
        }

        .mc-check-lbl {
            font-size: 11px;
            color: #475569;
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        .mc-body-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 12px;
        }

        .mc-left-panel,
        .mc-right-panel {
            display: flex;
            flex-direction: column;
        }

        .mc-form-card {
            border: 1px solid #c8cdd4;
            border-radius: 3px;
            padding: 8px 10px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .mc-form-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mc-lbl {
            width: 60px;
            font-size: 11.5px;
            color: #334155;
            flex-shrink: 0;
        }

        .mc-lbl-r {
            width: 105px;
            font-size: 11.5px;
            color: #334155;
            flex-shrink: 0;
        }

        .mc-input {
            flex: 1;
            height: 22px;
            padding: 1px 6px;
            font-size: 11px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            background: #ffffff;
            box-sizing: border-box;
        }

        .mc-action-btns {
            display: flex;
            gap: 6px;
            margin: 8px 0;
        }

        .mc-table-btn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 12px;
            font-size: 11.5px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            cursor: pointer;
        }

        .mc-table-btn:hover {
            background: #f1f5f9;
        }

        .mc-table-container {
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            max-height: 220px;
            overflow-y: auto;
            background: #ffffff;
        }

        .mc-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        .mc-table th {
            background: #f8fafc;
            color: #334155;
            font-weight: 600;
            padding: 5px 8px;
            border-bottom: 1px solid #cbd5e1;
            border-right: 1px solid #e2e8f0;
            text-align: left;
        }

        .mc-table td {
            padding: 4px 8px;
            border-bottom: 1px solid #f1f5f9;
            border-right: 1px solid #f1f5f9;
            color: #1e293b;
        }

        .mc-table tr:hover {
            background: #f8fafc;
        }

        .mc-row-selected {
            background: #e0f2fe !important;
            color: #0369a1 !important;
        }

        /* Shaded Slate Blue Totals Section */
        .mc-totals-section {
            margin-top: 8px;
            border-top: 1px solid #e2e8f0;
            padding-top: 6px;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .mc-total-row {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .mc-total-lbl {
            width: 110px;
            background: #b0c4de;
            color: #1e293b;
            font-size: 11px;
            font-weight: 600;
            padding: 3px 6px;
            border-radius: 2px;
            text-align: left;
            flex-shrink: 0;
        }

        .mc-total-val {
            flex: 1;
            height: 22px;
            padding: 1px 6px;
            font-size: 11px;
            border: 1px solid #cbd5e1;
            border-radius: 2px;
            background: #ffffff;
            text-align: right;
            font-family: inherit;
        }

        /* Rate Summary Modal Styles */
        .rs-modal-container {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .rs-table-wrapper {
            border: 1px solid #cbd5e1;
            max-height: 380px;
            overflow-y: auto;
            background: #fff;
        }

        .rs-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        .rs-table th {
            background: #f1f5f9;
            color: #334155;
            font-weight: 600;
            padding: 5px 8px;
            border-bottom: 1px solid #cbd5e1;
            border-right: 1px solid #cbd5e1;
            white-space: nowrap;
            text-align: left;
        }

        .rs-table td {
            padding: 4px 8px;
            border-bottom: 1px solid #e2e8f0;
