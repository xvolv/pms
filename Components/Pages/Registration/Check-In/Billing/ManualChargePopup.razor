@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public RegistrationRow? TargetRegistration { get; set; }

    [Parameter] public string? Article { get; set; } = "ROOM CHARGE";
    [Parameter] public EventCallback<string?> ArticleChanged { get; set; }
    [Parameter] public int Qty { get; set; } = 1;
    [Parameter] public EventCallback<int> QtyChanged { get; set; }
    [Parameter] public decimal Amount { get; set; } = 0.00m;
    [Parameter] public EventCallback<decimal> AmountChanged { get; set; }
    [Parameter] public string Note { get; set; } = "";
    [Parameter] public string Remark { get; set; } = "";
    [Parameter] public EventCallback<string> RemarkChanged { get; set; }

    [Parameter] public string GuestCode { get; set; } = "67";
    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string TinNo { get; set; } = "";
    [Parameter] public bool IsTinMandatory { get; set; } = false;

    [Parameter] public DateTime? Date { get; set; } = DateTime.Today;
    [Parameter] public string No { get; set; } = "DRC-00003-26";
    [Parameter] public string? ChargeType { get; set; } = "Room Charge";
    [Parameter] public string TransactionType { get; set; } = "Credit Sales";
    [Parameter] public string? Currency { get; set; } = "Birr";
    [Parameter] public string Registration { get; set; } = "REG-00008-26";
    [Parameter] public string Room { get; set; } = "107";
    [Parameter] public string Reference { get; set; } = "";
    [Parameter] public string? Window { get; set; } = "Window 1";
    [Parameter] public decimal Subtotal { get; set; } = 0.00m;
    [Parameter] public decimal Discount { get; set; } = 0.00m;
    [Parameter] public decimal AdditionalCharge { get; set; } = 0.00m;
    [Parameter] public decimal Vat { get; set; } = 0.00m;
    [Parameter] public decimal GrandTotal { get; set; } = 0.00m;

    [Parameter] public List<ManualChargeLine> Lines { get; set; } = new();
    [Parameter] public ManualChargeLine? SelectedLine { get; set; }
    [Parameter] public EventCallback<ManualChargeLine?> SelectedLineChanged { get; set; }

    [Parameter]
    public List<ArticleItem> Articles { get; set; } = new()
    {
        new() { Code = "RC-0001-26", Name = "ROOM CHARGE" },
        new() { Code = "BF-0002-26", Name = "BREAKFAST" },
        new() { Code = "LD-0003-26", Name = "LAUNDRY" },
        new() { Code = "MB-0004-26", Name = "MINIBAR" },
        new() { Code = "PK-0005-26", Name = "BED AND BREAKFAST" },
        new() { Code = "SP-0006-26", Name = "SPA SERVICE" },
        new() { Code = "TR-0007-26", Name = "AIRPORT TRANSFER" }
    };

    [Parameter] public List<string> ChargeTypes { get; set; } = new() { "Room Charge", "Package Charge", "Extra Charge" };
    [Parameter] public List<string> TransactionTypes { get; set; } = new() { "Credit Sales", "Cash Sales" };
    [Parameter]
    public List<string> Currencies { get; set; } = new() { "Birr", "US Dollar", "Euro", "Yen", "Yuan", "Pound",
"Dirham" };
    [Parameter]
    public List<string> WindowList { get; set; } = new() { "Window 1", "Window 2", "Window 3", "Window 4",
"Window 5", "Window 6", "Window 7" };

    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnAddLine { get; set; }
    [Parameter] public EventCallback OnRemoveLine { get; set; }
    [Parameter] public EventCallback OnOpenArticleFind { get; set; }

    bool showArticleFind = false;
    bool showRateSummary = false;
    bool showDailyRateDetail = false;
    bool showRateSummaryPrint = false;

    decimal LineTotal => Qty * (Amount > 0 ? Amount : 0);

    List<RateSummaryModelRow> RateRows = new();
    RateSummaryModelRow? selectedRateRow;

    decimal TotalCostOfStay => RateRows.Sum(r => r.GrandTotal);
    decimal TotalDeducted => 0.00m;
    decimal OutstandingStayTotal => TotalCostOfStay - TotalDeducted;

    protected override void OnParametersSet()
    {
        if (TargetRegistration != null)
        {
            if (string.IsNullOrEmpty(Registration)) Registration = TargetRegistration.Registration ?? "REG-00008-26";
            if (string.IsNullOrEmpty(Room)) Room = (TargetRegistration.Room ?? "107").Replace("#", "");
            if (string.IsNullOrEmpty(Company)) Company = TargetRegistration.Company ?? "";
            if (string.IsNullOrEmpty(GuestCode)) GuestCode = TargetRegistration.SN.ToString();
        }
        if (string.IsNullOrEmpty(No))
        {
            No = $"DRC-00003-26";
        }
        BuildRateSummaryRows();
    }

    void BuildRateSummaryRows()
    {
        RateRows.Clear();
        var baseDate = TargetRegistration?.Arrival ?? new DateTime(2026, 8, 27);
        int nights = 15;
        if (TargetRegistration != null)
        {
            nights = Math.Max(1, (int)(TargetRegistration.Departure - TargetRegistration.Arrival).TotalDays);
        }

        for (int i = 0; i < nights; i++)
        {
            var date = baseDate.AddDays(i);
            RateRows.Add(new RateSummaryModelRow
            {
                SN = i + 1,
                Day = date.ToString("dddd"),
                Date = date,
                RateCode = "2",
                RoomRevenue = 86.96m,
                Package = 0.00m,
                Subtotal = 86.96m,
                ServiceCharge = 0.00m,
                Vat = 13.04m,
                GrandTotal = 100.00m
            });
        }
        selectedRateRow = RateRows.FirstOrDefault();
    }

    void RecalculateLineTotal()
    {
        StateHasChanged();
    }

    void RecalculateTotals()
    {
        Subtotal = Lines.Sum(l => l.TotalPrice);
        Discount = 0;
        AdditionalCharge = Math.Round(Subtotal * 0.10m, 2);
        Vat = Math.Round((Subtotal + AdditionalCharge - Discount) * 0.15m, 2);
        GrandTotal = Subtotal + AdditionalCharge - Discount + Vat;
    }

    async Task HandleNew()
    {
        Article = "ROOM CHARGE";
        Qty = 1;
        Amount = 0;
        Note = "";
        Remark = "";
        Lines.Clear();
        SelectedLine = null;
        RecalculateTotals();
        await OnNew.InvokeAsync();
    }

    async Task HandleAddLine()
    {
        if (OnAddLine.HasDelegate)
        {
            await OnAddLine.InvokeAsync();
        }
        else if (!string.IsNullOrWhiteSpace(Article))
        {
            var desc = Article;
            var unit = Amount > 0 ? Amount : 100.00m;
            var tax = Math.Round(unit * Qty * 0.15m, 2);
            Lines.Add(new ManualChargeLine
            {
                SN = Lines.Count + 1,
                Description = desc,
                UnitPrice = unit,
                Qty = Qty,
                Tax = tax,
                TotalPrice = unit * Qty
            });
            RecalculateTotals();
        }
    }

    async Task HandleRemoveLine()
    {
        if (OnRemoveLine.HasDelegate)
        {
            await OnRemoveLine.InvokeAsync();
        }
        else if (SelectedLine != null)
        {
            Lines.Remove(SelectedLine);
            SelectedLine = null;
            int i = 1;
            foreach (var l in Lines) l.SN = i++;
            RecalculateTotals();
        }
    }

    void HandleOpenArticleFind()
    {
        showArticleFind = true;
    }

    void HandleSelectArticle(string? artName)
    {
        if (artName != null)
        {
            Article = artName;
            ArticleChanged.InvokeAsync(Article);
        }
        showArticleFind = false;
    }

    void OpenRateSummary()
    {
        showRateSummary = true;
    }

    void OpenDailyRateDetail()
    {
        if (selectedRateRow == null && RateRows.Any()) selectedRateRow = RateRows.First();
        showDailyRateDetail = true;
    }

    void OpenRateSummaryPrint()
    {
        showRateSummaryPrint = true;
    }

    async Task HandleSave() => await OnSave.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);

    public class RateSummaryModelRow
    {
        public int SN { get; set; }
        public string Day { get; set; } = "";
        public DateTime Date { get; set; }
        public string RateCode { get; set; } = "";
        public decimal RoomRevenue { get; set; }
        public decimal Package { get; set; }
        public decimal Subtotal { get; set; }
        public decimal ServiceCharge { get; set; }
        public decimal Vat { get; set; }
        public decimal GrandTotal { get; set; }
    }
}
