@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="Customer" Width="520px"
         CloseOnOutsideClick="false" ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div style="display:flex; gap:8px; margin-bottom:8px;">
            <DxTextBox Width="100%" SizeMode="SizeMode.Small" />
            <DxButton Text="Find" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" />
        </div>
        <table class="multi-table" style="width:100%; max-height:280px; overflow:auto;">
            <thead>
                <tr><th>code</th><th>name</th><th>id Number</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Customers)
                {
                    <tr style="cursor:pointer;"
                        class="@(SelectedCustomer == c ? "row-selected" : "")"
                        @onclick="() => SelectedCustomerChanged.InvokeAsync(c)"
                        @ondblclick="HandleOk">
                        <td>@c.Code</td>
                        <td>@c.Name</td>
                        <td>@c.IdNumber</td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="margin-top:10px; display:flex; gap:8px; justify-content:flex-end;">
            <DxButton Text="New" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => {})" />
            <DxButton Text="Clear" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" Click="HandleClear" />
            <DxButton Text="OK" SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Primary" Click="HandleOk" />
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public List<CustomerFindItem> Customers { get; set; } = new();
    [Parameter] public CustomerFindItem? SelectedCustomer { get; set; }
    [Parameter] public EventCallback<CustomerFindItem?> SelectedCustomerChanged { get; set; }
    [Parameter] public EventCallback OnOk { get; set; }

    async Task HandleOk() { await OnOk.InvokeAsync(); await VisibleChanged.InvokeAsync(false); }
    async Task HandleClear()
    {
        await SelectedCustomerChanged.InvokeAsync(null);
        await VisibleChanged.InvokeAsync(false);
    }
}
