@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="@Title" Width="640px"
         CloseOnOutsideClick="false" ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div class="amend-toolbar">
            <button type="button" class="toolbar-btn" @onclick="HandleSave">
                <div class="toolbar-icon"><i class="bi bi-floppy"></i></div>
                <div class="toolbar-text">Save</div>
            </button>
            @if (ShowForeignCurrency)
            {
                <button type="button" class="toolbar-btn" @onclick="HandleForeignCurrency">
                    <div class="toolbar-icon"><i class="bi bi-currency-exchange"></i></div>
                    <div class="toolbar-text">Foreign<br/>Currency</div>
                </button>
            }
            <button type="button" class="toolbar-btn" @onclick="HandleClose">
                <div class="toolbar-icon"><i class="bi bi-x-circle"></i></div>
                <div class="toolbar-text">Close</div>
            </button>
        </div>
        <div style="display:flex; gap:12px;">
            <div class="amend-form" style="flex:1; border:1px solid #c8cdd4; padding:8px;">
                <div class="amend-row"><label>Customer</label>
                    <div class="input-with-btn">
                        <DxComboBox CssClass="erp-combobox" Data="@Customers.Select(c => c.Name).ToList()" @bind-Value="Customer" SizeMode="SizeMode.Small" />
                        @if (ShowCustomerFind)
                        {
                            <DxButton Text="..." SizeMode="SizeMode.Small" RenderStyle="ButtonRenderStyle.Secondary" Click="HandleOpenCustomerFind" />
                        }
                    </div>
                </div>
                <div class="amend-row"><label>Payment Type</label>
                    <DxComboBox CssClass="erp-combobox" Data="@PaymentMethods" @bind-Value="PaymentType" SizeMode="SizeMode.Small" />
                </div>
                <div class="amend-row"><label>Currency</label>
                    <DxComboBox CssClass="erp-combobox" Data="@Currencies" @bind-Value="Currency" SizeMode="SizeMode.Small" />
                </div>
                <div class="amend-row"><label>Ex. Rate</label>
                    <DxSpinEdit CssClass="dx-input-num" @bind-Value="ExRate" SizeMode="SizeMode.Small" />
                </div>
                <div class="amend-row"><label>Amount</label>
                    <DxSpinEdit CssClass="dx-input-num" @bind-Value="Amount" SizeMode="SizeMode.Small" />
                </div>
                <div class="amend-row"><label>Total Amount</label>
                    <DxTextBox Text="@TotalAmount.ToString("N2")" SizeMode="SizeMode.Small" ReadOnly="true" />
                </div>
                @if (ShowNetOff)
                {
                    <div class="amend-row"><label></label>
                        <DxCheckBox @bind-Checked="NetOff">Net Off</DxCheckBox>
                    </div>
                }
            </div>
            <div class="amend-form" style="flex:1; border:1px solid #c8cdd4; padding:8px;">
                <div class="amend-row"><label>Voucher No.</label>
                    <DxTextBox @bind-Text="VoucherNo" SizeMode="SizeMode.Small" ReadOnly="true" />
                </div>
                <div class="amend-row"><label>Date</label>
                    <DxDateEdit @bind-Date="Date" SizeMode="SizeMode.Small" />
                </div>
                <div class="amend-row"><label>Reg. No</label>
                    <DxTextBox @bind-Text="RegNo" SizeMode="SizeMode.Small" ReadOnly="true" />
                </div>
                <div class="amend-row"><label>Window</label>
                    <DxComboBox CssClass="erp-combobox" Data="@WindowList" @bind-Value="Window" SizeMode="SizeMode.Small" />
                </div>
                <div class="amend-row"><label>Reference</label>
                    <DxTextBox @bind-Text="Reference" SizeMode="SizeMode.Small" />
                </div>
            </div>
        </div>
        <div class="amend-form" style="margin-top:8px;">
            <div class="amend-row"><label>Purpose</label>
                <DxMemo @bind-Text="Purpose" Rows="2" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Remark</label>
                <DxTextBox @bind-Text="Remark" SizeMode="SizeMode.Small" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Embedded Foreign Currency Popup -->
<ForeignCurrencyPopup
    @bind-Visible="showForeignCurrency"
    VoucherNo="@VoucherNo"
    Payment="@Amount"
    Currencies="@Currencies"
    OnSave="@(() => showForeignCurrency = false)" />

<!-- Embedded Customer Find Popup -->
<CrCustomerFindPopup
    @bind-Visible="showCustomerFind"
    Customers="@Customers"
    @bind-SelectedCustomer="selectedCustomerItem"
    OnOk="HandleSelectCustomer" />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public RegistrationRow? TargetRegistration { get; set; }
    [Parameter] public string Title { get; set; } = "Cash Receipt";
    [Parameter] public bool ShowForeignCurrency { get; set; } = true;
    [Parameter] public bool ShowNetOff { get; set; } = false;
    [Parameter] public bool ShowCustomerFind { get; set; } = true;

    [Parameter] public string Customer { get; set; } = "";
    [Parameter] public string? PaymentType { get; set; } = "Cash";
    [Parameter] public string? Currency { get; set; } = "Birr";
    [Parameter] public decimal ExRate { get; set; } = 1;
    [Parameter] public decimal Amount { get; set; } = 3744.03m;
    [Parameter] public decimal TotalAmount { get; set; } = 3744.03m;
    [Parameter] public string VoucherNo { get; set; } = "";
    [Parameter] public DateTime? Date { get; set; } = DateTime.Today;
    [Parameter] public string RegNo { get; set; } = "";
    [Parameter] public string? Window { get; set; } = "Window 1";
    [Parameter] public string Reference { get; set; } = "";
    [Parameter] public string Purpose { get; set; } = "";
    [Parameter] public string Remark { get; set; } = "";
    [Parameter] public bool NetOff { get; set; } = true;

    [Parameter] public List<CustomerFindItem> Customers { get; set; } = new();
    [Parameter] public List<string> PaymentMethods { get; set; } = new() { "Cash", "Check", "CPO", "Credit Card", "Debit Card", "Gift Card", "Entertainment" };
    [Parameter] public List<string> Currencies { get; set; } = new() { "Birr", "US Dollar", "Euro", "Yen", "Yuan", "Pound", "Dirham" };
    [Parameter] public List<string> WindowList { get; set; } = new() { "Window 1", "Window 2", "Window 3", "Window 4", "Window 5", "Window 6", "Window 7" };

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnForeignCurrency { get; set; }
    [Parameter] public EventCallback OnOpenCustomerFind { get; set; }

    bool showForeignCurrency = false;
    bool showCustomerFind = false;
    CustomerFindItem? selectedCustomerItem;

    protected override void OnParametersSet()
    {
        if (TargetRegistration != null)
        {
            if (string.IsNullOrEmpty(Customer)) Customer = TargetRegistration.Guest ?? "";
            if (string.IsNullOrEmpty(RegNo)) RegNo = TargetRegistration.Registration ?? "";
        }

        if (string.IsNullOrEmpty(VoucherNo))
        {
            VoucherNo = Title.Contains("Rebate", StringComparison.OrdinalIgnoreCase) ? $"WCNO-{Random.Shared.Next(100, 999)}-17" :
                        Title.Contains("Paid Out", StringComparison.OrdinalIgnoreCase) ? $"POV-{Random.Shared.Next(100, 999)}-17" :
                        $"CRV-{Random.Shared.Next(50000, 99999)}";
        }

        if (!Customers.Any())
        {
            Customers = new List<CustomerFindItem>
            {
                new() { Code = "PCU-00001", Name = "TIGIST ASMAMAW", IdNumber = "" },
                new() { Code = "WPGU-00001-17", Name = "TEST GUEST WASA", IdNumber = "123456" },
                new() { Code = "WPGU-00002-17", Name = "TAHER NAGUIB ALI", IdNumber = "D02018" },
                new() { Code = "WPGU-00003-17", Name = "OUDINE FATHIA DJAMA", IdNumber = "D02020" },
                new() { Code = "WPGU-00004-17", Name = "DJAMA MOHAMED ALI", IdNumber = "D02362" },
                new() { Code = "WPGU-00005-17", Name = "DOUALEH DOUALEH AHMED", IdNumber = "D01950" },
                new() { Code = "WPGU-00007-17", Name = "ONEN TONNYYY", IdNumber = "263805" },
                new() { Code = "WPGU-00008-17", Name = "DAVID NIJIRI WAWERU", IdNumber = "C042628" },
                new() { Code = "WPGU-00010-17", Name = "SINGH KUNWAR SURENDRA", IdNumber = "J8124701" },
                new() { Code = RegNo, Name = Customer, IdNumber = "" }
            };
        }
    }

    async Task HandleSave() => await OnSave.InvokeAsync();
    async Task HandleForeignCurrency()
    {
        if (OnForeignCurrency.HasDelegate) await OnForeignCurrency.InvokeAsync();
        else showForeignCurrency = true;
    }
    async Task HandleOpenCustomerFind()
    {
        if (OnOpenCustomerFind.HasDelegate) await OnOpenCustomerFind.InvokeAsync();
        else showCustomerFind = true;
    }
    void HandleSelectCustomer()
    {
        if (selectedCustomerItem != null)
        {
            Customer = selectedCustomerItem.Name;
        }
        showCustomerFind = false;
    }
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}
