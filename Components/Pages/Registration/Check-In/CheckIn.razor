        }
        var key = guestSearchText.Trim().ToLower();
        filteredGuests = guestList
            .Where(g => (g.FirstName + " " + g.MiddleName + " " + g.LastName).ToLower().Contains(key)
                     || g.Identification.ToLower().Contains(key))
            .ToList();
    }

