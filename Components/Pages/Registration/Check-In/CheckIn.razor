@rendermode InteractiveServer
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using ERP.V7.WebPMS.Components.Shared
@using ERP.V7.WebPMS.Components.Pages.Profile.Guest
@using ERP.V7.WebPMS.Components.Pages.Profile.Company
@using ERP.V7.WebPMS.Components.Pages.Profile.Company.Models
@using ERP.V7.WebPMS.Components.Pages.Profile.Group
@using ERP.V7.WebPMS.Components.Pages.Profile.Group.Models
@using ERP.V7.WebPMS.Components.Pages.Profile.Contact
@using ERP.V7.WebPMS.Components.Pages.Profile.TravelAgent
@using ERP.V7.WebPMS.Components.Pages.Profile.TravelAgent.Models
@using ERP.V7.WebPMS.Components.Pages.Profile.Source
@using ERP.V7.WebPMS.Components.Pages.Profile.Source.Models
@using ERP.V7.WebPMS.Components.Pages.Profile.Shared
@using ERP.V7.WebPMS.Services.DocumentBrowser
@using CNET_V7_Domain.Misc
@inject IDocumentBrowserService DocumentBrowserService
@inject NavigationManager Navigation

<PageTitle>Check-In - CNET ERP</PageTitle>

<div class="reservation-page">

    <!-- ===================== TITLE BAR ===================== -->
    @if (!IsShareMode)
    {
        <div class="window-title">
            <img src="/cnet logo.png" class="title-icon" alt="CNET Logo" />
            <span class="title-text">CHECK-IN - @ReservationNo</span>
        </div>
    }

    <!-- ===================== COMMAND PANEL ===================== -->
    <div class="erp-toolbar">
        <div class="toolbar-group">
            <button class="toolbar-btn" @onclick="NewCheckIn">
                <div class="toolbar-icon"><i class="bi bi-file-earmark-plus"></i></div>
                <div class="toolbar-text">New</div>
            </button>
            <button class="toolbar-btn" @onclick="PerformCheckIn">
                <div class="toolbar-icon" style="color:#2e7d32;"><i class="bi bi-check2-square"></i></div>
                <div class="toolbar-text">Check In</div>
            </button>
        </div>

        <div class="toolbar-group">
            <button class="toolbar-btn" @onclick="OpenDailyDetail">
                <div class="toolbar-icon"><i class="bi bi-calendar"></i></div>
                <div class="toolbar-text">Daily Detail</div>
            </button>
            <button class="toolbar-btn" @onclick="OpenTravelDetail">
                <div class="toolbar-icon"><i class="bi bi-briefcase"></i></div>
                <div class="toolbar-text">Travel Detail</div>
            </button>
            <button class="toolbar-btn" @onclick="OpenComments">
                <div class="toolbar-icon"><i class="bi bi-chat-square"></i></div>
                <div class="toolbar-text">Comments</div>
            </button>
            <button class="toolbar-btn" disabled="@(!IsFormValid)" @onclick="OpenReservationDetail">
                <div class="toolbar-icon" style="@(!IsFormValid ? "opacity:.4;" : "")"><i class="bi bi-list-ul"></i></div>
                <div class="toolbar-text" style="@(!IsFormValid ? "opacity:.4;" : "")">Reservation Detail</div>
            </button>
            <button class="toolbar-btn" @onclick="IssueCard">
                <div class="toolbar-icon"><i class="bi bi-pencil"></i></div>
                <div class="toolbar-text">Issue Card</div>
            </button>
            <button class="toolbar-btn" @onclick="PrintCard">
                <div class="toolbar-icon"><i class="bi bi-printer"></i></div>
                <div class="toolbar-text">Print Card</div>
            </button>
        </div>

        <div class="toolbar-group hotel-group">
            <HotelDropdown @bind-selectedHotel="selectedHotel" />
        </div>

        <div class="toolbar-group">
            <button class="toolbar-btn toolbar-close" @onclick="CloseWindow">
                <div class="toolbar-icon"><i class="bi bi-x-circle"></i></div>
                <div class="toolbar-text">Close</div>
            </button>
        </div>
    </div>

    <!-- ===================== MAIN FORM ===================== -->
    <div class="main-area">
        <div class="form-body">

            <!-- TOP ROW: Basic Info + Consignee -->
            <div class="top-row">
                <!-- LEFT: Basic Info -->
                <div class="left-middle">
                    <fieldset class="section">
                        <legend>Basic Info</legend>
                        <div class="basic-grid">
                            <label>Guest Name</label>
                            <div class="input-with-btn wide">
                                <div class="lookup-field" style="flex:1;">
                                    <DxTextBox @bind-Text="guestNameText" ReadOnly="true" Width="100%"
                                               CssClass="erp-combobox lookup-input" Click="OpenGuestSearch" />
                                    <button type="button" class="lookup-toggle-btn" @onclick="OpenGuestSearch">▾</button>
                                </div>
                                <DxButton IconCssClass="bi bi-plus-lg"
                                          CssClass="circle-btn"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          SizeMode="SizeMode.Small"
                                          Click="AddNewGuest" />
                            </div>

                            <label>Nationality</label>
                            <DxTextBox @bind-Text="nationality" SizeMode="SizeMode.Small" />
                            <label>Passport</label>
                            <DxTextBox @bind-Text="passport" SizeMode="SizeMode.Small" />

                            <label>Title</label>
                            <DxTextBox @bind-Text="title" SizeMode="SizeMode.Small" />
                            <label>Address</label>
                            <div class="input-with-btn">
                                <DxTextBox @bind-Text="address" SizeMode="SizeMode.Small" />
                                <DxButton Text="A" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
                            </div>
                        </div>
                    </fieldset>
                </div>

                <!-- RIGHT: Consignee -->
                <div class="right-col">
                    <fieldset class="section consignee-section">
                        <legend>Consignee</legend>
                        <div class="consignee-grid">
                            <label>Company</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="company" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Company"))" />
                                <button type="button" class="lookup-toggle-btn"
                                        @onclick="@(() => OpenLookup("Company"))">▾</button>
                            </div>
                            <label>Agent</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="agent" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Agent"))" />
                                <button type="button" class="lookup-toggle-btn"
                                        @onclick="@(() => OpenLookup("Agent"))">▾</button>
                            </div>

                            <label>Contact</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="contact" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Contact"))" />
                                <button type="button" class="lookup-toggle-btn"
                                        @onclick="@(() => OpenLookup("Contact"))">▾</button>
                            </div>
                            <label>Group</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="group" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Group"))" />
                                <button type="button" class="lookup-toggle-btn"
                                        @onclick="@(() => OpenLookup("Group"))">▾</button>
                            </div>

                            <label>Source</label>
                            <div class="lookup-field">
                                <DxTextBox @bind-Text="consigneeSource" ReadOnly="true" Width="100%"
                                           CssClass="erp-combobox lookup-input" Click="@(() => OpenLookup("Source"))" />
                                <button type="button" class="lookup-toggle-btn"
                                        @onclick="@(() => OpenLookup("Source"))">▾</button>
                            </div>
                            <label>Member Type</label>
                            <DxComboBox CssClass="erp-combobox" Data="@memberTypes" @bind-Value="memberType" SizeMode="SizeMode.Small" />
                        </div>
                    </fieldset>
                </div>
            </div>

            <!-- Stay + Classification + Rate Adjustment -->
            <div class="bottom-row">

                <!-- Stay Info -->
                <fieldset class="section stay-section">
                    <div class="stay-grid">
                        <label>Arrival</label>
                        <DxDateEdit @bind-Date="arrivalDate" SizeMode="SizeMode.Small" />
                        <label>ETA</label>
                        <DxTimeEdit @bind-Time="eta" SizeMode="SizeMode.Small" />

                        <label>Nights</label>
                        <DxSpinEdit CssClass="dx-input-num" @bind-Value="nights" MinValue="1" MaxValue="365" SizeMode="SizeMode.Small" />
                        <label></label><span></span>

                        <label>Departure</label>
                        <DxDateEdit @bind-Date="departureDate" SizeMode="SizeMode.Small" />
                        <label></label><span></span>

                        <label>Adults</label>
                        <DxSpinEdit CssClass="dx-input-num" @bind-Value="adults" MinValue="1" MaxValue="20" SizeMode="SizeMode.Small" />
                        <label>Child</label>
                        <DxSpinEdit CssClass="dx-input-num" @bind-Value="children" MinValue="0" MaxValue="20" SizeMode="SizeMode.Small" />

                        <label>No . of. Rooms</label>
                        <DxSpinEdit CssClass="dx-input-num" @bind-Value="noOfRooms" MinValue="1" MaxValue="50" SizeMode="SizeMode.Small" />
                        <label></label><span></span>

                        <label>Room Type</label>
                        <div class="input-with-error">
                            <DxComboBox CssClass="erp-combobox" Data="@roomTypes" @bind-Value="roomType" SizeMode="SizeMode.Small" />
                            @if (showValidation && string.IsNullOrWhiteSpace(roomType))
                            {
                                <span class="mandatory-x">✕</span>
                            }
                        </div>
                        <label>RTC.</label>
                        <div class="input-with-error">
                            <DxComboBox CssClass="erp-combobox" Data="@rtcList" @bind-Value="rtc" SizeMode="SizeMode.Small" />
                            @if (showValidation && string.IsNullOrWhiteSpace(rtc))
                            {
                                <span class="mandatory-x">✕</span>
                            }
                        </div>

                        <label>Room</label>
                        <div class="input-with-btn">
                            <div class="input-with-error" style="flex:1;">
                                <DxTextBox @bind-Text="room" SizeMode="SizeMode.Small" />
                                @if (showValidation && string.IsNullOrWhiteSpace(room))
                                {
                                    <span class="mandatory-x">✕</span>
                                }
                            </div>
                            <DxButton IconCssClass="bi bi-plus-lg"
                                      CssClass="circle-btn"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="OpenRoomSearch" />
                        </div>
                        <label></label>
                        <div class="checkbox-wrapper">
                            <span>Fixed Rate</span>
                            <DxCheckBox @bind-Checked="fixedRate" SizeMode="SizeMode.Small" />
                        </div>

                        <label>Rate Code</label>
                        <div class="input-with-btn">
                            <div class="input-with-error" style="flex:1;">
                                <DxTextBox @bind-Text="rateCode" ReadOnly="true" SizeMode="SizeMode.Small" />
                                @if (showValidation && string.IsNullOrWhiteSpace(rateCode))
                                {
                                    <span class="mandatory-x">✕</span>
                                }
                            </div>
                            <DxButton IconCssClass="bi bi-plus-lg"
                                      CssClass="circle-btn"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="OpenRateSearch" />
                        </div>
                        <PackageDropdown @bind-SelectedPackage="package" PackageItems="@packages" CssClass="stay-package-span" />

                        <label>Rate</label>
                        <DxTextBox @bind-Text="rate" SizeMode="SizeMode.Small" />
                        <label>Total</label>
                        <DxTextBox @bind-Text="total" SizeMode="SizeMode.Small" ReadOnly="true" />
                    </div>
                </fieldset>

                <!-- Classification -->
                <fieldset class="section class-section">
                    <div class="class-grid">
                        <label>Res. Type</label>
                        <DxComboBox CssClass="erp-combobox" Data="@resTypes" @bind-Value="resType" SizeMode="SizeMode.Small" />
                        <label>Market</label>
                        <DxComboBox CssClass="erp-combobox" Data="@markets" @bind-Value="market" SizeMode="SizeMode.Small" />
                        <label>Source</label>
                        <DxComboBox CssClass="erp-combobox" Data="@sources" @bind-Value="source" SizeMode="SizeMode.Small" />
                        <label>Origin</label>
                        <DxComboBox CssClass="erp-combobox" Data="@origins" @bind-Value="origin" SizeMode="SizeMode.Small" />
                        <label>Payment</label>
                        <DxComboBox CssClass="erp-combobox" Data="@payments" @bind-Value="payment" SizeMode="SizeMode.Small" />
                    </div>
                </fieldset>

                <!-- Rate Adjustment -->
                <fieldset class="section rate-section">
                    <legend>Rate Adjustment</legend>

                    <div class="rate-adj-content">
                        <div class="radio-col">
                            <label>
                                <input type="radio" name="rateAdjType" value="Amount"
                                       checked="@(rateAdjType == "Amount")"
                                       @onchange="@(() => rateAdjType = "Amount")" /> Amount
                            </label>
                            <label>
                                <input type="radio" name="rateAdjType" value="Percent"
                                       checked="@(rateAdjType == "Percent")"
                                       @onchange="@(() => rateAdjType = "Percent")" /> Percent
                            </label>
                        </div>
                        <div class="rate-fields">
                            <label>Amount</label>
                            <div class="input-box">
                                <DxTextBox @bind-Text="adjAmount" Enabled="@(rateAdjType == "Amount")" SizeMode="SizeMode.Small" />
                            </div>
                            <label>Percent</label>
                            <div class="input-box">
                                <DxTextBox @bind-Text="adjPercent" Enabled="@(rateAdjType == "Percent")" SizeMode="SizeMode.Small" />
                            </div>
                            <label>Value</label>
                            <DxTextBox @bind-Text="adjValue" SizeMode="SizeMode.Small" />
                        </div>
                    </div>
                    <div class="rate-adj-top">
                        <label>Reason</label>
                        <DxComboBox CssClass="erp-combobox" Data="@reasons" @bind-Value="reason" SizeMode="SizeMode.Small" />
                    </div>
                    <div class="rate-bottom">
                        <label>Specials</label>
                        <DxComboBox CssClass="erp-combobox" Data="@specials" @bind-Value="special" SizeMode="SizeMode.Small" />
                        <label>Voucher #</label>
                        <DxTextBox @bind-Text="voucher" SizeMode="SizeMode.Small" />
                    </div>
                </fieldset>
            </div>

            @if (!string.IsNullOrWhiteSpace(commentText))
            {
                <div class="comment-bar" @onclick="OpenComments" title="Click to view/edit comment">
                    <span>Comment</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===================== DIRTY ROOM ALERT ===================== -->
<DxPopup @bind-Visible="showDirtyRoomAlert"
         HeaderText="CNET_v2016"
         Width="min(380px, 95vw)"
         CloseOnOutsideClick="false"
         ShowCloseButton="true">
    <BodyContentTemplate>
        <div style="padding:16px; display:flex; gap:12px; align-items:flex-start;">
            <i class="bi bi-exclamation-triangle" style="font-size:28px; color:#f9a825;"></i>
            <div>
                <p style="margin:0 0 16px 0;">The selected room is Dirty. Please, select another room.</p>
                <div style="text-align:center;">
                    <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
                              Click="() => showDirtyRoomAlert = false" />
                </div>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== ROOM SEARCH POPUP ===================== -->
<!-- ===================== ROOM SEARCH POPUP ===================== -->
<RoomSearchPopup @bind-Visible="showRoomSearch"
                 GuestName="@SelectedGuestName"
                 @bind-SelectedRoom="selectedRoom"
                 OnSelect="SelectRoom" />

<!-- ===================== RATE SEARCH POPUP ===================== -->
<RateSearchPopup @bind-Visible="showRateSearch"
                 StartDate="rateStartDate"
                 EndDate="rateEndDate"
                 RateSearchRows="rateSearchRows"
                 OnSelect="SelectRate"
                 OnSearch="SearchRates"
                 OnRateInfo="ShowRateInfo"
                 OnRowClick="OnRateRowClick"
                 OnCustomizeElement="OnRateCustomizeElement" />

<!-- ===================== LOOKUP POPUP ===================== -->
<DxPopup @bind-Visible="showLookup"
         HeaderText="@lookupTitle"
         Width="min(620px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.Lookup">
            <CustomContent>
                <DxTextBox @bind-Text="lookupSearchText" NullText="" Width="260px" SizeMode="SizeMode.Small"
                           BindValueMode="BindValueMode.OnInput" />
                <DxButton Text="Find" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="FilterLookup" />
            </CustomContent>
        </RegistrationToolbar>

        <div class="grid-scroll-wrap">
        <DxGrid Data="@filteredLookupItems" KeyFieldName="Code" PageSize="10" ShowPager="true"
                SizeMode="SizeMode.Small" RowClick="OnLookupRowClick" Height="310px">
            <Columns>
                <DxGridDataColumn FieldName="Code" Caption="code" Width="120px" />
                <DxGridDataColumn FieldName="Name" Caption="name" />
                <DxGridDataColumn FieldName="IdNumber" Caption="id Number" Width="130px" />
            </Columns>
        </DxGrid>
        </div>

        <div class="lookup-footer">
            <DxButton Text="New" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
            <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="ClearLookupSelection" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== TRAVEL DETAIL POPUP ===================== -->
<DxPopup @bind-Visible="showTravelDetail"
         HeaderText="Travel Detail"
         Width="min(550px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.TravelDetail"
                            OnReset="ResetTravelDetail"
                            OnSave="SaveTravelDetail"
                            OnClose="() => showTravelDetail = false" />

        <DxTabs @bind-ActiveTabIndex="travelTab">
            <DxTabPage Text="Arrival">
                <div class="travel-form">
                    <label>Pick Up Required</label>
                    <DxComboBox CssClass="erp-combobox" Data="@yesNo" @bind-Value="pickupRequired" SizeMode="SizeMode.Small" />
                    <label>Transportation Type</label>
                    <DxComboBox CssClass="erp-combobox" Data="@transportTypes" @bind-Value="arrivalTransportType" SizeMode="SizeMode.Small" />
                    <label>Station Code</label>
                    <DxTextBox @bind-Text="arrivalStationCode" SizeMode="SizeMode.Small" />
                    <label>Carrier Code</label>
                    <DxComboBox CssClass="erp-combobox" Data="@carrierCodes" @bind-Value="arrivalCarrierCode" SizeMode="SizeMode.Small" />
                    <label>Transportation #</label>
                    <DxTextBox @bind-Text="arrivalTransportNo" SizeMode="SizeMode.Small" />
                    <label>Arrival Date</label>
                    <DxDateEdit @bind-Date="arrivalTravelDate" SizeMode="SizeMode.Small" />
                    <label>Pick Up Time</label>
                    <DxTimeEdit @bind-Time="pickupTime" SizeMode="SizeMode.Small" />
                </div>
            </DxTabPage>
            <DxTabPage Text="Departure">
                <div class="travel-form">
                    <label>Drop Off Required</label>
                    <DxComboBox CssClass="erp-combobox" Data="@yesNo" @bind-Value="dropoffRequired" SizeMode="SizeMode.Small" />
                    <label>Transportation Type</label>
                    <DxComboBox CssClass="erp-combobox" Data="@transportTypes" @bind-Value="departureTransportType" SizeMode="SizeMode.Small" />
                    <label>Station Code</label>
                    <DxTextBox @bind-Text="departureStationCode" SizeMode="SizeMode.Small" />
                    <label>Carrier Code</label>
                    <DxComboBox CssClass="erp-combobox" Data="@carrierCodes" @bind-Value="departureCarrierCode" SizeMode="SizeMode.Small" />
                    <label>Departure Date</label>
                    <DxDateEdit @bind-Date="departureTravelDate" SizeMode="SizeMode.Small" />
                    <label>Transportation #</label>
                    <DxTextBox @bind-Text="departureTransportNo" SizeMode="SizeMode.Small" />
                    <label>Drop Off Time</label>
                    <DxTimeEdit @bind-Time="dropoffTime" SizeMode="SizeMode.Small" />
                </div>
            </DxTabPage>
        </DxTabs>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== COMMENTS POPUP ===================== -->
<DxPopup @bind-Visible="showComments"
         HeaderText="Comments"
         Width="min(600px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.Comments"
                            OnClear="() => commentText = string.Empty"
                            OnSave="SaveComment"
                            OnClose="() => showComments = false" />
        <div style="padding: 10px;">
            <DxMemo @bind-Text="commentText" Rows="14" Width="100%" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== COMPANY / CUSTOMER SEARCH POPUP ===================== -->
<CompanySearchPopup @bind-Visible="showCompanySearch"
                    OnSelect="SelectCustomer"
                    OnAddNew="AddNewCompany"
                    OnClear="ClearCustomer" />

<!-- ===================== GROUP SEARCH POPUP ===================== -->
<GroupSearchPopup @bind-Visible="showGroupSearch"
                  OnSelect="SelectGroup"
                  OnAddNew="AddNewGroup"
                  OnClear="ClearGroup" />

<!-- ===================== GUEST SEARCH POPUP ===================== -->
<GuestSearchPopup @bind-Visible="showGuestSearch"
                  OnSelect="SelectGuest"
                  OnAddNew="AddNewGuest"
                  OnClear="ClearGuest" />

<!-- ===================== CONTACT SEARCH POPUP ===================== -->
<ContactSearchPopup @bind-Visible="showContactSearch"
                    OnSelect="SelectContact"
                    OnAddNew="AddNewContact"
                    OnClear="ClearContact" />

<!-- ===================== AGENT SEARCH POPUP ===================== -->
<AgentSearchPopup @bind-Visible="showAgentSearch"
                  OnSelect="SelectAgent"
                  OnAddNew="AddNewAgent"
                  OnClear="ClearAgent" />

<!-- ===================== SOURCE SEARCH POPUP ===================== -->
<SourceSearchPopup @bind-Visible="showSourceSearch"
                   OnSelect="SelectSource"
                   OnAddNew="AddNewSource"
                   OnClear="ClearSource" />

<!-- ===================== FORM MODALS ===================== -->
<DxPopup @bind-Visible="showCompanyModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
         HeaderText="Add New Company" CloseOnEscape="true">
    <BodyContentTemplate>
        <Company IsModal="true" OnSaved="HandleCompanySaved" OnClose="() => showCompanyModal = false" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showGroupModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
         HeaderText="Add New Group" CloseOnEscape="true">
    <BodyContentTemplate>
        <Group IsModal="true" OnSaved="HandleGroupSaved" OnClose="() => showGroupModal = false" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showGuestModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
         HeaderText="Add New Guest" CloseOnEscape="true">
    <BodyContentTemplate>
        <Guest IsModal="true" OnSaved="OnGuestSavedFromModal" OnClose="() => showGuestModal = false" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showContactModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
         HeaderText="Add New Contact" CloseOnEscape="true">
    <BodyContentTemplate>
        <Contact IsModal="true" OnSaved="HandleContactSaved" OnClose="() => showContactModal = false" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showAgentModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
         HeaderText="Add New Travel Agent" CloseOnEscape="true">
    <BodyContentTemplate>
        <TravelAgent IsModal="true" OnSaved="HandleAgentSaved" OnClose="() => showAgentModal = false" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showSourceModal" Width="900px" Height="600px" ShowCloseButton="true" CloseOnOutsideClick="false"
         HeaderText="Add New Source" CloseOnEscape="true">
    <BodyContentTemplate>
        <Source IsModal="true" OnSaved="HandleSourceSaved" OnClose="() => showSourceModal = false" />
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== RESERVATION DETAIL POPUP ===================== -->
<ReservationDetail @bind-Visible="showReservationDetail"
                   ReservationId="@ReservationNo"
                   RoomType="@(roomType ?? "Standard Room")"
                   ActualRTC="@(rtc ?? roomType ?? "Standard Room")"
                   RoomNo="@(room ?? "")"
                   Rate="@(rateCode ?? "")"
                   Adult="@adults"
                   Child="@children"
                   ArrivalDate="@arrivalDate"
                   DepartureDate="@departureDate"
                   Market="@market"
                   Source="@source" />

<style>
    * {
        box-sizing: border-box;
    }

    .reservation-page {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #f0f2f5;
        min-height: 100vh;
        font-size: 12.5px;
        padding: 0 20px;
        max-width: 100%;
        overflow-x: hidden;
    }

    .window-title {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        background: #fff;
        border-bottom: 1px solid #d0d5dd;
        flex-wrap: wrap;
    }

    .title-icon {
        width: 32px;
        height: 32px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .title-text {
        font-size: 13px;
