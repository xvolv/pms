    void HandleSourceSaved(SourceRow s)
    {
        var code = !string.IsNullOrWhiteSpace(s.Code) ? s.Code : (!string.IsNullOrWhiteSpace(s.SourceId) ? s.SourceId : $"SRC-{new Random().Next(100, 999)}");
        var name = s.Name ?? "";
        var newSource = new SourceItem
        {
            Code = code,
            Name = name,
            SourceType = s.SourceType ?? "Other"
        };
        Sources.Add(newSource);
        if (!sources.Contains(name) && !string.IsNullOrEmpty(name))
        {
            sources.Add(name);
        }
        consigneeSource = name;
        source = name;
        showSourceModal = false;
    }

    // Lookup
    void OpenLookup(string type)
    {
        if (type == "Company")
        {
            showCompanySearch = true;
            return;
        }
        if (type == "Group")
        {
            showGroupSearch = true;
            return;
        }
        if (type == "Contact")
        {
            showContactSearch = true;
            return;
        }
        if (type == "Agent")
        {
            showAgentSearch = true;
            return;
        }
        if (type == "Source")
        {
            showSourceSearch = true;
            return;
        }

        lookupType = type;
        lookupTitle = type;
        lookupSearchText = "";

        currentLookupData = new List<LookupItem>();
        filteredLookupItems = currentLookupData.ToList();
        showLookup = true;
    }

    void FilterLookup()
    {
        if (string.IsNullOrWhiteSpace(lookupSearchText))
        {
            filteredLookupItems = currentLookupData.ToList();
            return;
        }
        var key = lookupSearchText.Trim().ToLower();
        filteredLookupItems = currentLookupData
            .Where(x => x.Code.ToLower().Contains(key) || x.Name.ToLower().Contains(key) || x.IdNumber.ToLower().Contains(key))
            .ToList();
    }

    void OnLookupRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as LookupItem;
        if (item == null) return;

        switch (lookupType)
        {
            case "Company": company = item.Name; break;
            case "Contact": contact = item.Name; break;
            case "Agent":   agent = item.Name; break;
            case "Group":   group = item.Name; break;
            case "Source":  consigneeSource = item.Name; break;
        }
        showLookup = false;
    }

    void ClearLookupSelection()
    {
        switch (lookupType)
        {
            case "Company": company = ""; break;
            case "Contact": contact = ""; break;
            case "Agent":   agent = ""; break;
            case "Group":   group = ""; break;
            case "Source":  consigneeSource = ""; break;
        }
        showLookup = false;
    }

    // Room Search
    void OnRoomRowClick(GridRowClickEventArgs e)
    {
        selectedRoom = e.Grid?.GetDataItem(e.VisibleIndex) as RoomItem;
    }

    void OnRoomCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataCell)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as RoomItem;
            if (item == null) return;

            if (e.Column?.Caption == "HK Status" && item.HKStatus == "Dirty")
                e.CssClass = "hk-dirty";
            if (e.Column?.Caption == "FO Status" && item.FOStatus == "Vacant")
                e.CssClass = "fo-vacant";
        }
        if (e.ElementType == GridElementType.DataRow && selectedRoom != null)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as RoomItem;
            if (item?.SN == selectedRoom.SN)
                e.CssClass = "room-row-selected";
        }
    }

    void SelectRoom()
    {
        if (selectedRoom == null) return;

        if (selectedRoom.HKStatus == "Dirty")
        {
            showDirtyRoomAlert = true;
            return;
        }

        room = selectedRoom.Room;
        roomType = selectedRoom.RoomType;
        showRoomSearch = false;
    }

