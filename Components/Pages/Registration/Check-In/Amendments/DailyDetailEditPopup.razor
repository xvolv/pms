@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DxPopup @bind-Visible="Visible" HeaderText="Edit Daily Registration Detail" Width="480px"
         CloseOnOutsideClick="false" ShowCloseButton="false" CloseOnEscape="false">
    <BodyContentTemplate>
        <div class="amend-toolbar">
            <button type="button" class="ci-btn" @onclick="HandleSave">
                <div class="ci-icon" style="color:#1565c0;"><i class="bi bi-floppy"></i></div>
                <div class="ci-text">Save</div>
            </button>
            <button type="button" class="ci-btn" @onclick="HandleClose">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <div class="amend-form">
            <div class="amend-row"><label>Date</label>
                <DxDateEdit @bind-Date="Model.Date" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Through Date</label>
                <DxDateEdit @bind-Date="Model.ThroughDate" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Adult</label>
                <DxSpinEdit @bind-Value="Model.Adult" SizeMode="SizeMode.Small" MinValue="1" MaxValue="10" />
            </div>
            <div class="amend-row"><label>Child</label>
                <DxSpinEdit @bind-Value="Model.Child" SizeMode="SizeMode.Small" MinValue="0" MaxValue="10" />
            </div>
            <div class="amend-row"><label>Room Type</label>
                <DxComboBox Data="@RoomTypes" @bind-Value="Model.RoomType" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>RTC</label>
                <DxComboBox Data="@RoomTypes" @bind-Value="Model.RTC" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Room</label>
                <div class="input-with-btn">
                    <DxTextBox @bind-Text="Model.Room" SizeMode="SizeMode.Small" />
                    <DxButton IconCssClass="bi bi-plus-lg" CssClass="circle-btn"
                              RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="@(() => {})" />
                </div>
            </div>
            <div class="amend-row"><label>Rate Code</label>
                <div class="input-with-btn">
                    <DxTextBox @bind-Text="Model.RateCode" SizeMode="SizeMode.Small" />
                    <DxButton IconCssClass="bi bi-plus-lg" CssClass="circle-btn"
                              RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="@(() => {})" />
                </div>
            </div>
            <div class="amend-row"><label>Amount</label>
                <DxSpinEdit @bind-Value="Model.Amount" SizeMode="SizeMode.Small" MinValue="0" />
            </div>
            <div class="amend-row"><label></label>
                <DxCheckBox @bind-Checked="Model.FixedRate">Fixed Rate</DxCheckBox>
            </div>
            <div class="amend-row"><label>No. Of Rooms</label>
                <DxSpinEdit @bind-Value="Model.NoOfRooms" SizeMode="SizeMode.Small" MinValue="1" MaxValue="10" />
            </div>
            <div class="amend-row"><label>Adjustment</label>
                <DxSpinEdit @bind-Value="Model.Adjustment" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Source</label>
                <DxComboBox Data="@SourceList" @bind-Value="Model.Source" SizeMode="SizeMode.Small" />
            </div>
            <div class="amend-row"><label>Market</label>
                <DxComboBox Data="@MarketList" @bind-Value="Model.Market" SizeMode="SizeMode.Small" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public EditDetailModel Model { get; set; } = new();
    [Parameter] public List<string> RoomTypes { get; set; } = new();
    [Parameter] public List<string> SourceList { get; set; } = new();
    [Parameter] public List<string> MarketList { get; set; } = new();

    [Parameter] public EventCallback OnSave { get; set; }

    async Task HandleSave() => await OnSave.InvokeAsync();
    async Task HandleClose() => await VisibleChanged.InvokeAsync(false);
}
