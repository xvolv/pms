        if (selectedReg == null) return;
        int sn = 1;
        for (var d = selectedReg.Arrival; d < selectedReg.Departure; d = d.AddDays(1))
        {
            bool isPast = d.Date < businessDate.Date;
            var row = new DailyDetailRow
            {
                SN = sn++,
                Date = d,
                Adult = 1,
                Child = 0,
                RoomCount = selectedReg.RoomCount,
                RoomType = selectedReg.RoomType,
                ActualRTC = selectedReg.RoomType,
                Room = selectedReg.Room ?? "",
                Rate = "Standard Rate",
                RateAmount = isPast ? 50 : (d.DayOfWeek == DayOfWeek.Friday || d.DayOfWeek == DayOfWeek.Saturday ? 500 : 50),
                Market = "Corporate Business",
                Source = "Company Direct",
                IsFixed = true,
                Packages = new List<PackageRow>
                {
                    new() { Package = "Lunch", Amount = 60, Remark = "" }
                }
            };
            dailyDetailRows.Add(row);
        }
