        <button type="button" class="toolbar-btn" @onclick="DoReinstateReservation">
            <div class="toolbar-icon"><i class="bi bi-arrow-clockwise"></i></div>
            <div class="toolbar-text">Reinstate</div>
        </button>
    </ToolbarContent>
    <ExtraFields>
        <div class="ci-row"><label>Action</label>
            <DxComboBox Data="@reinstateActions" @bind-Value="ciReinstateAction" SizeMode="SizeMode.Small" />
        </div>
    </ExtraFields>
</StateReviewPopup>

<!-- Check Out Review -->
<StateReviewPopup
