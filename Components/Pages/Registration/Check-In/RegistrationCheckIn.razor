    void OpenSplitVoucher(BillSplitItem item)
    {
        svVoucherNo = item.VoucherNo;
        svCustomer = selectedReg?.Guest ?? "";
        svSplitBy = "Amount";
        svFactorPercent = true;
        svNoOfSplit = 2;
        svGrandTotal = item.Amount;
        svPercentValue = 30;
        svAmountValue = Math.Round(item.Amount * 0.3m, 2);
        svPieces = new List<SplitPiece>();
        selectedSplitPiece = null;
        showSplitVoucher = true;
    }

    void DoSplitVoucher()
    {
        svPieces = new List<SplitPiece>();
        decimal a1, a2;
        if (svFactorPercent)
        {
            a1 = Math.Round(svGrandTotal * (100 - svPercentValue) / 100m, 2);
            a2 = svGrandTotal - a1;
        }
        else
        {
            a2 = svAmountValue;
            a1 = svGrandTotal - a2;
        }
        // Build sample line items proportional to split amounts (matches screenshot expand)
        var roomUnit = Math.Round(svGrandTotal * 0.53m, 2);
        var bedUnit = Math.Round(svGrandTotal - roomUnit, 2);
        var ratio1 = svGrandTotal > 0 ? a1 / svGrandTotal : 0.5m;
        var ratio2 = 1 - ratio1;

        svPieces.Add(new SplitPiece
        {
            SN = 1,
            VoucherNo = svVoucherNo,
            Date = businessDate,
            Amount = a1,
            Expanded = false,
            LineItems = new List<SplitLineItem>
            {
                new() { ArticleCode = "B-0001", Name = "BED AND BREA...", UnitAmount = Math.Round(bedUnit * ratio1, 2), Quantity = 1, TotalAmount = Math.Round(bedUnit * ratio1, 2) },
                new() { ArticleCode = "SE-00001", Name = "ROOM CHARGE", UnitAmount = Math.Round(roomUnit * ratio1, 2), Quantity = 1, TotalAmount = Math.Round(roomUnit * ratio1, 2) }
            }
        });
        svPieces.Add(new SplitPiece
        {
            SN = 2,
            VoucherNo = $"WDRC-{Random.Shared.Next(1500, 1999)}-17",
            Date = businessDate,
            Amount = a2,
            Expanded = false,
            LineItems = new List<SplitLineItem>
            {
                new() { ArticleCode = "B-0001", Name = "BED AND BREA...", UnitAmount = Math.Round(bedUnit * ratio2, 2), Quantity = 1, TotalAmount = Math.Round(bedUnit * ratio2, 2) },
                new() { ArticleCode = "SE-00001", Name = "ROOM CHARGE", UnitAmount = Math.Round(roomUnit * ratio2, 2), Quantity = 1, TotalAmount = Math.Round(roomUnit * ratio2, 2) }
            }
        });
        StateHasChanged();
    }

    void ToggleSplitPieceExpand(SplitPiece p)
    {
        p.Expanded = !p.Expanded;
        StateHasChanged();
    }

    void SaveSplitVoucher()
    {
        if (!svPieces.Any())
        {
            ShowInfo("Please run Split first.");
            return;
        }
        // Keep first piece in same window; add remaining pieces to window 2
        if (selectedBillSplitItem != null)
        {
            selectedBillSplitItem.Amount = svPieces[0].Amount;
            for (int i = 1; i < svPieces.Count; i++)
            {
                billSplitWindow2.Add(new BillSplitItem
                {
                    SN = billSplitWindow2.Count + 1,
                    VoucherNo = svPieces[i].VoucherNo,
                    Purpose = selectedBillSplitItem.Purpose,
                    Date = svPieces[i].Date,
                    Amount = svPieces[i].Amount
                });
            }
        }
        showSplitVoucher = false;
        ShowInfo("Voucher Split is Successful!");
    }

