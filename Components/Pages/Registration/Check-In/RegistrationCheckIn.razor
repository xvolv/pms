    void EditDailyDetail()
    {
        if (selectedDetailRow == null) return;
        if (selectedDetailRow.Date.Date < businessDate.Date) { showPassedDateError = true; return; }
        editDetail = new EditDetailModel
        {
            Date = selectedDetailRow.Date,
            ThroughDate = selectedDetailRow.Date,
            Adult = selectedDetailRow.Adult,
            Child = selectedDetailRow.Child,
            RoomType = selectedDetailRow.RoomType,
            RTC = selectedDetailRow.ActualRTC,
            Room = selectedDetailRow.Room,
            RateCode = selectedDetailRow.Rate,
            Amount = selectedDetailRow.RateAmount,
            FixedRate = selectedDetailRow.IsFixed,
            NoOfRooms = selectedDetailRow.RoomCount,
            Adjustment = 0,
            Source = selectedDetailRow.Source,
            Market = selectedDetailRow.Market
        };
        showEditDailyDetail = true;
    }

    void SaveDailyDetailEdit()
    {
        if (selectedDetailRow != null)
        {
            selectedDetailRow.Adult = editDetail.Adult;
            selectedDetailRow.Child = editDetail.Child;
            selectedDetailRow.RoomType = editDetail.RoomType ?? selectedDetailRow.RoomType;
            selectedDetailRow.ActualRTC = editDetail.RTC ?? selectedDetailRow.ActualRTC;
            selectedDetailRow.Room = editDetail.Room;
            selectedDetailRow.Rate = editDetail.RateCode;
            selectedDetailRow.RateAmount = editDetail.Amount;
            selectedDetailRow.IsFixed = editDetail.FixedRate;
            selectedDetailRow.RoomCount = editDetail.NoOfRooms;
            selectedDetailRow.Source = editDetail.Source ?? selectedDetailRow.Source;
            selectedDetailRow.Market = editDetail.Market ?? selectedDetailRow.Market;
        }
        showEditDailyDetail = false;
        StateHasChanged();
    }

