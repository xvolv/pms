@page "/registration-browser"
@rendermode InteractiveServer
@using DevExpress.Blazor
@inject NavigationManager Navigation

<PageTitle>Registration Browser - CNET ERP</PageTitle>

<div class="reg-browser-page" @onclick="CloseMenus">

    <div class="erp-toolbar" @onclick:stopPropagation="true">
        <div class="toolbar-group">
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-eye"></i></div>
                <div class="toolbar-text">Show</div>
            </button>
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-gear"></i></div>
                <div class="toolbar-text">Options ▾</div>
            </button>

            <div class="toolbar-dropdown">
                <button type="button" class="toolbar-btn @(showActivitiesMenu ? "active" : "")" @onclick="ToggleActivities">
                    <div class="toolbar-icon" style="color:#1565c0;"><i class="bi bi-type"></i></div>
                    <div class="toolbar-text">Activities ▾</div>
                </button>
                @if (showActivitiesMenu)
                {
                    <ul class="dropdown-menu show">
                        <li class="dropdown-item" @onclick="@(() => OnActivity("Waitinglist"))">Waitinglist</li>
                        <li class="dropdown-item" @onclick="@(() => OnActivity("6PM"))">6PM</li>
                        <li class="dropdown-item" @onclick="@(() => OnActivity("Confirmation"))">Confirmation</li>
                        <li class="dropdown-item" @onclick="@(() => OnActivity("Cancel"))">Cancel</li>
                        <li class="dropdown-item" @onclick="@(() => OnActivity("CheckIn"))">Check In</li>
                        <li class="dropdown-item disabled">Check out</li>
                        <li class="dropdown-item" @onclick="@(() => OnActivity("Reinstate"))">Reinstate</li>
                        <li class="dropdown-item" @onclick="@(() => OnActivity("PostMaster"))">Post Master (PM)</li>
                    </ul>
                }
            </div>

            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="toolbar-text">Billing ▾</div>
            </button>
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-pencil-square"></i></div>
                <div class="toolbar-text">Amendment ▾</div>
            </button>
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="toolbar-text">Preview ▾</div>
            </button>
        </div>

        <div class="toolbar-group filter-group">
            <span class="filter-icon"><i class="bi bi-door-closed"></i></span>
            <span class="filter-label">Room</span>
            <DxTextBox @bind-Text="filterRoom" Width="100px" SizeMode="SizeMode.Small" />
            <span class="filter-icon"><i class="bi bi-person"></i></span>
            <span class="filter-label">Guest</span>
            <DxComboBox Data="@guestFilterList" @bind-Value="filterGuest" Width="140px" SizeMode="SizeMode.Small" />
            <span class="filter-icon"><i class="bi bi-star"></i></span>
            <span class="filter-label">State</span>
            <DxComboBox Data="@stateList" @bind-Value="filterState" Width="100px" SizeMode="SizeMode.Small" />
        </div>

        <div class="toolbar-group filter-group">
            <span class="filter-label">Arrival</span>
            <DxDateEdit @bind-Date="filterArrival" Width="110px" SizeMode="SizeMode.Small" />
            <span class="filter-label">Departure</span>
            <DxDateEdit @bind-Date="filterDeparture" Width="110px" SizeMode="SizeMode.Small" />
            <span class="filter-label">Company</span>
            <DxComboBox Data="@companyFilterList" @bind-Value="filterCompany" Width="120px" SizeMode="SizeMode.Small" />
        </div>

        <div class="toolbar-group">
            <button type="button" class="toolbar-btn" @onclick="ApplyFilters">
                <div class="toolbar-icon"><i class="bi bi-search"></i></div>
                <div class="toolbar-text">Advanced Search ▾</div>
            </button>
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-printer"></i></div>
                <div class="toolbar-text">Print ▾</div>
            </button>
        </div>
    </div>

    <DxGrid Data="@filteredRegistrations"
            KeyFieldName="SN"
            PageSize="20"
            ShowPager="false"
            SizeMode="SizeMode.Small"
            Height="480px"
            FocusedRowEnabled="true"
            FocusedRowKey="@(selectedReg?.SN)"
            FocusedRowKeyChanged="OnFocusedRowKeyChanged"
            RowClick="OnGridRowClick"
            CssClass="reg-grid">
        <Columns>
            <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
            <DxGridDataColumn FieldName="Registration" Caption="Registration" Width="110px" />
            <DxGridDataColumn FieldName="Room" Caption="Room" Width="70px" />
            <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="120px" />
            <DxGridDataColumn FieldName="Guest" Caption="Guest" Width="160px" />
            <DxGridDataColumn FieldName="Company" Caption="Company" Width="120px" />
            <DxGridDataColumn FieldName="Arrival" Caption="Arrival" Width="100px" DisplayFormat="M/d/yyyy" />
            <DxGridDataColumn FieldName="Departure" Caption="Departure" Width="100px" DisplayFormat="M/d/yyyy" />
            <DxGridDataColumn FieldName="Nights" Caption="# of Night" Width="80px" />
            <DxGridDataColumn FieldName="Payment" Caption="Payment" Width="80px" />
        </Columns>
    </DxGrid>

    <div class="record-bar">
        @if (selectedReg != null)
        {
            <span>Selected: <strong>@selectedReg.Registration</strong> — @selectedReg.Guest</span>
        }
        else
        {
            <span>Click a row to select a registration</span>
        }
        <span class="record-count">Record @(selectedReg?.SN ?? 0) of @filteredRegistrations.Count</span>
    </div>
</div>

<DxPopup @bind-Visible="showStateConfirm" HeaderText="State Change Confirmation" Width="420px" CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-info-circle" style="font-size:32px; color:#1565c0;"></i>
            <p>Do you want to change @(selectedReg?.State ?? "") state to Check In ?</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="Yes" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="ConfirmCheckIn" />
            <DxButton Text="No" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="CloseStateConfirm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="CloseStateConfirm" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showArrivalError" HeaderText="Error" Width="420px" CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-x-circle" style="font-size:32px; color:#c62828;"></i>
            <p>You can not check in a guest whose arrival date is not equal to today.</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="CloseArrivalError" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showNoSelection" HeaderText="Information" Width="360px" CloseOnOutsideClick="true" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-info-circle" style="font-size:28px; color:#1565c0;"></i>
            <p>Please select a registration first.</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="() => showNoSelection = false" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showSingleCheckIn" HeaderText="Check In" Width="640px" Height="500px" CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="ci-toolbar">
            <button type="button" class="ci-btn" @onclick="DoCheckInSingle">
                <div class="ci-icon" style="color:#2e7d32;"><i class="bi bi-check2-square"></i></div>
                <div class="ci-text">Check In</div>
            </button>
            <button type="button" class="ci-btn" @onclick="NoOp">
                <div class="ci-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                <div class="ci-text">Issue Card</div>
            </button>
            <button type="button" class="ci-btn" @onclick="OpenRegistrationCard">
                <div class="ci-icon"><i class="bi bi-card-heading"></i></div>
                <div class="ci-text">Registration card</div>
            </button>
            <button type="button" class="ci-btn" @onclick="NoOp">
                <div class="ci-icon"><i class="bi bi-printer"></i></div>
                <div class="ci-text">Print Card Pocket</div>
            </button>
            <button type="button" class="ci-btn" @onclick="CloseSingleCheckIn">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <h3 class="ci-heading">You are checking in the guest below</h3>
        <div class="ci-form">
            <div class="ci-left">
                <div class="ci-row"><label>Reg. No</label><DxTextBox @bind-Text="ciRegNo" SizeMode="SizeMode.Small" ReadOnly="true" /></div>
                <div class="ci-row"><label>Arrival</label><DxDateEdit @bind-Date="ciArrival" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Departure</label><DxDateEdit @bind-Date="ciDeparture" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Room Type</label><DxComboBox Data="@roomTypes" @bind-Value="ciRoomType" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row">
                    <label>Room</label>
                    <div class="input-with-btn">
                        <DxTextBox @bind-Text="ciRoom" SizeMode="SizeMode.Small" />
                        <DxButton IconCssClass="bi bi-plus-lg" CssClass="circle-btn" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="OpenRoomSearchForSingle" />
                    </div>
                </div>
                <div class="ci-row"><label>Payment Type</label><DxComboBox Data="@payments" @bind-Value="ciPayment" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Total Bill</label><DxTextBox @bind-Text="ciTotalBill" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Paid</label><DxTextBox @bind-Text="ciPaid" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Remaining</label><DxTextBox @bind-Text="ciRemaining" SizeMode="SizeMode.Small" ReadOnly="true" /></div>
            </div>
            <fieldset class="ci-profile">
                <legend>Profile</legend>
                <div class="ci-row"><label>Guest</label><DxComboBox Data="@guestNames" @bind-Value="ciGuest" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Company</label><DxComboBox Data="@companyFilterList" @bind-Value="ciCompany" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Agent</label><DxComboBox Data="@agentList" @bind-Value="ciAgent" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Source</label><DxComboBox Data="@sourceList" @bind-Value="ciSource" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Group</label><DxComboBox Data="@groupList" @bind-Value="ciGroup" SizeMode="SizeMode.Small" /></div>
                <div class="ci-row"><label>Contact</label><DxComboBox Data="@contactList" @bind-Value="ciContact" SizeMode="SizeMode.Small" /></div>
            </fieldset>
        </div>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showMultiCheckIn" HeaderText="@MultiCheckInTitle" Width="860px" Height="440px" CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="ci-toolbar">
            <button type="button" class="ci-btn" @onclick="DoCheckInMulti">
                <div class="ci-icon" style="color:#2e7d32;"><i class="bi bi-check2-square"></i></div>
                <div class="ci-text">Check In</div>
            </button>
            <button type="button" class="ci-btn" @onclick="NoOp">
                <div class="ci-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                <div class="ci-text">Issue Card</div>
            </button>
            <button type="button" class="ci-btn" @onclick="OpenRegistrationCard">
                <div class="ci-icon"><i class="bi bi-card-heading"></i></div>
                <div class="ci-text">Registration card</div>
            </button>
            <button type="button" class="ci-btn" @onclick="NoOp">
                <div class="ci-icon"><i class="bi bi-printer"></i></div>
                <div class="ci-text">Print Card Pocket</div>
            </button>
            <button type="button" class="ci-btn" @onclick="CloseMultiCheckIn">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <h3 class="ci-heading">You are checking in the guest(s) below</h3>
        <table class="multi-table">
            <thead>
                <tr>
                    <th style="width:36px;"></th>
                    <th style="width:40px;">SN</th>
                    <th>Company</th>
                    <th style="width:180px;">Guest</th>
                    <th style="width:70px;">Guest No</th>
                    <th style="width:120px;">Room</th>
                    <th style="width:100px;">Arrival</th>
                    <th style="width:100px;">Departure</th>
                    <th style="width:60px;">Key</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in multiRoomRows)
                {
                    <tr class="@(row.Selected ? "row-selected" : "")">
                        <td><input type="checkbox" checked="@row.Selected" @onchange="@(e => row.Selected = (bool)(e.Value ?? false))" /></td>
                        <td>@row.SN</td>
                        <td>@row.Company</td>
                        <td><DxComboBox Data="@guestNames" @bind-Value="row.Guest" SizeMode="SizeMode.Small" Width="100%" /></td>
                        <td>@row.GuestNo</td>
                        <td>
                            <div class="input-with-btn">
                                <DxTextBox @bind-Text="row.Room" SizeMode="SizeMode.Small" />
                                <DxButton IconCssClass="bi bi-plus-circle" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="@(() => OpenRoomSearchForMulti(row))" />
                            </div>
                        </td>
                        <td>@row.Arrival.ToString("M/d/yyyy")</td>
                        <td>@row.Departure.ToString("M/d/yyyy")</td>
                        <td>@row.Key</td>
                    </tr>
                }
            </tbody>
        </table>
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="showRoomSearch" HeaderText="Room Search" Width="780px" Height="420px" CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <div class="ci-toolbar">
            <button type="button" class="ci-btn" @onclick="SelectRoom">
                <div class="ci-icon" style="color:#2e7d32;"><i class="bi bi-check-lg"></i></div>
                <div class="ci-text">Select</div>
            </button>
            <span style="margin-left:12px;">Feature</span>
            <DxComboBox Data="@roomFeatures" @bind-Value="selectedFeature" Width="130px" SizeMode="SizeMode.Small" />
            <span style="margin-left:8px;">Room</span>
            <DxTextBox @bind-Text="roomFilterText" Width="90px" SizeMode="SizeMode.Small" />
            <button type="button" class="ci-btn" style="margin-left:auto;" @onclick="CloseRoomSearch">
                <div class="ci-icon" style="color:#c62828;"><i class="bi bi-x-circle"></i></div>
                <div class="ci-text">Close</div>
            </button>
        </div>
        <DxTabs>
            <DxTabPage Text="Rooms">
                <DxGrid Data="@availableRooms" KeyFieldName="SN" PageSize="10" ShowPager="false" SizeMode="SizeMode.Small" Height="280px"
                        FocusedRowEnabled="true" FocusedRowKey="@(selectedRoomItem?.SN)" FocusedRowKeyChanged="OnRoomFocusedKeyChanged"
                        RowClick="OnRoomRowClick" CustomizeElement="OnRoomCustomize">
                    <Columns>
                        <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
                        <DxGridDataColumn FieldName="Room" Caption="Room" Width="70px" />
                        <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="110px" />
                        <DxGridDataColumn FieldName="HKStatus" Caption="HK Status" Width="90px" />
                        <DxGridDataColumn FieldName="FOStatus" Caption="FO Status" Width="90px" />
                        <DxGridDataColumn FieldName="Floor" Caption="Floor" Width="90px" />
                        <DxGridDataColumn FieldName="Feature" Caption="Feature" />
                        <DxGridDataColumn FieldName="Remark" Caption="Remark" />
                    </Columns>
                </DxGrid>
            </DxTabPage>
            <DxTabPage Text="Pseudo Rooms">
                <div style="padding:30px; text-align:center; color:#999;">Pseudo Rooms</div>
            </DxTabPage>
        </DxTabs>
    </BodyContentTemplate>
</DxPopup>

<style>
    .reg-browser-page { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; background: #f0f2f5; min-height: 100vh; font-size: 12.5px; padding: 8px 12px; }
    .erp-toolbar { display: flex; align-items: center; gap: 4px; padding: 4px 8px; min-height: 64px; background: white; border: 1px solid #d6d6d6; border-radius: 4px; margin-bottom: 8px; flex-wrap: wrap; position: relative; z-index: 20; overflow: visible; }
    .toolbar-group { display: flex; gap: 2px; align-items: center; flex-wrap: wrap; overflow: visible; }
    .filter-group { border-left: 1px solid #ddd; padding-left: 8px; margin-left: 4px; gap: 4px; }
    .filter-label { font-size: 11px; color: #555; white-space: nowrap; }
    .filter-icon { font-size: 14px; color: #666; }
    .toolbar-btn { background: transparent !important; border: none !important; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 56px; padding: 3px 8px; cursor: pointer; border-radius: 4px; height: 48px; }
    .toolbar-btn:hover, .toolbar-btn.active { background: #e3f2fd !important; }
    .toolbar-icon { font-size: 22px; line-height: 22px; color: #555; }
    .toolbar-icon i { font-size: 22px; }
    .toolbar-text { margin-top: 2px; font-size: 10px; color: #444; font-weight: 500; }
    .toolbar-dropdown { position: relative; overflow: visible; }
    .dropdown-menu { position: absolute; top: 100%; left: 0; background: #fff; border: 1px solid #bbb; box-shadow: 0 6px 16px rgba(0,0,0,.18); z-index: 9999; min-width: 170px; padding: 4px 0; margin: 0; list-style: none; display: block; }
    .dropdown-item { padding: 7px 18px; cursor: pointer; font-size: 12.5px; color: #222; white-space: nowrap; }
    .dropdown-item:hover { background: #0078d4; color: #fff; }
    .dropdown-item.disabled { color: #aaa; cursor: default; pointer-events: none; }
    .reg-grid { background: #fff; }
    .record-bar { padding: 6px 10px; font-size: 12px; color: #333; background: #f5f5f5; border: 1px solid #ddd; border-top: none; display: flex; justify-content: space-between; align-items: center; }
    .record-count { color: #666; font-size: 11px; }
    .confirm-body { display: flex; gap: 14px; align-items: flex-start; padding: 16px; }
    .confirm-body p { margin: 4px 0 0; font-size: 13px; }
    .confirm-buttons { display: flex; justify-content: center; gap: 10px; padding: 0 16px 16px; }
    .ci-toolbar { display: flex; gap: 4px; padding: 6px 0; border-bottom: 1px solid #eee; margin-bottom: 10px; align-items: center; flex-wrap: wrap; }
    .ci-btn { background: transparent; border: none; display: flex; flex-direction: column; align-items: center; min-width: 64px; padding: 4px 8px; cursor: pointer; border-radius: 4px; }
    .ci-btn:hover { background: #f0f4f8; }
    .ci-icon { font-size: 24px; }
    .ci-icon i { font-size: 24px; }
    .ci-text { font-size: 10px; color: #444; margin-top: 2px; }
    .ci-heading { color: #c62828; font-size: 15px; font-weight: 600; margin: 8px 0 12px; }
    .ci-form { display: flex; gap: 16px; }
    .ci-left { flex: 1; }
    .ci-profile { flex: 1; border: 1px solid #c8cdd4; border-radius: 3px; padding: 8px 12px; margin: 0; }
    .ci-profile legend { font-size: 12px; font-weight: 600; color: #1565c0; padding: 0 4px; }
    .ci-row { display: grid; grid-template-columns: 100px 1fr; gap: 6px; align-items: center; margin-bottom: 6px; }
    .ci-row label { text-align: right; font-size: 12px; color: #555; }
    .input-with-btn { display: flex; gap: 3px; align-items: center; }
    .input-with-btn > :first-child { flex: 1; }
    .circle-btn { width: 26px; height: 26px; border-radius: 50%; padding: 0; display: flex; align-items: center; justify-content: center; }
    .multi-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .multi-table th { background: #f0f0f0; border: 1px solid #ccc; padding: 5px 6px; text-align: left; font-weight: 600; }
    .multi-table td { border: 1px solid #ddd; padding: 3px 5px; vertical-align: middle; }
    .multi-table tr.row-selected { background: #cce5ff; }
    .hk-clean { background-color: #fdd835 !important; color: #000 !important; }
    .fo-vacant { background-color: #1e88e5 !important; color: white !important; }
    .hk-dirty { background-color: #e53935 !important; color: white !important; }
</style>

@code {
    string filterRoom = "";
    string? filterGuest;
    string filterState = "All";
    DateTime? filterArrival = new DateTime(2017, 8, 19);
    DateTime? filterDeparture;
    string? filterCompany;

    List<string> stateList = new() { "All", "6PM", "Confirmed", "Tentative", "Checked In", "Cancelled" };
    List<string> guestFilterList = new() { "", "Solomon Tuffa Bereket", "miskir engida engida", "Solman Jack Jemes" };
    List<string> companyFilterList = new() { "", "Fish", "MISIKIR LTD" };
    List<string> roomTypes = new() { "Standard Room", "Executive", "Deluxe", "Suite" };
    List<string> payments = new() { "Cash", "Credit Card", "Company Account", "Bank Transfer" };
    List<string> guestNames = new() { "Solomon Tuffa Bereket", "miskir engida engida", "Solman Jack Jemes", "Taddeses ARABA Mola", "teshome mola" };
    List<string> agentList = new() { "", "MY AGENT", "RIHANN'S AGENT" };
    List<string> sourceList = new() { "", "Company Directory", "Website", "Walk-in" };
    List<string> groupList = new() { "", "Musical Group", "Girls Group" };
    List<string> contactList = new() { "", "KEBEDE ZELEKE ABEBE", "BROWN CHRIS" };
    List<string> roomFeatures = new() { "Select feature", "Sea View", "City View", "Balcony" };

    List<RegistrationRow> allRegistrations = new();
    List<RegistrationRow> filteredRegistrations = new();
    RegistrationRow? selectedReg;

    bool showActivitiesMenu = false;
    bool showStateConfirm = false;
    bool showArrivalError = false;
    bool showNoSelection = false;
    bool showSingleCheckIn = false;
    bool showMultiCheckIn = false;
    bool showRoomSearch = false;

    string ciRegNo = "";
    DateTime? ciArrival;
    DateTime? ciDeparture;
    string? ciRoomType;
    string ciRoom = "";
    string? ciPayment = "Cash";
    string ciTotalBill = "";
    string ciPaid = "";
    string ciRemaining = "";
    string? ciGuest;
    string? ciCompany;
    string? ciAgent;
    string? ciSource;
    string? ciGroup;
    string? ciContact;

    List<MultiRoomRow> multiRoomRows = new();
    MultiRoomRow? currentMultiRowForRoom;
    string MultiCheckInTitle => $"Multiple Room Check In - {(selectedReg?.Registration ?? "")}";

    string? selectedFeature;
    string roomFilterText = "";
    RoomItem? selectedRoomItem;
    bool roomSearchForSingle = true;

    List<RoomItem> availableRooms = new()
    {
        new() { SN = 1, Room = "103", RoomType = "Executive", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1", Feature = "", Remark = "" },
        new() { SN = 2, Room = "101", RoomType = "Standard Room", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1", Feature = "", Remark = "" },
        new() { SN = 3, Room = "102", RoomType = "Standard Room", HKStatus = "Dirty", FOStatus = "Vacant", Floor = "Floor - 1", Feature = "", Remark = "" },
    };

    DateTime businessDate = new DateTime(2017, 8, 19);

    protected override void OnInitialized()
    {
        allRegistrations = new List<RegistrationRow>
        {
            new() { SN = 1, Registration = "REG-00156-17", Room = "#2", RoomType = "Executive", Guest = "Solomon Tuffa Bereket", Company = "Fish", Arrival = new DateTime(2017, 8, 19), Departure = new DateTime(2017, 8, 23), Nights = 4, Payment = "Cash", State = "6PM", RoomCount = 2 },
            new() { SN = 2, Registration = "REG-00113-17", Room = "", RoomType = "Standard Room", Guest = "miskir engida engida", Company = "MISIKIR LTD", Arrival = new DateTime(2017, 8, 19), Departure = new DateTime(2017, 8, 20), Nights = 1, Payment = "Cash", State = "6PM", RoomCount = 1 },
            new() { SN = 3, Registration = "REG-00040-17", Room = "103", RoomType = "Standard Room", Guest = "Solman Jack Jemes", Company = "", Arrival = new DateTime(2017, 8, 19), Departure = new DateTime(2017, 8, 20), Nights = 1, Payment = "Cash", State = "6PM", RoomCount = 1 },
        };
        filteredRegistrations = allRegistrations.ToList();
        selectedReg = filteredRegistrations.FirstOrDefault();
    }

    void NoOp() { }
    void CloseMenus() => showActivitiesMenu = false;
    void ToggleActivities() => showActivitiesMenu = !showActivitiesMenu;

    void OnActivity(string action)
    {
        showActivitiesMenu = false;
        if (selectedReg == null) { showNoSelection = true; return; }
        if (action == "CheckIn")
        {
            if (selectedReg.Arrival.Date != businessDate.Date) { showArrivalError = true; return; }
            showStateConfirm = true;
        }
    }

    void CloseStateConfirm() => showStateConfirm = false;
    void CloseArrivalError() => showArrivalError = false;
    void CloseSingleCheckIn() => showSingleCheckIn = false;
    void CloseMultiCheckIn() => showMultiCheckIn = false;
    void CloseRoomSearch() => showRoomSearch = false;

    void ConfirmCheckIn()
    {
        showStateConfirm = false;
        if (selectedReg == null) return;
        if (selectedReg.RoomCount > 1)
        {
            multiRoomRows = new List<MultiRoomRow>();
            for (int i = 1; i <= selectedReg.RoomCount; i++)
            {
                multiRoomRows.Add(new MultiRoomRow
                {
                    SN = i, Company = selectedReg.Company, Guest = i == 1 ? selectedReg.Guest : "", GuestNo = 1,
                    Room = "", Arrival = selectedReg.Arrival, Departure = selectedReg.Departure, Key = "", Selected = i == 1
                });
            }
            showMultiCheckIn = true;
        }
        else
        {
            ciRegNo = selectedReg.Registration;
            ciArrival = selectedReg.Arrival;
            ciDeparture = selectedReg.Departure;
            ciRoomType = selectedReg.RoomType;
            ciRoom = (selectedReg.Room ?? "").Replace("#", "");
            ciPayment = selectedReg.Payment;
            ciGuest = selectedReg.Guest;
            ciCompany = selectedReg.Company;
            ciAgent = selectedReg.Company == "MISIKIR LTD" ? "MY AGENT" : "";
            ciTotalBill = ""; ciPaid = ""; ciRemaining = "";
            showSingleCheckIn = true;
        }
    }

    void DoCheckInSingle()
    {
        if (string.IsNullOrWhiteSpace(ciRoom)) return;
        if (selectedReg != null) selectedReg.State = "Checked In";
        showSingleCheckIn = false;
        StateHasChanged();
    }

    void DoCheckInMulti()
    {
        showMultiCheckIn = false;
        if (selectedReg != null) selectedReg.State = "Checked In";
        StateHasChanged();
    }

    void OpenRegistrationCard()
    {
        showSingleCheckIn = false;
        showMultiCheckIn = false;
        Navigation.NavigateTo("/guest-registration");
    }

    void OpenRoomSearchForSingle()
    {
        roomSearchForSingle = true;
        currentMultiRowForRoom = null;
        selectedRoomItem = null;
        showRoomSearch = true;
    }

    void OpenRoomSearchForMulti(MultiRoomRow row)
    {
        roomSearchForSingle = false;
        currentMultiRowForRoom = row;
        selectedRoomItem = null;
        showRoomSearch = true;
    }

    void SelectRoom()
    {
        if (selectedRoomItem == null) return;
        if (selectedRoomItem.HKStatus == "Dirty") return;
        if (roomSearchForSingle) { ciRoom = selectedRoomItem.Room; ciRoomType = selectedRoomItem.RoomType; }
        else if (currentMultiRowForRoom != null) currentMultiRowForRoom.Room = selectedRoomItem.Room;
        showRoomSearch = false;
        StateHasChanged();
    }

    void OnGridRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid.GetDataItem(e.VisibleIndex) as RegistrationRow;
        if (item != null) { selectedReg = item; StateHasChanged(); }
    }

    void OnFocusedRowKeyChanged(object newKey)
    {
        if (newKey is int sn) selectedReg = filteredRegistrations.FirstOrDefault(r => r.SN == sn);
        else if (newKey != null) selectedReg = filteredRegistrations.FirstOrDefault(r => r.SN.Equals(newKey));
        StateHasChanged();
    }

    void OnRoomRowClick(GridRowClickEventArgs e)
    {
        selectedRoomItem = e.Grid.GetDataItem(e.VisibleIndex) as RoomItem;
        StateHasChanged();
    }

    void OnRoomFocusedKeyChanged(object newKey)
    {
        if (newKey is int sn) selectedRoomItem = availableRooms.FirstOrDefault(r => r.SN == sn);
        StateHasChanged();
    }

    void OnRoomCustomize(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataCell) return;
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as RoomItem;
        if (item == null) return;
        if (e.Column?.Caption == "HK Status")
        {
            if (item.HKStatus == "Clean") e.CssClass = "hk-clean";
            else if (item.HKStatus == "Dirty") e.CssClass = "hk-dirty";
        }
        if (e.Column?.Caption == "FO Status" && item.FOStatus == "Vacant") e.CssClass = "fo-vacant";
    }

    void ApplyFilters()
    {
        filteredRegistrations = allRegistrations.Where(r =>
            (string.IsNullOrWhiteSpace(filterRoom) || r.Room.Contains(filterRoom, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(filterGuest) || r.Guest == filterGuest) &&
            (filterState == "All" || r.State == filterState) &&
            (filterArrival == null || r.Arrival.Date == filterArrival.Value.Date) &&
            (filterDeparture == null || r.Departure.Date == filterDeparture.Value.Date) &&
            (string.IsNullOrWhiteSpace(filterCompany) || r.Company == filterCompany)
        ).ToList();
        selectedReg = filteredRegistrations.FirstOrDefault();
        StateHasChanged();
    }

    public class RegistrationRow
    {
        public int SN { get; set; }
        public string Registration { get; set; } = "";
        public string Room { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string Guest { get; set; } = "";
        public string Company { get; set; } = "";
        public DateTime Arrival { get; set; }
        public DateTime Departure { get; set; }
        public int Nights { get; set; }
        public string Payment { get; set; } = "";
        public string State { get; set; } = "6PM";
        public int RoomCount { get; set; } = 1;
    }

    public class MultiRoomRow
    {
        public int SN { get; set; }
        public string Company { get; set; } = "";
        public string Guest { get; set; } = "";
        public int GuestNo { get; set; } = 1;
        public string Room { get; set; } = "";
        public DateTime Arrival { get; set; }
        public DateTime Departure { get; set; }
        public string Key { get; set; } = "";
        public bool Selected { get; set; }
    }

    public class RoomItem
    {
        public int SN { get; set; }
        public string Room { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string HKStatus { get; set; } = "";
        public string FOStatus { get; set; } = "";
        public string Floor { get; set; } = "";
        public string Feature { get; set; } = "";
        public string Remark { get; set; } = "";
    }
}