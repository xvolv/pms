@page "/registration-document"
@rendermode InteractiveServer
@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn
@inject NavigationManager Navigation

<PageTitle>Registration Browser - CNET ERP</PageTitle>

<div class="reg-browser-page" @onclick="CloseMenus">

    <!-- Toolbar -->
    <div class="erp-toolbar" @onclick:stopPropagation="true">
        <div class="toolbar-group">
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-eye"></i></div>
                <div class="toolbar-text">Show</div>
            </button>
            <div class="toolbar-dropdown">
                <button type="button" class="toolbar-btn @(showOptionsMenu ? "active" : "")"
                        @onclick="ToggleOptions">
                    <div class="toolbar-icon"><i class="bi bi-gear-fill"></i></div>
                    <div class="toolbar-text">Options ▾</div>
                </button>
                @if (showOptionsMenu)
                {
                    <ul class="dropdown-menu show">
                        <li class="dropdown-item" @onclick="@(() => OnOption("AccompanyGuest"))">Accompany Guest</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("Replicate"))">Replicate(Add on)</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("Attachment"))">Attachment</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("History"))">History</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("HouseKeeping"))">House Keeping</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("WakeupCall"))">Wakeup Calls</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("Messages"))">Messages</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("Routing"))">Routing</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("Shares"))">Shares</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("Privilege"))">Privilege</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("ScheduledActivity"))">Scheduled Activity</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("TravelDetail"))">Travel Detail</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("IssueCard"))">Issue Card</li>
                        <li class="dropdown-item" @onclick="@(() => OnOption("RoomAssignment"))">Room Assignment</li>
                    </ul>
                }
            </div>

            <div class="toolbar-dropdown">
                <button type="button" class="toolbar-btn @(showActivitiesMenu ? "active" : "")"
                        @onclick="ToggleActivities">
                    <div class="toolbar-icon"><i class="bi bi-type"></i></div>
                    <div class="toolbar-text">Activities ▾</div>
                </button>
                @if (showActivitiesMenu)
                {
                    <ul class="dropdown-menu show">
                        <li class="dropdown-item @(IsActivityEnabled("Waitinglist") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("Waitinglist"))">Waitinglist</li>
                        <li class="dropdown-item @(IsActivityEnabled("6PM") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("6PM"))">6PM</li>
                        <li class="dropdown-item @(IsActivityEnabled("Confirmation") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("Confirmation"))">Confirmation</li>
                        <li class="dropdown-item @(IsActivityEnabled("Cancel") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("Cancel"))">Cancel</li>
                        <li class="dropdown-item @(IsActivityEnabled("CheckIn") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("CheckIn"))">Check In</li>
                        <li class="dropdown-item @(IsActivityEnabled("CheckOut") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("CheckOut"))">Check out</li>
                        <li class="dropdown-item @(IsActivityEnabled("Reinstate") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("Reinstate"))">Reinstate</li>
                        <li class="dropdown-item @(IsActivityEnabled("PostMaster") ? "" : "disabled")"
                            @onclick="@(() => OnActivity("PostMaster"))">Post Master (PM)</li>
                    </ul>
                }
            </div>

            <div class="toolbar-dropdown">
                <button type="button" class="toolbar-btn @(showBillingMenu ? "active" : "")"
                        @onclick="ToggleBilling">
                    <div class="toolbar-icon"><i class="bi bi-cash-coin"></i></div>
                    <div class="toolbar-text">Billing ▾</div>
                </button>
                @if (showBillingMenu)
                {
                    <ul class="dropdown-menu show">
                        <li class="dropdown-item" @onclick="@(() => OnBilling("ManualCharge"))">Manual Charge</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("RoomCharges"))">Room Charges</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("BillSplit"))">Bill Split</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("BillTransfer"))">Bill Transfer</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("CashReceipt"))">Cash Receipt</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("Rebate"))">Rebate</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("PaidOut"))">Paid Out</li>
                        <li class="dropdown-item" @onclick="@(() => OnBilling("Refund"))">Refund</li>
                    </ul>
                }
            </div>

            <div class="toolbar-dropdown">
                <button type="button" class="toolbar-btn @(showAmendmentMenu ? "active" : "")"
                        @onclick="ToggleAmendment">
                    <div class="toolbar-icon"><i class="bi bi-pencil-square"></i></div>
                    <div class="toolbar-text">Amendment ▾</div>
                </button>
                @if (showAmendmentMenu)
                {
                    <ul class="dropdown-menu show">
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("Profiles"))">Profiles</li>
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("Date"))">Date Amendment</li>
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("Detail"))">Registration Detail</li>
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("Rate"))">Rate Adjustment</li>
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("RoomMove"))">Room Move</li>
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("Payment"))">Payment Options</li>
                        <li class="dropdown-item" @onclick="@(() => OnAmendment("Other"))">Other Fields</li>
                    </ul>
                }
            </div>

            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="toolbar-text">Preview ▾</div>
            </button>
        </div>

        <div class="filter-columns">
            <div class="filter-col">
                <div class="filter-row">
                    <span class="filter-icon text-secondary" ><i class="bi bi-house-door-fill"></i></span>
                    <span class="filter-label">Room</span>
                    <DxTextBox @bind-Text="filterRoom" Width="100%" SizeMode="SizeMode.Small" />
                </div>
                <div class="filter-row">
                    <span class="filter-icon text-secondary"><i class="bi bi-person-fill"></i></span>
                    <span class="filter-label">Guest</span>
                    <DxComboBox Data="@guestFilterList" @bind-Value="filterGuest" Width="100%"
                                SizeMode="SizeMode.Small" />
                </div>
                <div class="filter-row">
                    <span class="filter-icon text-secondary"><i class="bi bi-star-fill text-secondary"></i></span>
                    <span class="filter-label">State</span>
                    <DxComboBox Data="@stateFilterList" 
                                Value="filterState" 
                                ValueChanged="@((string s) => { filterState = s; ApplyFilters(); })" 
                                Width="100%" 
                                SizeMode="SizeMode.Small">
                        <ItemTemplate>
                            <div class="state-item">
                                <span>@context</span>
                                @if (stateColors.TryGetValue(context, out var col) && !string.IsNullOrEmpty(col))
                                {
                                    <span class="state-color-label" style="color:@col;">@col</span>
                                }
                            </div>
                        </ItemTemplate>
                    </DxComboBox>
                </div>
            </div>

            <div class="filter-col">
                <div class="filter-row">
                    <span class="filter-label filter-label-plain">Arrival</span>
                    <DxDateEdit @bind-Date="filterArrival" Width="100%" SizeMode="SizeMode.Small" />
                </div>
                <div class="filter-row">
                    <span class="filter-label filter-label-plain">Departure</span>
                    <DxDateEdit @bind-Date="filterDeparture" Width="100%" SizeMode="SizeMode.Small" />
                </div>
                <div class="filter-row">
                    <span class="filter-label filter-label-plain">Company</span>
                    <DxComboBox Data="@companyFilterList" @bind-Value="filterCompany" Width="100%"
                                SizeMode="SizeMode.Small" />
                </div>
            </div>
        </div>

        <div class="toolbar-group" style="margin-left:auto;">
            <div class="search-criteria">@GetSearchCriteria()</div>
            <button type="button" class="toolbar-btn" @onclick="ApplyFilters">
                <div class="toolbar-icon"><i class="bi bi-search"></i></div>
                <div class="toolbar-text">Advanced<br />Search ▾</div>
            </button>
            <button type="button" class="toolbar-btn" @onclick="NoOp">
                <div class="toolbar-icon"><i class="bi bi-printer-fill"></i></div>
                <div class="toolbar-text">Print ▾</div>
            </button>
            <button type="button" class="toolbar-btn" @onclick="ClearFilters" title="Clear Filter">
                <div class="toolbar-icon"><i class="bi bi-x-lg"></i></div>
                <div class="toolbar-text">Clear<br />Filter</div>
            </button>
        </div>
    </div>

    <!-- Grid -->
    <DxGrid Data="@filteredRegistrations" KeyFieldName="SN" PageSize="20" ShowPager="false" SizeMode="SizeMode.Small"
            Width="100%" Height="480px" FocusedRowEnabled="true" FocusedRowKey="@(selectedReg?.SN)"
            FocusedRowKeyChanged="OnFocusedRowKeyChanged" RowClick="OnGridRowClick" CustomizeElement="OnRegCustomize"
            CssClass="reg-grid">
        <Columns>
            <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
            <DxGridDataColumn FieldName="Registration" Caption="Registration" Width="110px" />
            <DxGridDataColumn FieldName="Room" Caption="Room" Width="70px" />
            <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="120px" />
            <DxGridDataColumn FieldName="Guest" Caption="Guest" Width="160px" />
            <DxGridDataColumn FieldName="Company" Caption="Company" Width="120px" />
            <DxGridDataColumn FieldName="Arrival" Caption="Arrival" Width="100px" DisplayFormat="M/d/yyyy" />
            <DxGridDataColumn FieldName="Departure" Caption="Departure" Width="100px" DisplayFormat="M/d/yyyy" />
            <DxGridDataColumn FieldName="Nights" Caption="# of Night" Width="80px" />
            <DxGridDataColumn FieldName="Payment" Caption="Payment" />
        </Columns>
    </DxGrid>

    <div class="record-bar">
        <button type="button" class="nav-btn" @onclick="GoFirst" title="First"><i class="bi bi-chevron-bar-left"></i></button>
        <button type="button" class="nav-btn" @onclick="GoPrev" title="Previous"><i class="bi bi-chevron-left"></i></button>
        <span class="record-text">Record @(GetRecordIndex()) of @filteredRegistrations.Count</span>
        <button type="button" class="nav-btn" @onclick="GoNext" title="Next"><i class="bi bi-chevron-right"></i></button>
        <button type="button" class="nav-btn" @onclick="GoLast" title="Last"><i class="bi bi-chevron-bar-right"></i></button>
    </div>
</div>
<!-- ========== AMENDMENT POPUPS ========== -->

<!-- 1. Profile Amendment -->
<ProfileAmendmentPopup
    @bind-Visible="showProfileAmendment"
    Guest="@amendGuest" GuestChanged="@((string? v) => amendGuest = v)"
    Contact="@amendContact" ContactChanged="@((string? v) => amendContact = v)"
    Company="@amendCompany" CompanyChanged="@((string? v) => amendCompany = v)"
    Agent="@amendAgent" AgentChanged="@((string? v) => amendAgent = v)"
    Group="@amendGroup" GroupChanged="@((string? v) => amendGroup = v)"
    Source="@amendSource" SourceChanged="@((string? v) => amendSource = v)"
    GuestNames="@guestNames" ContactList="@contactList" CompanyList="@companyFilterList"
    AgentList="@agentList" GroupList="@groupList" SourceList="@sourceList"
    OnSave="SaveProfileAmendment" />

<!-- 2. Date Amendment -->
<DateAmendmentPopup
    @bind-Visible="showDateAmendment"
    Arrival="@amendArrival" ArrivalChanged="@((DateTime? v) => amendArrival = v)"
    Departure="@amendDeparture" DepartureChanged="@((DateTime? v) => amendDeparture = v)"
    Adult="@amendAdult" AdultChanged="@((int v) => amendAdult = v)"
    Child="@amendChild" ChildChanged="@((int v) => amendChild = v)"
    RoomType="@amendRoomType" RoomTypeChanged="@((string? v) => amendRoomType = v)"
    Room="@amendRoom" RoomChanged="@((string v) => amendRoom = v)"
    RateCode="@amendRateCode" RateCodeChanged="@((string v) => amendRateCode = v)"
    Amount="@amendAmount" AmountChanged="@((decimal v) => amendAmount = v)"
    Fixed="@amendFixed" FixedChanged="@((bool v) => amendFixed = v)"
    RoomTypes="@roomTypes"
    OnSave="SaveDateAmendment"
    OnRoomSearch="OpenRoomSearchForAmendment" />

<!-- 3. Registration Detail -->
<RegistrationDetailPopup
    @bind-Visible="showRegistrationDetail"
    RegistrationNo="@selectedReg?.Registration"
    Rows="@dailyDetailRows"
    SelectedRow="@selectedDetailRow"
    SelectedRowChanged="@((DailyDetailRow? r) => selectedDetailRow = r)"
    OnRefresh="RefreshRegistrationDetail"
    OnEdit="EditDailyDetail" />

<!-- 3b. Edit Daily Registration Detail -->
<DailyDetailEditPopup
    @bind-Visible="showEditDailyDetail"
    Model="@editDetail"
    RoomTypes="@roomTypes"
    SourceList="@sourceList"
    MarketList="@marketList"
    OnSave="SaveDailyDetailEdit" />

<!-- 4. Rate Adjustment -->
<RateAdjustmentPopup
    @bind-Visible="showRateAdjustment"
    RegNo="@rateAdjRegNo"
    RateCode="@rateAdjRateCode"
    Amount="@rateAdjAmount"
    StartDate="@rateAdjStartDate"
    EndDate="@rateAdjEndDate"
    AdjType="@rateAdjType"
    Factor="@rateAdjFactor"
    Value="@rateAdjValue"
    Reason="@rateAdjReason"
    AdjTypes="@rateAdjTypes"
    Reasons="@rateAdjustmentReasons"
    OnSave="SaveRateAdjustment" />

<!-- 5. Room Move -->
<RoomMovePopup
    @bind-Visible="showRoomMove"
    RegNo="@roomMoveRegNo"
    Guest="@roomMoveGuest"
    CurrentRoomType="@roomMoveCurrentRoomType"
    CurrentRoom="@roomMoveCurrentRoom"
    NewRoomType="@roomMoveNewRoomType" NewRoomTypeChanged="@((string? v) => roomMoveNewRoomType = v)"
    NewRoom="@roomMoveNewRoom" NewRoomChanged="@((string v) => roomMoveNewRoom = v)"
    Start="@roomMoveStart"
    End="@roomMoveEnd"
    Reason="@roomMoveReason"
    RoomTypes="@roomTypes"
    Reasons="@roomMoveReasons"
    OnSave="SaveRoomMove"
    OnRoomSearch="OpenRoomSearchForRoomMove" />

<!-- 6. Payment Options -->
<PaymentOptionsPopup
    @bind-Visible="showPaymentOptions"
    Guest="@payGuest" RegNo="@payRegNo" Room="@payRoom"
    PayMethod="@payMethod" PayMethodChanged="@((string? v) => payMethod = v)"
    CreditCard="@payCreditCard" CreditCardChanged="@((string? v) => payCreditCard = v)"
    CreditCardNo="@payCreditCardNo" CreditCardNoChanged="@((string v) => payCreditCardNo = v)"
    Currency="@payCurrency" CurrencyChanged="@((string? v) => payCurrency = v)"
    ExpDate="@payExpDate"
    CrsNo="@payCrsNo" CrsNoChanged="@((string v) => payCrsNo = v)"
    ApprovalCode="@payApprovalCode" ApprovalCodeChanged="@((string v) => payApprovalCode = v)"
    ApprovalAmt="@payApprovalAmt" ApprovalAmtChanged="@((decimal v) => payApprovalAmt = v)"
    Payments="@payments" CreditCardTypes="@creditCardTypes" Currencies="@currencies"
    OnSave="SavePaymentOptions" OnReset="ResetPaymentOptions" />

<!-- 7. Other Fields -->
<OtherFieldsPopup
    @bind-Visible="showOtherFields"
    ResType="@otherResType"
    Market="@otherMarket"
    Source="@otherSource"
    Origin="@otherOrigin"
    MemberType="@otherMemberType"
    Specials="@otherSpecials"
    ReservationTypes="@reservationTypes"
    MarketList="@marketList"
    SourceList="@sourceList"
    OriginList="@originList"
    MemberTypes="@memberTypes"
    SpecialsList="@specialsList"
    OnSave="SaveOtherFields" />

<!-- ========== OPTIONS POPUPS ========== -->

<!-- Accompany Guest -->
<AccompanyGuestPopup
    @bind-Visible="showAccompanyGuest"
    RegistrationNo="@selectedReg?.Registration"
    Room="@selectedReg?.Room"
    Guests="@accompanyGuests"
    SelectedGuest="@selectedAccompanyGuest"
    SelectedGuestChanged="@((AccompanyGuestRow? g) => selectedAccompanyGuest = g)"
    OnNew="AddAccompanyGuest"
    OnSave="SaveAccompanyGuest"
    OnRemove="RemoveAccompanyGuest" />

<!-- Guest Find -->
<GuestFindPopup
    @bind-Visible="showGuestFind"
    GuestNames="@guestNames"
    OnSelect="SelectAccompanyGuest"
    OnAddNew="OpenNewGuestFromAccompany" />

<!-- Attachment -->
<AttachmentPopup
    @bind-Visible="showAttachment"
    RegistrationNo="@selectedReg?.Registration"
    OnNew="@(() => showNewAttachment = true)" />

<!-- New Attachment -->
<NewAttachmentPopup
    @bind-Visible="showNewAttachment"
    OnSave="SaveNewAttachment" />

<!-- Wakeup Call -->
<WakeupCallPopup
    @bind-Visible="showWakeupCall"
    Room="@wuRoom" RegNo="@wuRegNo" Guest="@wuGuest"
    DateFrom="@wuDateFrom" NoDays="@wuNoDays" DateTo="@wuDateTo"
    Time="@wuTime" Note="@wuNote"
    Schedules="@wakeupSchedules"
    SelectedSchedule="@selectedWakeup"
    SelectedScheduleChanged="@((WakeupScheduleRow? s) => selectedWakeup = s)"
    OnSave="SaveWakeupCall"
    OnRemove="RemoveWakeupCall" />

<!-- Send Message -->
<SendMessagePopup
    @bind-Visible="showSendMessage"
    MsgUser="@msgUser" MsgUserChanged="@((string v) => msgUser = v)"
    MsgSendToAll="@msgSendToAll" MsgSendToAllChanged="@((bool v) => msgSendToAll = v)"
    MsgGuest="@msgGuest" MsgGuestChanged="@((string v) => msgGuest = v)"
    MsgRoom="@msgRoom" MsgRoomChanged="@((string v) => msgRoom = v)"
    MsgRegNo="@msgRegNo" MsgNo="@msgNo" MsgDate="@msgDate"
    MsgType="@msgType" MsgTypeChanged="@((string? v) => msgType = v)"
    MsgBody="@msgBody" MsgBodyChanged="@((string v) => msgBody = v)"
    MessageTypes="@messageTypes"
    OnSave="SaveMessage" OnReset="ResetMessage"
    OnOpenUserFind="@(() => showUserFind = true)" />

<!-- User Find -->
<UserFindPopup
    @bind-Visible="showUserFind"
    Users="@systemUsers"
    SelectedUser="@selectedUserItem"
    SelectedUserChanged="@((UserItem? u) => selectedUserItem = u)"
    OnOk="SelectUser"
    OnClear="@(() => { selectedUserItem = null; msgUser = null; })" />

<!-- Privilege -->
<PrivilegePopup
    @bind-Visible="showPrivilege"
    RegNo="@privRegNo"
    NoPost="@privNoPost"
    AuthorizeDirectBill="@privAuthorizeDirectBill"
    PreStayCharging="@privPreStayCharging"
    PostStayCheckout="@privPostStayCheckout"
    AllowLateCheckout="@privAllowLateCheckout"
    Remark="@privRemark"
    OnSave="SavePrivilege" />

<!-- Travel Detail -->
<TravelDetailPopup
    @bind-Visible="showTravelDetail"
    RegistrationNo="@selectedReg?.Registration"
    PickupRequired="@travelPickupRequired"
    TransportType="@travelTransportType"
    CarrierCode="@travelCarrierCode"
    TransportNo="@travelTransportNo"
    ArrivalDate="@travelArrivalDate"
    PickupTime="@travelPickupTime"
    YesNoList="@yesNoList"
    TransportTypes="@transportTypes"
    CarrierCodes="@carrierCodes"
    OnSave="SaveTravelDetail"
    OnReset="ResetTravelDetail" />

<!-- ========== BILLING POPUPS ========== -->

<!-- Manual Charge -->
<ManualChargePopup
    @bind-Visible="showManualCharge"
    Article="@mcArticle" ArticleChanged="@((string? v) => mcArticle = v)"
    Qty="@mcQty" QtyChanged="@((int v) => mcQty = v)"
    Amount="@mcAmount" AmountChanged="@((decimal v) => mcAmount = v)"
    Remark="@mcRemark" RemarkChanged="@((string v) => mcRemark = v)"
    Date="@mcDate" No="@mcNo"
    ChargeType="@mcChargeType" TransactionType="@mcTransactionType"
    Currency="@mcCurrency" Registration="@mcRegistration" Room="@mcRoom"
    Reference="@mcReference" Window="@mcWindow"
    Subtotal="@mcSubtotal" Discount="@mcDiscount"
    AdditionalCharge="@mcAdditionalCharge" Vat="@mcVat" GrandTotal="@mcGrandTotal"
    Lines="@mcLines" SelectedLine="@selectedMcLine"
    SelectedLineChanged="@((ManualChargeLine? l) => selectedMcLine = l)"
    Articles="@articles" ChargeTypes="@chargeTypes"
    Currencies="@currencies" WindowList="@windowList"
    OnNew="OpenManualCharge" OnSave="SaveManualCharge"
    OnAddLine="AddManualChargeLine" OnRemoveLine="RemoveManualChargeLine"
    OnOpenArticleFind="@(() => showArticleFind = true)" />

<!-- Article Find -->
<ArticleFindPopup
    @bind-Visible="showArticleFind"
    Articles="@articles"
    OnSelect="@((string? v) => mcArticle = v)" />

<!-- Confirm User -->
<ConfirmUserPopup
    @bind-Visible="showConfirmUser"
    Password="@confirmUserPassword"
    PasswordChanged="@((string v) => confirmUserPassword = v)"
    OnConfirm="ConfirmBillingUser" />

<!-- Overdue error -->
<OverdueErrorPopup @bind-Visible="showOverdueError" />

<!-- Room Charge -->
<RoomChargePopup
    @bind-Visible="showRoomCharge"
    From="@rcFrom" To="@rcTo"
    Rows="@roomChargeRows"
    OnPost="PostRoomCharge"
    OnShow="OpenRoomCharge"
    OnOption="SetRoomChargeOption" />

<!-- Cash Receipt -->
<CashReceiptPopup
    @bind-Visible="showCashReceipt"
    Title="Cash Receipt"
    ShowForeignCurrency="true" ShowNetOff="false" ShowCustomerFind="true"
    Customer="@crCustomer" PaymentType="@crPaymentType" Currency="@crCurrency"
    ExRate="@crExRate" Amount="@crAmount" TotalAmount="@crTotalAmount"
    VoucherNo="@crVoucherNo" Date="@crDate" RegNo="@crRegNo"
    Window="@crWindow" Reference="@crReference" Purpose="@crPurpose" Remark="@crRemark"
    Customers="@crCustomers" PaymentMethods="@paymentMethods"
    Currencies="@currencies" WindowList="@windowList"
    OnSave="SaveCashReceipt"
    OnForeignCurrency="OpenForeignCurrency"
    OnOpenCustomerFind="OpenCrCustomerFind" />

<!-- Cash Receipt Customer Find -->
<CrCustomerFindPopup
    @bind-Visible="showCrCustomerFind"
    Customers="@crCustomers"
    SelectedCustomer="@selectedCrCustomer"
    SelectedCustomerChanged="@((CustomerFindItem? c) => selectedCrCustomer = c)"
    OnOk="SelectCrCustomer" />

<!-- Foreign Currency -->
<ForeignCurrencyPopup
    @bind-Visible="showForeignCurrency"
    VoucherNo="@crVoucherNo" Payment="@fxPayment"
    TotalAmount="@fxTotalAmount" Remaining="@fxRemaining"
    Rows="@fxRows" Currencies="@currencies"
    OnSave="SaveForeignCurrency" />

<!-- Rebate -->
<CashReceiptPopup
    @bind-Visible="showRebate"
    Title="Rebate"
    ShowForeignCurrency="false" ShowNetOff="true" ShowCustomerFind="false"
    Customer="@crCustomer" PaymentType="@crPaymentType" Currency="@crCurrency"
    ExRate="@crExRate" Amount="@crAmount" TotalAmount="@crTotalAmount"
    VoucherNo="@crVoucherNo" Date="@crDate" RegNo="@crRegNo"
    Window="@crWindow" Reference="@crReference" Purpose="@crPurpose" Remark="@crRemark"
    NetOff="@rebateNetOff"
    Customers="@crCustomers" PaymentMethods="@paymentMethods"
    Currencies="@currencies" WindowList="@windowList"
    OnSave="SaveRebate" />

<!-- Paid Out -->
<CashReceiptPopup
    @bind-Visible="showPaidOut"
    Title="Paid Out"
    ShowForeignCurrency="false" ShowNetOff="false" ShowCustomerFind="false"
    Customer="@crCustomer" PaymentType="@crPaymentType" Currency="@crCurrency"
    ExRate="@crExRate" Amount="@crAmount" TotalAmount="@crTotalAmount"
    VoucherNo="@crVoucherNo" Date="@crDate" RegNo="@crRegNo"
    Window="@crWindow" Reference="@crReference" Purpose="@crPurpose" Remark="@crRemark"
    Customers="@crCustomers" PaymentMethods="@paymentMethods"
    Currencies="@currencies" WindowList="@windowList"
    OnSave="SavePaidOut" />

<!-- Bill Split -->
<BillSplitPopup
    @bind-Visible="showBillSplit"
    GuestName="@(selectedReg?.Guest ?? "")"
    WindowCount="@billSplitWindowCount"
    Window1="@billSplitWindow1" Window2="@billSplitWindow2" Window3="@billSplitWindow3"
    SelectedItem="@selectedBillSplitItem"
    SelectedItemChanged="@((BillSplitItem? b) => selectedBillSplitItem = b)"
    ActiveWindowChanged="@((int w) => activeBillSplitWindow = w)"
    OnAddWindow="AddBillSplitWindow"
    OnSave="@(() => ShowInfo("Windows saved."))"
    OnBreak="BreakSelectedBillItem"
    OnViewFolio="OpenFolio"
    OnCheckOut="@(() => OnActivity("CheckOut"))"
    OnOpenSplitVoucher="OpenSplitVoucher" />

<!-- Split Voucher -->
<SplitVoucherPopup
    @bind-Visible="showSplitVoucher"
    VoucherNo="@svVoucherNo" Customer="@(selectedReg?.Guest ?? "")"
    BusinessDate="@businessDate" GrandTotal="@svGrandTotal"
    SplitBy="@svSplitBy" NoOfSplit="@svNoOfSplit"
    FactorPercent="@svFactorPercent" FactorPercentChanged="@((bool v) => { svFactorPercent = v; StateHasChanged(); })"
    PercentValue="@svPercentValue" AmountValue="@svAmountValue"
    Pieces="@svPieces"
    SelectedPiece="@selectedSplitPiece"
    SelectedPieceChanged="@((SplitPiece? p) => selectedSplitPiece = p)"
    OnSave="SaveSplitVoucher" OnSplit="DoSplitVoucher" OnClear="ClearSplitVoucher" />

<!-- Bill Transfer -->
<BillTransferPopup
    @bind-Visible="showBillTransfer"
    GuestName="@btGuestName" RegNo="@btRegNo" Company="@btCompany"
    FsNum="@btFsNum" Tin="@btTin" Arrival="@btArrival" Departure="@btDeparture"
    ToGuest="@btToGuest" ToGuestChanged="@((string? v) => btToGuest = v)"
    Window="@btWindow" SelectAll="@btSelectAll"
    RoomCharges="@btRoomCharges" ExtraBills="@btExtraBills" PaymentHistory="@btPayments"
    WindowOptions="@(new List<string> { "All" }.Concat(windowList).ToList())"
    OnRefresh="OpenBillTransfer"
    OnOpenGuestFind="OpenBtGuestFind"
    OnSelectAll="@((bool v) => { btSelectAll = v; foreach (var r in btRoomCharges) r.Selected = v; foreach (var e in btExtraBills) e.Selected = v; foreach (var p in btPayments) p.Selected = v; })"
    OnTransfer="TransferBills"
    OnReturn="ReturnBills" />

