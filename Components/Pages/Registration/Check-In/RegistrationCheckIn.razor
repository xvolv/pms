    void SelectRoom()
    {
        if (selectedRoomItem == null) return;
        if (selectedRoomItem.HKStatus == "Dirty") return;
        if (roomSearchContext == "ShareCheckIn")
        {
            shareRoom = selectedRoomItem.Room;
            shareRoomType = selectedRoomItem.RoomType;
        }
        else if (roomSearchContext == "CheckIn" || roomSearchForSingle)
        {
            ciRoom = selectedRoomItem.Room;
            ciRoomType = selectedRoomItem.RoomType;
        }
        else if (roomSearchContext == "MultiCheckIn" && currentMultiRowForRoom != null)
        {
            currentMultiRowForRoom.Room = selectedRoomItem.Room;
        }
        else if (roomSearchContext == "DateAmendment")
        {
            amendRoom = selectedRoomItem.Room;
            amendRoomType = selectedRoomItem.RoomType;
        }
        else if (roomSearchContext == "RoomMove")
        {
            roomMoveNewRoom = selectedRoomItem.Room;
            roomMoveNewRoomType = selectedRoomItem.RoomType;
        }
        showRoomSearch = false;
        StateHasChanged();
    }

    void OnGridRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid.GetDataItem(e.VisibleIndex) as RegistrationRow;
        if (item != null) { selectedReg = item; StateHasChanged(); }
    }

    void OnFocusedRowKeyChanged(object newKey)
    {
        if (newKey is int sn) selectedReg = filteredRegistrations.FirstOrDefault(r => r.SN == sn);
        else if (newKey != null) selectedReg = filteredRegistrations.FirstOrDefault(r => r.SN.Equals(newKey));
        StateHasChanged();
    }

    void OnRegCustomize(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataRow) return;
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as RegistrationRow;
        if (item == null) return;

        var classes = new List<string>();

        if (selectedReg != null && item.SN == selectedReg.SN)
            classes.Add("row-selected");

        classes.Add(item.State switch
        {
            "Waiting List" => "state-waiting",
            "6PM" => "state-6pm",
            "Cancelled" => "state-cancelled",
            "Guaranteed" => "state-guaranteed",
            "Checked Out" => "state-checkout",
            "PM" => "state-pm",
            "Inhouse" => "state-inhouse",
            "No show" => "state-noshow",
            _ => ""
        });

        e.CssClass = string.Join(" ", classes).Trim();
    }

    int GetRecordIndex() => selectedReg == null ? 0 : filteredRegistrations.IndexOf(selectedReg) + 1;

    void GoFirst()
    {
        selectedReg = filteredRegistrations.FirstOrDefault();
        StateHasChanged();
    }

    void GoPrev()
    {
        if (selectedReg == null) return;
        var idx = filteredRegistrations.IndexOf(selectedReg);
        if (idx > 0) selectedReg = filteredRegistrations[idx - 1];
        StateHasChanged();
    }

    void GoNext()
    {
        if (selectedReg == null) return;
        var idx = filteredRegistrations.IndexOf(selectedReg);
        if (idx >= 0 && idx < filteredRegistrations.Count - 1) selectedReg = filteredRegistrations[idx + 1];
        StateHasChanged();
    }

    void GoLast()
    {
        selectedReg = filteredRegistrations.LastOrDefault();
        StateHasChanged();
    }

    void OnRoomRowClick(GridRowClickEventArgs e)
    {
        selectedRoomItem = e.Grid.GetDataItem(e.VisibleIndex) as RoomSearchItem;
        StateHasChanged();
    }

    void OnRoomFocusedKeyChanged(object newKey)
    {
        if (newKey is int sn) selectedRoomItem = availableRooms.FirstOrDefault(r => r.SN == sn);
        StateHasChanged();
    }

    void OnRoomCustomize(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType != GridElementType.DataCell) return;
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as RoomSearchItem;
        if (item == null) return;
        if (e.Column?.Caption == "HK Status")
        {
            if (item.HKStatus == "Clean") e.CssClass = "hk-clean";
            else if (item.HKStatus == "Dirty") e.CssClass = "hk-dirty";
        }
        if (e.Column?.Caption == "FO Status" && item.FOStatus == "Vacant") e.CssClass = "fo-vacant";
    }

    void ApplyFilters()
    {
        filteredRegistrations = allRegistrations.Where(r =>
            (string.IsNullOrWhiteSpace(filterRoom) || (!string.IsNullOrEmpty(r.Room) && r.Room.Contains(filterRoom, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(filterGuest) || r.Guest == filterGuest) &&
            (filterState == "All" || r.State == filterState) &&
            (filterArrival == null || r.Arrival.Date == filterArrival.Value.Date) &&
            (filterDeparture == null || r.Departure.Date == filterDeparture.Value.Date) &&
            (string.IsNullOrWhiteSpace(filterCompany) || r.Company == filterCompany)
        ).ToList();
        selectedReg = filteredRegistrations.FirstOrDefault();
        StateHasChanged();
    }

    void ClearFilters()
    {
        filterRoom = "";
        filterGuest = null;
        filterState = "Inhouse";
        filterArrival = null;
        filterDeparture = null;
        filterCompany = null;
        ApplyFilters();
    }

    void UpdateRegistrationState(int? sn, string newState)
    {
        if (!sn.HasValue) return;
        var reg = allRegistrations.FirstOrDefault(r => r.SN == sn.Value);
        if (reg != null)
        {
            reg.State = newState;
        }
    }

