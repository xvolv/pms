    string GetSearchCriteria()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(filterState) && filterState != "All") parts.Add($"State = {filterState}");
        if (filterArrival.HasValue) parts.Add($"Arrival = {filterArrival.Value:M/d/yyyy}");
        if (parts.Count == 0) return "";
        return "Search Criteria: " + string.Join(", ", parts);
    }

    bool IsActivityEnabled(string activity)
    {
        if (selectedReg == null) return false;
        var s = selectedReg.State;

        switch (activity)
        {
            case "Waitinglist":
                return s != "Checked In" && s != "Inhouse" && s != "Checked Out";
            case "6PM":
                return s != "Checked In" && s != "Inhouse" && s != "Cancelled" && s != "Checked Out" && s != "6PM" && s != "No show";
            case "Confirmation":
                return s == "Waiting List" || s == "6PM" || s == "No show";
            case "Cancel":
                return s != "Checked In" && s != "Inhouse" && s != "Cancelled" && s != "Checked Out";
            case "CheckIn":
                return s != "Checked In" && s != "Inhouse" && s != "Cancelled" && s != "Checked Out";
            case "CheckOut":
                return s == "Checked In" || s == "Inhouse";
            case "Reinstate":
                return (s == "Cancelled" || s == "Checked Out" || s == "No show") && selectedReg.Departure.Date >= businessDate.Date;
            case "PostMaster":
                return s == "Checked In" || s == "Inhouse";
            default:
                return true;
        }
    }

    void OnActivity(string action)
    {
        showActivitiesMenu = false;
        if (selectedReg == null) { showNoSelection = true; return; }

        if (!IsActivityEnabled(action))
        {
            validationErrorMessage = $"The \'{action}\' action is not available for a reservation in \'{selectedReg.State}\' state.";
            showValidationError = true;
            return;
        }

        pendingActivity = action;

        switch (action)
        {
            case "CheckIn":
                if (selectedReg.Arrival.Date != businessDate.Date) { showArrivalError = true; return; }
                stateConfirmMessage = $"Do you want to change {selectedReg.State} state to Check In ?";
                showStateConfirm = true;
                break;

            case "Confirmation":
                stateConfirmMessage = $"Do you want to change {selectedReg.State} state to Conformation state?";
                showStateConfirm = true;
                break;

            case "Cancel":
                stateConfirmMessage = "Do you want to cancel this registration?";
                showStateConfirm = true;
                break;

            case "CheckOut":
                stateConfirmMessage = $"Do you want to check out {selectedReg.Guest}?";
                showStateConfirm = true;
                break;

            case "Reinstate":
                stateConfirmMessage = $"Do you want to reinstate {selectedReg.State}?";
                showStateConfirm = true;
                break;

            case "6PM":
                UpdateRegistrationState(selectedReg?.SN, "6PM");
                ApplyFilters();
                infoMessage = "State changed successfully!"; showSuccessInfo = true;
                StateHasChanged();
                break;

            case "Waitinglist":
                UpdateRegistrationState(selectedReg?.SN, "Waiting List");
                ApplyFilters();
                infoMessage = "State changed successfully!"; showSuccessInfo = true;
                StateHasChanged();
                break;

            case "PostMaster":
                validationErrorMessage = "Post Master functionality is not implemented in this demo.";
                showValidationError = true;
                break;
        }
    }

