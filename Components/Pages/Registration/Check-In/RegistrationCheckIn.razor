    void ConfirmStateChange()
    {
        showStateConfirm = false;
        if (selectedReg == null) return;

        switch (pendingActivity)
        {
            case "CheckIn":
                OpenCheckInReview();
                break;
            case "Confirmation":
                OpenConfirmationReview();
                break;
            case "Cancel":
                OpenCancellationReview();
                break;
            case "CheckOut":
                OpenCheckOutReview();
                break;
            case "Reinstate":
                OpenReinstateReview();
                break;
        }
    }

    void OpenCheckInReview()
    {
        if (selectedReg == null) return;
        if (selectedReg.RoomCount > 1)
        {
            multiRoomRows = new List<MultiRoomRow>();
            for (int i = 1; i <= selectedReg.RoomCount; i++)
            {
                multiRoomRows.Add(new MultiRoomRow
                {
                    SN = i,
                    Company = selectedReg.Company,
                    Guest = i == 1 ? selectedReg.Guest : "",
                    GuestNo = 1,
                    Room = "",
                    Arrival = selectedReg.Arrival,
                    Departure = selectedReg.Departure,
                    Key = "",
                    Selected = i == 1
                });
            }
            showMultiCheckIn = true;
        }
        else
        {
            ciRegNo = selectedReg.Registration;
            ciArrival = selectedReg.Arrival;
            ciDeparture = selectedReg.Departure;
            ciRoomType = selectedReg.RoomType;
            ciRoom = (selectedReg.Room ?? "").Replace("#", "");
            ciPayment = selectedReg.Payment;
            ciGuest = selectedReg.Guest;
            ciCompany = selectedReg.Company;
            ciAgent = selectedReg.Company == "MISIKIR LTD" ? "MY AGENT" : "";
            ciSource = "";
            ciGroup = "";
            ciContact = "";
            ciTotalBill = ""; ciPaid = ""; ciRemaining = "";
            showSingleCheckIn = true;
        }
    }

    void DoCheckInSingle()
    {
        if (string.IsNullOrWhiteSpace(ciRoom)) return;
        if (selectedReg != null)
        {
            UpdateRegistrationState(selectedReg.SN, "Checked In");
            selectedReg.Room = ciRoom;
        }
        showSingleCheckIn = false;
        ApplyFilters();
        infoMessage = "State changed successfully!"; showSuccessInfo = true;
