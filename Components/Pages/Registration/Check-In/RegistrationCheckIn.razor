<!-- Confirmation Review -->
<StateReviewPopup
    @bind-Visible="showConfirmationReview"
    Title="Confirmation" Heading="You are conforming the guest below"
    RegNo="@ciRegNo" Guest="@ciGuest" Company="@ciCompany" Room="@ciRoom"
    Payment="@ciPayment" TotalBill="@ciTotalBill" Paid="@ciPaid" Remaining="@ciRemaining"
    Departure="@ciDeparture" Agent="@ciAgent" Source="@ciSource"
    CompanyList="@companyFilterList" Payments="@payments"
    AgentList="@agentList" SourceList="@sourceList">
    <ToolbarContent>
        <button type="button" class="toolbar-btn" @onclick="DoConfirmReservation">
            <div class="toolbar-icon"><i class="bi bi-check-square"></i></div>
            <div class="toolbar-text">Conform</div>
        </button>
        <button type="button" class="toolbar-btn" @onclick="NoOp">
            <div class="toolbar-icon"><i class="bi bi-arrow-right-circle"></i></div>
            <div class="toolbar-text">Payment</div>
        </button>
        <button type="button" class="toolbar-btn" @onclick="NoOp">
            <div class="toolbar-icon"><i class="bi bi-arrow-clockwise"></i></div>
            <div class="toolbar-text">Conformation Slip</div>
        </button>
    </ToolbarContent>
</StateReviewPopup>

<!-- Cancellation Review -->
<StateReviewPopup
    @bind-Visible="showCancellationReview"
    Title="Cancellation" Heading="You are cancelling the guest below"
    RegNo="@ciRegNo" Guest="@ciGuest" Company="@ciCompany" Room="@ciRoom"
    Payment="@ciPayment" TotalBill="@ciTotalBill" Paid="@ciPaid" Remaining="@ciRemaining"
    Departure="@ciDeparture" Agent="@ciAgent" Source="@ciSource"
    CompanyList="@companyFilterList" Payments="@payments"
    AgentList="@agentList" SourceList="@sourceList">
    <ToolbarContent>
        <button type="button" class="toolbar-btn" @onclick="DoCancelReservation">
            <div class="toolbar-icon"><i class="bi bi-file-earmark-x"></i></div>
            <div class="toolbar-text">Cancel</div>
        </button>
    </ToolbarContent>
    <ExtraFields>
        <div class="ci-row"><label>Reason</label>
            <DxComboBox Data="@cancelReasons" @bind-Value="ciCancelReason" SizeMode="SizeMode.Small" />
        </div>
    </ExtraFields>
</StateReviewPopup>

<!-- Reinstate Review -->
<StateReviewPopup
    @bind-Visible="showReinstateReview"
    Title="Re InState" Heading="You are reinstating the Canceled guest."
    RegNo="@ciRegNo" Guest="@ciGuest" Company="@ciCompany" Room="@ciRoom"
