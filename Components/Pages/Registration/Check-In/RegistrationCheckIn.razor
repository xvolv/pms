    void OnBilling(string action)
    {
        showBillingMenu = false;
        if (selectedReg == null) { showNoSelection = true; return; }

        // Overdue out cannot manual charge
        if (action == "ManualCharge" && selectedReg.State == "Checked Out" && selectedReg.Departure.Date < businessDate.Date)
        {
            showOverdueError = true;
            return;
        }

        switch (action)
        {
            case "ManualCharge":
                OpenManualCharge();
                break;
            case "RoomCharges":
                OpenRoomCharge();
                break;
            case "BillSplit":
                OpenBillSplit();
                break;
            case "BillTransfer":
                OpenBillTransfer();
                break;
            case "CashReceipt":
                OpenCashReceipt();
                break;
            case "Rebate":
                OpenRebate();
                break;
            case "PaidOut":
                OpenPaidOut();
                break;
            case "Refund":
                if (selectedReg.State != "Checked Out")
                {
                    ShowInfo("Refund is only allowed for checked-out guests.");
                    return;
                }
                ShowInfo("This feature is not yet implemented.");
                break;
        }
    }

    void OpenManualCharge()
    {
        if (selectedReg == null) return;
        mcArticle = null;
        mcQty = 1;
        mcAmount = 0;
        mcRemark = "";
        mcDate = businessDate;
        mcNo = $"WDRC-{Random.Shared.Next(1000, 9999)}-17";
        mcChargeType = "Room Charge";
        mcTransactionType = "Credit Sales";
        mcCurrency = "Birr";
        mcRegistration = selectedReg.Registration;
        mcRoom = selectedReg.Room?.Replace("#", "") ?? "";
        mcReference = "";
        mcWindow = "Window 1";
        mcLines = new List<ManualChargeLine>();
        selectedMcLine = null;
        RecalcManualChargeTotals();
        showManualCharge = true;
    }

    void RecalcManualChargeTotals()
    {
        mcSubtotal = mcLines.Sum(l => l.TotalPrice);
        mcDiscount = 0;
        mcAdditionalCharge = Math.Round(mcSubtotal * 0.10m, 2);
        mcVat = Math.Round((mcSubtotal + mcAdditionalCharge - mcDiscount) * 0.15m, 2);
        mcGrandTotal = mcSubtotal + mcAdditionalCharge - mcDiscount + mcVat;
    }

    void AddManualChargeLine()
    {
        if (string.IsNullOrWhiteSpace(mcArticle)) return;
        var art = articles.FirstOrDefault(a => a.Name == mcArticle || a.Code == mcArticle);
        var desc = art?.Name ?? mcArticle;
        var unit = mcAmount > 0 ? mcAmount : 948.62m;
        var tax = Math.Round(unit * mcQty * 0.15m, 2);
        mcLines.Add(new ManualChargeLine
        {
            SN = mcLines.Count + 1,
            Description = desc,
            UnitPrice = unit,
            Qty = mcQty,
            Tax = tax,
            TotalPrice = unit * mcQty
        });
        RecalcManualChargeTotals();
        StateHasChanged();
    }

    void RemoveManualChargeLine()
    {
        if (selectedMcLine == null) return;
        mcLines.Remove(selectedMcLine);
        selectedMcLine = null;
        int i = 1;
        foreach (var l in mcLines) l.SN = i++;
        RecalcManualChargeTotals();
        StateHasChanged();
    }

    void SaveManualCharge()
    {
        if (!mcLines.Any())
        {
            ShowInfo("Please add at least one charge line.");
            return;
        }
        pendingBillingAction = "ManualCharge";
        confirmUserPassword = "";
        showConfirmUser = true;
    }

    void ConfirmBillingUser()
    {
        showConfirmUser = false;
        if (pendingBillingAction == "ManualCharge")
        {
            showManualCharge = false;
            ShowInfo("Manual charge is saved!");
        }
        else if (pendingBillingAction == "RoomCharge")
        {
            ShowInfo("Saved successfully!!!");
        }
        else
        {
            ShowInfo("Saved successfully.");
        }
        pendingBillingAction = "";
    }

    void OpenRoomCharge()
    {
        if (selectedReg == null) return;
        rcFrom = businessDate;
        rcTo = selectedReg.Departure;
        roomChargeRows = new List<RoomChargeRow>();
        var d = businessDate.Date;
        var end = selectedReg.Departure.Date;
        if (end < d) end = d;
        int sn = 1;
        for (var day = d; day < end; day = day.AddDays(1))
        {
            roomChargeRows.Add(new RoomChargeRow
            {
                SN = sn++,
                RegistrationNo = selectedReg.Registration,
                Date = day,
                RoomNo = selectedReg.Room?.Replace("#", "") ?? "",
                Consignee = selectedReg.Guest,
                Amount = 1755.01m
            });
        }
        if (!roomChargeRows.Any())
        {
            roomChargeRows.Add(new RoomChargeRow
            {
                SN = 1,
                RegistrationNo = selectedReg.Registration,
                Date = businessDate,
                RoomNo = selectedReg.Room?.Replace("#", "") ?? "",
                Consignee = selectedReg.Guest,
                Amount = 1755.01m
            });
        }
        showRoomCharge = true;
    }

    void PostRoomCharge()
    {
        pendingBillingAction = "RoomCharge";
        confirmUserPassword = "";
        showConfirmUser = true;
    }

    void SetRoomChargeOption(string opt)
    {
        if (selectedReg == null) return;
        if (opt == "Today")
        {
            rcFrom = businessDate;
            rcTo = businessDate.AddDays(1);
        }
        else if (opt == "Entire Stay")
        {
            rcFrom = selectedReg.Arrival;
            rcTo = selectedReg.Departure;
        }
        OpenRoomCharge();
    }

