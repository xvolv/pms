<!-- Room Assignment Confirm -->
<DxPopup @bind-Visible="showRoomAssignConfirm" HeaderText="Room Assignment" Width="380px"
         CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-info-circle" style="font-size:32px; color:#1565c0;"></i>
            <p>Do you want to assign a room to this guest?</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="Yes" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small"
                      Click="ConfirmRoomAssignment" />
            <DxButton Text="No" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small"
                      Click="() => showRoomAssignConfirm = false" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small"
                      Click="() => showRoomAssignConfirm = false" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ========== EXISTING ACTIVITY POPUPS ========== -->

<!-- State Change Confirmation -->
<DxPopup @bind-Visible="showStateConfirm" HeaderText="State Change Confirmation" Width="420px"
         CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-info-circle" style="font-size:32px; color:#1565c0;"></i>
            <p>@stateConfirmMessage</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="Yes" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="ConfirmStateChange" />
            <DxButton Text="No" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="CloseStateConfirm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="CloseStateConfirm" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Error: Arrival not today -->
<DxPopup @bind-Visible="showArrivalError" HeaderText="Error" Width="420px" CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-x-circle" style="font-size:32px; color:#c62828;"></i>
            <p>You can not check in a guest whose arrival date is not equal to today.</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="CloseArrivalError" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Error: Validation -->
<DxPopup @bind-Visible="showValidationError" HeaderText="Error" Width="420px" CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-x-circle" style="font-size:32px; color:#c62828;"></i>
            <p>@validationErrorMessage</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="() => showValidationError = false" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Error: Passed date edit -->
<DxPopup @bind-Visible="showPassedDateError" HeaderText="Error" Width="420px" CloseOnOutsideClick="false" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-x-circle" style="font-size:32px; color:#c62828;"></i>
            <p>You can not edit the passed registration!</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="() => showPassedDateError = false" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- No selection warning -->
<DxPopup @bind-Visible="showNoSelection" HeaderText="Information" Width="360px" CloseOnOutsideClick="true" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-info-circle" style="font-size:28px; color:#1565c0;"></i>
            <p>Please select a registration first.</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="() => showNoSelection = false" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Success / Info -->
<DxPopup @bind-Visible="showSuccessInfo" HeaderText="Information" Width="360px" CloseOnOutsideClick="true" ShowCloseButton="false">
    <BodyContentTemplate>
        <div class="confirm-body">
            <i class="bi bi-info-circle" style="font-size:28px; color:#1565c0;"></i>
            <p>@infoMessage</p>
        </div>
        <div class="confirm-buttons">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="() => showSuccessInfo = false" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- Single Check In -->
<SingleCheckInPopup
