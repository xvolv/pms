            selectedGuestId = existing.Id;
        }
        else
        {
            var newId = savedGuest.Id > 0 ? savedGuest.Id : (guestList.Any() ? guestList.Max(g => g.Id) + 1 : 1);
            var newGuest = new Guest
            {
                Id = newId,
                Title = savedGuest.Title ?? "",
                FirstName = savedGuest.FirstName ?? "",
                MiddleName = savedGuest.MiddleName ?? "",
                LastName = savedGuest.LastName ?? "",
                Identification = savedGuest.PassportNum ?? ""
            };
            guestList.Add(newGuest);
            filteredGuests = guestList.ToList();
            selectedGuestId = newId;
        }

        if (!Guests.Any(g => g.FirstName.Equals(savedGuest.FirstName, StringComparison.OrdinalIgnoreCase)))
        {
            Guests.Add(new GuestItem
            {
                FirstName = savedGuest.FirstName ?? "",
                MiddleName = $"{savedGuest.MiddleName} {savedGuest.LastName}".Trim(),
                Tin = savedGuest.PassportNum ?? ""
            });
        }

        title = savedGuest.Title ?? "";
        nationality = savedGuest.Nationality ?? "";
        passport = savedGuest.PassportNum ?? "";

        var addrParts = new List<string?> { savedGuest.Address1, savedGuest.City, savedGuest.Region, savedGuest.Phone1, savedGuest.Email, savedGuest.Website }
            .Where(s => !string.IsNullOrWhiteSpace(s));
        address = string.Join(", ", addrParts);

        showGuestSearch = false;
        showGuestModal = false;
    }

