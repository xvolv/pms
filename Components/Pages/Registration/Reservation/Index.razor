    void OpenLookup(string type)
    {
        lookupType = type;
        lookupTitle = type;
        lookupSearchText = "";

        currentLookupData = type switch
        {
            "Company" => companyData,
            "Contact" => contactData,
            "Agent"   => agentData,
            "Group"   => groupData,
            "Source"  => sourceData,
            _         => new List<LookupItem>()
        };
        filteredLookupItems = currentLookupData.ToList();
        showLookup = true;
