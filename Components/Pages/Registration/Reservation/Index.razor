@page "/reservation"
@rendermode InteractiveServer
@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration

<PageTitle>Reservation - CNET ERP</PageTitle>

<div class="reservation-page">

    <!-- ===================== TITLE BAR ===================== -->
    <div class="window-title">
        <img src="/cnet logo.jpg" class="title-icon" alt="CNET Logo" />
        <span class="title-text">RESERVATION - @ReservationNo</span>
        <!-- <button class="btn-close-win" @onclick="CloseWindow">×</button> -->
    </div>

    <!-- ===================== COMMAND PANEL ===================== -->
    <RegistrationToolbar ToolbarContext="ToolbarContextType.CommandPanel"
                        OnNew="NewReservation"
                        OnSave="SaveReservation"
                        OnTravelDetail="OpenTravelDetail"
                        OnComments="OpenComments"
                        OnClose="CloseWindow">
        <StateContent>
            <DxComboBox Data="@reservationStates" @bind-Value="selectedState" Width="110px" SizeMode="SizeMode.Small" />
        </StateContent>
    </RegistrationToolbar>

    <!-- ===================== MAIN FORM + RED COMMENT BAR ===================== -->
    <div class="main-area">

       

        <div class="form-body">

            <!-- TOP ROW: Basic Info + Consignee -->
            <div class="top-row">
                <!-- LEFT: Basic Info -->
                <div class="left-middle">
                    <!-- Basic Info -->
                    <fieldset class="section">
                        <legend>Basic Info</legend>
                        <div class="basic-grid">
                            <label>Guest Name</label>
                            <div class="input-with-btn wide">
                                <DxComboBox Data="@guestList"
                                            TextFieldName="FullName"
                                            ValueFieldName="Id"
                                            @bind-Value="selectedGuestId"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                                            NullText=""
                                            Width="100%"
                                            SizeMode="SizeMode.Small"
                                            SelectedItemChanged="OnGuestSelected" />
                                <DxButton IconCssClass="bi bi-plus-lg"
                                          CssClass="circle-btn"
                                          RenderStyle="ButtonRenderStyle.Secondary"
                                          SizeMode="SizeMode.Small"
                                          Click="OpenGuestSearch" />
                            </div>

                            <label>Nationality</label>
                            <DxTextBox @bind-Text="nationality" SizeMode="SizeMode.Small" />
                            <label>Passport</label>
                            <DxTextBox @bind-Text="passport" SizeMode="SizeMode.Small" />

                            <label>Title</label>
                            <DxTextBox @bind-Text="title" SizeMode="SizeMode.Small" />
                            <label>Address</label>
                            <div class="input-with-btn">
                                <DxTextBox @bind-Text="address" SizeMode="SizeMode.Small" />
                                <DxButton Text="A" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
                            </div>
                        </div>
                    </fieldset>
                </div>

                <!-- RIGHT: Consignee -->
                <div class="right-col">
                <fieldset class="section consignee-section">
                    <legend>Consignee</legend>
                    <div class="consignee-grid">
                        <label>Company</label>
                        <div class="input-with-btn">
                            <DxTextBox @bind-Text="company" SizeMode="SizeMode.Small" ReadOnly="true" />
                            <DxButton IconCssClass="bi bi-caret-down-fill"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="@(() => OpenLookup("Company"))" />
                        </div>
                        <label>Agent</label>
                        <div class="input-with-btn">
                            <DxTextBox @bind-Text="agent" SizeMode="SizeMode.Small" ReadOnly="true" />
                            <DxButton IconCssClass="bi bi-caret-down-fill"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="@(() => OpenLookup("Agent"))" />
                        </div>

                        <label>Contact</label>
                        <div class="input-with-btn">
                            <DxTextBox @bind-Text="contact" SizeMode="SizeMode.Small" ReadOnly="true" />
                            <DxButton IconCssClass="bi bi-caret-down-fill"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="@(() => OpenLookup("Contact"))" />
                        </div>
                        <label>Group</label>
                        <div class="input-with-btn">
                            <DxTextBox @bind-Text="group" SizeMode="SizeMode.Small" ReadOnly="true" />
                            <DxButton IconCssClass="bi bi-caret-down-fill"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="@(() => OpenLookup("Group"))" />
                        </div>

                        <label>Source</label>
                        <div class="input-with-btn">
                            <DxTextBox @bind-Text="consigneeSource" SizeMode="SizeMode.Small" ReadOnly="true" />
                            <DxButton IconCssClass="bi bi-caret-down-fill"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="@(() => OpenLookup("Source"))" />
                        </div>
                        <label>Member Type</label>
                        <DxComboBox Data="@memberTypes" @bind-Value="memberType" SizeMode="SizeMode.Small" />
                    </div>
                </fieldset>
                </div>
            </div>

            <!-- Stay + Classification + Rate Adjustment -->
            <div class="bottom-row">

                <!-- Stay Info -->
                <fieldset class="section stay-section">
                    <div class="stay-grid">
                        <label>Arrival</label>
                        <DxDateEdit @bind-Date="arrivalDate" SizeMode="SizeMode.Small" />
                        <label>ETA</label>
                        <DxTimeEdit @bind-Time="eta" SizeMode="SizeMode.Small" />

                        <label>Nights</label>
                        <DxSpinEdit @bind-Value="nights" MinValue="1" MaxValue="365" SizeMode="SizeMode.Small" />
                        <label></label><span></span>

                        <label>Departure</label>
                        <DxDateEdit @bind-Date="departureDate" SizeMode="SizeMode.Small" />
                        <label></label><span></span>

                        <label>Adults</label>
                        <DxSpinEdit @bind-Value="adults" MinValue="1" MaxValue="20" SizeMode="SizeMode.Small" />
                        <label>Child</label>
                        <DxSpinEdit @bind-Value="children" MinValue="0" MaxValue="20" SizeMode="SizeMode.Small" />

                        <label>No . of. Rooms</label>
                        <DxSpinEdit @bind-Value="noOfRooms" MinValue="1" MaxValue="50" SizeMode="SizeMode.Small" />
                        <label></label><span></span>

                        <label>Room Type</label>
                        <DxComboBox Data="@roomTypes" @bind-Value="roomType" SizeMode="SizeMode.Small" />
                        <label>RTC.</label>
                        <DxComboBox Data="@rtcList" @bind-Value="rtc" SizeMode="SizeMode.Small" />

                        <label>Room</label>
                        <div class="input-with-btn">
                            <DxTextBox @bind-Text="room" SizeMode="SizeMode.Small" />
                            <DxButton IconCssClass="bi bi-plus-lg"
                                      CssClass="circle-btn"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="OpenRoomSearch" />
                        </div>
                        <label></label>
                        <div class="checkbox-wrapper">
                            <span>Fixed Rate</span>
                            <DxCheckBox @bind-Checked="fixedRate" SizeMode="SizeMode.Small" />
                        </div>

                        <label>Rate Code</label>
                        <div class="input-with-btn">
                            <DxComboBox Data="@rateCodes" @bind-Value="rateCode" SizeMode="SizeMode.Small" />
                            <DxButton IconCssClass="bi bi-plus-lg"
                                      CssClass="circle-btn"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      SizeMode="SizeMode.Small"
                                      Click="OpenRateSearch" />
                        </div>
                        <label>Packages</label>
                        <DxComboBox Data="@packages" @bind-Value="package" SizeMode="SizeMode.Small" />

                        <label>Rate</label>
                        <DxTextBox @bind-Text="rate" SizeMode="SizeMode.Small" />
                        <label>Total</label>
                        <DxTextBox @bind-Text="total" SizeMode="SizeMode.Small" ReadOnly="true" />
                    </div>
                </fieldset>

                <!-- Classification -->
                <fieldset class="section class-section">
                    <div class="class-grid">
                        <label>Res. Type</label>
                        <DxComboBox Data="@resTypes" @bind-Value="resType" SizeMode="SizeMode.Small" />
                        <label>Market</label>
                        <DxComboBox Data="@markets" @bind-Value="market" SizeMode="SizeMode.Small" />
                        <label>Source</label>
                        <DxComboBox Data="@sources" @bind-Value="source" SizeMode="SizeMode.Small" />
                        <label>Origin</label>
                        <DxComboBox Data="@origins" @bind-Value="origin" SizeMode="SizeMode.Small" />
                        <label>Payment</label>
                        <DxComboBox Data="@payments" @bind-Value="payment" SizeMode="SizeMode.Small" />
                    </div>
                </fieldset>

                <!-- Rate Adjustment -->
                <fieldset class="section rate-section">
                    <legend>Rate Adjustment</legend>
                    
                    <div class="rate-adj-content">
                        <div class="radio-col">
                            <label>
                                <input type="radio" name="rateAdjType" value="Amount"
                                       checked="@(rateAdjType == "Amount")"
                                       @onchange="@(() => rateAdjType = "Amount")" /> Amount
                            </label>
                            <label>
                                <input type="radio" name="rateAdjType" value="Percent"
                                       checked="@(rateAdjType == "Percent")"
                                       @onchange="@(() => rateAdjType = "Percent")" /> Percent
                            </label>
                        </div>
                        <div class="rate-fields">
                            <label>Amount</label>
                            <div class="input-box">
                                <DxTextBox @bind-Text="adjAmount" Enabled="@(rateAdjType == "Amount")" SizeMode="SizeMode.Small" />
                            </div>
                            <label>Percent</label>
                            <div class="input-box">
                                <DxTextBox @bind-Text="adjPercent" Enabled="@(rateAdjType == "Percent")" SizeMode="SizeMode.Small" />
                            </div>
                            <label>Value</label>
                            <DxTextBox @bind-Text="adjValue" SizeMode="SizeMode.Small" />
                        </div>
                    </div>
                    <div class="rate-adj-top">
                        <label>Reason</label>
                        <DxComboBox Data="@reasons" @bind-Value="reason" SizeMode="SizeMode.Small" />
                    </div>
                    <div class="rate-bottom">
                        <label>Specials</label>
                        <DxComboBox Data="@specials" @bind-Value="special" SizeMode="SizeMode.Small" />
                        <label>Voucher #</label>
                        <DxTextBox @bind-Text="voucher" SizeMode="SizeMode.Small" />
                    </div>
                </fieldset>
            </div>
            @if (!string.IsNullOrWhiteSpace(commentText))
        {
            <div class="comment-bar" @onclick="OpenComments" title="Click to view/edit comment">
                <span>Comment</span>
            </div>
        }
        </div>


         
    </div>
    
</div>

<!-- ===================== ROOM SEARCH POPUP ===================== -->
<DxPopup @bind-Visible="showRoomSearch"
         HeaderText="@($"Room Search-{SelectedGuestName}")"
         Width="min(900px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.RoomSearch"
                            OnSelect="SelectRoom"
                            OnClose="() => showRoomSearch = false">
            <CustomContent>
                <span style="margin-left:12px;">Feature</span>
                <DxComboBox Data="@roomFeatures" @bind-Value="selectedFeature" Width="140px" SizeMode="SizeMode.Small" />
                <span style="margin-left:8px;">Room</span>
                <DxTextBox @bind-Text="roomFilter" Width="100px" SizeMode="SizeMode.Small" />
            </CustomContent>
        </RegistrationToolbar>

        <DxTabs @bind-ActiveTabIndex="roomTab">
            <DxTabPage Text="Rooms">
                <div class="grid-scroll-wrap">
                <DxGrid Data="@roomList" KeyFieldName="SN" PageSize="15" ShowPager="false"
                        SizeMode="SizeMode.Small" Height="390px"
                        RowClick="OnRoomRowClick"
                        CustomizeElement="OnRoomCustomizeElement">
                    <Columns>
                        <DxGridDataColumn FieldName="SN" Caption="SN" Width="40px" />
                        <DxGridDataColumn FieldName="Room" Caption="Room" Width="70px" />
                        <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="120px" />
                        <DxGridDataColumn FieldName="HKStatus" Caption="HK Status" Width="90px" />
                        <DxGridDataColumn FieldName="FOStatus" Caption="FO Status" Width="90px" />
                        <DxGridDataColumn FieldName="Floor" Caption="Floor" Width="90px" />
                        <DxGridDataColumn FieldName="Feature" Caption="Feature" />
                        <DxGridDataColumn FieldName="Remark" Caption="Remark" />
                    </Columns>
                </DxGrid>
                </div>
            </DxTabPage>
            <DxTabPage Text="Pseudo Rooms">
                <div style="padding:40px; text-align:center; color:#999;">Pseudo Rooms content</div>
            </DxTabPage>
        </DxTabs>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== RATE SEARCH POPUP ===================== -->
<DxPopup @bind-Visible="showRateSearch"
         HeaderText="@($"Rate Search {rateStartDate:M/d/yyyy} - {rateEndDate:M/d/yyyy}")"
         Width="min(920px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.RateSearch"
                            OnSelect="SelectRate"
                            OnSearch="SearchRates"
                            OnRateInfo="ShowRateInfo"
                            OnClose="() => showRateSearch = false">
            <CustomContent>
                <div class="rate-dates">
                    <label>Start Date</label>
                    <DxDateEdit @bind-Date="rateStartDate" Width="110px" SizeMode="SizeMode.Small" />
                    <label>End Date</label>
                    <DxDateEdit @bind-Date="rateEndDate" Width="110px" SizeMode="SizeMode.Small" />
                </div>

                <div class="rate-type">
                    <label>
                        <input type="radio" name="rateType" checked="@(rateSearchType == "Average")"
                               @onchange="@(() => rateSearchType = "Average")" /> Average Rate
                    </label>
                    <label>
                        <input type="radio" name="rateType" checked="@(rateSearchType == "Total")"
                               @onchange="@(() => rateSearchType = "Total")" /> Total Rate
                    </label>
                </div>

                <div>
                    <label>Rate Code</label>
                    <DxTextBox @bind-Text="rateSearchCode" Width="100px" SizeMode="SizeMode.Small" />
                </div>

                <div class="rate-status">
                    <label>
                        <input type="radio" name="rateStatus" checked="@(rateStatus == "Closed")"
                               @onchange="@(() => rateStatus = "Closed")" /> Closed
                    </label>
                    <label>
                        <input type="radio" name="rateStatus" checked="@(rateStatus == "Negotiated")"
                               @onchange="@(() => rateStatus = "Negotiated")" /> Negotiated
                    </label>
                    <label>
                        <input type="radio" name="rateStatus" checked="@(rateStatus == "DayUse")"
                               @onchange="@(() => rateStatus = "DayUse")" /> Day Use
                    </label>
                </div>
            </CustomContent>
        </RegistrationToolbar>

        <div class="grid-scroll-wrap">
        <DxGrid Data="@rateSearchRows" KeyFieldName="Name" PageSize="10" ShowPager="false"
                SizeMode="SizeMode.Small" Height="340px"
                RowClick="OnRateRowClick"
                CustomizeElement="OnRateCustomizeElement">
            <Columns>
                <DxGridDataColumn FieldName="Name" Caption="Name" Width="160px" />
                <DxGridDataColumn FieldName="StandardRoom" Caption="Standard Room" />
                <DxGridDataColumn FieldName="Executive" Caption="Executive" />
                <DxGridDataColumn FieldName="PseudoRooms" Caption="Pseudo Rooms" />
            </Columns>
        </DxGrid>
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== LOOKUP POPUP ===================== -->
<DxPopup @bind-Visible="showLookup"
         HeaderText="@lookupTitle"
         Width="min(620px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.Lookup">
            <CustomContent>
                <DxTextBox @bind-Text="lookupSearchText" NullText="" Width="260px" SizeMode="SizeMode.Small"
                           BindValueMode="BindValueMode.OnInput" />
                <DxButton Text="Find" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="FilterLookup" />
            </CustomContent>
        </RegistrationToolbar>

        <div class="grid-scroll-wrap">
        <DxGrid Data="@filteredLookupItems" KeyFieldName="Code" PageSize="10" ShowPager="true"
                SizeMode="SizeMode.Small" RowClick="OnLookupRowClick" Height="310px">
            <Columns>
                <DxGridDataColumn FieldName="Code" Caption="code" Width="120px" />
                <DxGridDataColumn FieldName="Name" Caption="name" />
                <DxGridDataColumn FieldName="IdNumber" Caption="id Number" Width="130px" />
            </Columns>
        </DxGrid>
        </div>

        <div class="lookup-footer">
            <DxButton Text="New" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" />
            <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="ClearLookupSelection" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== TRAVEL DETAIL POPUP ===================== -->
<DxPopup @bind-Visible="showTravelDetail"
         HeaderText="Travel Detail"
         Width="min(550px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.TravelDetail"
                            OnReset="ResetTravelDetail"
                            OnSave="SaveTravelDetail"
                            OnClose="() => showTravelDetail = false" />

        <DxTabs @bind-ActiveTabIndex="travelTab">
            <DxTabPage Text="Arrival">
                <div class="travel-form">
                    <label>Pick Up Required</label>
                    <DxComboBox Data="@yesNo" @bind-Value="pickupRequired" SizeMode="SizeMode.Small" />
                    <label>Transportation Type</label>
                    <DxComboBox Data="@transportTypes" @bind-Value="arrivalTransportType" SizeMode="SizeMode.Small" />
                    <label>Station Code</label>
                    <DxTextBox @bind-Text="arrivalStationCode" SizeMode="SizeMode.Small" />
                    <label>Carrier Code</label>
                    <DxComboBox Data="@carrierCodes" @bind-Value="arrivalCarrierCode" SizeMode="SizeMode.Small" />
                    <label>Transportation #</label>
                    <DxTextBox @bind-Text="arrivalTransportNo" SizeMode="SizeMode.Small" />
                    <label>Arrival Date</label>
                    <DxDateEdit @bind-Date="arrivalTravelDate" SizeMode="SizeMode.Small" />
                    <label>Pick Up Time</label>
                    <DxTimeEdit @bind-Time="pickupTime" SizeMode="SizeMode.Small" />
                </div>
            </DxTabPage>
            <DxTabPage Text="Departure">
                <div class="travel-form">
                    <label>Drop Off Required</label>
                    <DxComboBox Data="@yesNo" @bind-Value="dropoffRequired" SizeMode="SizeMode.Small" />
                    <label>Transportation Type</label>
                    <DxComboBox Data="@transportTypes" @bind-Value="departureTransportType" SizeMode="SizeMode.Small" />
                    <label>Station Code</label>
                    <DxTextBox @bind-Text="departureStationCode" SizeMode="SizeMode.Small" />
                    <label>Carrier Code</label>
                    <DxComboBox Data="@carrierCodes" @bind-Value="departureCarrierCode" SizeMode="SizeMode.Small" />
                    <label>Departure Date</label>
                    <DxDateEdit @bind-Date="departureTravelDate" SizeMode="SizeMode.Small" />
                    <label>Transportation #</label>
                    <DxTextBox @bind-Text="departureTransportNo" SizeMode="SizeMode.Small" />
                    <label>Drop Off Time</label>
                    <DxTimeEdit @bind-Time="dropoffTime" SizeMode="SizeMode.Small" />
                </div>
            </DxTabPage>
        </DxTabs>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== COMMENTS POPUP ===================== -->
<DxPopup @bind-Visible="showComments"
         HeaderText="Comments"
         Width="min(600px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.Comments"
                            OnClear="() => commentText = string.Empty"
                            OnSave="SaveComment"
                            OnClose="() => showComments = false" />
        <div style="padding: 10px;">
            <DxMemo @bind-Text="commentText" Rows="14" Width="100%" />
        </div>
    </BodyContentTemplate>
</DxPopup>

<!-- ===================== GUEST SEARCH POPUP ===================== -->
<DxPopup @bind-Visible="showGuestSearch"
         HeaderText="Guest Search"
         Width="min(720px, 95vw)"
         CloseOnOutsideClick="false" ShowCloseButton="true">
    <BodyContentTemplate>
        <RegistrationToolbar ToolbarContext="ToolbarContextType.GuestSearch">
            <CustomContent>
                <DxTextBox @bind-Text="guestSearchText" Width="280px" SizeMode="SizeMode.Small"
                           BindValueMode="BindValueMode.OnInput" />
                <DxButton Text="Find" RenderStyle="ButtonRenderStyle.Primary" SizeMode="SizeMode.Small" Click="FilterGuests" />
                <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small" Click="ClearGuestFilter" />
            </CustomContent>
        </RegistrationToolbar>
        <div class="grid-scroll-wrap">
        <DxGrid Data="@filteredGuests" KeyFieldName="Id" PageSize="12" ShowPager="true"
                SizeMode="SizeMode.Small" RowClick="OnGuestRowClick" Height="360px">
            <Columns>
                <DxGridDataColumn FieldName="Title" Caption="Title" Width="70px" />
                <DxGridDataColumn FieldName="FirstName" Caption="First Name" />
                <DxGridDataColumn FieldName="MiddleName" Caption="Middle Name" />
                <DxGridDataColumn FieldName="LastName" Caption="Last Name" />
                <DxGridDataColumn FieldName="Identification" Caption="Identification" Width="120px" />
            </Columns>
        </DxGrid>
        </div>
    </BodyContentTemplate>
</DxPopup>

<style>
    * {
        box-sizing: border-box;
    }

    .reservation-page {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #f0f2f5;
        min-height: 100vh;
        font-size: 12.5px;
        padding: 0 20px;
        max-width: 100%;
        overflow-x: hidden;
    }

    .window-title {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        background: #fff;
        border-bottom: 1px solid #d0d5dd;
        flex-wrap: wrap;
    }

    .title-icon {
        width: 32px;
        height: 32px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .title-text {
        font-size: 13px;
        font-weight: 500;
        color: #1565c0;
        word-break: break-word;
    }

    .btn-close-win {
        margin-left: auto;
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: #666;
    }

    .command-panel {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 10px;
        background: #fff;
        border-bottom: 1px solid #d0d5dd;
        flex-wrap: wrap;
    }

    .cmd-group {
        display: flex;
        gap: 3px;
        align-items: center;
        flex-wrap: wrap;
    }

    .state-group {
        border-left: 1px solid #ddd;
        border-right: 1px solid #ddd;
        padding: 0 10px;
    }

    .state-label {
        font-size: 12px;
        color: #555;
        margin-right: 5px;
    }

    /* ---------- Responsive layout core ---------- */
    .main-area {
        display: flex;
        min-height: 520px;
        max-width: 100%;
    }

    .comment-bar {
        width: 100px;
        height: 150px;
        background: red;
        color: black;
        text-orientation: mixed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        font-size: 17px;
        letter-spacing: 1px;
        cursor: pointer;
        user-select: none;
        flex-shrink: 0;
    }

    .comment-bar:hover {
        background: #c62828;
    }

    .form-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 8px;
        min-width: 0;
    }

    .top-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        width: 100%;
    }

    .left-middle {
        flex: 1 1 320px;
        min-width: 280px;
    }

    .right-col {
        flex: 1 1 320px;
        min-width: 280px;
    }

    .section {
        background: #fff;
        border: 1px solid #c8cdd4;
        border-radius: 2px;
        padding: 8px 10px 10px;
        margin: 0;
        min-width: 0;
    }

    .section legend {
        font-size: 12.5px;
        font-weight: 600;
        color: #1565c0;
        padding: 0 4px;
    }

    .basic-grid {
        display: grid;
        grid-template-columns: 90px 1fr 80px 1fr;
        gap: 5px 8px;
        align-items: center;
    }

    .basic-grid label {
        text-align: right;
        color: #555;
    }

    .basic-grid .wide {
        grid-column: span 3;
    }

    .bottom-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        width: 100%;
    }

    .stay-section {
        flex: 2 1 420px;
        min-width: 300px;
    }

    .class-section {
