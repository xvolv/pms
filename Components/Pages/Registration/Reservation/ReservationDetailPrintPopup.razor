@using DevExpress.Blazor
@using ERP.V7.WebPMS.Components.Pages.Registration.CheckIn

<DevExpressPrintPreview
    @bind-Visible="Visible"
    Title="Print Dialog"
    DocumentTitle="@($"Reservation Detail - {RegistrationNo}")"
    PrintElementId="reservation-detail-print-area">

    <!-- Title Header -->
    <div class="dx-report-header">
        <div class="dx-report-hotel-title">@HotelName</div>
        <div class="dx-report-doc-title">Reservation Detail - @RegistrationNo</div>
    </div>

    <div class="dx-report-meta-row">
        <span></span>
        <span>Date: @(PrintDate.ToString("M/d/yyyy"))</span>
    </div>

    <!-- Print Table with Master and Sub-rows -->
    <table class="dx-report-table">
        <thead>
            <tr>
                <th style="width:75px;">Date</th>
                <th style="width:65px;">Week Day</th>
                <th style="width:40px; text-align:center;">Adult</th>
                <th style="width:40px; text-align:center;">Child</th>
                <th style="width:65px; text-align:center;">Room Count</th>
                <th style="width:80px;">Room Type</th>
                <th style="width:80px;">Actual RTC</th>
                <th style="width:45px; text-align:center;">Room</th>
                <th style="width:60px;">Rate</th>
                <th style="width:75px; text-align:right;">Rate Amount</th>
                <th style="width:95px;">Market</th>
                <th style="width:95px;">Source</th>
                <th style="width:50px; text-align:center;">Is Fixed</th>
            </tr>
        </thead>
        <tbody>
            @if (Rows != null && Rows.Any())
            {
                @foreach (var r in Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("M/d/yyyy")</td>
                        <td>@r.WeekDay</td>
                        <td style="text-align:center;">@r.Adult</td>
                        <td style="text-align:center;">@r.Child</td>
                        <td style="text-align:center;">@r.RoomCount</td>
                        <td>@r.RoomType</td>
                        <td>@r.ActualRTC</td>
                        <td style="text-align:center;">@r.Room</td>
                        <td>@r.Rate</td>
                        <td style="text-align:right;">@r.RateAmount.ToString("N2")</td>
                        <td>@r.Market</td>
                        <td>@r.Source</td>
                        <td style="text-align:center;">
                            <input type="checkbox" checked="@r.IsFixed" disabled />
                        </td>
                    </tr>

                    @if (r.Packages != null && r.Packages.Any())
                    {
                        <tr style="background:#e0e0e0; font-weight:bold;">
                            <th colspan="4" style="text-align:left; padding-left:12px;">Package Header Description</th>
                            <th colspan="2" style="text-align:center;">Id</th>
                            <th colspan="2" style="text-align:left; padding-left:8px;">Registration Detail</th>
                            <th style="text-align:left;">Package</th>
                            <th style="text-align:right;">Amount</th>
                            <th colspan="3" style="text-align:left; padding-left:8px;">Remark</th>
                        </tr>

                        @foreach (var pkg in r.Packages)
                        {
                            <tr style="background:#fafafa;">
                                <td colspan="4" style="padding-left:12px;">@(string.IsNullOrEmpty(pkg.PackageHeaderDescription) ? pkg.Package : pkg.PackageHeaderDescription)</td>
                                <td colspan="2" style="text-align:center;">@(string.IsNullOrEmpty(pkg.Id) ? "1" : pkg.Id)</td>
                                <td colspan="2" style="padding-left:8px;">@(string.IsNullOrEmpty(pkg.RegistrationDetail) ? "Standard" : pkg.RegistrationDetail)</td>
                                <td>@pkg.Package</td>
                                <td style="text-align:right;">@pkg.Amount.ToString("N2")</td>
                                <td colspan="3" style="padding-left:8px;">@pkg.Remark</td>
                            </tr>
                        }
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="13" style="text-align:center; padding:10px; color:#888;">No reservation detail records found.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Signatures Row (4 columns) -->
    <div class="dx-report-signatures">
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Prepared By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Checked By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Approved By</div>
        </div>
        <div class="dx-report-sig-col">
            <div class="dx-report-sig-line"></div>
            <div class="dx-report-sig-text">Authorized By</div>
        </div>
    </div>

    <!-- Footer Left -->
    <div class="dx-report-footer">
        <span>ERP System</span>
    </div>
</DevExpressPrintPreview>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string HotelName { get; set; } = "TEST HOTEL";
    [Parameter] public string RegistrationNo { get; set; } = "REG-00004-26";
    [Parameter] public DateTime PrintDate { get; set; } = DateTime.Today;
    [Parameter] public List<DailyDetailRow> Rows { get; set; } = new();
}
