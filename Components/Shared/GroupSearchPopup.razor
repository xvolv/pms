@using DevExpress.Blazor
@using ERP.V7.WebPMS.Services.DocumentBrowser
@using CNET_V7_Domain.Misc
@inject IDocumentBrowserService DocumentBrowserService

<DxPopup Visible="@Visible"
         VisibleChanged="@HandleVisibleChanged"
         HeaderText="Group Search"
         Width="520px"
         CloseOnOutsideClick="true"
         ShowCloseButton="true"
         CloseOnEscape="true"
         CssClass="global-lookup-popup">
    <BodyContentTemplate>
        <div class="lookup-modal-container">
            <div class="lookup-modal-searchrow">
                <input class="lookup-modal-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search group..." />
                <button type="button" class="lookup-modal-find-btn">Find</button>
            </div>
            <div class="lookup-modal-gridwrap">
                @if (IsLoading && DataList.Count == 0)
                {
                    <div style="padding: 24px; text-align: center; color: #666; font-size: 13px;">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span> Loading groups...
                    </div>
                }
                else
                {
                    <DxGrid @ref="gridRef"
                            Data="@FilteredGroups"
                            CssClass="lookup-modal-grid"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            CustomizeElement="OnCustomizeElement"
                            RowClick="OnRowClick"
                            RowDoubleClick="OnRowDoubleClick">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(GroupItem.Code)" Caption="Code" Width="100px" />
                            <DxGridDataColumn FieldName="@nameof(GroupItem.Name)" Caption="Group Name" Width="180px" />
                            <DxGridDataColumn FieldName="@nameof(GroupItem.Description)" Caption="Description" Width="140px" />
                        </Columns>
                    </DxGrid>
                }
            </div>
            <div class="lookup-modal-footer">
                <button type="button" class="lookup-modal-btn lookup-modal-btn-select" @onclick="HandleSelect">Select</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleAddNew">Add New</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClear">Clear</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClose">Close</button>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public List<GroupItem>? Groups { get; set; }
    [Parameter] public GroupItem? SelectedGroup { get; set; }
    [Parameter] public EventCallback<GroupItem?> SelectedGroupChanged { get; set; }
    [Parameter] public EventCallback<GroupItem> OnSelect { get; set; }
    [Parameter] public EventCallback OnAddNew { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    string SearchText { get; set; } = "";
    GroupItem? selectedRow;
    IGrid? gridRef;
    List<GroupItem> ApiGroups = new();
    bool IsLoading = false;
    bool hasLoaded = false;

    List<GroupItem> DataList => (ApiGroups.Count > 0) ? ApiGroups : (Groups ?? new());

    IEnumerable<GroupItem> FilteredGroups =>
        string.IsNullOrWhiteSpace(SearchText)
            ? DataList
            : DataList.Where(g => (g.Code?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.Name?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.Description?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadApiDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedGroup != null)
        {
            selectedRow = SelectedGroup;
        }

        if (Visible && !hasLoaded)
        {
            await LoadApiDataAsync();
        }
    }

    async Task LoadApiDataAsync()
    {
        if (hasLoaded && ApiGroups.Count > 0) return;

        try
        {
            IsLoading = true;
            var res = await DocumentBrowserService.GetConsigneeHeaderFormattedViewAsync(new ConsigneeFilterCriteria
            {
                GslType = 41,
                FieldFormatType = 1617
            });

            if (res != null && res.Count > 0)
            {
                ApiGroups = res.Select(dto => new GroupItem
                {
                    Code = dto.Code ?? "",
                    Name = !string.IsNullOrWhiteSpace(dto.FullName) ? dto.FullName : (dto.FirstName ?? ""),
                    Description = !string.IsNullOrWhiteSpace(dto.ChildPreferenceDescrption) 
                        ? dto.ChildPreferenceDescrption 
                        : (dto.BusinessTypeDesc ?? "")
                }).ToList();
                hasLoaded = true;
            }
        }
        catch
        {
            // fallback gracefully
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    void OnRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as GroupItem;
        if (item != null)
        {
            selectedRow = item;
        }
    }

    async Task OnRowDoubleClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as GroupItem;
        if (item != null)
        {
            selectedRow = item;
            await HandleSelect();
        }
    }

    void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && selectedRow != null)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as GroupItem;
            if (item != null && item.Name == selectedRow.Name)
            {
                e.CssClass = "lookup-modal-row-selected";
            }
        }
    }

    async Task HandleSelect()
    {
        if (selectedRow != null)
        {
            await SelectedGroupChanged.InvokeAsync(selectedRow);
            await OnSelect.InvokeAsync(selectedRow);
        }
        await HandleClose();
    }

    async Task HandleAddNew()
    {
        await OnAddNew.InvokeAsync();
    }

    async Task HandleClear()
    {
        selectedRow = null;
        await SelectedGroupChanged.InvokeAsync(null);
        await OnClear.InvokeAsync();
        await HandleClose();
    }

    async Task HandleClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    async Task HandleVisibleChanged(bool visible)
    {
        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }
}
