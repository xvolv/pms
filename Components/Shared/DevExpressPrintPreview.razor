    private void SetColorMode(string mode)
    {
        switch (mode.ToLowerInvariant())
        {
            case "grayscale":
                isGrayscale = true;
                colorModeClass = "grayscale-mode";
                break;
            case "sepia":
                isGrayscale = false;
                colorModeClass = "sepia-mode";
                break;
            case "contrast":
                isGrayscale = false;
                colorModeClass = "contrast-mode";
                break;
            case "invert":
                isGrayscale = false;
                colorModeClass = "invert-mode";
                break;
            case "color":
            default:
                isGrayscale = false;
                colorModeClass = "";
                break;
        }
        CloseAllMenus();
