            showScaleMenu = !showScaleMenu;
            showLayoutMenu = false;
            showColorMenu = false;
            showExportMenu = false;
            showEmailMenu = false;
        }
        else if (subMenu == "layout")
        {
            showLayoutMenu = !showLayoutMenu;
