    private void CancelPageSetup()
    {
        tempLandscape = isLandscape;
        tempPaperSize = appliedPaperSize;
        tempMarginLeft = appliedMarginLeft;
        tempMarginRight = appliedMarginRight;
        tempMarginTop = appliedMarginTop;
        tempMarginBottom = appliedMarginBottom;
        UpdateDimensionsDisplay();
        showPageSetupModal = false;
    }

