    private void UpdateDimensionsDisplay()
    {
        double baseW = 8.27;
        double baseH = 11.69;
        switch (tempPaperSize.ToUpperInvariant())
        {
            case "LETTER": baseW = 8.5; baseH = 11.0; break;
            case "LEGAL": baseW = 8.5; baseH = 14.0; break;
            case "EXECUTIVE": baseW = 7.25; baseH = 10.5; break;
            case "A3": baseW = 11.69; baseH = 16.54; break;
            case "A5": baseW = 5.83; baseH = 8.27; break;
            case "B5": baseW = 6.93; baseH = 9.84; break;
            case "A4":
            default: baseW = 8.27; baseH = 11.69; break;
        }

        double w = tempLandscape ? baseH : baseW;
        double h = tempLandscape ? baseW : baseH;

        if (tempUnit == "Millimeter")
        {
            tempWidthDisplay = $"{(w * 25.4):0.##} mm";
            tempHeightDisplay = $"{(h * 25.4):0.##} mm";
        }
        else if (tempUnit == "Centimeter")
        {
            tempWidthDisplay = $"{(w * 2.54):0.##} cm";
            tempHeightDisplay = $"{(h * 2.54):0.##} cm";
        }
        else
        {
            tempWidthDisplay = $"{w:0.##} \"";
            tempHeightDisplay = $"{h:0.##} \"";
        }
    }

    private void ApplyPageSetup()
    {
        isLandscape = tempLandscape;
        appliedPaperSize = tempPaperSize;
        appliedMarginLeft = tempMarginLeft;
        appliedMarginRight = tempMarginRight;
