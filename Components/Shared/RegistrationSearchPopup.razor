@using DevExpress.Blazor

<DxPopup Visible="@Visible"
         VisibleChanged="@HandleVisibleChanged"
         HeaderText="Registrations Search"
         Width="550px"
         CloseOnOutsideClick="true"
         ShowCloseButton="true"
         CloseOnEscape="true"
         CssClass="global-lookup-popup">
    <BodyContentTemplate>
        <div class="lookup-modal-container">
            <div class="lookup-modal-searchrow">
                <input class="lookup-modal-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search registration code, guest or room..." />
                <button type="button" class="lookup-modal-find-btn">Find</button>
            </div>
            <div class="lookup-modal-gridwrap">
                <DxGrid @ref="gridRef"
                        Data="@FilteredItems"
                        CssClass="lookup-modal-grid"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        CustomizeElement="OnCustomizeElement"
                        RowClick="OnRowClick"
                        RowDoubleClick="OnRowDoubleClick">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(RegistrationLookupItem.Code)" Caption="Code" Width="120px" />
                        <DxGridDataColumn FieldName="@nameof(RegistrationLookupItem.Guest)" Caption="Guest" Width="140px" />
                        <DxGridDataColumn FieldName="@nameof(RegistrationLookupItem.RoomNumber)" Caption="Room Number" Width="110px" />
                        <DxGridDataColumn FieldName="@nameof(RegistrationLookupItem.RoomType)" Caption="Room Type" Width="110px" />
                    </Columns>
                </DxGrid>
            </div>
            <div class="lookup-modal-footer">
                <button type="button" class="lookup-modal-btn lookup-modal-btn-select" @onclick="HandleSelect">Select</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClear">Clear</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClose">Close</button>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public List<RegistrationLookupItem>? Items { get; set; }
    [Parameter] public RegistrationLookupItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<RegistrationLookupItem?> SelectedItemChanged { get; set; }
    [Parameter] public EventCallback<RegistrationLookupItem> OnSelect { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    string SearchText { get; set; } = "";
    RegistrationLookupItem? selectedRow;
    IGrid? gridRef;

    List<RegistrationLookupItem> DefaultItems { get; } = new()
    {
        new() { Code = "REG-00000-26", Guest = "JANE DOE", RoomNumber = "101", RoomType = "Standard" },
        new() { Code = "REG-00001-26", Guest = "JANE DOE", RoomNumber = "205", RoomType = "Delux" },
        new() { Code = "REG-00002-26", Guest = "JANE DOE", RoomNumber = "207", RoomType = "Delux" },
        new() { Code = "REG-00003-26", Guest = "JANE DOE", RoomNumber = "208", RoomType = "Delux" },
        new() { Code = "REG-00004-26", Guest = "JANE DOE", RoomNumber = "209", RoomType = "Delux" },
        new() { Code = "REG-00005-26", Guest = "JANE DOE", RoomNumber = "210", RoomType = "Delux" },
        new() { Code = "REG-00006-26", Guest = "JANE DOE", RoomNumber = "102", RoomType = "Standard" },
        new() { Code = "REG-00007-26", Guest = "JANE DOE", RoomNumber = "103", RoomType = "Standard" }
    };

    List<RegistrationLookupItem> DataList => (Items != null && Items.Count > 0) ? Items : DefaultItems;

    IEnumerable<RegistrationLookupItem> FilteredItems =>
        string.IsNullOrWhiteSpace(SearchText)
            ? DataList
            : DataList.Where(i => (i.Code?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (i.Guest?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (i.RoomNumber?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (i.RoomType?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnParametersSet()
    {
        if (SelectedItem != null)
        {
            selectedRow = SelectedItem;
        }
    }

    void OnRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as RegistrationLookupItem;
        if (item != null)
        {
            selectedRow = item;
        }
    }

    async Task OnRowDoubleClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as RegistrationLookupItem;
        if (item != null)
        {
            selectedRow = item;
            await HandleSelect();
        }
    }

    void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && selectedRow != null)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as RegistrationLookupItem;
            if (item != null && item.Code == selectedRow.Code)
            {
                e.CssClass = "lookup-modal-row-selected";
            }
        }
    }

    async Task HandleSelect()
    {
        if (selectedRow != null)
        {
            await SelectedItemChanged.InvokeAsync(selectedRow);
            await OnSelect.InvokeAsync(selectedRow);
        }
        await HandleClose();
    }

    async Task HandleClear()
    {
        selectedRow = null;
        await SelectedItemChanged.InvokeAsync(null);
        await OnClear.InvokeAsync();
        await HandleClose();
    }

    async Task HandleClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    async Task HandleVisibleChanged(bool visible)
    {
        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }
}
