@using DevExpress.Blazor
@using ERP.V7.WebPMS.Services.DocumentBrowser
@using CNET_V7_Domain.Misc
@inject IDocumentBrowserService DocumentBrowserService

<DxPopup Visible="@Visible"
         VisibleChanged="@HandleVisibleChanged"
         HeaderText="Guest Search"
         Width="660px"
         CloseOnOutsideClick="true"
         ShowCloseButton="true"
         CloseOnEscape="true"
         CssClass="global-lookup-popup">
    <BodyContentTemplate>
        <div class="lookup-modal-container">
            <div class="lookup-modal-searchrow">
                <input class="lookup-modal-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search guest..." />
                <button type="button" class="lookup-modal-find-btn">Find</button>
            </div>
            <div class="lookup-modal-gridwrap">
                @if (IsLoading && DataList.Count == 0)
                {
                    <div style="padding: 24px; text-align: center; color: #666; font-size: 13px;">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span> Loading guests...
                    </div>
                }
                else
                {
                    <DxGrid @ref="gridRef"
                            Data="@FilteredGuests"
                            CssClass="lookup-modal-grid"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            CustomizeElement="OnCustomizeElement"
                            RowClick="OnRowClick"
                            RowDoubleClick="OnRowDoubleClick">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(GuestItem.Code)" Caption="Code" Width="105px" />
                            <DxGridDataColumn FieldName="@nameof(GuestItem.FirstName)" Caption="First Name" Width="125px" />
                            <DxGridDataColumn FieldName="@nameof(GuestItem.MiddleName)" Caption="Middle Name" Width="125px" />
                            <DxGridDataColumn FieldName="@nameof(GuestItem.LastName)" Caption="Last Name" Width="135px" />
                            <DxGridDataColumn FieldName="@nameof(GuestItem.IdNumber)" Caption="Id Number" Width="120px" />
                        </Columns>
                    </DxGrid>
                }
            </div>
            <div class="lookup-modal-footer">
                <button type="button" class="lookup-modal-btn lookup-modal-btn-select" @onclick="HandleSelect">Select</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleAddNew">Add New</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClear">Clear</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClose">Close</button>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public List<GuestItem>? Guests { get; set; }
    [Parameter] public GuestItem? SelectedGuest { get; set; }
    [Parameter] public EventCallback<GuestItem?> SelectedGuestChanged { get; set; }
    [Parameter] public EventCallback<GuestItem> OnSelect { get; set; }
    [Parameter] public EventCallback OnAddNew { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    string SearchText { get; set; } = "";
    GuestItem? selectedRow;
    IGrid? gridRef;
    List<GuestItem> ApiGuests = new();
    bool IsLoading = false;
    bool hasLoaded = false;

    List<GuestItem> DataList => (ApiGuests.Count > 0) ? ApiGuests : (Guests ?? new());

    IEnumerable<GuestItem> FilteredGuests =>
        string.IsNullOrWhiteSpace(SearchText)
            ? DataList
            : DataList.Where(g => (g.Code?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.FirstName?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.MiddleName?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.LastName?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.IdNumber?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (g.Tin?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadApiDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedGuest != null)
        {
            selectedRow = SelectedGuest;
        }

        if (Visible && !hasLoaded)
        {
            await LoadApiDataAsync();
        }
    }

    async Task LoadApiDataAsync()
    {
        if (hasLoaded && ApiGuests.Count > 0) return;

        try
        {
            IsLoading = true;
            var res = await DocumentBrowserService.GetConsigneeHeaderFormattedViewAsync(new ConsigneeFilterCriteria
            {
                GslType = 27,
                FieldFormatType = 1617
            });

            if (res != null && res.Count > 0)
            {
                ApiGuests = res.Select(dto =>
                {
                    var names = (dto.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var fName = !string.IsNullOrWhiteSpace(dto.FirstName) ? dto.FirstName : (names.Length > 0 ? names[0] : "");
                    var mName = names.Length > 2 ? names[1] : (names.Length == 2 ? names[1] : "");
                    var lName = names.Length > 2 ? string.Join(" ", names.Skip(2)) : "";

                    return new GuestItem
                    {
                        Id = dto.Id,
                        Code = dto.Code ?? "",
                        FirstName = fName,
                        MiddleName = mName,
                        LastName = lName,
                        Tin = dto.Tin ?? "",
                        IdNumber = !string.IsNullOrWhiteSpace(dto.Tin) ? dto.Tin : (dto.NationalId ?? ""),
                        Title = dto.Title.HasValue ? $"Title {dto.Title.Value}" : "Ato",
                        Nationality = !string.IsNullOrWhiteSpace(dto.Nationality) ? dto.Nationality : "Ethiopian"
                    };
                }).ToList();
                hasLoaded = true;
            }
        }
        catch
        {
            // fallback gracefully
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    void OnRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as GuestItem;
        if (item != null)
        {
            selectedRow = item;
        }
    }

    async Task OnRowDoubleClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as GuestItem;
        if (item != null)
        {
            selectedRow = item;
            await HandleSelect();
        }
    }

    void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && selectedRow != null)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as GuestItem;
            if (item != null && item.FirstName == selectedRow.FirstName && item.MiddleName == selectedRow.MiddleName)
            {
                e.CssClass = "lookup-modal-row-selected";
            }
        }
    }

    async Task HandleSelect()
    {
        if (selectedRow != null)
        {
            await SelectedGuestChanged.InvokeAsync(selectedRow);
            await OnSelect.InvokeAsync(selectedRow);
        }
        await HandleClose();
    }

    async Task HandleAddNew()
    {
        await OnAddNew.InvokeAsync();
    }

    async Task HandleClear()
    {
        selectedRow = null;
        await SelectedGuestChanged.InvokeAsync(null);
        await OnClear.InvokeAsync();
        await HandleClose();
    }

    async Task HandleClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    async Task HandleVisibleChanged(bool visible)
    {
        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }
}
