@using DevExpress.Blazor

<DxPopup @bind-Visible="Visible" HeaderText="Room Search" Width="min(950px, 95vw)" CloseOnOutsideClick="false"
         ShowCloseButton="true" CssClass="global-room-search-popup">
    <BodyContentTemplate>
        <div class="rs-container">

            @* ---------------- TOP TOOLBAR ---------------- *@
            <div class="rs-toolbar">

                <!-- SELECT BUTTON GROUP -->
                <div class="rs-btn-group" @onclick="HandleSelect">
                    <div class="rs-btn-content">
                        <i class="bi bi-check-circle-fill rs-icon-select"></i>
                        <span class="rs-btn-text">Select</span>
                    </div>
                </div>

                <!-- FILTER INPUTS GROUP -->
                <div class="rs-filter-group">
                    <div class="rs-filter-col">
                        <div class="rs-field-row">
                            <label class="rs-label">Feature</label>
                            <DxComboBox CssClass="erp-combobox" Data="@roomFeatures" @bind-Value="selectedFeature"
                                        Width="150px" SizeMode="SizeMode.Small" />
                        </div>
                        <div class="rs-field-row">
                            <label class="rs-label">Room Type</label>
                            <DxComboBox CssClass="erp-combobox" Data="@roomTypes" @bind-Value="selectedRoomType"
                                        Width="150px" SizeMode="SizeMode.Small" />
                        </div>
                    </div>

                    <div class="rs-vsep"></div>

                    <div class="rs-filter-col rs-center-col">
                        <div class="rs-field-row">
                            <label class="rs-label">Room</label>
                            <DxTextBox @bind-Text="roomFilter" Width="110px" SizeMode="SizeMode.Small"
                                       BindValueMode="BindValueMode.OnInput" />
                        </div>
                    </div>
                </div>

                <!-- CLOSE BUTTON GROUP -->
                <div class="rs-btn-group" @onclick="HandleClose">
                    <div class="rs-btn-content">
                        <i class="bi bi-x-square-fill rs-icon-close"></i>
                        <span class="rs-btn-text">Close</span>
                    </div>
                </div>

            </div>

            @* ---------------- TABS + GRID ---------------- *@
            <DxTabs @bind-ActiveTabIndex="roomTab" CssClass="rs-tabs">
                <DxTabPage Text="Rooms">
                    <div class="grid-scroll-wrap">
                        <DxGrid Data="@FilteredRooms" KeyFieldName="SN" PageSize="20" ShowPager="false"
                                SizeMode="SizeMode.Small" Height="380px" RowClick="OnRoomRowClick"
                                CustomizeElement="OnRoomCustomizeElement" CssClass="rs-grid">
                            <Columns>
                                @if (MultiSelect)
                                {
                                    <DxGridDataColumn Width="45px" TextAlignment="GridTextAlignment.Center">
                                        <HeaderCaptionTemplate Context="headerContext">
                                            <input type="checkbox" checked="@IsAllSelected()" @onchange="ToggleSelectAll"
                                                   style="cursor:pointer;" />
                                        </HeaderCaptionTemplate>
                                        <CellDisplayTemplate Context="roomContext">
                                            @{
                                                var room = (RoomItem)roomContext.DataItem;
                                                bool isDirty = room.HKStatus.Equals("Dirty",
                                        StringComparison.OrdinalIgnoreCase);
                                                bool isChecked = IsRoomSelected(room);
                                            }
                                            <input type="checkbox" checked="@isChecked" disabled="@isDirty"
                                                   @onchange="@(e => ToggleRoomSelection(room, (bool)(e.Value ?? false)))"
                                                   style="cursor:pointer;" />
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>
                                }
                                <DxGridDataColumn FieldName="SN" Caption="SN" Width="45px"
                                                  TextAlignment="GridTextAlignment.Center" />
                                <DxGridDataColumn FieldName="Room" Caption="Room" Width="80px" />
                                <DxGridDataColumn FieldName="RoomType" Caption="Room Type" Width="120px" />
                                <DxGridDataColumn FieldName="HKStatus" Caption="HK Status" Width="100px" />
                                <DxGridDataColumn FieldName="FOStatus" Caption="FO Status" Width="100px" />
                                <DxGridDataColumn FieldName="Floor" Caption="Floor" Width="110px" />
                                <DxGridDataColumn FieldName="Feature" Caption="Feature" Width="140px" />
                                <DxGridDataColumn FieldName="Remark" Caption="Remark" />
                            </Columns>
                        </DxGrid>
                    </div>
                </DxTabPage>
                <DxTabPage Text="Pseudo Rooms">
                    <div style="padding:50px; text-align:center; color:#888;">
                        Pseudo Rooms Content
                    </div>
                </DxTabPage>
            </DxTabs>

        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string GuestName { get; set; } = "";
    [Parameter] public RoomItem? SelectedRoom { get; set; }
    [Parameter] public EventCallback<RoomItem?> SelectedRoomChanged { get; set; }
    [Parameter] public bool MultiSelect { get; set; } = false;
    [Parameter] public List<RoomItem> SelectedRooms { get; set; } = new();
    [Parameter] public EventCallback<List<RoomItem>> SelectedRoomsChanged { get; set; }
    [Parameter] public EventCallback<List<RoomItem>> OnSelectMulti { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string FilterText { get; set; } = "";
    [Parameter] public List<RoomItem>? RoomList { get; set; }

    int roomTab = 0;
    string? selectedFeature;
    string? selectedRoomType;
    string roomFilter = "";

    List<string> roomFeatures = new() { "Select feature", "Sea View", "City View", "Balcony", "Connecting" };
    List<string> roomTypes = new() { "All", "Delux", "Standard", "Suite", "Executive" };

    private static readonly List<RoomItem> MasterRoomList = new()
    {
        new() { SN = 1, Room = "204", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 2, Room = "205", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Due Out", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 3, Room = "206", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 4, Room = "207", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 5, Room = "208", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 6, Room = "209", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 7, Room = "210", RoomType = "Delux", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 2", Feature
= "", Remark = "" },
        new() { SN = 8, Room = "101", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",Feature = "", Remark = "" },
        new() { SN = 9, Room = "102", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",Feature = "", Remark = "" },
        new() { SN = 10, Room = "103", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 11, Room = "104", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 12, Room = "105", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 13, Room = "106", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 14, Room = "107", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 15, Room = "108", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 16, Room = "109", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 17, Room = "110", RoomType = "Standard", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 1",
Feature = "", Remark = "" },
        new() { SN = 18, Room = "301", RoomType = "Suite", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 3", Feature
= "", Remark = "" },
        new() { SN = 19, Room = "302", RoomType = "Suite", HKStatus = "Clean", FOStatus = "Vacant", Floor = "Floor - 3", Feature
= "", Remark = "" },
        new() { SN = 20, Room = "4001",RoomType = "Standard", HKStatus = "Dirty", FOStatus = "Vacant", Floor = "Abay Block",Feature = "", Remark = "" },
    };

    IEnumerable<RoomItem> FilteredRooms
    {
        get
        {
            var list = MasterRoomList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(selectedFeature) && selectedFeature != "Select feature")
            {
                list = list.Where(r => r.Feature.Equals(selectedFeature, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedRoomType) && selectedRoomType != "All")
            {
                list = list.Where(r => r.RoomType.Equals(selectedRoomType, StringComparison.OrdinalIgnoreCase));
            }

            var activeFilter = !string.IsNullOrWhiteSpace(roomFilter) ? roomFilter : FilterText;
            if (!string.IsNullOrWhiteSpace(activeFilter))
            {
                var f = activeFilter.Trim().ToLower();
                list = list.Where(r => r.Room.ToLower().Contains(f)
                                    || r.RoomType.ToLower().Contains(f)
                                    || r.Floor.ToLower().Contains(f));
            }

            return list.ToList();
        }
    }

    bool IsRoomSelected(RoomItem room) => SelectedRooms.Any(r => r.SN == room.SN || r.Room == room.Room);

    bool IsAllSelected()
    {
        var selectable = FilteredRooms.Where(r => !r.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase)).ToList();
        return selectable.Count > 0 && selectable.All(r => IsRoomSelected(r));
    }

    void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        var selectable = FilteredRooms.Where(r => !r.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase)).ToList();
        if (isChecked)
        {
            foreach (var r in selectable)
            {
                if (!IsRoomSelected(r))
                {
                    SelectedRooms.Add(r);
                }
            }
        }
        else
        {
            foreach (var r in selectable)
            {
                SelectedRooms.RemoveAll(x => x.SN == r.SN || x.Room == r.Room);
            }
        }
        _ = SelectedRoomsChanged.InvokeAsync(SelectedRooms);
    }

    void ToggleRoomSelection(RoomItem room, bool isChecked)
    {
        if (room.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase)) return;

        if (isChecked)
        {
            if (!IsRoomSelected(room))
            {
                SelectedRooms.Add(room);
            }
        }
        else
        {
            SelectedRooms.RemoveAll(x => x.SN == room.SN || x.Room == room.Room);
        }
        _ = SelectedRoomsChanged.InvokeAsync(SelectedRooms);
    }

    async Task HandleSelect()
    {
        if (MultiSelect)
        {
            // Filter out dirty rooms if any were somehow included
            SelectedRooms.RemoveAll(r => r.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase));
            Visible = false;
            await VisibleChanged.InvokeAsync(false);
            await SelectedRoomsChanged.InvokeAsync(SelectedRooms);
            await OnSelectMulti.InvokeAsync(SelectedRooms);
            return;
        }

        if (SelectedRoom != null && SelectedRoom.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnSelect.InvokeAsync();
    }

    async Task HandleClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    async Task OnRoomRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as RoomItem;
        if (item != null)
        {
            // Dirty rooms cannot be selected
            if (item.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (MultiSelect)
            {
                bool isCurrentlySelected = IsRoomSelected(item);
                ToggleRoomSelection(item, !isCurrentlySelected);
            }
            else
            {
                SelectedRoom = item;
                await SelectedRoomChanged.InvokeAsync(SelectedRoom);
            }
            StateHasChanged();
        }
    }

    void OnRoomCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataCell || e.ElementType == GridElementType.DataRow)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as RoomItem;
            if (item == null) return;

            bool isDirty = item.HKStatus.Equals("Dirty", StringComparison.OrdinalIgnoreCase);
            bool isSelected = !isDirty && (MultiSelect ? IsRoomSelected(item) : (SelectedRoom != null && (item.SN == SelectedRoom.SN
|| item.Room == SelectedRoom.Room)));
            bool isDueOutOrDirty = item.FOStatus == "Due Out" || isDirty;

            if (e.ElementType == GridElementType.DataCell)
            {
                if (isSelected)
                {
                    e.CssClass = "rs-cell-selected";
                }
                else if (isDueOutOrDirty)
                {
                    e.CssClass = isDirty ? "rs-cell-red rs-cell-dirty" : "rs-cell-red";
                }
                else
                {
                    e.CssClass = "rs-cell-green";
                }
            }

            if (e.ElementType == GridElementType.DataRow)
            {
                if (isDirty)
                {
                    e.CssClass += " rs-row-dirty";
                }
                else if (isSelected)
                {
                    e.CssClass += " rs-row-selected";
                }
            }
        }
    }
}

<style>
    .global-room-search-popup .dxbl-popup-body-content {
        padding: 8px !important;
        background-color: #f7f9fa;
    }

    .rs-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .rs-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f5f5f5;
        border-bottom: 1px solid #d0d7dd;
        padding: 6px;
    }

    .rs-btn-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        padding: 4px 12px;
        cursor: pointer;
        min-width: 60px;
        user-select: none;
        transition: all 0.15s ease;
    }

    .rs-btn-group:hover {
        background: #e3f2fd;
        border-color: #90caf9;
    }

    .rs-btn-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .rs-icon-select {
        font-size: 26px;
        color: #4caf50;
        line-height: 1;
    }

    .rs-icon-close {
        font-size: 26px;
        color: #d32f2f;
        line-height: 1;
    }

    .rs-btn-text {
        font-size: 11px;
        font-weight: 600;
        color: #333;
        margin-top: 2px;
    }

    .rs-filter-group {
        display: flex;
        align-items: center;
        border-radius: 4px;
        padding: 4px 10px;
        gap: 12px;
        flex: 1;
    }

    .rs-filter-col {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .rs-center-col {
        justify-content: center;
    }

    .rs-field-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .rs-label {
        font-size: 11.5px;
        font-weight: 500;
        color: #333;
        min-width: 65px;
        text-align: right;
    }

    .rs-vsep {
        width: 1px;
        height: 44px;
        background: #d0d7dd;
    }

    .rs-tabs {
        margin-top: 4px;
    }

    .rs-tab-title {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
    }

    .rs-tab-icon-house {
        color: #f57c00;
    }

    .rs-tab-icon-minus {
        color: #0288d1;
    }

    /* Grid Styles matching reference image */
    .rs-grid.dxbl-grid {
        border: 1px solid #c9d2d9;
        border-radius: 3px;
        font-size: 12px;
    }

    .rs-grid .dxbl-grid-header-cell {
        background: #e9ecef !important;
        font-weight: 700;
        color: #2b3e50;
        border-bottom: 1px solid #b0bec5 !important;
        border-right: 1px solid #cfd8dc !important;
        padding: 4px 8px !important;
    }

    .rs-grid .dxbl-grid-data-cell {
        padding: 4px 8px !important;
        border-right: 1px solid #e0e0e0 !important;
        border-bottom: 1px solid #eeeeee !important;
        font-weight: 500;
    }

    .rs-cell-green {
        color: #2e7d32 !important;
    }

    .rs-cell-red {
        color: #d32f2f !important;
    }

    .rs-cell-selected,
    .rs-grid .dxbl-grid-data-row.rs-row-selected .dxbl-grid-data-cell,
    .rs-grid .dxbl-grid-data-row.rs-row-selected td {
        background-color: #0d6efd !important;
        color: #ffffff !important;
    }

    .rs-cell-dirty,
    .rs-grid .dxbl-grid-data-row.rs-row-dirty,
    .rs-grid .dxbl-grid-data-row.rs-row-dirty td {
        cursor: not-allowed !important;
        background-color: #fff5f5 !important;
        opacity: 0.8;
    }
</style>
