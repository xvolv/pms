@using DevExpress.Blazor
@using ERP.V7.WebPMS.Services.DocumentBrowser
@using CNET_V7_Domain.Misc
@inject IDocumentBrowserService DocumentBrowserService

<DxPopup Visible="@Visible"
         VisibleChanged="@HandleVisibleChanged"
         HeaderText="Travel Agent Search"
         Width="540px"
         CloseOnOutsideClick="true"
         ShowCloseButton="true"
         CloseOnEscape="true"
         CssClass="global-lookup-popup">
    <BodyContentTemplate>
        <div class="lookup-modal-container">
            <div class="lookup-modal-searchrow">
                <input class="lookup-modal-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search travel agent..." />
                <button type="button" class="lookup-modal-find-btn">Find</button>
            </div>
            <div class="lookup-modal-gridwrap">
                @if (IsLoading && DataList.Count == 0)
                {
                    <div style="padding: 24px; text-align: center; color: #666; font-size: 13px;">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span> Loading travel agents...
                    </div>
                }
                else
                {
                    <DxGrid @ref="gridRef"
                            Data="@FilteredAgents"
                            CssClass="lookup-modal-grid"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            CustomizeElement="OnCustomizeElement"
                            RowClick="OnRowClick"
                            RowDoubleClick="OnRowDoubleClick">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(AgentItem.Code)" Caption="Code" Width="110px" />
                            <DxGridDataColumn FieldName="@nameof(AgentItem.Name)" Caption="Agent Name" Width="180px" />
                            <DxGridDataColumn FieldName="@nameof(AgentItem.IataNo)" Caption="IATA / ID" Width="120px" />
                            <DxGridDataColumn FieldName="@nameof(AgentItem.AgentType)" Caption="Type" Width="90px" />
                        </Columns>
                    </DxGrid>
                }
            </div>
            <div class="lookup-modal-footer">
                <button type="button" class="lookup-modal-btn lookup-modal-btn-select" @onclick="HandleSelect">Select</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleAddNew">Add New</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClear">Clear</button>
                <button type="button" class="lookup-modal-btn" @onclick="HandleClose">Close</button>
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public List<AgentItem>? Agents { get; set; }
    [Parameter] public AgentItem? SelectedAgent { get; set; }
    [Parameter] public EventCallback<AgentItem?> SelectedAgentChanged { get; set; }
    [Parameter] public EventCallback<AgentItem> OnSelect { get; set; }
    [Parameter] public EventCallback OnAddNew { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    string SearchText { get; set; } = "";
    AgentItem? selectedRow;
    IGrid? gridRef;
    List<AgentItem> ApiAgents = new();
    bool IsLoading = false;
    bool hasLoaded = false;

    List<AgentItem> DataList => (ApiAgents.Count > 0) ? ApiAgents : (Agents ?? new());

    IEnumerable<AgentItem> FilteredAgents =>
        string.IsNullOrWhiteSpace(SearchText)
            ? DataList
            : DataList.Where(a => (a.Code?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (a.Name?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (a.IataNo?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (a.AgentType?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadApiDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedAgent != null)
        {
            selectedRow = SelectedAgent;
        }

        if (Visible && !hasLoaded)
        {
            await LoadApiDataAsync();
        }
    }

    async Task LoadApiDataAsync()
    {
        if (hasLoaded && ApiAgents.Count > 0) return;

        try
        {
            IsLoading = true;
            var res = await DocumentBrowserService.GetConsigneeHeaderFormattedViewAsync(new ConsigneeFilterCriteria
            {
                GslType = 31,
                FieldFormatType = 1617
            });

            if (res != null && res.Count > 0)
            {
                ApiAgents = res.Select(dto => new AgentItem
                {
                    Code = dto.Code ?? "",
                    Name = !string.IsNullOrWhiteSpace(dto.FullName) ? dto.FullName : (dto.FirstName ?? ""),
                    IataNo = !string.IsNullOrWhiteSpace(dto.Tin) ? dto.Tin : (dto.NationalId ?? ""),
                    AgentType = !string.IsNullOrWhiteSpace(dto.BusinessTypeDesc) ? dto.BusinessTypeDesc : "Travel Agent"
                }).ToList();
                hasLoaded = true;
            }
        }
        catch
        {
            // fallback gracefully
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    void OnRowClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as AgentItem;
        if (item != null)
        {
            selectedRow = item;
        }
    }

    async Task OnRowDoubleClick(GridRowClickEventArgs e)
    {
        var item = e.Grid?.GetDataItem(e.VisibleIndex) as AgentItem;
        if (item != null)
        {
            selectedRow = item;
            await HandleSelect();
        }
    }

    void OnCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow && selectedRow != null)
        {
            var item = e.Grid?.GetDataItem(e.VisibleIndex) as AgentItem;
            if (item != null && item.Code == selectedRow.Code)
            {
                e.CssClass = "lookup-modal-row-selected";
            }
        }
    }

    async Task HandleSelect()
    {
        if (selectedRow != null)
        {
            await SelectedAgentChanged.InvokeAsync(selectedRow);
            await OnSelect.InvokeAsync(selectedRow);
        }
        await HandleClose();
    }

    async Task HandleAddNew()
    {
        await OnAddNew.InvokeAsync();
    }

    async Task HandleClear()
    {
        selectedRow = null;
        await SelectedAgentChanged.InvokeAsync(null);
        await OnClear.InvokeAsync();
        await HandleClose();
    }

    async Task HandleClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    async Task HandleVisibleChanged(bool visible)
    {
        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }
}
