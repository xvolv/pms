@using DevExpress.Blazor

<div class="package-dropdown-wrapper">
    <label>Packages</label>
    <div class="lookup-field">
        <DxTextBox @bind-Text="SelectedPackage" ReadOnly="true"
                   CssClass="erp-combobox lookup-input" NullText="" />
        <button type="button" class="lookup-toggle-btn" @onclick="TogglePackagePopup">▾</button>

        @if (ShowPackagePopup)
        {
            <div class="global-dropdown-popup">
            <div class="global-dropdown-body">
                <div class="global-dropdown-search-row">
                    <input class="global-dropdown-search-input"
                           @bind="PackagePopupFilter" @bind:event="oninput" />
                    <button type="button" class="global-dropdown-find-btn" @onclick="@(() => { })">Find</button>
                </div>
                <div class="global-dropdown-list">
                    <div class="global-dropdown-list-header">Name</div>
                    @foreach (var item in PackageListItems.Where(MatchesFilter(PackagePopupFilter)))
                    {
                        <div class="global-dropdown-list-item @(SelectedPackage == item ? "global-selected" : "")"
                             @onclick="() => SelectPackage(item)">
                            @item
                        </div>
                    }
                </div>
            </div>
            <div class="global-dropdown-clear-row">
                <button type="button" class="global-dropdown-clear-btn"
                        @onclick="@(() => PackagePopupFilter = string.Empty)">Clear</button>
            </div>
            <div class="global-dropdown-footer-bar">
                <i class="bi bi-x-lg" @onclick="() => ShowPackagePopup = false"></i>
                <i class="bi bi-grip-horizontal global-dropdown-resize-handle"></i>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? SelectedPackage { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedPackageChanged { get; set; }

    [Parameter]
    public List<string>? PackageItems { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "";

    private bool ShowPackagePopup;
    private string PackagePopupFilter = "";

    private List<string> PackageListItems => PackageItems ?? new List<string>();

    void TogglePackagePopup()
    {
        ShowPackagePopup = !ShowPackagePopup;
    }

    async Task SelectPackage(string item)
    {
        SelectedPackage = item;
        await SelectedPackageChanged.InvokeAsync(SelectedPackage);
        ShowPackagePopup = false;
    }

    Func<string, bool> MatchesFilter(string filterText) =>
        item => string.IsNullOrEmpty(filterText) ||
                item.Contains(filterText, StringComparison.OrdinalIgnoreCase);
}

<style>
    .package-dropdown-wrapper {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
    }

    .package-dropdown-wrapper label {
        font-size: 12px;
        color: #333;
        white-space: nowrap;
    }

    .global-dropdown-anchor {
        position: relative;
    }

    .global-dropdown-popup {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        background: #fff;
        border: 1px solid #888;
        box-shadow: 2px 2px 8px rgba(0,0,0,0.3);
        width: 420px;
        display: flex;
        flex-direction: column;
    }

    .global-dropdown-body {
        padding: 8px;
        display: flex;
        flex-direction: column;
    }

    .global-dropdown-search-row {
        display: flex;
        gap: 8px;
        margin-bottom: 6px;
    }

    .global-dropdown-search-input {
        flex: 1;
        border: 1px solid #999;
        padding: 3px 5px;
        font-size: 13px;
    }

    .global-dropdown-find-btn {
        border: 1px solid #888;
        background: #fff;
        padding: 3px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    .global-dropdown-list {
        min-height: 180px;
        max-height: 280px;
        overflow-y: auto;
    }

    .global-dropdown-list-header {
        color: #555;
        padding: 3px 2px 5px 2px;
        font-size: 13px;
        border-bottom: 1px solid #eee;
    }

    .global-dropdown-list-item {
        padding: 4px 6px;
        cursor: pointer;
        font-size: 13px;
    }

    .global-dropdown-list-item:hover {
        background: #f0f4fa;
    }

    .global-dropdown-list-item.global-selected {
        background: #cce4f7;
        border: 1px solid #99c2e8;
    }

    .global-dropdown-clear-row {
        border-top: 1px solid #ccc;
        padding: 6px 8px;
        display: flex;
        justify-content: flex-end;
    }

    .global-dropdown-clear-btn {
        border: 1px solid #888;
        background: #fff;
        padding: 3px 16px;
        font-size: 13px;
        cursor: pointer;
    }

    .global-dropdown-footer-bar {
        background: #ececec;
        border-top: 1px solid #ccc;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 6px;
    }

    .global-dropdown-footer-bar i {
        color: #555;
        font-size: 11px;
        cursor: pointer;
    }

    .global-dropdown-resize-handle {
        transform: rotate(45deg);
    }
</style>
