@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject RecentPagesService RecentPagesService
@inject IJSRuntime JS
@implements IDisposable

<div class="page @(isSidebarCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <AppSidebar OnSectionActivated="ExpandSidebar" />
    </div>

    <main>
        <button class="sidebar-toggle-btn" @onclick="ToggleSidebar" title="@(isSidebarCollapsed ? "Show Menu" : "Hide Menu")">
            <i class="bi @(isSidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        </button>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<FolioPopup />

@code {
    private bool isSidebarCollapsed = true;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        TrackCurrentLocation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("authSync.init");
                await JS.InvokeAsync<bool>("authSync.validate");
            }
            catch
            {
                // Ignored if JS runtime is unavailable or disconnected
            }
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        TrackCurrentLocation();
        _ = ValidateAuthAsync();
    }

    private async Task ValidateAuthAsync()
    {
        try
        {
            var isValid = await JS.InvokeAsync<bool>("authSync.validate");
            if (!isValid)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
        }
        catch
        {
            // Ignored during disconnection or circuit teardown
        }
    }

    private void TrackCurrentLocation()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        RecentPagesService.Track(relativePath);
    }

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private void ExpandSidebar()
    {
        isSidebarCollapsed = false;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
